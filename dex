local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local Settings = {
    AutoParry = true,
    AlwaysSpam = true, -- Mode spam nonstop saat bola mendekat/target
    ParryRange = 25,    -- Jarak aman pemicu awal
    ConfigFile = "BladeBall_SpamConfig.json"
}

-- Load Saved Settings
if isfile and isfile(Settings.ConfigFile) then
    pcall(function()
        local data = HttpService:JSONDecode(readfile(Settings.ConfigFile))
        for k, v in pairs(data) do Settings[k] = v end
    end)
end

local function SaveSettings()
    if writefile then
        pcall(function()
            writefile(Settings.ConfigFile, HttpService:JSONEncode(Settings))
        end)
    end
end

