local scannedObjects = {}
local currentIndex = 0
local RaycastMode = false
local PullMode = false

-- Fungsi Mengisi Kolom 3 (Isi Folder)
local function populateCol3(folderItem)
    for _, child in pairs(Col3:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    
    local count = 0
    for _, subObj in pairs(folderItem:GetChildren()) do
        count = count + 1
        local subBtn = Instance.new("TextButton")
        subBtn.Size = UDim2.new(1, -4, 0, 24)
        subBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
        subBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
        subBtn.Font = Enum.Font.Code
        subBtn.TextSize = 9
        subBtn.Text = " - " .. subObj.Name .. " [" .. subObj.ClassName .. "]"
        subBtn.TextXAlignment = Enum.TextXAlignment.Left
        subBtn.Parent = Col3
        Instance.new("UICorner", subBtn).CornerRadius = UDim.new(0, 4)
    end
    Col3.CanvasSize = UDim2.new(0, 0, 0, count * 26)
end

-- Fungsi Memperbarui Kolom 2 (Hirarki Induk) secara Otomatis
local function showTripleHierarchy(targetObj)
    for _, child in pairs(Col2:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    for _, child in pairs(Col3:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
    
    local current = targetObj.Parent
    local lineage = {}
    while current and current ~= game do
        table.insert(lineage, 1, current)
        current = current.Parent
    end
    
    local count = 0
    for _, folderItem in ipairs(lineage) do
        count = count + 1
        local fBtn = Instance.new("TextButton")
        fBtn.Size = UDim2.new(1, -4, 0, 26)
        fBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
        fBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
        fBtn.Font = Enum.Font.Code
        fBtn.TextSize = 9
        fBtn.Text = "📁 " .. folderItem.Name
        fBtn.TextXAlignment = Enum.TextXAlignment.Left
        fBtn.Parent = Col2
        Instance.new("UICorner", fBtn).CornerRadius = UDim.new(0, 4)
        
        fBtn.MouseButton1Click:Connect(function()
            populateCol3(folderItem)
        end)
    end
    Col2.CanvasSize = UDim2.new(0, 0, 0, count * 28)
    
    -- Otomatis tampilkan isi dari folder tingkat paling dekat dengan objek
    if #lineage > 0 then
        populateCol3(lineage[#lineage])
    end
end

-- Fungsi Target Utama (Pindah Objek, Pindah Garis Hijau, & Refresh Kolom Sejajar)
local function selectTargetObject(obj, index)
    if not obj or not obj.Parent then return end
    currentIndex = index
    HighlightFolder:ClearAllChildren()
    
    pcall(function()
        local box = Instance.new("SelectionBox")
        box.Adornee = obj
        box.Color3 = Color3.fromRGB(0, 255, 128)
        box.LineThickness = 0.09
        box.Parent = HighlightFolder
    end)
    
    -- Segarkan susunan kolom 2 dan kolom 3 secara otomatis menyesuaikan objek baru
    showTripleHierarchy(obj)
    StatusLabel.Text = "Aktif [" .. currentIndex .. "/" .. #scannedObjects .. "]: " .. obj.Name .. " (" .. obj.ClassName .. ")"
end

-- Tombol Scan Workspace
ScanBtn.MouseButton1Click:Connect(function()
    ScanBtn.Text = "MEMINDAI..."
    ScanBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    
    task.spawn(function()
        for _, child in pairs(Col1:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        for _, child in pairs(Col2:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        for _, child in pairs(Col3:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
        HighlightFolder:ClearAllChildren()
        
        scannedObjects = {}
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name and (obj:IsA("BasePart") or obj:IsA("Model")) then
                table.insert(scannedObjects, obj)
            end
        end
        
        for i, obj in ipairs(scannedObjects) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -4, 0, 24)
            btn.BackgroundColor3 = Color3.fromRGB(16, 16, 20)
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Font = Enum.Font.Code
            btn.TextSize = 9
            btn.Text = i .. ". " .. obj.Name
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.Parent = Col1
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            
            btn.MouseButton1Click:Connect(function()
                selectTargetObject(obj, i)
            end)
        end
        Col1.CanvasSize = UDim2.new(0, 0, 0, #scannedObjects * 26)
        ScanBtn.Text = "🔄 SCAN SEMUA"
        ScanBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        
        if #scannedObjects > 0 then
            selectTargetObject(scannedObjects[1], 1)
        end
    end)
end)

-- Tombol Skip Objek (Mengganti Susunan World & Kolom Secara Otomatis)
SkipBtn.MouseButton1Click:Connect(function()
    if #scannedObjects == 0 then
        StatusLabel.Text = "Error: Belum scan objek! Klik Scan Dulu."
        return
    end
    
    currentIndex = currentIndex + 1
    if currentIndex > #scannedObjects then
        currentIndex = 1
    end
    
    local nextObj = scannedObjects[currentIndex]
    if nextObj then
        selectTargetObject(nextObj, currentIndex)
    end
end)

-- Tombol 3D Raycast Click Mode
RaycastBtn.MouseButton1Click:Connect(function()
    RaycastMode = not RaycastMode
    RaycastBtn.Text = RaycastMode and "🎯 3D CLICK: ON" or "🎯 3D CLICK: OFF"
    RaycastBtn.BackgroundColor3 = RaycastMode and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not RaycastMode or gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {player.Character, HighlightFolder}
        
        local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1500, rayParams)
        if result and result.Instance then
            local hitPart = result.Instance
            MainFrame.Visible = true
            showTripleHierarchy(hitPart)
            HighlightFolder:ClearAllChildren()
            
            pcall(function()
                local box = Instance.new("SelectionBox")
                box.Adornee = hitPart
                box.Color3 = Color3.fromRGB(255, 100, 0)
                box.LineThickness = 0.09
                box.Parent = HighlightFolder
            end)
            StatusLabel.Text = "3D Click Target: " .. hitPart.Name
        end
    end
end)

-- Tombol Auto Pull Item
PullBtn.MouseButton1Click:Connect(function()
    PullMode = not PullMode
    PullBtn.Text = PullMode and "🧲 PULL: ON" or "🧲 PULL: OFF"
    PullBtn.BackgroundColor3 = PullMode and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
end)

RunService.Heartbeat:Connect(function()
    if PullMode then
        pcall(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local myPos = char.HumanoidRootPart.CFrame
            
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and not obj.Anchored and obj ~= char and not obj:IsDescendantOf(char) then
                    local size = obj.Size
                    if size.X < 4 and size.Y < 4 and size.Z < 4 then
                        obj.CFrame = myPos + Vector3.new(0, 2, 0)
                    end
                end
            end
        end)
    end
end)

