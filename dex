-- ==========================================
-- [BAGIAN 5] FITUR UTAMA: AUTO COLLECT (AMAN DARI BASE)
-- ==========================================

local autoCollectBtn = Instance.new("TextButton")
autoCollectBtn.Name = "AutoCollectButton"
autoCollectBtn.Size = UDim2.new(0, 220, 0, 45)
autoCollectBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoCollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoCollectBtn.Text = "Auto Collect: OFF"
autoCollectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoCollectBtn.TextSize = 14
autoCollectBtn.Font = Enum.Font.SourceSansBold
autoCollectBtn.Parent = mainFrame

local autoCollectAktif = false
autoCollectBtn.MouseButton1Click:Connect(function()
    autoCollectAktif = not autoCollectAktif
    
    if autoCollectAktif then
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoCollectBtn.Text = "Auto Collect: ON"
        
        task.spawn(function()
            while autoCollectAktif do
                local karakter = game:GetService("Players").LocalPlayer.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local posAwal = karakter.HumanoidRootPart.Position
                    local targetKetemu = nil
                    
                    -- Cari benda yang punya TouchInterest di seluruh workspace
                    for _, descendant in ipairs(workspace:GetDescendants()) do
                        if descendant:IsA("TouchInterest") and descendant.Parent then
                            local partTarget = descendant.Parent
                            
                            -- Pastikan itu berupa BasePart dan BUKAN bagian dari base (misal: cek apakah ada di dalam folder Base/Tycoon)
                            if partTarget:IsA("BasePart") then
                                
                                -- CEK TAMBAHAN (PENGAMAN):
                                -- 1. Pastikan tidak masuk ke folder Base (Biasanya nama foldernya "Plots", "Bases", atau "Tycoons")
                                local isBase = false
                                local parentCek = partTarget.Parent
                                while parentCek and parentCek ~= workspace do
                                    if parentCek.Name:lower():find("base") or parentCek.Name:lower():find("plot") or parentCek.Name:lower():find("tycoon") then
                                        isBase = true
                                        break
                                    end
                                    parentCek = parentCek.Parent
                                end
                                
                                -- Kalau BUKAN base, jadikan target!
                                if not isBase then
                                    targetKetemu = partTarget
                                    break -- Ambil satu dulu yang terdekat/ketemu
                                end
                                
                            end
                        end
                    end
                    
                    -- Kalau target yang bukan base ketemu, langsung teleport ke situ!
                    if targetKetemu then
                        karakter.HumanoidRootPart.CFrame = targetKetemu.CFrame
                    end
                    
                end
                task.wait(0.4)
            end
        end)
    else
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoCollectBtn.Text = "Auto Collect: OFF"
    end
end)
