-- Execute Rapid Hits (Zero Cooldown Loop)
local function ExecHit()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- Detection Engine
local function CheckTarget(ball)
    if ball:GetAttribute("target") == LocalPlayer.Name or ball:GetAttribute("Target") == LocalPlayer.Name then
        return true
    end
    
    local highlight = ball:FindFirstChildOfClass("Highlight")
    if highlight and (highlight.FillColor == Color3.fromRGB(255, 0, 0) or highlight.OutlineColor == Color3.fromRGB(255, 0, 0)) then
        return true
    end

    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local hrp = character.HumanoidRootPart
        local ballVelocity = ball.AssemblyLinearVelocity
        if ballVelocity.Magnitude > 0 then
            local directionToPlayer = (hrp.Position - ball.Position).Unit
            local movementDot = ballVelocity.Unit:Dot(directionToPlayer)
            if movementDot > 0.75 then
                return true
            end
        end
    end

    return false
end

-- Main Heartbeat Engine (Super High Speed)
RunService.PreRender:Connect(function()
    if not Settings.AutoParry then return end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local balls = workspace:FindFirstChild("Balls") or workspace
    
    for _, ball in pairs(balls:GetChildren()) do
        if ball:IsA("BasePart") and ball.Transparency < 1 then
            local distance = (ball.Position - hrp.Position).Magnitude
            local isTarget = CheckTarget(ball)

            -- Jika target mengunci atau bola masuk ke jarak area aman
            if isTarget and distance <= Settings.ParryRange then
                if Settings.AlwaysSpam then
                    -- Spam berturut-turut tanpa task.wait untuk menutup celah
                    ExecHit()
                else
                    ExecHit()
                    task.wait(0.1)
                end
                break
            end
        end
    end
end)
