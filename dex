-- Folder & SelectionBox untuk Garis Batas Objek (Highlight)
local HighlightFolder = Instance.new("Folder", ScreenGui)
HighlightFolder.Name = "DewaHighlights"

local function selectObject(obj)
    HighlightFolder:ClearAllChildren()
    if obj and obj:IsA("Instance") then
        pcall(function()
            local box = Instance.new("SelectionBox")
            box.Adornee = obj
            box.Color3 = Color3.fromRGB(0, 255, 128)
            box.LineThickness = 0.08
            box.Parent = HighlightFolder
        end)
        
        -- Cari jalur folder aslinya (Path)
        local success, path = pcall(function()
            return obj:GetFullName()
        end)
        
        StatusLabel.Text = "Terpilih:\nNama: " .. obj.Name .. "\nKelas: " .. obj.ClassName .. "\nPath: " .. (success and path or "Unknown")
    end
end

-- Tombol Scan Workspace
ScanBtn.MouseButton1Click:Connect(function()
    ScanBtn.Text = "MEMINDAI..."
    ScanBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    
    pcall(function()
        for _, child in pairs(ScrollFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        HighlightFolder:ClearAllChildren()
        
        local count = 0
        for _, obj in pairs(workspace:GetChildren()) do
            if obj and obj.Name then
                count = count + 1
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -6, 0, 26)
                btn.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
                btn.TextColor3 = Color3.fromRGB(210, 210, 210)
                btn.Font = Enum.Font.Code
                btn.TextSize = 9
                btn.Text = "📁 " .. obj.Name .. " [" .. obj.ClassName .. "]"
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = ScrollFrame
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
                
                -- Kalau tombol di menu diklik, arahkan garis kotak ke objek itu
                btn.MouseButton1Click:Connect(function()
                    selectObject(obj)
                end)
            end
        end
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 29)
        StatusLabel.Text = "Scan Selesai! Ditemukan " .. count .. " objek."
    end)
    
    ScanBtn.Text = "🔄 SCAN OBJEK WORKSPACE"
    ScanBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
end)
