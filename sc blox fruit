-- 6. LOOP UTAMA
-- ==========================================
task.spawn(function()
    while task.wait(2.5) do
        autoStoreFruits()

        local fruitListRaw = {}
        local targetFruitObj = nil
        local targetFruitHandle = nil

        for _, obj in ipairs(Workspace:GetChildren()) do
            if isRealSpawnedFruit(obj) then
                table.insert(fruitListRaw, obj.Name)
                if not targetFruitObj then
                    targetFruitObj = obj
                    targetFruitHandle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                end
            end
        end

        local fruitList = {}
        local checkDuplicate = {}
        for _, name in ipairs(fruitListRaw) do
            if not checkDuplicate[name] then
                checkDuplicate[name] = true
                table.insert(fruitList, name)
            end
        end

        local currentCount = #fruitList

        MonitorFrame.Visible = Settings.MonitorVisible
        if Settings.MonitorVisible then
            local playerCount = #Players:GetPlayers()
            local fruitTextDisplay = currentCount > 0 and table.concat(fruitList, ", ") or "Tidak ada"
            MonitorContent.Text = string.format("• Player di Server: %d\n• Buah Spawn: %d\n• Nama: %s", playerCount, currentCount, fruitTextDisplay)
        end

        if Settings.FruitNotifier and currentCount > 0 then
            local fruitNameStr = table.concat(fruitList, ", ")
            playFruitSound()
            task.spawn(function() showFruitNotification(fruitNameStr) end)

            if Settings.AutoTeleportFruit and targetFruitObj and targetFruitHandle then
                local rootPart = getCharacterRootPart()
                if rootPart and not activeFlyConnection then
                    smoothFlyTo(targetFruitHandle.CFrame, "AutoTeleportFruit")
                end
            end
        end

        if Settings.AutoFlyPlayer then
            local targetPlayer = nil
            if Settings.TargetPlayerName ~= "" then
                targetPlayer = Players:FindFirstChild(Settings.TargetPlayerName)
            else
                local shortestDist = math.huge
                local rootPart = getCharacterRootPart()
                if rootPart then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local dist = (rootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                targetPlayer = p
                            end
                        end
                    end
                end
            end
            
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and Settings.AutoFlyPlayer then
                local rootPart = getCharacterRootPart()
                if rootPart and not activeFlyConnection then
                    smoothFlyTo(targetPlayer.Character.HumanoidRootPart.CFrame, "AutoFlyPlayer")
                end
            end
        end
    end
end)

