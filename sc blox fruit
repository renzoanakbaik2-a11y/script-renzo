-- Fungsi untuk memperbarui daftar player yang ada di server secara otomatis
local function refreshPlayerList()
	-- Hapus tombol lama di dalam list
	for _, child in ipairs(PlayerListScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local players = Players:GetPlayers()
	PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, #players * 34)

	for _, p in ipairs(players) do
		if p ~= LocalPlayer then
			local pBtn = Instance.new("TextButton")
			pBtn.Size = UDim2.new(1, -6, 0, 30)
			pBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
			pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			pBtn.Text = "  👤 " .. p.Name .. " (" .. p.DisplayName .. ")"
			pBtn.TextSize, pBtn.Font = 10, Enum.Font.Gotham
			pBtn.TextXAlignment = Enum.TextXAlignment.Left
			pBtn.Parent = PlayerListScroll

			local pBtnCorner = Instance.new("UICorner")
			pBtnCorner.CornerRadius = UDim.new(0, 4)
			pBtnCorner.Parent = pBtn

			pBtn.MouseButton1Click:Connect(function()
				Settings.TargetPlayerName = p.Name
				TargetStatusLabel.Text = "Target Aktif: " .. p.Name
				saveSettings()
			end)
		end
	end
end

-- Update daftar player saat ada yang masuk atau keluar server
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)
task.spawn(refreshPlayerList)


