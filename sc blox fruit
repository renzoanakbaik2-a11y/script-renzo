local activeHoverMobConnection = nil
local function toggleHoverNearestMob(state)
    if not state then 
        if activeHoverMobConnection then activeHoverMobConnection:Disconnect() activeHoverMobConnection = nil end
        return 
    end
    if activeHoverMobConnection then activeHoverMobConnection:Disconnect() end
    
    activeHoverMobConnection = RunService.Heartbeat:Connect(function()
        if not Settings.HoverNearestMob then return end
        local root = getCharacterRootPart()
        if not root then return end
        
        local closestMob = nil
        local minDist = math.huge
        
        local function scanMobModel(model)
            if model:IsA("Model") and model ~= LocalPlayer.Character then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                if humanoid and hrp and humanoid.Health > 0 then
                    if not Players:GetPlayerFromCharacter(model) then
                        local d = (root.Position - hrp.Position).Magnitude
                        if d < minDist then minDist = d closestMob = hrp end
                    end
                end
            end
        end

        local mobFolderNames = {"Enemies", "Enemy", "Monster", "Monsters"}
        for _, folderName in ipairs(mobFolderNames) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, mob in pairs(folder:GetChildren()) do scanMobModel(mob) end
            end
        end
        if closestMob then
            local safeOffset = math.clamp(Settings.MobHeightOffset, 3, 10)
            root.CFrame = CFrame.new(closestMob.Position + Vector3.new(0, safeOffset, 0))
        end
    end)
end

local function equipSelectedWeapon()
    pcall(function()
        local character = LocalPlayer.Character
        local backpack = LocalPlayer.Backpack
        if not character or not backpack then return end

        local targetType = Settings.SelectedWeapon or "Melee"
        local function matchesCategory(itemName, category)
            itemName = itemName:lower()
            if category == "Melee" then return itemName:find("combat") or itemName:find("step") or itemName:find("claw") or itemName:find("fist") or itemName:find("water") or itemName:find("dragon") or itemName:find("superhuman") or itemName:find("godhuman") or itemName:find("electric") or itemName:find("sanguine") or itemName:find("sharkman") or itemName:find("death")
            elseif category == "Fruit" then return itemName:find("fruit") or itemName:find("rocket") or itemName:find("spin") or itemName:find("spring") or itemName:find("chop") or itemName:find("spike") or itemName:find("flame") or itemName:find("falcon") or itemName:find("ice") or itemName:find("sand") or itemName:find("dark") or itemName:find("diamond") or itemName:find("light") or itemName:find("rubber") or itemName:find("barrier") or itemName:find("ghost") or itemName:find("magma") or itemName:find("quake") or itemName:find("buddha") or itemName:find("love") or itemName:find("spider") or itemName:find("phoenix") or itemName:find("portal") or itemName:find("pain") or itemName:find("blizzard") or itemName:find("gravity") or itemName:find("mammoth") or itemName:find("trex") or itemName:find("dough") or itemName:find("shadow") or itemName:find("venom") or itemName:find("control") or itemName:find("spirit") or itemName:find("dragon") or itemName:find("leopard") or itemName:find("kitsune")
            elseif category == "Sword" then return itemName:find("sword") or itemName:find("katana") or itemName:find("blade") or itemName:find("saber") or itemName:find("tushita") or itemName:find("culling") or itemName:find("buddy") or itemName:find("hallow") or itemName:find("dark") or itemName:find("pole") or itemName:find("rengoku") or itemName:find("wando") or itemName:find("shisui") or itemName:find("bisento") or itemName:find("midnight") or itemName:find("cavendish") or itemName:find("foxlamp")
            elseif category == "Gun" then return itemName:find("gun") or itemName:find("rifle") or itemName:find("musket") or itemName:find("kabucha") or itemName:find("soul") or itemName:find("bazooka") or itemName:find("flintlock") or itemName:find("cannon") or itemName:find("acidum") or itemName:find("serpent") end
            return false
        end

        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") and matchesCategory(child.Name, targetType) then return end
        end

        local targetTool = nil
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and matchesCategory(child.Name, targetType) then targetTool = child break end
        end

        if targetTool and targetTool.Parent == backpack then
            character.Humanoid:EquipTool(targetTool)
        end
    end)
end

local activeAuraConnection = nil
local function toggleAutoAuraAttack(state)
    if not state then
        if activeAuraConnection then activeAuraConnection:Disconnect() activeAuraConnection = nil end
        return
    end

    if activeAuraConnection then activeAuraConnection:Disconnect() end
    local lastAttackTick = 0

    activeAuraConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoAuraAttack then return end
        local root = getCharacterRootPart()
        if not root then return end

        local interval = (tonumber(Settings.AuraAttackSpeed) or 40) / 1000 
        if tick() - lastAttackTick < interval then return end
        lastAttackTick = tick()

        pcall(function()
            equipSelectedWeapon()
            local foundTarget = false
            local targetPos = nil

            local mobFolderNames = {"Enemies", "Enemy", "Monster", "Monsters"}
            for _, folderName in ipairs(mobFolderNames) do
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    for _, mob in pairs(folder:GetChildren()) do
                        local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        if mRoot and mHum and mHum.Health > 0 then
                            if (root.Position - mRoot.Position).Magnitude <= Settings.AuraRange then
                                foundTarget = true
                                targetPos = mRoot.Position
                                break
                            end
                        end
                    end
                end
                if foundTarget then break end
            end

            if foundTarget and targetPos then
                root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local combatRemote = remotes and remotes:FindFirstChild("Combat")
                if combatRemote then
                    combatRemote:InvokeServer(targetPos)
                else
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool then
                        local remoteEvent = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("AttackRemote")
                        if remoteEvent then remoteEvent:FireServer(targetPos) end
                    end
                end
            end
        end)
    end)
end

local function autoStoreFruits()
    if not Settings.AutoStoreFruit then return end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("MainRemote")
        local commF = remotes and (remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("Data"))
        if not commF then return end
        
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local character = LocalPlayer.Character
        local function checkAndStore(item)
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("fruit") or name:find("rocket") or name:find("spin") or name:find("kitsune") or name:find("dragon") or name:find("dough") or name:find("buddha") or name:find("trex") or name:find("mammoth") then
                    pcall(function() commF:InvokeServer("StoreFruit", item.Name) end)
                end
            end
        end
        if backpack then for _, item in ipairs(backpack:GetChildren()) do checkAndStore(item) end end
        if character then for _, item in ipairs(character:GetChildren()) do checkAndStore(item) end end
    end)
end

