-- ===================================================
-- LOGIKA TELEPORT MURNI (NO BUG / NO VOID)
-- ===================================================
local isAutoHitActive = false
local isProcessingHit = false
local lastHitTime = 0

local function SingleSwing()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- Pencari Bola Presisi
local function GetValidCourtBall()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local HRP = char.HumanoidRootPart

    for _, obj in pairs(Workspace:GetChildren()) do
        -- Cek objek bola aktif di Workspace utama
        local name = obj.Name:lower()
        if name:find("ball") or name:find("tennis") or obj:FindFirstChild("Ball") then
            local part = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
            if part then
                local bPos = part.Position
                -- Syarat 1: Bola tidak di bawah tanah dan tidak ketinggian aneh
                if bPos.Y >= 1 and bPos.Y <= 40 then
                    -- Syarat 2: Jarak horisontal bola mendekati area kita (Max 50 studs)
                    local dist2D = (Vector2.new(HRP.Position.X, HRP.Position.Z) - Vector2.new(bPos.X, bPos.Z)).Magnitude
                    if dist2D <= 50 then
                        return part
                    end
                end
            end
        end
    end
    return nil
end

local function ResetScriptState()
    isAutoHitActive = false
    isProcessingHit = false
    BtnAutoHit.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnAutoHit.Text = "AUTO TELEPORT BALL: OFF"
    StatusText.Text = "Status: Reset Done!"
end

BtnAutoHit.MouseButton1Click:Connect(function()
    isAutoHitActive = not isAutoHitActive
    if isAutoHitActive then
        BtnAutoHit.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnAutoHit.Text = "AUTO TELEPORT BALL: ON"
        StatusText.Text = "Status: Waiting Ball..."
    else
        ResetScriptState()
    end
end)

BtnReset.MouseButton1Click:Connect(function()
    ResetScriptState()
end)

-- ENGINE LOOP
RunService.RenderStepped:Connect(function()
    if not isAutoHitActive or isProcessingHit then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    local ballPart = GetValidCourtBall()

    if ballPart and (tick() - lastHitTime > 0.3) then
        isProcessingHit = true
        lastHitTime = tick()

        StatusText.Text = "Status: Ball Intercepted!"

        local bPos = ballPart.Position
        
        -- KUNCI UTAMA: Teleport HANYA di koordinat X dan Z bola, Y TETAP di ketinggian berdiri karakter
        HRP.CFrame = CFrame.new(Vector3.new(bPos.X, HRP.Position.Y, bPos.Z), Vector3.new(bPos.X, HRP.Position.Y, bPos.Z))

        -- Mukul 1 Kali
        task.wait(0.02)
        SingleSwing()

        task.wait(0.2)
        isProcessingHit = false

        if isAutoHitActive then
            StatusText.Text = "Status: Waiting Ball..."
        end
    end
end)
