-- Tombol Toggle Fitur
local function addToggle(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.Text = text .. ": OFF"
    btn.Parent = MainFrame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = btn

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)
end

addToggle("Instant Area Kill (Radius Dekat)", 55, function(v) CONFIG.InstantAreaKill = v end)
addToggle("ESP Kotak Musuh di Area", 110, function(v) CONFIG.VisualESP = v end)

