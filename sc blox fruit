-- 4. LOGIKA TELEPORTATION
local isAutoTeleport = false

local function TriggerTeleport()
    -- Cek ketersediaan folder Shared / RemoteEvents World // Zero
    local sharedFolder = ReplicatedStorage:FindFirstChild("Shared") or ReplicatedStorage:FindFirstChild("Packages")
    
    -- Mencari RemoteEvent khusus antrean dungeon / teleport
    local teleportRemote = ReplicatedStorage:FindFirstChild("TeleportToDungeon", true) 
        or ReplicatedStorage:FindFirstChild("EnterDungeon", true)
        or ReplicatedStorage:FindFirstChild("JoinQueue", true)

    if teleportRemote and teleportRemote:IsA("RemoteEvent") or teleportRemote:IsA("RemoteFunction") then
        -- Parameter World 1-1 Crabby Crusade
        local dungeonData = {
            World = 1,
            Dungeon = 1,
            Name = "Crabby Crusade",
            Difficulty = "Normal"
        }
        
        if teleportRemote:IsA("RemoteEvent") then
            teleportRemote:FireServer(dungeonData)
        else
            teleportRemote:InvokeServer(dungeonData)
        end
    else
        -- Fallback: Memanggil panggilan klik tombol UI 'Select' bawaan game secara otomatis
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            -- Simulasi interaksi klik GUI bawaan World // Zero
            warn("[TEST] Remote direct tidak ditemukan, mencoba trigger via UI Event game...")
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    isAutoTeleport = not isAutoTeleport
    
    if isAutoTeleport then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80) -- Hijau (ON)
        ToggleBtn.Text = "AUTO TELEPORT: ON"
        
        -- Eksekusi Teleport
        TriggerTeleport()
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40) -- Merah (OFF)
        ToggleBtn.Text = "AUTO TELEPORT: OFF"
    end
end)
