local activeAuraConnection = nil
local function toggleAutoAuraAttack(state)
    if not state then
        if activeAuraConnection then
            activeAuraConnection:Disconnect()
            activeAuraConnection = nil
        end
        return
    end

    if activeAuraConnection then activeAuraConnection:Disconnect() end

    local lastAttackTick = 0
    activeAuraConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoAuraAttack then return end
        local root = getCharacterRootPart()
        if not root then return end

        local speedSetting = tonumber(Settings.AuraAttackSpeed) or 40
        local interval = speedSetting / 1000 
        if tick() - lastAttackTick < interval then return end
        lastAttackTick = tick()

        pcall(function()
            equipSelectedWeapon()
            local foundTarget = false
            local targetPos = nil

            local mobFolderNames = {"Enemies", "Enemy", "Monster", "Monsters"}
            for _, folderName in ipairs(mobFolderNames) do
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    for _, mob in pairs(folder:GetChildren()) do
                        local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        if mRoot and mHum and mHum.Health > 0 then
                            local distanceToMob = (root.Position - mRoot.Position).Magnitude
                            if distanceToMob <= Settings.AuraRange then
                                foundTarget = true
                                targetPos = mRoot.Position
                                break
                            end
                        end
                    end
                end
                if foundTarget then break end
            end

            if not foundTarget then
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and plr.Character then
                        local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                        local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
                        if pRoot and pHum and pHum.Health > 0 then
                            if (root.Position - pRoot.Position).Magnitude <= Settings.AuraRange then
                                foundTarget = true
                                targetPos = pRoot.Position
                                break
                            end
                        end
                    end
                end
            end

            if foundTarget and targetPos then
                root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
                
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local combatRemote = remotes and remotes:FindFirstChild("Combat")
                if combatRemote then
                    combatRemote:InvokeServer(targetPos)
                else
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool and tool:FindFirstChild("Handle") then
                        local remoteEvent = tool:FindFirstChild("RemoteEvent") or tool:FindFirstChild("AttackRemote")
                        if remoteEvent then
                            remoteEvent:FireServer(targetPos)
                        end
                    end
                end
            end
        end)
    end)
end

local function autoStoreFruits()
    if not Settings.AutoStoreFruit then return end
    
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") 
            or ReplicatedStorage:FindFirstChild("MainRemote")
            
        local commF = remotes and (remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("Data"))
        if not commF then return end
        
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local character = LocalPlayer.Character
        
        local function checkAndStore(item)
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("fruit") or name:find("rocket") or name:find("spin") or name:find("kitsune") or name:find("dragon") or name:find("dough") or name:find("buddha") or name:find("trex") or name:find("mammoth") then
                    local originalName = item:GetAttribute("OriginalName") or item.Name
                    pcall(function() commF:InvokeServer("StoreFruit", originalName, item) end)
                    pcall(function() commF:InvokeServer("StoreFruit", item.Name) end)
                end
            end
        end
        
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                checkAndStore(item)
            end
        end
        
        if character then
            for _, item in ipairs(character:GetChildren()) do
                checkAndStore(item)
            end
        end
    end)
end

