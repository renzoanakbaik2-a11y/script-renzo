-- FUNGSI TERBANG MULUS & AMAN ANTI-RUBBERBAND
local function terbangMulus(cframeTujuan, speed)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end
	
	local jarak = (hrp.Position - cframeTujuan.Position).Magnitude
	local durasi = jarak / (speed or 75) -- Speed 75 aman dari deteksi server
	local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(hrp, tweenInfo, {CFrame = cframeTujuan})
	tween:Play()
	tween.Completed:Wait()
end

-- CARI GARIS AMAN DEPAN
local function cariGarisAmanDepan()
	local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localHrp then return nil end
	
	local targetGaris = nil
	local jarakTerdekatAman = math.huge

	for _, part in ipairs(Workspace:GetDescendants()) do
		if part:IsA("BasePart") then
			local nama = part.Name:lower()
			if nama:find("safe") or nama:find("finish") or nama:find("line") or nama:find("checkpoint") or (part.BrickColor.Name == "White" and part.Size.X > 8) then
				local jarak = (part.Position - localHrp.Position).Magnitude
				if jarak > 10 and jarak < jarakTerdekatAman then
					jarakTerdekatAman = jarak
					targetGaris = part
				end
			end
		end
	end
	return targetGaris
end

-- FILTER HUNTER VS SURVIVOR KETAT
local function isPemainSurvivor(player)
	if not player.Character then return false end
	local char = player.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	
	-- Cek Highlight
	local highlight = char:FindFirstChildOfClass("Highlight") or char:FindFirstChild("Highlight", true)
	if highlight then
		local fill = highlight.FillColor or highlight.OutlineColor
		if fill then
			-- Jika warna Merah jauh lebih pekat dari Hijau & Biru -> HUNTER
			if fill.R > fill.G and fill.R > fill.B and fill.R > 0.4 then
				return false
			end
		end
	end
	
	-- Cek Team jika ada
	if player.Team and (player.Team.Name:lower():find("hunter") or player.Team.Name:lower():find("tagger")) then
		return false
	end
	
	return true
end

-- SERANG & SENTUH
local function eksekusiTangkap(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar then return end
	
	local tool = myChar:FindFirstChildOfClass("Tool")
	if tool then tool:Activate() end
	
	local myHrp = myChar:FindFirstChild("HumanoidRootPart")
	local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
	if myHrp and targetHrp and firetouchinterest then
		firetouchinterest(myHrp, targetHrp, 0)
		firetouchinterest(myHrp, targetHrp, 1)
	end
end

-- SURVIVOR LOGIC (DENGAN LOCK ZONA)
BtnSurvivor.MouseButton1Click:Connect(function()
	isSurvivorActive = not isSurvivorActive
	if isSurvivorActive then
		isHunterActive = false
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		
		BtnSurvivor.Text = "SURVIVOR MODE: ON"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			local sudahSampaiZona = false
			local zonaTerakhir = nil
			
			while isSurvivorActive do
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				
				if myHrp then
					if not sudahSampaiZona then
						local targetGaris = cariGarisAmanDepan()
						if targetGaris then
							Status.Text = "Status: Otw Zona Aman Depan..."
							Status.TextColor3 = Color3.fromRGB(100, 255, 150)
							
							-- Terbang mulus nempel tanah garis
							terbangMulus(targetGaris.CFrame * CFrame.new(0, 2, 0), 75)
							
							-- Tembak pemicu sentuhan fisik ke garis biar terdaftar di server
							if firetouchinterest then
								firetouchinterest(myHrp, targetGaris, 0)
								firetouchinterest(myHrp, targetGaris, 1)
							end
							
							sudahSampaiZona = true
							zonaTerakhir = targetGaris
						else
							Status.Text = "Status: Mencari Zona Aman..."
							Status.TextColor3 = Color3.fromRGB(200, 200, 100)
						end
					else
						Status.Text = "Status: Aman di Zona (Menunggu Ronde)"
						Status.TextColor3 = Color3.fromRGB(100, 200, 255)
						
						-- Lepas kunci jika ronde baru mulai (posisi karakter ter-reset jauh dari zona terakhir)
						if zonaTerakhir and (zonaTerakhir.Position - myHrp.Position).Magnitude > 60 then
							sudahSampaiZona = false
						end
					end
				end
				task.wait(0.3)
			end
		end)
	else
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)

-- HUNTER LOGIC
BtnHunter.MouseButton1Click:Connect(function()
	isHunterActive = not isHunterActive
	if isHunterActive then
		isSurvivorActive = false
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		
		BtnHunter.Text = "HUNTER MODE: ON"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			while isHunterActive do
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				
				if myHrp then
					local survivorDitemukan = false
					
					for _, targetPlayer in ipairs(Players:GetPlayers()) do
						if targetPlayer ~= LocalPlayer and targetPlayer.Character then
							local targetChar = targetPlayer.Character
							local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
							local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
							
							if targetHrp and targetHum and targetHum.Health > 0 and isPemainSurvivor(targetPlayer) then
								survivorDitemukan = true
								Status.Text = "Status: Memburu [" .. targetPlayer.Name .. "]"
								Status.TextColor3 = Color3.fromRGB(255, 100, 100)
								
								myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 1.5)
								eksekusiTangkap(targetChar)
								task.wait(0.15)
								break
							end
						end
					end
					
					if not survivorDitemukan then
						Status.Text = "Status: Tidak Ada Survivor Terdeteksi"
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
					end
				end
				task.wait(0.05)
			end
		end)
	else
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
