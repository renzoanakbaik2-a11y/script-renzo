-- 6. AUTO AURA ATTACK (MENYERANG OTOMATIS SEGALA YANG MASUK AREA)
-- =====================================================================
local activeAuraConnection = nil
local function toggleAutoAuraAttack(state)
    if not state then
        if activeAuraConnection then
            activeAuraConnection:Disconnect()
            activeAuraConnection = nil
        end
        return
    end

    if activeAuraConnection then activeAuraConnection:Disconnect() end

    local lastAttackTick = 0
    activeAuraConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoAuraAttack then return end
        local root = getCharacterRootPart()
        if not root then return end

        -- Rumus delay berdasarkan kecepatan pukul (100-500)
        -- Semakin tinggi kecepatan (misal 500), delay semakin cepat.
        local interval = math.clamp(0.6 - (Settings.AuraAttackSpeed / 1000), 0.05, 0.5)
        if tick() - lastAttackTick < interval then return end
        lastAttackTick = tick()

        pcall(function()
            -- Cek target di sekitar (Bisa Mob atau Player lain)
            local targetsInRange = {}

            -- 1. Scan Players (jika bukan diri sendiri)
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                    local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if pRoot and pHum and pHum.Health > 0 then
                        if (root.Position - pRoot.Position).Magnitude <= Settings.AuraRange then
                            table.insert(targetsInRange, pRoot)
                        end
                    end
                end
            end

            -- 2. Scan Mobs / Enemies
            local mobFolderNames = {"Enemies", "Enemy", "Monster", "Monsters"}
            for _, folderName in ipairs(mobFolderNames) do
                local folder = Workspace:FindFirstChild(folderName)
                if folder then
                    for _, mob in pairs(folder:GetChildren()) do
                        if mob:IsA("Model") then
                            local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
                            local mHum = mob:FindFirstChildOfClass("Humanoid")
                            if mRoot and mHum and mHum.Health > 0 then
                                if (root.Position - mRoot.Position).Magnitude <= Settings.AuraRange then
                                    table.insert(targetsInRange, mRoot)
                                end
                            end
                        end
                    end
                end
            end

            -- Eksekusi serangan jika ada target dalam area
            if #targetsInRange > 0 then
                VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                VirtualUser:Button1Up(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
            end
        end)
    end)
end

