-- Fungsi Menampilkan Hierarki Folder di Kolom Kanan
local function displayFolderHierarchy(targetObj, blockName)
    for _, child in pairs(RightScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    StatusLabel.Text = "Blok terpilih: [" .. blockName .. "]\nMenampilkan isi dari folder induknya:"
    
    local current = targetObj.Parent
    local lineage = {}
    while current and current ~= game do
        table.insert(lineage, 1, current)
        current = current.Parent
    end
    
    local count = 0
    for _, folderItem in ipairs(lineage) do
        count = count + 1
        local folderBtn = Instance.new("TextButton")
        folderBtn.Size = UDim2.new(1, -6, 0, 28)
        folderBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        folderBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
        folderBtn.Font = Enum.Font.Code
        folderBtn.TextSize = 10
        folderBtn.Text = "📁 " .. folderItem.Name .. " (" .. folderItem.ClassName .. ")"
        folderBtn.TextXAlignment = Enum.TextXAlignment.Left
        folderBtn.Parent = RightScroll
        Instance.new("UICorner", folderBtn).CornerRadius = UDim.new(0, 4)
        
        folderBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(RightScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            StatusLabel.Text = "Melihat isi dalam folder: " .. folderItem.Name
            
            local subCount = 0
            for _, subObj in pairs(folderItem:GetChildren()) do
                subCount = subCount + 1
                local subBtn = Instance.new("TextButton")
                subBtn.Size = UDim2.new(1, -6, 0, 26)
                subBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                subBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
                subBtn.Font = Enum.Font.Code
                subBtn.TextSize = 10
                subBtn.Text = "   - " .. subObj.Name .. " [" .. subObj.ClassName .. "]"
                subBtn.TextXAlignment = Enum.TextXAlignment.Left
                subBtn.Parent = RightScroll
                Instance.new("UICorner", subBtn).CornerRadius = UDim.new(0, 4)
            end
            RightScroll.CanvasSize = UDim2.new(0, 0, 0, subCount * 30)
        end)
    end
    RightScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

