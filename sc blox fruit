-- 1. CLEANER TOTAL (Pastiin 1 Menu Doang)
local function SapuBersih(parent)
    if not parent then return end
    for _, gui in ipairs(parent:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:find("SpeedHub") or gui.Name:find("Step1") or gui.Name:find("Fix") or gui.Name:find("V1")) then
            pcall(function() gui:Destroy() end)
        end
    end
end
