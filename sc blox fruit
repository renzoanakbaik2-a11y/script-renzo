-- SISTEM JALAN DI AIR (WALK ON WATER) - REVISED
-- ==========================================
local WaterPart = nil

local function updateWaterWalk()
    pcall(function()
        if Settings.WalkOnWater then
            local rootPart = getCharacterRootPart()
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            
            if rootPart then
                local currentY = rootPart.Position.Y
                
                -- Hanya aktif di permukaan air (Y <= 15 agar di daratan tinggi pulau platform tidak muncul)
                if currentY <= 15 then
                    if not WaterPart or not WaterPart.Parent then
                        WaterPart = Instance.new("Part")
                        WaterPart.Name = "WaterWalkPlatform"
                        WaterPart.Size = Vector3.new(100, 1, 100)
                        WaterPart.Anchored = true
                        WaterPart.Transparency = 1 
                        WaterPart.CanCollide = true
                        WaterPart.Parent = Workspace
                    end
                    
                    -- Kunci posisi platform datar di ketinggian air standar Blox Fruits (Y = 3.5)
                    WaterPart.Position = Vector3.new(rootPart.Position.X, 3.5, rootPart.Position.Z)
                    
                    if humanoid then
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
                    end
                else
                    if WaterPart then
                        WaterPart:Destroy()
                        WaterPart = nil
                    end
                    if humanoid then
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
                    end
                end
            end
        else
            local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
            end
            if WaterPart then
                WaterPart:Destroy()
                WaterPart = nil
            end
        end
    end)
end

RunService.RenderStepped:Connect(updateWaterWalk)

