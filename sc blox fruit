local function createDropdown(title, settingKey, options, unit, onSelectCallback)
    local collapsedHeight = 32
    local itemHeight = 26
    local maxVisibleItems = 4
    local calculatedListHeight = math.min(#options, maxVisibleItems) * itemHeight
    local totalExpandedHeight = collapsedHeight + calculatedListHeight + 8

    local dropFrame = Instance.new("Frame")
    dropFrame.Size = UDim2.new(1, -10, 0, collapsedHeight)
    dropFrame.Position = UDim2.new(0, 5, 0, 0)
    dropFrame.BackgroundColor3 = Color3.fromRGB(22, 25, 35)
    dropFrame.BorderSizePixel = 0
    dropFrame.ClipsDescendants = true
    dropFrame.ZIndex = 150
    dropFrame.Parent = Container

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = dropFrame

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 52, 70)
    stroke.Thickness = 1
    stroke.Parent = dropFrame

    local mainBtn = Instance.new("TextButton")
    mainBtn.Size = UDim2.new(1, 0, 0, collapsedHeight)
    mainBtn.BackgroundTransparency = 1
    mainBtn.Font = Enum.Font.GothamBold
    mainBtn.TextSize = 11
    mainBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    mainBtn.TextXAlignment = Enum.TextXAlignment.Left
    mainBtn.ZIndex = 151
    mainBtn.Parent = dropFrame

    local currentVal = Settings[settingKey]
    local unitText = (unit ~= "" and " " .. unit) or ""
    mainBtn.Text = "   " .. title .. ": " .. tostring(currentVal) .. unitText

    local arrowLabel = Instance.new("TextLabel")
    arrowLabel.Size = UDim2.new(0, 30, 0, collapsedHeight)
    arrowLabel.Position = UDim2.new(1, -35, 0, 0)
    arrowLabel.BackgroundTransparency = 1
    arrowLabel.Text = "▼"
    arrowLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    arrowLabel.TextSize = 10
    arrowLabel.Font = Enum.Font.GothamBold
    arrowLabel.ZIndex = 151
    arrowLabel.Parent = dropFrame

    local optionsContainer = Instance.new("ScrollingFrame")
    optionsContainer.Size = UDim2.new(1, -10, 0, calculatedListHeight)
    optionsContainer.Position = UDim2.new(0, 5, 0, collapsedHeight + 4)
    optionsContainer.BackgroundTransparency = 1
    optionsContainer.CanvasSize = UDim2.new(0, 0, 0, #options * itemHeight)
    optionsContainer.ScrollBarThickness = 4
    optionsContainer.ZIndex = 152
    optionsContainer.Parent = dropFrame

    local optLayout = Instance.new("UIListLayout")
    optLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optLayout.Padding = UDim.new(0, 2)
    optLayout.Parent = optionsContainer

    local isOpen = false

    mainBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        if isOpen then
            arrowLabel.Text = "▲"
            TweenService:Create(dropFrame, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, -10, 0, totalExpandedHeight)
            }):Play()
        else
            arrowLabel.Text = "▼"
            TweenService:Create(dropFrame, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
                Size = UDim2.new(1, -10, 0, collapsedHeight)
            }):Play()
        end
    end)

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, -4, 0, itemHeight - 2)
        optBtn.BackgroundColor3 = (opt == Settings[settingKey]) and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(30, 35, 48)
        optBtn.Font = Enum.Font.GothamBold
        optBtn.TextSize = 10
        optBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.ZIndex = 153
        optBtn.Parent = optionsContainer

        local optCorner = Instance.new("UICorner")
        optCorner.CornerRadius = UDim.new(0, 4)
        optCorner.Parent = optBtn

        local optPadding = Instance.new("UIPadding")
        optPadding.PaddingLeft = UDim.new(0, 10)
        optPadding.Parent = optBtn

        optBtn.Text = tostring(opt) .. unitText

        optBtn.MouseButton1Click:Connect(function()
            Settings[settingKey] = opt
            mainBtn.Text = "   " .. title .. ": " .. tostring(opt) .. unitText
            saveSettings()

            for _, child in ipairs(optionsContainer:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = Color3.fromRGB(30, 35, 48)
                end
            end
            optBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)

            isOpen = false
            arrowLabel.Text = "▼"
            TweenService:Create(dropFrame, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
                Size = UDim2.new(1, -10, 0, collapsedHeight)
            }):Play()

            if onSelectCallback then onSelectCallback(opt) end
        end)
    end
end

