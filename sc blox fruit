ToggleBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    
    if isAutoFarm then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "AUTO FARM: ON"
        
        heartbeatConnection = RunService.Heartbeat:Connect(function()
            if not isAutoFarm then return end
            
            Character = LocalPlayer.Character
            if not Character then return end
            RootPart = Character:FindFirstChild("HumanoidRootPart")
            Humanoid = Character:FindFirstChildOfClass("Humanoid")
            if not RootPart or not Humanoid then return end
            
            -- Netralkan Gravitasi Roblox
            RootPart.AssemblyLinearVelocity = Vector3.zero
            
            -- Validasi Target
            local isTargetValid = false
            if currentTargetRoot and currentTargetRoot.Parent and currentTargetRoot:IsDescendantOf(Workspace) then
                isTargetValid = true
            end
            
            if not isTargetValid then
                currentTargetRoot = GetNearestTarget()
            end
            
            if currentTargetRoot then
                local enemyName = currentTargetRoot.Parent.Name
                local enemyPos = currentTargetRoot.Position
                local targetFlyPos = Vector3.new(enemyPos.X, enemyPos.Y + CONFIG.FLY_HEIGHT, enemyPos.Z)
                
                UpdateStatus("Fly: " .. enemyName)
                UpdateVisuals(currentTargetRoot)
                
                -- Pindahkan CFrame tepat di atas musuh
                RootPart.CFrame = CFrame.new(targetFlyPos, enemyPos)
                AutoAttack()
            else
                ClearVisuals()
                local chests = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
                if chests and #chests:GetChildren() > 0 and not isLooting then
                    ClaimGachaChests()
                else
                    UpdateStatus("Menunggu Mobs Spawn...")
                end
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleBtn.Text = "AUTO FARM: OFF"
        UpdateStatus("IDLE")
        currentTargetRoot = nil
        ClearVisuals()
        
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end
end)-- ==========================================================
