                    local rayDirection = Vector3.new(0, -200, 0)
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                    raycastParams.FilterDescendantsInstances = {character, Workspace.Enemies}
                    
                    local rayResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
                    local groundY = rayResult and rayResult.Position.Y or targetMobRoot.Position.Y

                    local stableHoverY = groundY + math.clamp(Settings.FlyHeight, 10, 30)
                    local targetPosition = Vector3.new(targetMobRoot.Position.X, stableHoverY, targetMobRoot.Position.Z)
