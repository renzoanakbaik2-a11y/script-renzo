-- UTILITY FISIKA & NOCLIP
local function netralkanFisika(char)
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
		end
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

-- TERBANG SURVIVOR
local function terbangMulus(cframeTujuan, speed)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
	
	netralkanFisika(char)
	local jarak = (hrp.Position - cframeTujuan.Position).Magnitude
	local durasi = jarak / (speed or 85)
	local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
	
	activeTween = TweenService:Create(hrp, tweenInfo, {CFrame = cframeTujuan})
	activeTween:Play()
	
	local noclipConn
	noclipConn = RunService.Stepped:Connect(function()
		if activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing then
			netralkanFisika(char)
		else
			if noclipConn then noclipConn:Disconnect() end
		end
	end)
	
	activeTween.Completed:Wait()
	activeTween = nil
	if noclipConn then noclipConn:Disconnect() end
	netralkanFisika(char)
end

-- CARI GARIS ZONA AMAN TERDEPAN
local function cariGarisAmanTerdepan()
	local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localHrp then return nil end
	
	local kandidatGaris = {}
	for _, part in ipairs(Workspace:GetDescendants()) do
		if part:IsA("BasePart") and part:IsDescendantOf(Workspace) then
			local nama = part.Name:lower()
			if nama:find("safe") or nama:find("finish") or nama:find("line") or nama:find("checkpoint") or (part.BrickColor.Name == "White" and part.Size.X > 8) then
				local jarak = (part.Position - localHrp.Position).Magnitude
				if jarak > 25 then
					table.insert(kandidatGaris, {part = part, jarak = jarak})
				end
			end
		end
	end
	
	table.sort(kandidatGaris, function(a, b)
		return a.jarak < b.jarak
	end)
	
	if #kandidatGaris > 0 then
		return kandidatGaris[1].part
	end
	return nil
end

-- CARI TARGET SURVIVOR KETAT UNTUK HUNTER
local function cariTargetSurvivorPresisi()
	local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localHrp then return nil end
	
	local targetTerbaik = nil
	local jarakTerdekat = math.huge
	
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character
			local hum = char:FindFirstChildOfClass("Humanoid")
			local hrp = char:FindFirstChild("HumanoidRootPart")
			
			if hum and hum.Health > 0 and hrp then
				local posisiY = hrp.Position.Y
				if posisiY > -100 and posisiY < 400 then
					if not char:FindFirstChildOfClass("ForceField") then
						local isHunter = false
						
						if player.Team then
							local tName = player.Team.Name:lower()
							if tName:find("hunter") or tName:find("tagger") or tName:find("it") then
								isHunter = true
							end
						end
						
						local highlight = char:FindFirstChildOfClass("Highlight") or char:FindFirstChild("Highlight", true)
						if highlight then
							local fill = highlight.FillColor or highlight.OutlineColor
							if fill and fill.R > fill.G and fill.R > fill.B and fill.R > 0.4 then
								isHunter = true
							end
						end
						
						if not isHunter then
							local jarak = (hrp.Position - localHrp.Position).Magnitude
							if jarak < jarakTerdekat then
								jarakTerdekat = jarak
								targetTerbaik = player
							end
						end
					end
				end
			end
		end
	end
	return targetTerbaik
end

-- EKSEKUSI PUKUL HUNTER
local function eksekusiPukulHunter(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar then return end
	local myHum = myChar:FindFirstChildOfClass("Humanoid")
	local myHrp = myChar:FindFirstChild("HumanoidRootPart")
	local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
	if not myHum or not myHrp or not targetHrp then return end
	
	local tool = myChar:FindFirstChildOfClass("Tool") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
	if tool and tool.Parent ~= myChar then
		myHum:EquipTool(tool)
	end
	
	if tool then tool:Activate() end
	VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
	VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
	
	if firetouchinterest then
		firetouchinterest(myHrp, targetHrp, 0)
		firetouchinterest(myHrp, targetHrp, 1)
		local torso = targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")
		if torso then
			firetouchinterest(myHrp, torso, 0)
			firetouchinterest(myHrp, torso, 1)
		end
	end
end

