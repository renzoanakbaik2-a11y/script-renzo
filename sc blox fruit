-- 3. METODE FREEZE PIGGY BARU (RENDERSTEPPED CFRAME LOCK)
RunService.RenderStepped:Connect(function()
    if not Settings.FreezePiggy then return end
    
    for _, model in ipairs(Workspace:GetChildren()) do
        -- Deteksi Model Piggy (Player Piggy maupun Bot)
        if model:IsA("Model") and (model.Name:lower():find("piggy") or model:FindFirstChild("Piggy") or model:FindFirstChild("Enemy")) then
            local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("Head")
            local hum = model:FindFirstChildOfClass("Humanoid")
            
            if hum then
                hum.WalkSpeed = 0
            end
            
            if hrp then
                -- Paksa paku posisi CFrame-nya setiap frame agar tidak bisa jalan
                hrp.Velocity = Vector3.new(0,0,0)
                hrp.RotVelocity = Vector3.new(0,0,0)
                if not hrp:IsGrounded() then
                    hrp.Anchored = true
                end
            end
        end
    end
end)

