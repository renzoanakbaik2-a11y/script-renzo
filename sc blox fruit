--// Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

--// FileName untuk Save Settings
local SettingsFileName = "BloxFruits_Settings.json"

--// Default Settings & State
local Settings = {
    AutoChest = false
}

--// Load Settings
if writefile and readfile and isfile then
    pcall(function()
        if isfile(SettingsFileName) then
            local data = HttpService:JSONDecode(readfile(SettingsFileName))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    Settings[k] = v
                end
            end
        end
    end)
end

local function SaveSettings()
    if writefile then
        pcall(function()
            writefile(SettingsFileName, HttpService:JSONEncode(Settings))
        end)
    end
end

--// GUI Creation
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BloxFruitsHub"
ScreenGui.ResetOnSpawn = false
pcall(function()
    if syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = CoreGui
    elseif protectgui then
        protectgui(ScreenGui)
        ScreenGui.Parent = CoreGui
    else
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end)
if not ScreenGui.Parent then
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

