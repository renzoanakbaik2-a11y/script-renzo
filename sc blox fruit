--// FileName untuk Save Settings
local SettingsFileName = "BloxFruits_Settings.json"

--// Default Settings & State
local Settings = {
    AutoChest = false
}

--// Load Settings
if writefile and readfile and isfile then
    pcall(function()
        if isfile(SettingsFileName) then
            local data = HttpService:JSONDecode(readfile(SettingsFileName))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    Settings[k] = v
                end
            end
        end
    end)
end

local function SaveSettings()
    if writefile then
        pcall(function()
            writefile(SettingsFileName, HttpService:JSONEncode(Settings))
        end)
    end
end

