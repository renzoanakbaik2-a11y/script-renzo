-- 1. Deteksi Net / Garis Tengah Lapangan
local function cariNet()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local nama = obj.Name:lower()
			if nama:find("net") or nama:find("jaring") then
				return obj
			end
		end
	end
	return nil
end

-- 2. Deteksi Shuttle / Bola
local function cariShuttle()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local nama = obj.Name:lower()
			if nama:find("shuttle") or nama:find("ball") or nama:find("kok") then
				return obj
			end
		end
	end
	return nil
end

-- 3. Logika Pemisah Zona
local function apakahDiZonaKita(hrp, shuttle, net)
	if not net then
		return (shuttle.Position - hrp.Position).Magnitude <= 30
	end
	
	local bedaKarakterZ = hrp.Position.Z - net.Position.Z
	local bedaShuttleZ = shuttle.Position.Z - net.Position.Z
	
	local bedaKarakterX = hrp.Position.X - net.Position.X
	local bedaShuttleX = shuttle.Position.X - net.Position.X
	
	local samadiZ = (bedaKarakterZ * bedaShuttleZ) > 0
	local samadiX = (bedaKarakterX * bedaShuttleX) > 0
	
	return samadiZ and samadiX
end

-- 4. PERINTAH AUTO HIT MULTI-METHOD
local function pukulRaket(char)
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			tool = backpack:FindFirstChildOfClass("Tool")
			if tool then tool.Parent = char end
		end
	end
	if tool then
		pcall(function() tool:Activate() end)
	end
	
	-- Virtual Mouse Click
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		task.wait(0.01)
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
	end)

	-- Virtual Keyboard (F & Space)
	pcall(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
	end)

	if mouse1click then
		pcall(mouse1click)
	end

	-- Fire Remotes
	for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
		if remote:IsA("RemoteEvent") then
			local nama = remote.Name:lower()
			if nama:find("hit") or nama:find("swing") or nama:find("racket") or nama:find("action") or nama:find("smash") then
				pcall(function() remote:FireServer() end)
			end
		end
	end
end

-- 5. EKSEKUSI BOT ANTI-AMBLES (Kaki Pas di Lantai)
local function eksekusiBot()
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	local shuttle = cariShuttle()
	local net = cariNet()
	
	if shuttle then
		if apakahDiZonaKita(hrp, shuttle, net) then
			-- Posisi horizontal mengikuti bola
			local posX = shuttle.Position.X
			local posZ = shuttle.Position.Z
			
			-- Kunci Y minimum (3.2 stud) agar kaki tidak pernah tenggelam ke bawah lantai
			local posY = math.max(shuttle.Position.Y, 3.2)
			
			-- Posisi berdiri tegak lurus murni tanpa terpengaruh rotasi miring bola
			hrp.CFrame = CFrame.new(posX, posY, posZ)
			
			-- Eksekusi pukulan
			pukulRaket(char)
			
			Status.Text = "Status: BOLA DI ZONA KITA! Hitbox Pas & Hit!"
			Status.TextColor3 = Color3.fromRGB(100, 255, 150)
		else
			Status.Text = "Status: Bola di Zona Lawan (Diam...)"
			Status.TextColor3 = Color3.fromRGB(255, 200, 100)
		end
	else
		Status.Text = "Status: Menunggu Bola / Match..."
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end

-- Event Tombol ON / OFF
Tombol.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	if isRunning then
