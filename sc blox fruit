-- Dragging HUD
local dragging, dragInput, dragStart, startPos
StatsHudFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = StatsHudFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

StatsHudFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        local newX = startPos.X.Scale + (delta.X / Workspace.CurrentCamera.ViewportSize.X)
        local newY = startPos.Y.Scale + (delta.Y / Workspace.CurrentCamera.ViewportSize.Y)
        
        StatsHudFrame.Position = UDim2.new(newX, 0, newY, 0)
        Settings.HUDPosition.X = newX
        Settings.HUDPosition.Y = newY
        saveSettings()
    end
end)

local function getIslandName(position)
    local x, z = position.X, position.Z
    if math.abs(x) < 2000 and math.abs(z) < 2000 then
        return "Starter Area"
    elseif x > 2000 then
        return "Marine Fortress"
    elseif x < -2000 then
        return "Skypiea"
    elseif z > 3000 then
        return "Ice Island"
    elseif z < -3000 then
        return "Magma Island"
    else
        return "Open Sea"
    end
end

local function isRealSpawnedFruit(obj)
    if not obj or not obj.Parent then return false end
    if obj.Parent ~= Workspace then return false end

    local officialFruits = {
        "rocket", "spin", "spring", "chop", "spike", "flame", "falcon", "ice", 
        "sand", "dark", "diamond", "light", "rubber", "barrier", "ghost", 
        "magma", "quake", "buddha", "love", "spider", "phoenix", 
        "portal", "pain", "blizzard", "gravity", "mammoth", "trex", "dough", 
        "shadow", "venom", "control", "spirit", "dragon", "leopard", "kitsune"
    }

    local objNameLower = obj.Name:lower()
    for _, fruitName in ipairs(officialFruits) do
        if objNameLower:find(fruitName) then
            if not objNameLower:find("pot") and not objNameLower:find("controller") then
                return obj:IsA("Tool") or objNameLower:sub(-5) == "fruit" or obj:FindFirstChild("Handle")
            end
        end
    end
    return false
end

