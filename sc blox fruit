local function ApplyMenuSize(sizeName)
    Settings.MenuSize = sizeName
    SaveSettings()
    
    SmallBtn.BackgroundColor3 = (sizeName == "Small") and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(40, 40, 40)
    MediumBtn.BackgroundColor3 = (sizeName == "Medium") and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(40, 40, 40)
    BigBtn.BackgroundColor3 = (sizeName == "Big") and Color3.fromRGB(0, 162, 255) or Color3.fromRGB(40, 40, 40)
    
    local targetSize = GetSizeDimensions(sizeName)
    TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
end

SmallBtn.MouseButton1Click:Connect(function() ApplyMenuSize("Small") end)
MediumBtn.MouseButton1Click:Connect(function() ApplyMenuSize("Medium") end)
BigBtn.MouseButton1Click:Connect(function() ApplyMenuSize("Big") end)

--// Animasi Membuka/Menutup Menu (Efek Lipat Kalender ke Atas)
local isMenuOpen = false
local function ToggleMenuAnimation()
    if not isMenuOpen then
        isMenuOpen = true
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 0)
        local targetSize = GetSizeDimensions(Settings.MenuSize)
        TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
    else
        isMenuOpen = false
        local tweenClose = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 0)})
        tweenClose:Play()
        tweenClose.Completed:Connect(function()
            if not isMenuOpen then
                MainFrame.Visible = false
            end
        end)
    end
end

OpenButton.MouseButton1Click:Connect(ToggleMenuAnimation)
CloseButton.MouseButton1Click:Connect(ToggleMenuAnimation)

