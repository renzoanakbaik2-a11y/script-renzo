local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local function ScanNearbyObjects()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        warn("Karakter belum spawn!")
        return 
    end
    
    local HRP = char.HumanoidRootPart
    print("================ [ HASIL SCANNING OBJECT ] ================")
    
    local count = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local dist = (HRP.Position - obj.Position).Magnitude
            -- Scan semua part di sekitar jarak 80 studs (kecuali karakter sendiri)
            if dist <= 80 and not obj:IsDescendantOf(char) then
                print(string.format("Nama: %s | Class: %s | Distance: %.1f studs | Parent: %s", 
                    obj.Name, obj.ClassName, dist, obj.Parent and obj.Parent.Name or "Nil"))
                count = count + 1
            end
        end
    end
    print("================ Total Part Ditemukan: " .. count .. " ================")
end

-- Eksekusi scan saat ini
ScanNearbyObjects()
