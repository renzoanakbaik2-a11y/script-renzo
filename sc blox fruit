local ClickMapMode = false
local PullMode = false

-- Fungsi Inti: Menampilkan Hirarki Folder Lengkap ke Kolom Kanan
local function showHierarchy(targetObj, customName)
    for _, child in pairs(RightScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    StatusLabel.Text = "Target Terpilih: [" .. customName .. "]\nMenampilkan jalur folder lengkap ke atas:"
    
    -- Kumpulkan seluruh leluhur (parent/folder) dari objek hingga Workspace
    local current = targetObj.Parent
    local lineage = {}
    while current and current ~= game do
        table.insert(lineage, 1, current)
        current = current.Parent
    end
    
    local count = 0
    for _, folderItem in ipairs(lineage) do
        count = count + 1
        local fBtn = Instance.new("TextButton")
        fBtn.Size = UDim2.new(1, -6, 0, 28)
        fBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
        fBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
        fBtn.Font = Enum.Font.Code
        fBtn.TextSize = 10
        fBtn.Text = "📁 " .. folderItem.Name .. " [" .. folderItem.ClassName .. "]"
        fBtn.TextXAlignment = Enum.TextXAlignment.Left
        fBtn.Parent = RightScroll
        Instance.new("UICorner", fBtn).CornerRadius = UDim.new(0, 4)
        
        -- Klik folder di kolom kanan untuk menelusuri isi di dalam folder tersebut
        fBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(RightScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            StatusLabel.Text = "Melihat isi di dalam folder: " .. folderItem.Name
            
            local subCount = 0
            for _, subObj in pairs(folderItem:GetChildren()) do
                subCount = subCount + 1
                local subBtn = Instance.new("TextButton")
                subBtn.Size = UDim2.new(1, -6, 0, 26)
                subBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
                subBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
                subBtn.Font = Enum.Font.Code
                subBtn.TextSize = 10
                subBtn.Text = "   - " .. subObj.Name .. " [" .. subObj.ClassName .. "]"
                subBtn.TextXAlignment = Enum.TextXAlignment.Left
                subBtn.Parent = RightScroll
                Instance.new("UICorner", subBtn).CornerRadius = UDim.new(0, 4)
            end
            RightScroll.CanvasSize = UDim2.new(0, 0, 0, subCount * 30)
        end)
    end
    RightScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

-- 1. FITUR UTAMA: KLIK BLOK LANGSUNG DI MAP 3D -> AUTO FOLDER
ClickMapBtn.MouseButton1Click:Connect(function()
    ClickMapMode = not ClickMapMode
    ClickMapBtn.Text = ClickMapMode and "🎯 3D MAP CLICK: ON" or "🎯 3D MAP CLICK: OFF"
    ClickMapBtn.BackgroundColor3 = ClickMapMode and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    if ClickMapMode then
        MainFrame.Visible = true
        StatusLabel.Text = "Mode Klik Aktif! Silakan ketuk/klik blok apa pun di dalam map game."
    end
end)

-- Eksekusi Deteksi Klik 3D Real-Time di Map
UserInputService.InputBegan:Connect(function(input, gpe)
    if not ClickMapMode or gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {player.Character, HighlightFolder}
        
        local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 2500, rayParams)
        if result and result.Instance then
            local hitPart = result.Instance
            HighlightFolder:ClearAllChildren()
            
            -- Berikan kotak biru menyala (SelectionBox) di map sebagai tanda wilayah blok
            local box = Instance.new("SelectionBox")
            box.Adornee = hitPart
            box.Color3 = Color3.fromRGB(0, 170, 255)
            box.LineThickness = 0.08
            box.Parent = HighlightFolder
            
            MainFrame.Visible = true
            showHierarchy(hitPart, hitPart.Name)
        end
    end
end)

