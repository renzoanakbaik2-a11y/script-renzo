local function showTopNotification(text, duration)
    pcall(function()
        NotifText.Text = text
        NotifFrame:TweenPosition(UDim2.new(0.5, -150, 0, 75), "Out", "Quad", 0.3, true)
        task.delay(duration or 5, function()
            NotifFrame:TweenPosition(UDim2.new(0.5, -150, 0, -60), "In", "Quad", 0.3, true)
        end)
    end)
end

local function autoSelectTeam()
    if not config.autoJoinTeamActive then return end
    if player.Team and player.Team.Name == config.selectedTeam then return end

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if commF then
        pcall(function()
            commF:InvokeServer("SetTeam", config.selectedTeam)
        end)
    end
end

task.spawn(function()
    task.wait(1.5)
    autoSelectTeam()
    while task.wait(5) do
        pcall(autoSelectTeam)
    end
end)

local function checkFruit()
    local foundFruitName = nil
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Tool") then
            local name = obj.Name
            if (name:lower():find("fruit") or name:lower():find("bloxfruit")) and name ~= "Fruit" then
                foundFruitName = name
                break
            end
        end
    end

    if foundFruitName then
        if lastState ~= foundFruitName then
            lastState = foundFruitName
            showTopNotification("Buah Ditemukan: " .. foundFruitName, 5)
        end
    else
        if lastState ~= "NONE" then
            showTopNotification("Buah Tidak Ada (Kosong)", 5)
            lastState = "NONE"
        end
    end
end

task.spawn(function()
    while task.wait(5) do
        pcall(checkFruit)
    end
end)

