-- 5. AUTO STORE FRUIT & AUTO CHEST
-- =====================================================================
local function autoStoreFruits()
    if not Settings.AutoStoreFruit then return end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if not remotes or not remotes:FindFirstChild("CommF_") then return end
        
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local character = LocalPlayer.Character
        
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") and (item.Name:lower():find("fruit") or item:FindFirstChild("Handle")) then
                    remotes.CommF_:InvokeServer("StoreFruit", item.Name)
                    task.wait(0.3)
                end
            end
        end
        
        if character then
            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Tool") and (item.Name:lower():find("fruit") or item:FindFirstChild("Handle")) then
                    remotes.CommF_:InvokeServer("StoreFruit", item.Name)
                    task.wait(0.3)
                end
            end
        end
    end)
end

task.spawn(function()
    while task.wait(0.4) do
        pcall(function()
            updateFruitESP()

            if Settings.AutoChest and not activeFlyConnection then
                local rootPart = getCharacterRootPart()
                if rootPart then
                    local targetChestPart = nil
                    local shortestDist = math.huge

                    for _, v in ipairs(Workspace:GetDescendants()) do
                        if v:IsA("BasePart") or v:IsA("Model") then
                            local nameLower = v.Name:lower()
                            if nameLower:find("chest") or nameLower:find("bronze") or nameLower:find("silver") or nameLower:find("gold") or nameLower:find("diamond") then
                                local partToCheck = v:IsA("Model") and (v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")) or v
                                if partToCheck then
                                    local dist = (rootPart.Position - partToCheck.Position).Magnitude
                                    if dist < shortestDist and partToCheck.Transparency < 1 then
                                        shortestDist = dist
                                        targetChestPart = partToCheck
                                    end
                                end
                            end
                        end
                    end

                    if targetChestPart then
                        smoothFlyTo(targetChestPart.CFrame, "AutoChest")
                        local startTime = tick()
                        repeat
                            task.wait(0.1)
                            local currentRoot = getCharacterRootPart()
                            if not currentRoot or not targetChestPart.Parent then break end
                            local dist = (currentRoot.Position - targetChestPart.Position).Magnitude
                        until dist < 4 or not Settings.AutoChest or tick() - startTime > 3
                    end
                end
            end
        end)
    end
end)

-- Loop Deteksi Buah & Notifikasi
task.spawn(function()
    while task.wait(3) do
        autoStoreFruits()

        local fruitListRaw = {}
        for _, obj in ipairs(Workspace:GetChildren()) do
            if isRealSpawnedFruit(obj) then
                table.insert(fruitListRaw, obj.Name)
            end
        end

        local fruitList = {}
        local checkDuplicate = {}
        for _, name in ipairs(fruitListRaw) do
            if not checkDuplicate[name] then
                checkDuplicate[name] = true
                table.insert(fruitList, name)
            end
        end

        if Settings.FruitNotifier and #fruitList > 0 then
            local fruitNameStr = table.concat(fruitList, ", ")
            playFruitSound()
            task.spawn(function() showFruitNotification(fruitNameStr) end)
        end
    end
end)

