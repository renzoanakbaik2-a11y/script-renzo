-- ==============================================================================
-- DEWA CODING: PREMIUM BRAINROT FARMER V2 (GUI VERSION)
-- ==============================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- SETUP GUI
local ScreenGui = Instance.new("ScreenGui", playerGui)
ScreenGui.Name = "DewaCodingMenu"

local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 150)
MainFrame.Position = UDim2.new(0.5, -100, 0.5, -75)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Active = true
MainFrame.Draggable = true
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel", MainFrame)
Title.Size = UDim2.new(1, 0, 0, 30)
Title.Text = "DEWA CODING FARMER"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.BackgroundTransparency = 1

-- BUTTONS
local DigBtn = Instance.new("TextButton", MainFrame)
DigBtn.Size = UDim2.new(0.8, 0, 0, 35)
DigBtn.Position = UDim2.new(0.1, 0, 0.3, 0)
DigBtn.Text = "Instant Dig: OFF"
DigBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Instance.new("UICorner", DigBtn)

local CollectBtn = Instance.new("TextButton", MainFrame)
CollectBtn.Size = UDim2.new(0.8, 0, 0, 35)
CollectBtn.Position = UDim2.new(0.1, 0, 0.6, 0)
CollectBtn.Text = "Auto Collect: OFF"
CollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Instance.new("UICorner", CollectBtn)

-- LOGIC
local Config = {Dig = false, Collect = false}

DigBtn.MouseButton1Click:Connect(function()
    Config.Dig = not Config.Dig
    DigBtn.Text = "Instant Dig: " .. (Config.Dig and "ON" or "OFF")
    DigBtn.BackgroundColor3 = Config.Dig and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
end)

CollectBtn.MouseButton1Click:Connect(function()
    Config.Collect = not Config.Collect
    CollectBtn.Text = "Auto Collect: " .. (Config.Collect and "ON" or "OFF")
    CollectBtn.BackgroundColor3 = Config.Collect and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
end)

-- ENGINE
RunService.Heartbeat:Connect(function()
    if Config.Dig then
        local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
        if tool then
            pcall(function() tool:Activate() end)
        end
    end
    
    if Config.Collect then
        local eggs = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("SpawnedEggs")
        local base = workspace:FindFirstChild("Base") or workspace:FindFirstChild("Hatchery")
        if eggs and base then
            for _, egg in pairs(eggs:GetChildren()) do
                if egg:IsA("Model") or egg:FindFirstChild("Handle") then
                    egg:PivotTo(base:GetPivot())
                end
            end
        end
    end
end)

print("⚡ DEWA CODING PREMIUM GUI LOADED ⚡")
