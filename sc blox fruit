-- 5. LOGIKA VISUAL ZONE & AUTO INTERCEPT
-- ===================================================
local isZoneVisible = false
local isZoneActive = false
local isProcessingHit = false
local lastHitTime = 0

local visualPart = nil

-- Fungsi Buat Kotak Visual Area Lapangan
local function UpdateVisualZone()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    if isZoneVisible then
        if not visualPart or not visualPart.Parent then
            visualPart = Instance.new("Part")
            visualPart.Name = "SpeedHub_VisualZone"
            visualPart.Anchored = true
            visualPart.CanCollide = false
            visualPart.Material = Enum.Material.ForceField
            visualPart.Color = Color3.fromRGB(0, 255, 150)
            visualPart.Transparency = 0.6
            visualPart.Size = Vector3.new(45, 15, 45) -- Ukuran Area Lapangan (45x45 Studs)
            visualPart.Parent = Workspace
            
            -- Efek Garis / SelectionBox
            local box = Instance.new("SelectionBox")
            box.Adornee = visualPart
            box.Color3 = Color3.fromRGB(0, 255, 200)
            box.LineThickness = 0.05
            box.Parent = visualPart
        end
        
        -- Mengikuti koordinat karakter tapi tetap berada di lantai
        visualPart.CFrame = CFrame.new(HRP.Position.X, HRP.Position.Y + 2.5, HRP.Position.Z)
    else
        if visualPart then
            visualPart:Destroy()
            visualPart = nil
        end
    end
end

local function SingleSwing()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function GetBallPart()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name == "ball" or name:find("tennis") or name:find("volley") then
                return obj
            end
        end
    end
    return nil
end

local function ResetScriptState()
    isZoneVisible = false
    isZoneActive = false
    isProcessingHit = false
    UpdateVisualZone()
    BtnShowZone.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnShowZone.Text = "VISUAL COURT ZONE: OFF"
    BtnZoneIntercept.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnZoneIntercept.Text = "AUTO INTERCEPT IN ZONE: OFF"
    StatusText.Text = "Status: Reset Done"
end

-- 6. EVENT LISTENERS
BtnShowZone.MouseButton1Click:Connect(function()
    isZoneVisible = not isZoneVisible
    if isZoneVisible then
        BtnShowZone.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        BtnShowZone.Text = "VISUAL COURT ZONE: ON"
        StatusText.Text = "Status: Visual Area Created!"
    else
        BtnShowZone.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        BtnShowZone.Text = "VISUAL COURT ZONE: OFF"
        StatusText.Text = "Status: Visual Area Hidden"
    end
    UpdateVisualZone()
end)

BtnZoneIntercept.MouseButton1Click:Connect(function()
    isZoneActive = not isZoneActive
    if isZoneActive then
        BtnZoneIntercept.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnZoneIntercept.Text = "AUTO INTERCEPT IN ZONE: ON"
        StatusText.Text = "Status: Monitoring Zone Entry..."
    else
        BtnZoneIntercept.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        BtnZoneIntercept.Text = "AUTO INTERCEPT IN ZONE: OFF"
        StatusText.Text = "Status: Intercept Stopped"
    end
end)

BtnReset.MouseButton1Click:Connect(function()
    ResetScriptState()
end)

-- LOOP ENGINE
RunService.RenderStepped:Connect(function()
    if isZoneVisible then
        UpdateVisualZone()
    end

    if not isZoneActive or isProcessingHit then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    local ball = GetBallPart()

    if ball and (tick() - lastHitTime > 0.4) then
        local ballPos = ball.Position
        
        -- Deteksi 2D Distance (Sumbu X dan Z)
        local player2D = Vector2.new(HRP.Position.X, HRP.Position.Z)
        local ball2D = Vector2.new(ballPos.X, ballPos.Z)
        local dist2D = (player2D - ball2D).Magnitude

        -- BUKTI VISUAL: Radius 22.5 studs (setengah dari ukuran kotak 45 studs)
        if dist2D <= 22.5 then
            isProcessingHit = true
            lastHitTime = tick()
            StatusText.Text = "Status: Ball Inside Zone! Intercepting..."

            -- Ubah warna kotak visual jadi MERAH pas bola masuk
            if visualPart then
                visualPart.Color = Color3.fromRGB(255, 30, 60)
            end

            -- Teleport ke X, Z Bola
            HRP.CFrame = CFrame.new(Vector3.new(ballPos.X, HRP.Position.Y, ballPos.Z), Vector3.new(ballPos.X, HRP.Position.Y, ballPos.Z))

            -- Swing
            SingleSwing()

            task.wait(0.25)
            
            -- Balikin warna hijau
            if visualPart then
                visualPart.Color = Color3.fromRGB(0, 255, 150)
            end

            isProcessingHit = false

            if isZoneActive then
                StatusText.Text = "Status: Monitoring Zone Entry..."
            end
        end
    end
end)
