-- MENCARI REMOTE EVENT SERANGAN GAME
local attackRemote = nil
for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
    if v:IsA("RemoteEvent") then
        local name = v.Name:lower()
        if name:find("attack") or name:find("m1") or name:find("swing") or name:find("hit") or name:find("damage") or name:find("combat") then
            attackRemote = v
            break
        end
    end
end

local isRunning = false

local function SendRemoteAttack()
    if attackRemote then
        -- Kirim sinyal serangan langsung ke server tanpa memicu animasi UI
        attackRemote:FireServer()
    else
        -- Jika remote spesifik tidak ditemukan, gunakan pemicu Tool internal tanpa Activate
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("RemoteEvent") then
                tool.RemoteEvent:FireServer()
            end
        end
    end
end

