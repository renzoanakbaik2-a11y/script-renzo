-- CONTAINER UNTUK VISUAL KOTAK BIRU & NAMA
local ESPFolder = Instance.new("Folder", ScreenGui)
ESPFolder.Name = "ESP_Container"

local Config = {
    Active = false
}

ToggleBtn.MouseButton1Click:Connect(function()
    Config.Active = not Config.Active
    ToggleBtn.Text = "ESP SCANNER: " .. (Config.Active and "ON" or "OFF")
    ToggleBtn.BackgroundColor3 = Config.Active and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    
    if not Config.Active then
        ESPFolder:ClearAllChildren()
    end
end)

-- FUNGSI MEMBUAT KOTAK BIRU DAN TEKS NAMA DI LAYAR
local function createESP(obj)
    if ESPFolder:FindFirstChild(obj.Name .. "_ESP") then return end
    
    -- Membuat Kotak Garis (Box) Biru di 3D World
    local box = Instance.new("SelectionBox")
    box.Name = obj.Name .. "_ESP"
    box.Adornee = obj
    box.Color3 = Color3.fromRGB(0, 170, 255) -- Warna Biru Menyala
    box.LineThickness = 0.05
    box.Parent = ESPFolder
    
    -- Membuat Teks Nama Objek di Atas Kotaknya
    local bill = Instance.new("BillboardGui")
    bill.Name = obj.Name .. "_Tag"
    bill.Adornee = obj
    bill.Size = UDim2.new(0, 100, 0, 40)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.AlwaysOnVisible = true
    bill.Parent = ESPFolder
    
    local txt = Instance.new("TextLabel", bill)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.fromRGB(0, 255, 255)
    txt.TextStrokeTransparency = 0 -- Biar tulisannya ada garis hitam pinggirannya jadi jelas dibaca
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 12
    txt.Text = obj.Name
end

