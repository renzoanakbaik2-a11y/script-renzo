-- 3. HELPER FUNCTIONS
local function DisableGravity(root)
    if not root:FindFirstChild("FarmBV") then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "FarmBV"
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = root
    end
end

local function EnableGravity(root)
    if root and root:FindFirstChild("FarmBV") then
        root.FarmBV:Destroy()
    end
end

