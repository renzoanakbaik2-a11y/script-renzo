-- Fungsi Cari Remote Event Global
local function findTargetRemote()
    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") then
            local name = remote.Name:lower()
            if name:find("answer") or name:find("submit") or name:find("word") or name:find("guess") or name:find("send") then
                return remote
            end
        end
    end
    return nil
end

-- Eksekusi Otomatis Cerdas & Auto Submit
task.spawn(function()
    while true do
        task.wait(0.5)
        if CONFIG.SmartPlay then
            pcall(function()
                local targetRemote = findTargetRemote()
                
                for _, ui in ipairs(playerGui:GetDescendants()) do
                    if ui:IsA("TextBox") then
                        local name = ui.Name:lower()
                        if name:find("input") or name:find("answer") or name:find("word") or name:find("chat") or ui.Active then
                            if ui.Visible then
                                local currentText = ui.Text or ""
                                if #currentText > 0 and #currentText <= 4 then
                                    local lastChar = string.sub(currentText, -1):lower()
                                    local listWord = MegaDictionary[lastChar]
                                    
                                    if listWord and #listWord > 0 then
                                        local chosenWord = listWord[math.random(1, #listWord)]
                                        
                                        -- 1. Set Teks Otomatis
                                        ui.Text = chosenWord
                                        
                                        -- 2. Metoda Tembak RemoteEvent (jika ada)
                                        if targetRemote then
                                            pcall(function()
                                                targetRemote:FireServer(chosenWord)
                                            end)
                                        end
                                        
                                        -- 3. Metoda Kirim Event FocusLost (Supaya game membaca input selesai)
                                        pcall(function()
                                            ui.FocusLost:Fire(true)
                                        end)
                                        
                                        -- 4. Metoda Tekan Tombol Enter Virtual (Return)
                                        pcall(function()
                                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                                            task.wait(0.05)
                                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                                        end)
                                        
                                        task.wait(1) -- Jeda aman antar kirim jawaban
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

