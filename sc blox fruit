local isRunning = false
ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    ToggleBtn.TextColor3 = isRunning and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    ToggleBtn.BorderColor3 = isRunning and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    ToggleBtn.Text = isRunning and "ON" else "OFF"
end)

-- Sistem Universal Text Scanner & Auto Sender
task.spawn(function()
    while true do
        task.wait(0.4)
        if isRunning then
            pcall(function()
                -- Pindai semua elemen teks di layar (TextLabel, TextButton, TextBox)
                for _, ui in ipairs(playerGui:GetDescendants()) do
                    local targetText = ""
                    if ui:IsA("TextBox") or ui:IsA("TextLabel") or ui:IsA("TextButton") then
                        targetText = ui.Text or ""
                    end

                    -- Jika mendeteksi karakter/huruf di kotak game
                    if #targetText > 0 and #targetText <= 5 then
                        local lastChar = string.sub(targetText, -1):lower()
                        
                        if Dictionary[lastChar] then
                            local words = Dictionary[lastChar]
                            local chosenWord = words[math.random(1, #words)]
                            
                            if ui:IsA("TextBox") then
                                ui.Text = chosenWord
                            end
                            
                            -- Kirim perintah Enter secara virtual agar tersubmit otomatis oleh game
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                            
                            task.wait(1.2) -- Jeda aman agar tidak spam server
                        end
                    end
                end
            end)
        end
    end
end)

