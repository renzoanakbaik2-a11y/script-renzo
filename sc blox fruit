-- ==============================================================================
-- PENCARIAN OBJEK TERSEMBUNYI DENGAN DETEKSI NET & STATUS SISI LAPANGAN
-- ==============================================================================
local function getBestTarget()
    local targetBall = nil
    local shortestDist = math.huge
    local isAtOurSide = false

    -- 1. Deteksi letak net lapangan
    local netZ = 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "net") then
            netZ = v.Position.Z
            break
        end
    end

    -- 2. Memindai objek bola/kok tersembunyi
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            if obj.Size.Magnitude < 20 and not obj.Anchored then
                local dist = (humanoidRootPart.Position - obj.Position).Magnitude
                local playerZ = humanoidRootPart.Position.Z
                
                if netZ ~= 0 then
                    -- Cek apakah bola sudah melewati net ke area kita
                    if (playerZ > netZ and obj.Position.Z > netZ) or (playerZ < netZ and obj.Position.Z < netZ) then
                        isAtOurSide = true
                    else
                        isAtOurSide = false -- Masih di area musuh, jangan dikejar!
                    end
                else
                    isAtOurSide = true
                end

                if dist < shortestDist then
                    shortestDist = dist
                    targetBall = obj
                end
            end
        end
    end

    return targetBall, shortestDist, isAtOurSide
end

-- ==============================================================================
-- FUNGSI AUTO HIT TINGKAT DEWA (MEMAKSA PUKULAN LEWAT TOOL & REMOTE)
-- ==============================================================================
local function executeGodHit(targetBall)
    -- 1. Aktifkan Tool (Raket) di tangan pemain
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end

    -- 2. Simulasi Klik Kiri Mouse
    pcall(function()
        VirtualUser:Button1Down(Vector2.new(0,0))
        task.wait(0.02)
        VirtualUser:Button1Up(Vector2.new(0,0))
    end)

    -- 3. Spam SEMUA RemoteEvent di game yang berpotensi menjadi fungsi pukulan
    for _, container in ipairs({ReplicatedStorage, player:FindFirstChild("PlayerGui"), Workspace}) do
        if container then
            for _, remote in ipairs(container:GetDescendants()) do
                if remote:IsA("RemoteEvent") then
                    local rName = string.lower(remote.Name)
                    if rName:find("hit") or rName:find("swing") or rName:find("shot") or rName:find("action") or rName:find("ball") or rName:find("racket") or rName:find("play") then
                        pcall(function()
                            remote:FireServer(targetBall)
                            remote:FireServer(targetBall.Position)
                            remote:FireServer()
                        end)
                    end
                end
            end
        end
    end
end

-- ==============================================================================
-- EKSEKUSI UTAMA LOOPING (FIX TELEPORT TINGGI + AUTO HIT STABIL)
-- ==============================================================================
RunService.RenderStepped:Connect(function()
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        character = player.Character
        if character then 
            humanoidRootPart = character:WaitForChild("HumanoidRootPart") 
            humanoid = character:WaitForChild("Humanoid")
        end
        return 
    end

    local ball, distance, atOurSide = getBestTarget()
    
    if ball then
        InfoLabel.Text = "Dist: " .. math.floor(distance) .. " | Sisi: " .. (atOurSide and "Kita 🟢" : "Musuh 🔴")
        
        if atOurSide then
            -- 1. Auto Teleport 3D Sempurna (Mengikuti X, Y Z agar ikut terbang ke atas jika bola tinggi)
            if CONFIG.AutoTeleportEnabled and distance > CONFIG.HitDistance then
                -- Mematikan gravitasi sementara agar karakter tidak jatuh saat teleport di udara mengikuti bola
                humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
                
                local offset = Vector3.new(CONFIG.TeleportOffset[1], CONFIG.TeleportOffset[2], CONFIG.TeleportOffset[3])
                humanoidRootPart.CFrame = CFrame.new(ball.Position + offset, ball.Position)
            end
            
            -- 2. Auto Hit Otomatis Saat Masuk Jangkauan Raket
            if CONFIG.AutoHitEnabled and distance <= CONFIG.HitDistance then
                executeGodHit(ball)
            end
        end
    else
        InfoLabel.Text = "Status: Menunggu Bola Masuk..."
    end
end)

