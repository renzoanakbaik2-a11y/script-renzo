-- 3. HELPER FUNCTIONS
local function GetItemInHandOrBackpack()
    local char = LocalPlayer.Character
    if char then
        local toolInHand = char:FindFirstChildOfClass("Tool")
        if toolInHand then
            return true, toolInHand
        end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local toolInBackpack = backpack:FindFirstChildOfClass("Tool")
            if toolInBackpack then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum:EquipTool(toolInBackpack)
                    task.wait(0.5)
                    return true, toolInBackpack
                end
            end
        end
    end
    return false, nil
end

local function GetPiggyTarget()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Piggy" or obj:FindFirstChild("Piggy") then
            if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
                return obj.HumanoidRootPart
            elseif obj:IsA("BasePart") then
                return obj
            end
        end
    end
    return nil
end

local function GetDoorCode()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "CodeBoard" or obj.Name == "CodePaper" or obj.Name == "Code" then
            local label = nil
            if obj:IsA("TextLabel") then
                label = obj
            elseif obj:IsA("SurfaceGui") or obj:IsA("BillboardGui") then
                label = obj:FindFirstChildOfClass("TextLabel")
            end
            
            if label and label.Text then
                local txt = string.gsub(label.Text, "%s+", "")
                if #txt == 4 and tonumber(txt) then
                    return txt
                end
            end
        end
    end
    return nil
end

-- 4. DYNAMIC MATCHING AUTO ESCAPE LOOP
local SequenceKeywords = {"hammer", "plank", "wrench", "keycard", "key", "gear", "code", "gun", "crossbow"}
local ColorKeywords = {"red", "blue", "green", "yellow", "purple", "orange", "cyan", "white"}

task.spawn(function()
    while true do
        task.wait(0.5)
        if Settings.AutoRunning then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hasTool, currentTool = GetItemInHandOrBackpack()

            if root then
                if not hasTool then
                    local itemPicked = false

                    for _, keyword in ipairs(SequenceKeywords) do
                        if itemPicked then break end

                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
                                local parentPart = obj.Parent
                                if parentPart and parentPart:IsA("BasePart") and parentPart:IsDescendantOf(Workspace) then
                                    local itemName = string.lower(parentPart.Name)
                                    if not UsedItems[parentPart] and itemName:find(keyword) then
                                        root.CFrame = parentPart.CFrame
                                        task.wait(0.5)
                                        
                                        if obj:IsA("ClickDetector") then fireclickdetector(obj) end
                                        if obj:IsA("ProximityPrompt") then fireproximityprompt(obj) end
                                        
                                        task.wait(1.0)
                                        
                                        if Settings.SafeMode then
                                            root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
                                        end

                                        itemPicked = true
                                        break
                                    end
                                end
                            end
                        end
                    end

                else
                    local toolName = string.lower(currentTool.Name)

                    if toolName:find("gun") or toolName:find("crossbow") then
                        local piggyRoot = GetPiggyTarget()
                        if piggyRoot then
                            local safePos = piggyRoot.CFrame * CFrame.new(0, 0, 15)
                            root.CFrame = CFrame.lookAt(safePos.Position, piggyRoot.Position)
                            task.wait(0.5)

                            currentTool:Activate()
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)

                            UsedItems[currentTool] = true
                            
                            if Settings.SafeMode then
                                root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
                            end
                            task.wait(1.0)
                        end
                    else
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
                                local targetPart = obj.Parent
                                if targetPart and targetPart:IsA("BasePart") and targetPart:IsDescendantOf(Workspace) then
                                    local targetName = string.lower(targetPart.Name)

                                    -- LOGIKA PENCOCOKAN WARNA & JENIS DENGAN DETAIL
                                    local isMatch = false
                                    if toolName:find("hammer") and (targetName:find("plank") or targetName:find("board") or targetName:find("wood")) then 
                                        isMatch = true
                                    elseif toolName:find("wrench") and (targetName:find("generator") or targetName:find("box") or targetName:find("drain")) then 
                                        isMatch = true
                                    elseif toolName:find("keycard") and (targetName:find("reader") or targetName:find("swipe")) then 
                                        isMatch = true
                                    elseif toolName:find("gear") and (targetName:find("machine") or targetName:find("clock")) then 
                                        isMatch = true
                                    elseif toolName:find("key") then
                                        -- Cek Kecocokan Warna Kunci dengan Warna Gembok/Pintu
                                        local isDoorOrLock = targetName:find("door") or targetName:find("padlock") or targetName:find("lock") or targetName:find("safe") or targetName:find("gate")
                                        if isDoorOrLock then
                                            for _, color in ipairs(ColorKeywords) do
                                                if toolName:find(color) and targetName:find(color) then
                                                    isMatch = true
                                                    break
                                                end
                                            end
                                            -- Jika kunci tidak punya nama warna spesifik, coba pasangkan ke gembok terdekat
                                            if not isMatch and not targetName:find("key") then
                                                isMatch = true
                                            end
                                        end
                                    end

                                    if isMatch then
                                        root.CFrame = targetPart.CFrame * CFrame.new(0, 0, -2)
                                        task.wait(0.5)
                                        
                                        if obj:IsA("ClickDetector") then fireclickdetector(obj) end
                                        if obj:IsA("ProximityPrompt") then fireproximityprompt(obj) end
                                        
                                        task.wait(1.0)
                                        UsedItems[currentTool] = true
                                        
                                        if Settings.SafeMode then
                                            root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
                                        end
                                        break
                                    end
                                end
                            end
                        end
                    end
                end

                -- SUBMIT KODE PINTU OTOMATIS
                if not CodeSubmitted then
                    local doorCode = GetDoorCode()
                    if doorCode then
                        for _, obj in pairs(Workspace:GetDescendants()) do
                            if obj.Name == "Keypad" or obj.Name == "CodeDoor" then
                                local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector")
                                if prompt then
                                    root.CFrame = obj.CFrame * CFrame.new(0, 0, -2)
                                    task.wait(0.5)
                                    
                                    if prompt:IsA("ClickDetector") then fireclickdetector(prompt) end
                                    if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
                                    
                                    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            local rName = string.lower(remote.Name)
                                            if rName:find("code") or rName:find("keypad") or rName:find("pad") then
                                                remote:FireServer(doorCode)
                                            end
                                        end
                                    end
                                    
                                    CodeSubmitted = true
                                    if Settings.SafeMode then root.CFrame = root.CFrame * CFrame.new(0, 14, 0) end
                                    task.wait(1.0)
                                    break
                                end
                            end
                        end
                    end
                end

            end
        end
    end
end)

-- 5. ENGINE & NOCLIP
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")

        if hum and Settings.Speed then
            hum.WalkSpeed = 28
        end

        if Settings.Noclip then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "Trap" or obj.Name == "BearTrap" then
                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                elseif obj:IsA("Model") then
                    for _, p in pairs(obj:GetChildren()) do
                        if p:IsA("BasePart") then p.CanTouch = false end
                    end
                end
            end
        end
    end
end)

