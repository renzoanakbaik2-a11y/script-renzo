-- 6. LOGIKA AIR-INTERCEPT BOLA (Bumbu Baru)
-- ===================================================
local isAirInterceptActive = false
local isProcessingHit = false
local lastHitBallTime = 0

-- Function Swinger
local function SingleSwing()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.03)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- Cari Object Bola Asli di Workspace
local function GetActiveBall()
    for _, obj in pairs(Workspace:GetChildren()) do
        local name = obj.Name:lower()
        if name:find("ball") or name:find("tennis") or obj:FindFirstChild("Ball") then
            if obj:IsA("BasePart") then
                return obj
            elseif obj:IsA("Model") then
                return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
            end
        end
    end
    return nil
end

-- Reset State
local function ResetScriptState()
    isAirInterceptActive = false
    isProcessingHit = false
    BtnAirIntercept.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnAirIntercept.Text = "AIR INTERCEPT (AIR TELEPORT): OFF"
    StatusText.Text = "Status: Reset Done"
end

-- 7. EVENT LISTENERS
BtnAirIntercept.MouseButton1Click:Connect(function()
    isAirInterceptActive = not isAirInterceptActive
    if isAirInterceptActive then
        BtnAirIntercept.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnAirIntercept.Text = "AIR INTERCEPT (AIR TELEPORT): ON"
        StatusText.Text = "Status: Tracking Ball in Air..."
    else
        ResetScriptState()
    end
end)

BtnReset.MouseButton1Click:Connect(function()
    ResetScriptState()
end)

-- LOOP ENGINE
RunService.RenderStepped:Connect(function()
    if not isAirInterceptActive or isProcessingHit then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    local ball = GetActiveBall()

    if ball and (tick() - lastHitBallTime > 0.5) then
        local ballPos = ball.Position
        local distToPlayer = (HRP.Position - ballPos).Magnitude

        -- BUMBU RAHASIA: Teleport CEGAT BOLA pas posisi bola masih di ketinggian 8 - 22 studs (masih melayang di atas!)
        -- Dan jaraknya gak terlalu jauh dari area kita (Max 70 studs)
        if ballPos.Y >= 8 and ballPos.Y <= 25 and distToPlayer <= 70 then
            isProcessingHit = true
            lastHitBallTime = tick()
            StatusText.Text = "Status: Intercepting Ball in Mid-Air!"

            -- Teleport persis di bawah bola + sedikit offset Y biar mukulnya pas pas bola turun
            HRP.CFrame = CFrame.new(Vector3.new(ballPos.X, ballPos.Y - 3, ballPos.Z), Vector3.new(ballPos.X, HRP.Position.Y, ballPos.Z))

            -- Ayun raket persis pas teleport selesai
            task.wait(0.02)
            SingleSwing()

            task.wait(0.3)
            isProcessingHit = false

            if isAirInterceptActive then
                StatusText.Text = "Status: Tracking Ball in Air..."
            end
        end
    end
end)
