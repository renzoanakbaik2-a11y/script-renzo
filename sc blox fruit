-- Helper Fungsi Teleport Baju/Aksesori
local function EquipItemByKeywords(keywords)
    if not HumanoidRootPart then return end
    local startCFrame = HumanoidRootPart.CFrame
    
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Model") then
            local itemName = item.Name:lower()
            for _, kw in ipairs(keywords) do
                if itemName:find(kw) then
                    local part = item:IsA("BasePart") and item or item:FindFirstChildOfClass("BasePart")
                    if part then
                        HumanoidRootPart.CFrame = part.CFrame
                        if firetouchinterest then
                            firetouchinterest(HumanoidRootPart, part, 0)
                            task.wait(0.05)
                            firetouchinterest(HumanoidRootPart, part, 1)
                        end
                        task.wait(0.1)
                    end
                end
            end
        end
    end
    
    -- Kembalikan posisi pemain ke area tengah
    HumanoidRootPart.CFrame = startCFrame
end

-- Helper Button Creator
local function CreateButton(text, posY, color, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Position = UDim2.new(0, 15, 0, posY)
    btn.Size = UDim2.new(0, 230, 0, 35)
    btn.BackgroundColor3 = color
    btn.Font = Enum.Font.SourceSansSemibold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.MouseButton1Click:Connect(callback)
    return btn
end

