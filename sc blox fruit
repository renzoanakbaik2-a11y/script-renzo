-- 2. FILTER BUAH (Mendeteksi buah spawn/drop asli)
-- ==========================================
local function isRealSpawnedFruit(obj)
    local name = obj.Name:lower()
    
    if obj:IsA("Sound") or name:find("sound") or name:find("music") or name:find("audio") then 
        return false 
    end
    
    local ancestor = obj.Parent
    while ancestor and ancestor ~= game do
        if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then
            return false 
        end
        if ancestor.Name == "Backpack" or ancestor.Name == "PlayerGui" then
            return false
        end
        ancestor = ancestor.Parent
    end
    
    local validFruits = {
        "rocket", "spin", "spring", "chop", "spike", "flame", "falcon", "ice", 
        "sand", "dark", "diamond", "light", "rubber", "barrier", "ghost", 
        "magma", "quake", "buddha", "love", "spider", "phoenix", 
        "portal", "pain", "blizzard", "gravity", "mammoth", "trex", "dough", 
        "shadow", "venom", "control", "spirit", "dragon", "leopard", "kitsune", "fruit", "blox"
    }
    
    local invalidKeywords = {"sword", "gun", "musket", "rifle", "cutlass", "pistol", "blade", "katana", "dagger", "staff"}
    for _, word in ipairs(invalidKeywords) do
        if name:find(word) then return end
    end
    
    for _, fruitName in ipairs(validFruits) do
        if name:find(fruitName) then
            return true
        end
    end
    
    return false
end

