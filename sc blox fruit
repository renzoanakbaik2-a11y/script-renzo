-- [[ UTILITY FUNCTIONS ]] --
local function GetBall()
    -- Mencari object bola di Workspace (handling nama instance bola)
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj.Name:lower():find("ball") or obj:FindFirstChild("Ball") then
            return obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
        end
    end
    return nil
end

local function SwingRacket()
    -- Bumbu Anti-Lag & Smooth Click Execution
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function UseSkill()
    -- Menekan tombol E/F untuk aktivasi kemampuan
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

-- [[ MAIN LOOP ENGINE ]] --
RunService.RenderStepped:Connect(function()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local HRP = LocalPlayer.Character.HumanoidRootPart
    local Ball = GetBall()

    -- Auto Hit Logic
    if Config.AutoHit and Ball and Ball:IsA("BasePart") then
        local distance = (HRP.Position - Ball.Position).Magnitude
        if distance <= Config.HitDistance then
            SwingRacket()
            task.wait(0.15) -- Debounce biar gak spamming terlalu cepat
        end
    end

    -- Auto Ability Logic
    if Config.AutoAbility then
        pcall(function()
            UseSkill()
        end)
    end

    -- Ball Tracker Visual
    if Config.BallESP and Ball then
        if not Ball:FindFirstChild("ScriptHighlight") then
            local hl = Instance.new("Highlight")
            hl.Name = "ScriptHighlight"
            hl.FillColor = Color3.fromRGB(0, 255, 127)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.Parent = Ball
        end
    end
end)

