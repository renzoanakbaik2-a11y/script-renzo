-- =====================================================================
local activeHoverMobConnection = nil
local function toggleHoverNearestMob(state)
    if not state then 
        if activeHoverMobConnection then 
            activeHoverMobConnection:Disconnect() 
            activeHoverMobConnection = nil 
        end
        return 
    end
    
    if activeHoverMobConnection then activeHoverMobConnection:Disconnect() end
    
    activeHoverMobConnection = RunService.Heartbeat:Connect(function()
        if not Settings.HoverNearestMob then return end
        local root = getCharacterRootPart()
        if not root then return end
        
        local closestMob = nil
        local minDist = math.huge
        
        local function scanMobModel(model)
            if model:IsA("Model") and model ~= LocalPlayer.Character then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
                
                if humanoid and hrp and humanoid.Health > 0 then
                    local isPlayer = Players:GetPlayerFromCharacter(model)
                    if not isPlayer then
                        local d = (root.Position - hrp.Position).Magnitude
                        if d < minDist then
                            minDist = d
                            closestMob = hrp
                        end
                    end
                end
            end
        end

        local mobFolderNames = {"Enemies", "Enemy", "Monster", "Monsters"}
        for _, folderName in ipairs(mobFolderNames) do
            local folder = Workspace:FindFirstChild(folderName)
            if folder then
                for _, mob in pairs(folder:GetChildren()) do
                    scanMobModel(mob)
                end
            end
        end
        
        if closestMob then
            root.CFrame = CFrame.new(closestMob.Position + Vector3.new(0, Settings.MobHeightOffset, 0))
        end
    end)
end

