-- SISTEM TERBANG STABIL & HALUS
-- ==========================================
local activeFlyConnection = nil
local function smoothFlyTo(targetCFrame, checkSettingKey)
    local rootPart = getCharacterRootPart()
    if not rootPart then return end

    if activeFlyConnection then
        activeFlyConnection:Disconnect()
        activeFlyConnection = nil
    end

    local currentSpeed = math.clamp(Settings.FlightSpeed, 20, 1000)
    local currentHeight = math.clamp(Settings.FlyHeight, 0, 10)
    local adjustedTarget = targetCFrame.Position + Vector3.new(0, currentHeight, 0)

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = true end

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = rootPart

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart

    activeFlyConnection = RunService.Heartbeat:Connect(function(dt)
        if checkSettingKey and not Settings[checkSettingKey] then
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        local currentRoot = getCharacterRootPart()
        if not currentRoot or not character or not character.Parent then
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        local currentPos = currentRoot.Position
        local targetPos = adjustedTarget
        
        if checkSettingKey == "AutoFlyPlayer" and Settings.TargetPlayerName ~= "" then
            local targetPlayer = Players:FindFirstChild(Settings.TargetPlayerName)
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                targetPos = targetPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, currentHeight, 0)
            end
        end

        local direction = (targetPos - currentPos)
        local distance = direction.Magnitude

        if distance < 5 then
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        bodyVelocity.Velocity = direction.Unit * math.min(currentSpeed, distance * 10)
        bodyGyro.CFrame = CFrame.new(currentPos, targetPos)
    end)
end

