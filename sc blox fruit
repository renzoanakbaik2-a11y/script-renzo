-- FUNGSI TERBANG KILAT & MULUS (SPEED 320 STUD/DETIK)
local function terbangMulus(cframeTujuan, speed)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	-- Kecepatan dinaikkan ke 320 (Sangat Cepat)
	local kecepatanAkhir = speed or 320
	local jarak = (hrp.Position - cframeTujuan.Position).Magnitude
	local durasi = jarak / kecepatanAkhir
	
	local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(hrp, tweenInfo, {CFrame = cframeTujuan})
	
	-- Noclip & Zero Velocity selama penerbangan kilat
	local noclipConn = RunService.Stepped:Connect(function()
		if char then
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") then p.CanCollide = false end
			end
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	
	tween:Play()
	tween.Completed:Wait()
	
	if noclipConn then noclipConn:Disconnect() end
	hrp.AssemblyLinearVelocity = Vector3.zero
end

-- CARI GARIS ZONA AMAN PALING UJUNG DEPAN
local function cariGarisAmanUjung()
	local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localHrp then return nil end
	
	local targetGaris = nil
	local jarakTerjauh = 0

	for _, part in ipairs(Workspace:GetDescendants()) do
		if part:IsA("BasePart") then
			local nama = part.Name:lower()
			if nama:find("safe") or nama:find("finish") or nama:find("line") or nama:find("checkpoint") or (part.BrickColor.Name == "White" and part.Size.X > 8) then
				local jarak = (part.Position - localHrp.Position).Magnitude
				if jarak > 40 and jarak > jarakTerjauh then
					jarakTerjauh = jarak
					targetGaris = part
				end
			end
		end
	end
	
	if not targetGaris then
		for _, part in ipairs(Workspace:GetDescendants()) do
			if part:IsA("BasePart") and (part.Name:lower():find("safe") or part.Name:lower():find("finish") or part.BrickColor.Name == "White") then
				local jarak = (part.Position - localHrp.Position).Magnitude
				if jarak > 15 and jarak > jarakTerjauh then
					jarakTerjauh = jarak
					targetGaris = part
				end
			end
		end
	end

	return targetGaris
end

-- DETEKSI HUNTER VS SURVIVOR
local function isPemainSurvivor(player)
	if not player.Character then return false end
	local char = player.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	
	local highlight = char:FindFirstChildOfClass("Highlight") or char:FindFirstChild("Highlight", true)
	if highlight then
		local fill = highlight.FillColor or highlight.OutlineColor
		if fill and (fill.R > fill.G and fill.R > fill.B and fill.R > 0.4) then
			return false
		end
	end
	
	if player.Team and (player.Team.Name:lower():find("hunter") or player.Team.Name:lower():find("tagger")) then
		return false
	end
	
	return true
end

-- FUNGSI SERANG HUNTER (AUTO EQUIP + SPASI + TOUCH)
local function eksekusiPukulInstan(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar then return end
	local myHum = myChar:FindFirstChildOfClass("Humanoid")
	local myHrp = myChar:FindFirstChild("HumanoidRootPart")
	local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
	if not myHum or not myHrp or not targetHrp then return end
	
	local tool = myChar:FindFirstChildOfClass("Tool") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
	if tool and tool.Parent ~= myChar then
		myHum:EquipTool(tool)
	end
	
	if tool then tool:Activate() end
	VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
	VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
	
	if firetouchinterest then
		firetouchinterest(myHrp, targetHrp, 0)
		firetouchinterest(myHrp, targetHrp, 1)
		
		local torso = targetChar:FindFirstChild("Torso") or targetChar:FindFirstChild("UpperTorso")
		if torso then
			firetouchinterest(myHrp, torso, 0)
