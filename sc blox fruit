-- Simple UI Button untuk Toggle
local ScreenGui = Instance.new("ScreenGui", playerGui)
ScreenGui.Name = "SimpleSambungKata"
ScreenGui.ResetOnSpawn = false

local Btn = Instance.new("TextButton", ScreenGui)
Btn.Size = UDim2.new(0, 100, 0, 50)
Btn.Position = UDim2.new(0, 50, 0, 200)
Btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
Btn.TextColor3 = Color3.fromRGB(0, 255, 0)
Btn.TextSize = 16
Btn.Font = Enum.Font.SourceSansBold
Btn.Text = "STATUS: OFF"
Btn.Active = true
Btn.Draggable = true

local active = false
Btn.MouseButton1Click:Connect(function()
    active = not active
    Btn.TextColor3 = active and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
    Btn.Text = active and "STATUS: ON" or "STATUS: OFF"
end)

-- Main Loop Aman Eksekutor
task.spawn(function()
    while true do
        task.wait(0.5)
        if active then
            pcall(function()
                for _, v in ipairs(playerGui:GetDescendants()) do
                    if v:IsA("TextBox") and v.Visible then
                        local txt = v.Text or ""
                        if #txt > 0 and #txt <= 4 then
                            local last = string.sub(txt, -1):lower()
                            if Dictionary[last] then
                                local list = Dictionary[last]
                                local kata = list[math.random(1, #list)]
                                v.Text = kata
                            end
                        end
                    end
                end
            end)
        end
    end
end)
