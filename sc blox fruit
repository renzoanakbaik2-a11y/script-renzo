-- [[ GURITA HUB - OPTIMIZED AUTO JOIN & SMART FRUIT NOTIFICATION ]] --

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local lastState = "UNKNOWN"
local hasJoinedTeam = false -- Penanda agar auto join tim tidak spam terus-menerus

-- PENGATURAN DEFAULT
local config = {
	autoJoinTeamActive = false,
	selectedTeam = "Pirates"
}

-- FOLDER & FILE PENYIMPANAN SETTING (CONFIG SAVE)
local configFileName = "GuritaHub_BloxFruits_Config.json"

local function saveConfig()
	pcall(function()
		if writefile then
			writefile(configFileName, HttpService:JSONEncode(config))
		end
	end)
end

local function loadConfig()
	pcall(function()
		if readfile and isfile and isfile(configFileName) then
			local data = HttpService:JSONDecode(readfile(configFileName))
			if type(data) == "table" then
				for k, v in pairs(data) do
					config[k] = v
				end
			end
		end
	end)
end

loadConfig()

-- FUNGSI NOTIFIKASI
local function sendNotification(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = duration or 5
		})
	end)
end

-- ==========================================================
-- FUNGSI AUTO JOIN TIM (HANYA SEKALI SAAT MASUK/HOP SERVER)
-- ==========================================================
local function autoSelectTeam()
	if not config.autoJoinTeamActive or hasJoinedTeam then return end
	
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		local commF = remotes:FindFirstChild("CommF_")
		if commF then
			pcall(function()
				commF:InvokeServer("SetTeam", config.selectedTeam)
				hasJoinedTeam = true -- Kunci agar tidak dikirim berulang-ulang kali
			end)
		end
	end
end

-- Cek otomatis pas pertama kali script jalan / habis hop server
task.spawn(function()
	task.wait(2) -- Beri waktu sebentar untuk loading game
	autoSelectTeam()
end)

-- ==========================================================
-- SISTEM DETEKSI BUAH LENGKAP (ADA & KOSONG DENGAN NAMA)
-- ==========================================================
local function checkFruit()
	local foundFruitObj = nil
	local foundFruitName = ""
	
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name:find("Fruit") or obj.Name:find("BloxFruit") or (obj:IsA("Tool") and obj:FindFirstChild("Handle")) then
			foundFruitObj = obj
			foundFruitName = obj.Name
			break
		end
	end

	if foundFruitObj then
		if lastState ~= foundFruitName then
			lastState = foundFruitName
			sendNotification("Gurita Hub", "Buah Ada: " .. foundFruitName, 5)
		end
	else
		if lastState ~= "NONE" then
			sendNotification("Gurita Hub", "Buah Tidak Ada (Kosong)", 5)
			lastState = "NONE"
		end
	end
end

task.spawn(function()
	while task.wait(5) do
		pcall(checkFruit)
	end
end)

