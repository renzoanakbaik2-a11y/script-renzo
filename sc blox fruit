local function showTopNotification(text, duration)
	pcall(function()
		NotifText.Text = text
		-- Diturunkan ke posisi Y = 75 agar pas dan tidak terlalu mentok atas
		NotifFrame:TweenPosition(UDim2.new(0.5, -150, 0, 75), "Out", "Quad", 0.3, true)
		
		task.delay(duration or 5, function()
			NotifFrame:TweenPosition(UDim2.new(0.5, -150, 0, -60), "In", "Quad", 0.3, true)
		end)
	end)
end

-- ==========================================================
-- FUNGSI AUTO JOIN TIM (DI-FIX AGAR TIDAK ADA DELAY)
-- ==========================================================
local function autoSelectTeam()
	if not config.autoJoinTeamActive then return end
	
	if player.Team and player.Team.Name == config.selectedTeam then
		return 
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		local commF = remotes:FindFirstChild("CommF_")
		if commF then
			pcall(function()
				commF:InvokeServer("SetTeam", config.selectedTeam)
			end)
		end
	end
end

-- Dipercepat agar langsung eksekusi begitu game siap tanpa delay lama
task.spawn(function()
	task.wait(1) 
	autoSelectTeam()
	while task.wait(5) do
		pcall(autoSelectTeam)
	end
end)

-- ==========================================================
-- SISTEM DETEKSI BUAH (ADA & KOSONG)
-- ==========================================================
local function checkFruit()
	local foundFruitObj = nil
	local foundFruitName = ""
	
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name:find("Fruit") or obj.Name:find("BloxFruit") or (obj:IsA("Tool") and obj:FindFirstChild("Handle")) then
			foundFruitObj = obj
			foundFruitName = obj.Name
			break
		end
	end

	if foundFruitObj then
		if lastState ~= foundFruitName then
			lastState = foundFruitName
			showTopNotification("Buah Ada: " .. foundFruitName, 5)
		end
	else
		if lastState ~= "NONE" then
			showTopNotification("Buah Tidak Ada (Kosong)", 5)
			lastState = "NONE"
		end
	end
end

task.spawn(function()
	while task.wait(5) do
		pcall(checkFruit)
	end
end)

