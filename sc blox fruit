        task.spawn(function()
            while isRunning do
                StatusBox.Text = "Status: [v1.8] Attacking & Locking UI..."
                PerformAttackWithArgs()
                ForceSkillUIVisible() -- Memaksa UI Skill tidak hilang
                task.wait(0.18)
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        ToggleBtn.Text = "AUTO ATTACK: OFF"
        StatusBox.Text = "Status: Dimatikan."
    end
end)
