RunService.Heartbeat:Connect(function()
    if PullMode then
        pcall(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local myPos = char.HumanoidRootPart.CFrame
            
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and not obj.Anchored and obj ~= char and not obj:IsDescendantOf(char) then
                    local size = obj.Size
                    if size.X < 4 and size.Y < 4 and size.Z < 4 then
                        obj.CFrame = myPos + Vector3.new(0, 2, 0)
                    end
                end
            end
        end)
    end
end)

