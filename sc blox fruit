-- Fungsi Memutar Musik Notifikasi Buah
local function playFruitSound()
	if Settings.CustomSoundEnabled and Settings.SoundId ~= "" then
		pcall(function()
			local soundIdNum = Settings.SoundId
			if not string.find(soundIdNum, "rbxassetid://") then
				soundIdNum = "rbxassetid://" .. soundIdNum
			end
			local sound = Instance.new("Sound")
			sound.SoundId = soundIdNum
			sound.Volume = 5
			sound.Parent = Workspace
			sound:Play()
			game:GetService("Debris"):AddItem(sound, 10)
		end)
	end
end

-- Scanner Buah di Workspace
task.spawn(function()
	local lastFound = false
	while task.wait(3) do
		if Settings.FruitNotifier then
			local foundFruit = nil
			for _, obj in ipairs(Workspace:GetChildren()) do
				if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
					foundFruit = obj.Name
					break
				end
			end
			
			if foundFruit then
				NotifText.Text = "BERHASIL KETEMU: " .. foundFruit
				if not lastFound then
					lastFound = true
					playFruitSound()
				end
			else
				NotifText.Text = "Status: Mencari Buah di Map (Kosong)..."
				lastFound = false
			end
		end
	end
end)


