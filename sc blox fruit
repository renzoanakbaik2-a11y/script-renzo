        end
    end
    if tool then
        tool:Activate()
    end
end
local function ClaimGachaChests()
    if isLooting then
        return
    end
    isLooting = true
    task.wait(1.5)
    local chestsFolder = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
    if chestsFolder then
        local allChests = chestsFolder:GetChildren()
        if #allChests >= 3 then
            local availableIndices = {1, 2, 3}
            local selectedChests = {}
            for i = 1, 2 do
                local randomIndex = math.random(1, #availableIndices)
                table.insert(selectedChests, allChests[availableIndices[randomIndex]])
                table.remove(availableIndices, randomIndex)
            end
            for _, chest in ipairs(selectedChests) do
                local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt)
                    task.wait(0.8)
                end
            end
        end
    end
    task.wait(1)
    isLooting = false
end
local function CalculateFlyAboveCFrame(enemyRoot)
    if not enemyRoot or not enemyRoot.Parent then
        return nil
    end
    local enemyPos = enemyRoot.Position
    local flyPosition = Vector3.new(enemyPos.X, enemyPos.Y + CONFIG.FLY_HEIGHT, enemyPos.Z)
    return CFrame.new(flyPosition, enemyPos)
end
local function IsCurrentTargetValid()
    if not currentTargetRoot or not currentTargetRoot.Parent or not currentTargetRoot:IsDescendantOf(Workspace) then
        return false
    end
    local enemyModel = currentTargetRoot:FindFirstAncestorOfClass("Model")
    if not enemyModel then
        return false
    end
    return IsTargetAlive(enemyModel)
end
