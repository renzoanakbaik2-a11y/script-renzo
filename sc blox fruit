-- 3. LOGIKA MEMORY HOOK: KUNCI PROPERTI VISIBLE UI SKILL
local lockedElements = {}

local function LockSkillUI()
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "SpeedHubStep1V21UI" then
            for _, descendant in ipairs(gui:GetDescendants()) do
                if descendant:IsA("Frame") or descendant:IsA("ImageLabel") or descendant:IsA("ImageButton") or descendant:IsA("CanvasGroup") then
                    local name = descendant.Name:lower()
                    if name:find("skill") or name:find("ability") or name:find("hud") or name:find("button") or name:find("action") then
                        descendant.Visible = true
                        if not lockedElements[descendant] then
                            lockedElements[descendant] = descendant:GetPropertyChangedSignal("Visible"):Connect(function()
                                if not descendant.Visible then
                                    descendant.Visible = true -- Paksa balik jadi Visible jika disembunyikan game
                                end
                            end)
                        end
                    end
                end
            end
        end
    end
end

-- 4. LOGIKA SERANGAN DENGAN VIRTUAL CLICK KOORDINAT TOMBOL SERANG
local isRunning = false

local function SmartAttack()
    local char = LocalPlayer.Character
    if not char then return end

    -- Aktifkan pengunci UI
    LockSkillUI()

    -- Trigger Tool / Attack
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        tool:Activate()
    else
        -- Kirim Virtual Input Klik tanpa mengganggu fokus kursor
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        ToggleBtn.Text = "AUTO ATTACK: ON"
        
        task.spawn(function()
            while isRunning do
                StatusBox.Text = "Status: [v2.1] Locking UI & Attacking..."
                SmartAttack()
                task.wait(0.15)
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        ToggleBtn.Text = "AUTO ATTACK: OFF"
        StatusBox.Text = "Status: Dimatikan."
    end
end)
