local isRunning = false

local function SmartAttack()
    local char = LocalPlayer.Character
    if not char then return end

    -- Method 1: Cari RemoteEvent di dalam Character/Tool pemain
    local foundRemote = false
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("RemoteEvent") then
            item:FireServer()
            foundRemote = true
        end
    end

    -- Method 2: Kirim Virtual Mouse Down pada sudut aman (pojok kanan bawah/area kosong)
    if not foundRemote then
        VirtualInputManager:SendMouseButtonEvent(10, 10, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(10, 10, 0, false, game, 0)
    end
end

