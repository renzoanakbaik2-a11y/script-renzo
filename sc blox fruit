-- ==========================================================
-- FUNGSI PENCARIAN & AUTO COLLECT BUAH SENSITIF
-- ==========================================================
local function findFruit()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name:find("Fruit") or obj.Name:find("BloxFruit") then
			return obj
		end
		if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
			return obj
		end
	end
	return nil
end

local function moveToFruit(fruitObj)
	pcall(function()
		local targetPart = fruitObj:FindFirstChild("Handle") or fruitObj:FindFirstChildWhichIsA("BasePart") or fruitObj
		if targetPart and targetPart:IsA("BasePart") then
			task.wait(0.3)
			local char = player.Character or player.CharacterAdded:Wait()
			local rootPart = char:WaitForChild("HumanoidRootPart", 3)
			
			if rootPart then
				rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
				print("[SUKSES] Karakter mendatangi buah: " .. fruitObj.Name)
				sendNotification("Auto Collect", "Berhasil mengambil buah: " .. fruitObj.Name, 5)
			end
		end
	end)
end

-- ==========================================================
-- LOGIKA SERVER HOP AMAN (DELTA COMPATIBLE)
-- ==========================================================
local function hopToNewServer()
	if not config.autoHopActive then return end
	
	print("[Blox Fruits] Mencari server publik alternatif...")
	local success, site = pcall(function()
		return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"))
	end)

	if success and site and site.data then
		local servers = {}
		for _, server in ipairs(site.data) do
			if type(server) == "table" and server.id and server.id ~= game.JobId then
				if server.playing and server.maxPlayers and server.playing < server.maxPlayers then
					table.insert(servers, server.id)
				end
			end
		end

		if #servers > 0 then
			local targetServer = servers[math.random(1, #servers)]
			print("[Blox Fruits] Berpindah ke server ID: " .. targetServer)
			
			local tpSuccess = pcall(function()
				TeleportService:TeleportToPlaceInstance(placeId, targetServer, player)
			end)
			
			if not tpSuccess then
				task.wait(2)
				TeleportService:Teleport(placeId, player)
			end
		else
			task.wait(SEARCH_DELAY)
			TeleportService:Teleport(placeId, player)
		end
	else
		print("[Blox Fruits] Menggunakan metode hop alternatif...")
		task.wait(SEARCH_DELAY)
		TeleportService:Teleport(placeId, player)
	end
end

local function startMainLoop()
	task.spawn(function()
		task.wait(3)

		if not config.autoHopActive then return end

		local detectedFruit = findFruit()
		if detectedFruit then
			print("========================================")
			print("[ADA BUAH] Ditemukan: " .. detectedFruit.Name)
			print("Auto Hop Dimatikan. Mengambil buah...")
			print("========================================")
			sendNotification("Gurita Hub V22", "Ada Buah: " .. detectedFruit.Name .. "!", 6)
			
			config.autoHopActive = false
			saveConfig()
			
			ToggleHopBtn.Text = "Auto Hop: OFF (Buah Ketemu)"
			ToggleHopBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
			
			if config.autoCollectActive then
				moveToFruit(detectedFruit)
			end
			return
		else
			print("[TIDAK ADA BUAH] Melakukan hop server...")
			sendNotification("Gurita Hub V22", "Tidak ada buah, mencari server...", 3)
		end

		if config.autoHopActive then
			hopToNewServer()
		end
	end)
end

