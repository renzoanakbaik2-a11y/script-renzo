-- Loop Auto Escape
task.spawn(function()
    while true do
        task.wait(0.5)
        if Settings.AutoEscape then
            local foundItem = nil
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("Tool") or (obj:IsA("Model") and obj:FindFirstChild("Handle"))) and not BlacklistedItems[obj] then
                    foundItem = obj
                    break
                end
            end
            
            if foundItem then
                local handle = foundItem:FindFirstChild("Handle") or foundItem:FindFirstChildOfClass("BasePart")
                if handle then
                    -- Teleport Ambil Item
                    SafeTeleport(handle.CFrame)
                    if firetouchinterest and HumanoidRootPart then
                        firetouchinterest(HumanoidRootPart, handle, 0)
                        firetouchinterest(HumanoidRootPart, handle, 1)
                    end
                    task.wait(0.3)
                    BlacklistedItems[foundItem] = true
                    
                    -- Equip Tool
                    local backpackTool = LocalPlayer.Backpack:FindFirstChild(foundItem.Name)
                    if backpackTool and Humanoid then
                        Humanoid:EquipTool(backpackTool)
                        task.wait(0.2)
                    end
                    
                    -- Cari Target Pintu/Objek
                    local itemName = foundItem.Name:lower()
                    local targetObject = nil
                    
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if (obj:IsA("BasePart") or obj:IsA("Model")) and not UsedTargets[obj] then
                            local objName = obj.Name:lower()
                            if (itemName:find("key") and (objName:find("door") or objName:find("lock"))) or
                               (itemName:find("plank") and objName:find("plank")) or
                               (itemName:find("wrench") and (objName:find("circuit") or objName:find("box"))) or
                               (itemName:find("gear") and objName:find("machine")) then
                                targetObject = obj
                                break
                            end
                        end
                    end
                    
                    -- Teleport ke Pintu
                    if targetObject then
                        local targetPart = targetObject:IsA("BasePart") and targetObject or targetObject:FindFirstChildOfClass("BasePart")
                        if targetPart then
                            SafeTeleport(targetPart.CFrame)
                            Interact(targetObject)
                            UsedTargets[targetObject] = true
                        end
                    end
                end
            end
        end
    end
end)
