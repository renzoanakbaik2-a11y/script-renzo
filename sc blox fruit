-- 4. STABILIZED FLY, AUTO COLLECT & FLY TO MOB SYSTEM
-- =====================================================================
local activeFlyConnection = nil

local function smoothFlyTo(targetCFrame, customOffset, onComplete)
    local rootPart = getCharacterRootPart()
    if not rootPart then return end

    if activeFlyConnection then
        activeFlyConnection:Disconnect()
        activeFlyConnection = nil
    end

    local currentSpeed = math.clamp(Settings.FlightSpeed, 30, 500)
    local heightOffset = customOffset or math.clamp(Settings.FlyHeight, 0, 25)
    local adjustedTarget = targetCFrame.Position + Vector3.new(0, heightOffset, 0)

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = true end

    local noclipConnection
    noclipConnection = RunService.Stepped:Connect(function()
        pcall(function()
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end)

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = rootPart

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart

    activeFlyConnection = RunService.Heartbeat:Connect(function()
        local currentRoot = getCharacterRootPart()
        if not currentRoot or not character or not character.Parent then
            if noclipConnection then noclipConnection:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        local currentPos = currentRoot.Position
        local targetPos = adjustedTarget
        local direction = (targetPos - currentPos)
        local distance = direction.Magnitude

        -- Toleransi jarak agar tidak overshoot / mental ke atas
        if distance < 3 then
            if noclipConnection then noclipConnection:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            if onComplete then onComplete() end
            return
        end

        bodyVelocity.Velocity = direction.Unit * math.min(currentSpeed, distance * 12)
        bodyGyro.CFrame = CFrame.new(currentPos, targetPos)
    end)
end

local function collectNearestFruit()
    local rootPart = getCharacterRootPart()
    if not rootPart then return end

    local targetFruit = nil
    local shortestDist = math.huge

    for _, obj in ipairs(Workspace:GetChildren()) do
        if isRealSpawnedFruit(obj) then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
            if handle then
                local dist = (rootPart.Position - handle.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    targetFruit = handle
                end
            end
        end
    end

    if targetFruit then
        -- Ketinggian pas ke buah (offset 1 agar tepat menyentuh buah tanpa mental)
        smoothFlyTo(targetFruit.CFrame, 1, function()
            task.wait(0.5)
            collectNearestFruit()
        end)
    end
end

local function getTargetMob()
    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, enemy in ipairs(enemiesFolder:GetChildren()) do
            if enemy.Name:lower() == Settings.SelectedMob:lower() then
                local hrp = enemy:FindFirstChild("HumanoidRootPart")
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    return hrp
                end
            end
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:lower() == Settings.SelectedMob:lower() then
            local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                return hrp
            end
        end
    end
    return nil
end

local function flyToMob()
    if not Settings.FlyToMobEnabled then return end
    pcall(function()
        local mobRoot = getTargetMob()
        if mobRoot and not activeFlyConnection then
            -- Menggunakan AttackHeightOffset yang bisa disetting sampai 10
            smoothFlyTo(mobRoot.CFrame, Settings.AttackHeightOffset, function()
            end)
        end
    end)
end

