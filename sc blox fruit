-- 3. LOGIKA ANTI-PIGGY (MEMATIKAN SERANGAN & HITBOX PIGGY HASIL VERIFIKASI)
RunService.RenderStepped:Connect(function()
    if not Settings.AntiPiggy then return end
    
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and (model.Name:lower():find("piggy") or model:FindFirstChild("Piggy") or model:FindFirstChild("Enemy")) then
            for _, part in ipairs(model:GetDescendants()) do
                -- Matikan TouchTransmitter (alat pembunuh Piggy)
                if part:IsA("TouchTransmitter") then
                    part:Destroy()
                end
                -- Matikan kolisi part penyerang Piggy
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- Helper: Teleport Aman Berjarak
local function SafeTeleport(targetCFrame)
    if HumanoidRootPart then
        HumanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 2, 0)
        task.wait(0.25)
    end
end

-- Helper: Interaksi Semua Jenis Trigger
local function TriggerObject(target)
    if not target then return end
    
    local cd = target:FindFirstChildOfClass("ClickDetector") or target.Parent:FindFirstChildOfClass("ClickDetector")
    if cd and fireclickdetector then fireclickdetector(cd) end
    
    local prompt = target:FindFirstChildOfClass("ProximityPrompt") or target.Parent:FindFirstChildOfClass("ProximityPrompt")
    if prompt and fireproximityprompt then fireproximityprompt(prompt) end
    
    local targetPart = target:IsA("BasePart") and target or target:FindFirstChildOfClass("BasePart")
    if HumanoidRootPart and targetPart and firetouchinterest then
        firetouchinterest(HumanoidRootPart, targetPart, 0)
        firetouchinterest(HumanoidRootPart, targetPart, 1)
    end
end

