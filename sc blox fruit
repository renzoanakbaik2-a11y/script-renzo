-- ==========================================================
-- FUNGSI PENCARIAN & GERAK KE BUAH
-- ==========================================================
local function findFruit()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("Tool") and (obj.Name:find("Fruit") or obj:FindFirstChild("Handle")) then
			return obj
		end
	end
	return nil
end

local function moveToFruit(fruitObj)
	pcall(function()
		local handle = fruitObj:FindFirstChild("Handle") or fruitObj:FindFirstChildWhichIsA("BasePart")
		if handle and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			player.Character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 3, 0)
			print("[SUKSES] Karakter mendatangi posisi buah: " .. fruitObj.Name)
		end
	end)
end

-- ==========================================================
-- LOGIKA UTAMA SERVER HOP & CEK BUAH OTOMATIS
-- ==========================================================
local function hopToNewServer()
	if not config.autoHopActive then return end
	
	print("[Blox Fruits] Mencari server lain...")
	local success, result = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
		return HttpService:JSONDecode(game:HttpGet(url))
	end)

	if success and result and result.data then
		local servers = {}
		for _, server in ipairs(result.data) do
			if server.id and server.id ~= game.JobId and server.playing < server.maxPlayers and server.playing >= 1 then
				table.insert(servers, server.id)
			end
		end

		if #servers > 0 then
			local randomServerId = servers[math.random(1, #servers)]
			print("[Blox Fruits] Berpindah ke server ID: " .. randomServerId)
			local tpSuccess, tpError = pcall(function()
				TeleportService:TeleportToPlaceInstance(placeId, randomServerId, player)
			end)
			
			if not tpSuccess then
				warn("[TELEPORT ERROR] Gagal masuk server, mencoba ulang...", tpError)
				task.wait(2)
				hopToNewServer()
			end
		else
			task.wait(SEARCH_DELAY)
			hopToNewServer()
		end
	else
		task.wait(SEARCH_DELAY)
		hopToNewServer()
	end
end

local function startMainLoop()
	task.spawn(function()
		-- Beri jeda loading server agar map dan objek termuat sempurna
		task.wait(4)

		if not config.autoHopActive then return end

		-- CEK BUAH DI SERVER & KIRIM NOTIFIKASI
		local detectedFruit = findFruit()
		if detectedFruit then
			print("========================================")
			print("[ADA BUAH] Ditemukan: " .. detectedFruit.Name)
			print("Auto Hop Dimatikan. Karakter diam & mengambil buah.")
			print("========================================")
			sendNotification("Gurita Hub V17", "Ada Buah: " .. detectedFruit.Name .. "!", 6)
			
			config.autoHopActive = false
			saveConfig()
			
			ToggleHopBtn.Text = "Auto Hop: OFF (Buah Ketemu)"
			ToggleHopBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
			
			if config.autoCollectActive then
				moveToFruit(detectedFruit)
			end
			return
		else
			print("[TIDAK ADA BUAH] Tidak ada buah di server ini. Melakukan hop...")
			sendNotification("Gurita Hub V17", "Tidak ada buah di server ini.", 3)
		end

		-- JIKA TIDAK ADA BUAH, LANJUTKAN HOP OTOMATIS
		if config.autoHopActive then
			hopToNewServer()
		end
	end)
end

