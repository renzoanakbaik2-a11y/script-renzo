-- 10. LOGIKA REVISI & INTEGRASI BOLA (Bumbu Terbaru)
-- ===================================================
local isAutoHitActive = false
local isSpeeding = false
local defaultWalkSpeed = 16
local customSpeed = 32
local isDebounce = false

-- Fungsi Swing Fast & Anti-Delay
local function SwingRacket()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- Bumbu Fix Scanner: Pencari Objek Bola/Ring secara mendalam di Workspace
local function GetBallOrRing()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            -- Scan nama bola/ring/landing indicator
            if name:find("ball") or name:find("tennis") or name:find("ring") or name:find("landing") or name:find("target") or name:find("indicator") then
                -- Jarak maksimal 65 studs (Menandakan bola berada di area lapangan kita)
                local dist = (Vector2.new(myPos.X, myPos.Z) - Vector2.new(obj.Position.X, obj.Position.Z)).Magnitude
                if dist <= 65 then
                    return obj
                end
            end
        end
    end
    return nil
end

-- Emergency Reset Function
local function ResetScriptState()
    isAutoHitActive = false
    isSpeeding = false
    isDebounce = false
    
    BtnTeleportHit.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnTeleportHit.Text = "AUTO TELEPORT & HIT: OFF"
    BtnSpeed.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnSpeed.Text = "SUPER SPEED: OFF"
    StatusText.Text = "Status: Script Reset Successfully!"
    
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = defaultWalkSpeed
    end
end

-- 11. EVENT LISTENERS
BtnTeleportHit.MouseButton1Click:Connect(function()
    isAutoHitActive = not isAutoHitActive
    if isAutoHitActive then
        BtnTeleportHit.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnTeleportHit.Text = "AUTO TELEPORT & HIT: ON"
        StatusText.Text = "Status: Tracking Incoming Ball..."
    else
        BtnTeleportHit.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        BtnTeleportHit.Text = "AUTO TELEPORT & HIT: OFF"
        StatusText.Text = "Status: Auto Hit Stopped"
    end
end)

BtnSpeed.MouseButton1Click:Connect(function()
    isSpeeding = not isSpeeding
    if isSpeeding then
        BtnSpeed.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        BtnSpeed.Text = "SUPER SPEED: ON"
        StatusText.Text = "Status: Speed Boost Active"
    else
        BtnSpeed.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        BtnSpeed.Text = "SUPER SPEED: OFF"
        StatusText.Text = "Status: Normal Speed"
        
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            LocalPlayer.Character.Humanoid.WalkSpeed = defaultWalkSpeed
        end
    end
end)

BtnReset.MouseButton1Click:Connect(function()
    ResetScriptState()
end)

-- 12. MAIN LOOP ENGINE
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
    
    local HRP = char.HumanoidRootPart
    local Humanoid = char.Humanoid

    -- Handle Speed Boost
    if isSpeeding then
        Humanoid.WalkSpeed = customSpeed
    end

    -- Handle Auto Teleport & Hit
    if isAutoHitActive and not isDebounce then
        local targetObj = GetBallOrRing()
        
        if targetObj then
            isDebounce = true
            StatusText.Text = "Status: Teleporting & Hitting!"
            
            local targetPos = targetObj.Position
            
            -- Teleport langsung di koordinat X, Z bola (Y aman di tinggi berdiri karakter)
            HRP.CFrame = CFrame.new(Vector3.new(targetPos.X, HRP.Position.Y, targetPos.Z), Vector3.new(targetPos.X, HRP.Position.Y, targetPos.Z))
            
            -- Eksekusi Pukulan Raket
            SwingRacket()
            
            -- Cooldown / Delay halus biar gak spam berlebih
            task.wait(0.2)
            isDebounce = false
            
            if isAutoHitActive then
                StatusText.Text = "Status: Tracking Incoming Ball..."
            end
        end
    end
end)
