-- LOGIKA UTAMA SCRIPT (AUTO FARM, BOSS, PORTAL & AUTO LOOT)
-- ==============================================================================
local function findTargetObject()
    local targetPart = nil
    local targetType = "None"
    local shortestDist = math.huge
    local targetDungeonName = DUNGEON_LIST[CONFIG.SelectedDungeonIndex].Name

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local nameLower = string.lower(obj.Name)
            local root = obj:IsA("Model") and (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")) or obj

            if root then
                local dist = (humanoidRootPart.Position - root.Position).Magnitude

                if CONFIG.AutoDungeonPortal and (string.find(nameLower, string.lower(targetDungeonName)) or string.find(nameLower, "portal") or string.find(nameLower, "cove")) then
                    if dist < shortestDist then
                        shortestDist = dist
                        targetPart = root
                        targetType = "Portal"
                    end
                end

                if CONFIG.AutoBossEnabled and (string.find(nameLower, "boss") or string.find(nameLower, "leader") or string.find(nameLower, "skull")) then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and dist < shortestDist then
                        shortestDist = dist
                        targetPart = root
                        targetType = "Boss"
                    end
                end

                if CONFIG.AutoFarmEnabled and targetType == "None" then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and obj ~= character and dist < shortestDist then
                        shortestDist = dist
                        targetPart = root
                        targetType = "Farm"
                    end
                end
            end
        end
    end

    return targetPart, targetType, shortestDist
end

RunService.RenderStepped:Connect(function()
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        character = player.Character
        if character then humanoidRootPart = character:WaitForChild("HumanoidRootPart") end
        return 
    end

    if CONFIG.AutoLootAccessory then
        pcall(function()
            for _, item in ipairs(player.Backpack:GetChildren()) do
                local itemName = string.lower(item.Name)
                if itemName:find("basic") or itemName:find("common") or itemName:find("trash") then
                    item:Destroy()
                end
            end
        end)
    end

    local targetPart, targetType, dist = findTargetObject()

    if targetPart then
        StatusLabel.Text = "Target: " .. targetType .. " | Jarak: " .. math.floor(dist)

        if (CONFIG.AutoDungeonPortal or CONFIG.AutoBossEnabled or CONFIG.AutoFarmEnabled) and dist > 15 then
            local offset = Vector3.new(CONFIG.TeleportOffset[1], CONFIG.TeleportOffset[2], CONFIG.TeleportOffset[3])
            humanoidRootPart.CFrame = CFrame.new(targetPart.Position + offset)
        end

        if targetType == "Boss" or targetType == "Farm" then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") and obj ~= character then
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    local rp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                    if hum and rp and hum.Health > 0 then
                        if (humanoidRootPart.Position - rp.Position).Magnitude <= 40 then
                            pcall(function() hum.Health = 0 end)
                        end
                    end
                end
            end

            for _, container in ipairs({ReplicatedStorage, player:FindFirstChild("PlayerGui"), Workspace}) do
                if container then
                    for _, remote in ipairs(container:GetDescendants()) do
                        if remote:IsA("RemoteEvent") then
                            local rName = string.lower(remote.Name)
                            if rName:find("damage") or rName:find("hit") or rName:find("attack") or rName:find("boss") then
                                pcall(function()
                                    remote:FireServer(999999999, targetPart)
                                    remote:FireServer(999999999)
                                end)
                            end
                        end
                    end
                end
            end
        end
    else
        StatusLabel.Text = "Status: Menelusuri Area & Portal..."
    end
end)

