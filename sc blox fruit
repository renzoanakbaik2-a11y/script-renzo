-- Fungsi Menampilkan Hirarki Folder ke UI Menu
local function showObjectFolders(targetObj)
    -- Bersihkan isi menu sebelumnya
    for _, child in pairs(ScrollContainer:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    ESPBoxFolder:ClearAllChildren()
    
    -- Beri kotak biru penanda pada objek yang diklik di map
    local box = Instance.new("SelectionBox")
    box.Adornee = targetObj
    box.Color3 = Color3.fromRGB(0, 170, 255)
    box.LineThickness = 0.08
    box.Parent = ESPBoxFolder
    
    StatusLabel.Text = "Berhasil Klik: " .. targetObj.Name .. " (" .. targetObj.ClassName .. ")\nDaftar Folder & Parent-nya:"
    MainFrame.Visible = true -- Otomatis munculkan menu saat objek di-klik
    
    -- Kumpulkan jalur hirarki dari objek ke Workspace
    local current = targetObj
    local lineage = {}
    while current and current ~= game do
        table.insert(lineage, 1, current)
        current = current.Parent
    end
    
    local count = 0
    for _, item in ipairs(lineage) do
        count = count + 1
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        btn.TextColor3 = Color3.fromRGB(255, 215, 0)
        btn.Font = Enum.Font.Code
        btn.TextSize = 10
        btn.Text = "📁 " .. item.Name .. " [" .. item.ClassName .. "]"
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = ScrollContainer
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        
        -- Klik folder di UI untuk melihat isi sub-foldernya
        btn.MouseButton1Click:Connect(function()
            for _, child in pairs(ScrollContainer:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            StatusLabel.Text = "Isi dari Folder: " .. item.Name
            
            local subCount = 0
            for _, sub in pairs(item:GetChildren()) do
                subCount = subCount + 1
                local subBtn = Instance.new("TextButton")
                subBtn.Size = UDim2.new(1, -6, 0, 26)
                subBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                subBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
                subBtn.Font = Enum.Font.Code
                subBtn.TextSize = 10
                subBtn.Text = "   - " .. sub.Name .. " [" .. sub.ClassName .. "]"
                subBtn.TextXAlignment = Enum.TextXAlignment.Left
                subBtn.Parent = ScrollContainer
                Instance.new("UICorner", subBtn).CornerRadius = UDim.new(0, 4)
            end
            ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, subCount * 30)
        end)
    end
    ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

-- Deteksi Klik Langsung ke Objek di Dalam Dunia Game (3D Map)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not Config.Active then return end
    
    -- Mendeteksi klik mouse kiri atau tap layar HP
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        -- Jangan eksekusi jika pemain sedang mengetik atau mengklik tombol UI Menu
        if gameProcessed then return end
        
        local mousePos = UserInputService:GetMouseLocation()
        local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        
        -- Lakukan Raycast ke map
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {player.Character}
        
        local raycastResult = workspace:Raycast(unitRay.Origin, unitRay.Direction * 1000, raycastParams)
        
        if raycastResult and raycastResult.Instance then
            local hitPart = raycastResult.Instance
            -- Tampilkan struktur foldernya secara otomatis
            showObjectFolders(hitPart)
        end
    end
end)

