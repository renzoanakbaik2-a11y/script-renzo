-- 2. PENULUSURAN TARGET MOBS DENGAN VERIFIKASI DEEP SCAN
local function GetNearestTargetScanner()
    local nearestEnemy = nil
    local shortestDistance = math.huge
    
    local mobsFolder = Workspace:FindFirstChild("Mobs") or Workspace:FindFirstChild("Enemies")
    if not mobsFolder then 
        UpdateStatus("Error: Folder Mobs/Enemies tidak ada!")
        return nil 
    end

    -- Memindai seluruh isi folder Mobs secara mendalam
    for _, desc in pairs(mobsFolder:GetDescendants()) do
        if desc:IsA("Model") and desc ~= Character then
            local enemyHum = desc:FindFirstChildOfClass("Humanoid")
            local enemyRoot = desc:FindFirstChild("HumanoidRootPart") 
                or desc.PrimaryPart 
                or desc:FindFirstChild("Collider")
                or desc:FindFirstChild("Root")
                or desc:FindFirstChildWhichIsA("BasePart")
            
            local isAlive = true
            if enemyHum and enemyHum.Health <= 0 then
                isAlive = false
            elseif desc:GetAttribute("Health") and desc:GetAttribute("Health") <= 0 then
                isAlive = false
            end
            
            if enemyRoot and isAlive then
                local dist = (RootPart.Position - enemyRoot.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearestEnemy = enemyRoot
                end
            end
        end
    end
    
    return nearestEnemy
end

-- 3. FUNGSI UPDATE VISUAL TRACKER
local function ClearVisuals()
    tracerBeam.Parent = nil
    attachment0.Parent = nil
    attachment1.Parent = nil
    targetHighlight.Parent = nil
end

local function UpdateVisualTracker(targetRoot)
    if not targetRoot or not targetRoot.Parent then
        ClearVisuals()
        return
    end
    
    -- Pasang Attachment Garis ke Karakter & Musuh
    attachment0.Parent = RootPart
    attachment1.Parent = targetRoot
    
    tracerBeam.Attachment0 = attachment0
    tracerBeam.Attachment1 = attachment1
    tracerBeam.Parent = RootPart
    
    -- Pasang Efek Menyala (Highlight) ke Model Musuh
    targetHighlight.Parent = targetRoot.Parent
end

-- 4. TOGGLE EVENT & MAIN LOOP
ToggleBtn.MouseButton1Click:Connect(function()
    isTrackerOn = not isTrackerOn
    
    if isTrackerOn then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "SCANNER: ON"
        UpdateStatus("Memulai Pemindaian...")
        
        heartbeatConnection = RunService.Heartbeat:Connect(function()
            if not isTrackerOn then return end
            
            Character = LocalPlayer.Character
            if not Character then return end
            RootPart = Character:FindFirstChild("HumanoidRootPart")
            if not RootPart then return end
            
            -- Validasi Target Terkini
            local isTargetValid = false
            if currentTargetRoot and currentTargetRoot.Parent and currentTargetRoot:IsDescendantOf(Workspace) then
                isTargetValid = true
            end
            
            if not isTargetValid then
                currentTargetRoot = GetNearestTargetScanner()
            end
            
            if currentTargetRoot then
                local enemyName = currentTargetRoot.Parent.Name
                local dist = math.floor((RootPart.Position - currentTargetRoot.Position).Magnitude)
                
                UpdateStatus("Ditemukan: " .. enemyName .. " [" .. dist .. " studs]")
                UpdateVisualTracker(currentTargetRoot)
            else
                UpdateStatus("Tidak ada Mobs hidup di sekitar!")
                ClearVisuals()
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleBtn.Text = "SCANNER: OFF"
        UpdateStatus("MATI")
        currentTargetRoot = nil
        
        ClearVisuals()
        
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end
end)
