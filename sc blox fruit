		return
	end

	setBusy(true)
	report("Mencari menu Dungeon...\nPlace sekarang: " .. tostring(game.PlaceId))

	local crabbyButton = findButton({"crabby crusade"})

	if not crabbyButton then
		local dungeonButton = findButton({"dungeon"})
		if dungeonButton then
			report("Menu Dungeon ditemukan.\nMembuka menu...")
			local clicked, errorMessage = clickButton(dungeonButton)
			if not clicked then
				setBusy(false)
				report("Gagal membuka menu Dungeon:\n" .. tostring(errorMessage))
				return
			end
			task.wait(1)
		else
			setBusy(false)
			report("Button Dungeon tidak ditemukan.\nDaftar button dikirim ke console.")
			dumpVisibleButtons()
			return
		end
	end

	crabbyButton = waitForButton({"crabby crusade"}, 5)
	if not crabbyButton then
		setBusy(false)
		report("Crabby Crusade tidak ditemukan.\nKemungkinan belum unlocked atau UI berbeda.\nCek console.")
		dumpVisibleButtons()
		return
	end

	report("Crabby Crusade ditemukan.\nMemilih dungeon...")
	local clickedCrabby, crabbyError = clickButton(crabbyButton)
	if not clickedCrabby then
		setBusy(false)
		report("Gagal memilih Crabby Crusade:\n" .. tostring(crabbyError))
		return
	end

	task.wait(1)

	local startButton = waitForButton({"start"}, 5)
	if not startButton then
		setBusy(false)
		report("Crabby dipilih tetapi START tidak ditemukan.\nCek console untuk UI yang aktif.")
		dumpVisibleButtons()
		return
	end

	report("START ditemukan.\nMeminta World // Zero memulai dungeon...")
	local clickedStart, startError = clickButton(startButton)

	if not clickedStart then
		setBusy(false)
		report("Gagal menekan START:\n" .. tostring(startError))
		return
	end

	report("START sudah ditekan.\nMenunggu server / teleport...")

	task.delay(15, function()
		if not alive or not busy then return end
		setBusy(false)
		report("15 detik belum ada teleport.\nSTART sudah ditekan, tetapi kemungkinan ada tahap server/queue lain.\nCek UI + console.")
		dumpVisibleButtons()
	end)
end

joinButton.Activated:Connect(function()
	local ok, err = xpcall(joinCrabby, debug.traceback)
	if not ok then
