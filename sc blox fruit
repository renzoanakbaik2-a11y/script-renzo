local function equipSelectedWeapon()
    pcall(function()
        local character = LocalPlayer.Character
        local backpack = LocalPlayer.Backpack
        if not character or not backpack then return end

        local targetType = Settings.SelectedWeapon or "Melee"
        
        local alreadyEquipped = false
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then
                local name = child.Name:lower()
                if targetType == "Melee" and (name:find("combat") or name:find("step") or name:find("claw") or name:find("fist") or name:find("water") or name:find("dragon") or name:find("superhuman") or name:find("godhuman") or name:find("electric") or name:find("sanguine")) then
                    alreadyEquipped = true
                    break
                elseif targetType == "Fruit" and (name:find("fruit") or name:find("rocket") or name:find("dough") or name:find("kitsune") or name:find("buddha") or name:find("leopard") or name:find("dragon")) then
                    alreadyEquipped = true
                    break
                elseif targetType == "Sword" and (name:find("sword") or name:find("katana") or name:find("blade") or name:find("saber") or name:find("tushita") or name:find("culling") or name:find("buddy") or name:find("hallow") or name:find("dark")) then
                    alreadyEquipped = true
                    break
                elseif targetType == "Gun" and (name:find("gun") or name:find("rifle") or name:find("musket") or name:find("kabucha") or name:find("soul") or name:find("bazooka") or name:find("flintlock")) then
                    alreadyEquipped = true
                    break
                end
            end
        end

        if alreadyEquipped then return end

        local targetTool = nil
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                local name = child.Name:lower()
                if targetType == "Melee" and (name:find("combat") or name:find("step") or name:find("claw") or name:find("fist") or name:find("water") or name:find("dragon") or name:find("superhuman") or name:find("godhuman") or name:find("electric") or name:find("sanguine")) then
                    targetTool = child
                    break
                elseif targetType == "Fruit" and (name:find("fruit") or name:find("rocket") or name:find("dough") or name:find("kitsune") or name:find("buddha") or name:find("leopard") or name:find("dragon")) then
                    targetTool = child
                    break
                elseif targetType == "Sword" and (name:find("sword") or name:find("katana") or name:find("blade") or name:find("saber") or name:find("tushita") or name:find("culling") or name:find("buddy") or name:find("hallow") or name:find("dark")) then
                    targetTool = child
                    break
                elseif targetType == "Gun" and (name:find("gun") or name:find("rifle") or name:find("musket") or name:find("kabucha") or name:find("soul") or name:find("bazooka") or name:find("flintlock")) then
                    targetTool = child
                    break
                end
            end
        end

        if not targetTool then
            for _, child in ipairs(backpack:GetChildren()) do
                if child:IsA("Tool") then
                    local name = child.Name:lower()
                    if targetType == "Melee" and not name:find("fruit") and not name:find("gun") and not name:find("sword") then
                        targetTool = child
                        break
                    elseif targetType == "Sword" and name:find("sword") then
                        targetTool = child
                        break
                    elseif targetType == "Gun" and name:find("gun") then
                        targetTool = child
                        break
                    end
                end
            end
        end

        if targetTool and character:FindFirstChildOfClass("Humanoid") then
            character.Humanoid:EquipTool(targetTool)
        end
    end)
end

local activeAuraConnection = nil
local function toggleAutoAuraAttack(state)
    if not state then
        if activeAuraConnection then
            activeAuraConnection:Disconnect()
            activeAuraConnection = nil
        end
        return
    end

    if activeAuraConnection then activeAuraConnection:Disconnect() end

    local lastAttackTick = 0
    activeAuraConnection = RunService.Heartbeat:Connect(function()
        if not Settings.AutoAuraAttack then return end
        local root = getCharacterRootPart()
        if not root then return end

        local interval = math.clamp(0.5 - (Settings.AuraAttackSpeed / 1200), 0.03, 0.4)
        if tick() - lastAttackTick < interval then return end
        lastAttackTick = tick()

        pcall(function()
            equipSelectedWeapon()
            local foundTarget = false

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local pRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                    local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if pRoot and pHum and pHum.Health > 0 then
                        if (root.Position - pRoot.Position).Magnitude <= Settings.AuraRange then
                            foundTarget = true
                            break
                        end
                    end
                end
            end

            if not foundTarget then
                local mobFolderNames = {"Enemies", "Enemy", "Monster", "Monsters"}
                for _, folderName in ipairs(mobFolderNames) do
                    local folder = Workspace:FindFirstChild(folderName)
                    if folder then
                        for _, mob in pairs(folder:GetChildren()) do
                            local mRoot = mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
                            local mHum = mob:FindFirstChildOfClass("Humanoid")
                            if mRoot and mHum and mHum.Health > 0 then
                                if (root.Position - mRoot.Position).Magnitude <= Settings.AuraRange then
                                    foundTarget = true
                                    break
                                end
                            end
                        end
                    end
                    if foundTarget then break end
                end
            end

            if foundTarget then
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                task.wait(0.02)
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end
        end)
    end)
