local function CreateButton(text, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 30)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 11
    btn.Parent = MainFrame

    btn.MouseButton1Click:Connect(function()
        callback(btn)
    end)
    return btn
end

OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- HELPER: FUNGSI SAMBAR ITEM/TEMPAT BERDASARKAN KLIK TOMBOL
local function TeleportAndInteract(keyword)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
            local parentPart = obj.Parent
            if parentPart and parentPart:IsA("BasePart") and parentPart:IsDescendantOf(Workspace) then
                local itemName = string.lower(parentPart.Name)
                if itemName:find(keyword) then
                    -- Teleport Ke Lokasi Item
                    root.CFrame = parentPart.CFrame
                    task.wait(0.2)
                    
                    if obj:IsA("ClickDetector") then fireclickdetector(obj) end
                    if obj:IsA("ProximityPrompt") then fireproximityprompt(obj) end
                    
                    task.wait(0.2)
                    
                    -- Langsung Kembali Melayang
                    if Settings.SafeMode then
                        root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
                    end
                    break
                end
            end
        end
    end
end

