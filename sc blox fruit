local function updateFruitESP()
    clearESP()
    if not Settings.FruitESP then return end

    pcall(function()
        local rootPart = getCharacterRootPart()
        for _, obj in ipairs(Workspace:GetChildren()) do
            if isRealSpawnedFruit(obj) then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    local distance = rootPart and math.floor((rootPart.Position - handle.Position).Magnitude) or 0
                    local island = getIslandName(handle.Position)
                    local fruitName = obj.Name

                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESP_" .. fruitName
                    billboard.Size = UDim2.new(0, 200, 0, 60)
                    billboard.AlwaysOnTop = true
                    billboard.Adornee = handle
                    billboard.Parent = ESPFolder

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextSize = 11
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.Text = string.format("%s\n%dm\n%s", fruitName, distance, island)
                    textLabel.Parent = billboard
                end
            end
        end
    end)
end

