-- Nama file untuk Auto Save Setting
local FileName = "BloxFruitsHubSettings.json"

-- Pengaturan Default & Status Fitur (Auto Save Aktif / On otomatis)
local Settings = {
	FruitNotifier = true,
	AutoJoinEnabled = true,
	SelectedTeam = "Pirates", -- Pilihan: "Pirates" atau "Marines"
	FpsBoost = false,
	CustomSoundEnabled = false,
	SoundId = "" -- ID Audio Roblox (Contoh: rbxassetid://...)
}

-- Fungsi Load Settings
local function loadSettings()
	if readfile and pcall(readfile, FileName) then
		local success, data = pcall(function()
			return HttpService:JSONDecode(readfile(FileName))
		end)
		if success and type(data) == "table" then
			for k, v in pairs(data) do
				Settings[k] = v
			end
		end
	end
end

-- Fungsi Save Settings
local function saveSettings()
	if writefile then
		local success, encoded = pcall(function()
			return HttpService:JSONEncode(Settings)
		end)
		if success then
			writefile(FileName, encoded)
		end
	end
end

-- Muat pengaturan saat pertama kali script dijalankan
