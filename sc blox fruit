-- Load & Save Settings
local function saveSettings()
    local success, encoded = pcall(function() return HttpService:JSONEncode(CONFIG) end)
    if success and writefile then pcall(function() writefile(CONFIG_FILE_NAME, encoded) end) end
end

local function loadSettings()
    if readfile and pcall(function() return readfile(CONFIG_FILE_NAME) end) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE_NAME)) end)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do CONFIG[k] = v end
        end
    end
end
