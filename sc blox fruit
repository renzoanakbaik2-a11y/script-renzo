-- 1. PEMBERSIHAN MENU HUB LAMA (Mastiin cuma 1 menu v2.3 di layar)
local function SapuMenuHub(parent)
    if not parent then return end
    for _, gui in ipairs(parent:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:find("SpeedHub") or gui.Name:find("Step1") or gui.Name:find("Fix") or gui.Name:find("V1") or gui.Name:find("V2")) then
            pcall(function() gui:Destroy() end)
        end
    end
end
