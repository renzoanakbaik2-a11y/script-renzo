-- 6. SMART BALL FINDER (FIX DIAM AJA)
-- ===================================================
local isAutoHitActive = false
local isProcessingHit = false
local lastHitTime = 0

local function SingleSwing()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.02)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- BUMBU RAHASIA: Pencari Bola Super Fleksibel
local function FindAnyBall()
    for _, obj in pairs(Workspace:GetDescendants()) do
        -- Cek apakah namanya mengandung kata bola/ball/tennis/projectile
        local name = obj.Name:lower()
        if name:find("ball") or name:find("tennis") or name:find("projectile") or name:find("ring") then
            if obj:IsA("BasePart") and obj.Transparency < 1 then
                return obj
            elseif obj:IsA("Model") then
                local part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if part then return part end
            end
        end
    end
    return nil
end

local function ResetScriptState()
    isAutoHitActive = false
    isProcessingHit = false
    BtnAutoHit.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnAutoHit.Text = "AUTO HIT / TELEPORT BOLA: OFF"
    StatusText.Text = "Status: Reset Done"
end

BtnAutoHit.MouseButton1Click:Connect(function()
    isAutoHitActive = not isAutoHitActive
    if isAutoHitActive then
        BtnAutoHit.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnAutoHit.Text = "AUTO HIT / TELEPORT BOLA: ON"
        StatusText.Text = "Status: Searching for Ball..."
    else
        ResetScriptState()
    end
end)

BtnReset.MouseButton1Click:Connect(function()
    ResetScriptState()
end)

-- LOOP ENGINE
RunService.RenderStepped:Connect(function()
    if not isAutoHitActive or isProcessingHit then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    local ballPart = FindAnyBall()

    if ballPart then
        local dist = (HRP.Position - ballPart.Position).Magnitude
        
        -- Update Status Teks Live Nama Object Bola Yang Ditemukan
        StatusText.Text = "Found: " .. ballPart.Name .. " (" .. math.floor(dist) .. " studs)"

        -- Kalau bola dalam jangkauan 60 studs
        if dist <= 60 and (tick() - lastHitTime > 0.3) then
            isProcessingHit = true
            lastHitTime = tick()
            
            StatusText.Text = "Hit Executed on: " .. ballPart.Name

            -- Teleport langsung ke posisi bola
            local targetPos = ballPart.Position
            HRP.CFrame = CFrame.new(Vector3.new(targetPos.X, HRP.Position.Y, targetPos.Z), Vector3.new(targetPos.X, HRP.Position.Y, targetPos.Z))

            -- Swing raket
            SingleSwing()

            task.wait(0.2)
            isProcessingHit = false
        end
    else
        StatusText.Text = "Status: Ball NOT Found! (Scanning...)"
    end
end)
