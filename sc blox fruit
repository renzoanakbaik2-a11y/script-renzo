task.spawn(function()
    while true do
        task.wait(0.4)
        if Settings.AutoEscape and HumanoidRootPart and Humanoid then
            local foundItem = nil
            
            -- Cari Item yang belum masuk Blacklist
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if not BlacklistedItems[obj] and obj ~= Character and not obj:IsDescendantOf(Character) then
                    local name = obj.Name:lower()
                    local parentName = obj.Parent and obj.Parent.Name:lower() or ""
                    
                    -- Cek kriteria Item Piggy (Key, Plank, Wrench, Gear, Card, Candle, Code, dll)
                    if (obj:IsA("Tool") or obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChildOfClass("TouchTransmitter")) then
                        if not name:find("door") and not name:find("gate") and not parentName:find("door") then
                            if name:find("key") or name:find("plank") or name:find("wrench") or name:find("gear") or name:find("card") or name:find("code") or name:find("candle") or name:find("bone") then
                                foundItem = obj
                                break
                            end
                        end
                    end
                end
            end
            
            if foundItem then
                local targetPart = foundItem:IsA("BasePart") and foundItem or foundItem:FindFirstChildOfClass("BasePart") or foundItem:FindFirstChild("Handle")
                
                if targetPart then
                    -- Step 1: Teleport dan Ambil Item
                    SafeTeleport(targetPart.CFrame)
                    TriggerObject(foundItem)
                    BlacklistedItems[foundItem] = true
                    task.wait(0.3)
                    
                    -- Step 2: Equip Item ke Tangan
                    local backpackTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                    if backpackTool then
                        Humanoid:EquipTool(backpackTool)
                        task.wait(0.2)
                    end
                    
                    local heldTool = Character:FindFirstChildOfClass("Tool")
                    local itemName = heldTool and heldTool.Name:lower() or foundItem.Name:lower()
                    
                    -- Step 3: Cari Pintu / Objek Target yang Pas
                    local doorTarget = nil
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if not UsedTargets[obj] then
                            local objName = obj.Name:lower()
                            if (itemName:find("key") and (objName:find("door") or objName:find("lock") or objName:find("padlock"))) or
                               (itemName:find("plank") and (objName:find("plank") or objName:find("bridge"))) or
                               (itemName:find("wrench") and (objName:find("circuit") or objName:find("box") or objName:find("gate"))) or
                               (itemName:find("gear") and (objName:find("machine") or objName:find("clock"))) or
                               (itemName:find("card") and (objName:find("reader") or objName:find("swipe"))) then
                                
                                doorTarget = obj
                                break
                            end
                        end
                    end
                    
                    -- Step 4: Teleport ke Pintu & Gunakan Item
                    if doorTarget then
                        local doorPart = doorTarget:IsA("BasePart") and doorTarget or doorTarget:FindFirstChildOfClass("BasePart")
                        if doorPart then
                            SafeTeleport(doorPart.CFrame)
                            TriggerObject(doorTarget)
                            UsedTargets[doorTarget] = true
                            task.wait(0.3)
                        end
                    end
                end
            end
        end
    end
end)-- =================================================================
