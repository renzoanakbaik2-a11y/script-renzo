local function ApplyMenuSize(sizeName)
    Settings.MenuSize = sizeName
    SaveSettings()
    
    SmallBtn.BackgroundColor3 = (sizeName == "Small") and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(35, 35, 35)
    MediumBtn.BackgroundColor3 = (sizeName == "Medium") and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(35, 35, 35)
    BigBtn.BackgroundColor3 = (sizeName == "Big") and Color3.fromRGB(70, 70, 70) or Color3.fromRGB(35, 35, 35)
    
    local targetSize = GetSizeDimensions(sizeName)
    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Size = targetSize}):Play()
end

