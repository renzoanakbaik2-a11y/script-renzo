-- 🚀 FUNGSI TERBANG MULUS
local function terbangMulus(cframeTujuan, speed)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
	
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") then p.CanCollide = false end
	end
	
	local jarak = (hrp.Position - cframeTujuan.Position).Magnitude
	local durasi = jarak / (speed or 100)
	local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
	
	activeTween = TweenService:Create(hrp, tweenInfo, {CFrame = cframeTujuan})
	activeTween:Play()
	activeTween.Completed:Wait()
	activeTween = nil
end

-- 🎯 CARI ZONA SEBERANG
local function cariZonaSeberang()
	local localHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not localHrp then return nil end
	
	local targetGaris = nil
	local jarakTerjauh = 0

	for _, part in ipairs(Workspace:GetDescendants()) do
		if part:IsA("BasePart") and part:IsDescendantOf(Workspace) then
			local nama = part.Name:lower()
			if nama:find("safe") or nama:find("finish") or nama:find("line") or nama:find("checkpoint") or (part.BrickColor.Name == "White" and part.Size.X > 8) then
				local jarak = (part.Position - localHrp.Position).Magnitude
				if jarak > 30 and jarak > jarakTerjauh then
					jarakTerjauh = jarak
					targetGaris = part
				end
			end
		end
	end
	return targetGaris
end

-- 🔍 DETEKSI PERGANTIAN RONDE DARI UI TEXT
local function cekPergantianRondeUI()
	local coreGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not coreGui then return false end
	
	for _, gui in ipairs(coreGui:GetDescendants()) do
		if gui:IsA("TextLabel") and gui.Visible then
			local teks = gui.Text:lower()
			if teks:find("putaran") or teks:find("menyeberang") or teks:find("pelari") then
				if gui.Text ~= putaranTerakhir then
					putaranTerakhir = gui.Text
					return true
				end
			end
		end
	end
	return false
end

-- 🕵️ DETEKSI SURVIVOR
local function isPemainSurvivor(player)
	if not player.Character then return false end
	local char = player.Character
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	
	if player.Team and (player.Team.Name:lower():find("hunter") or player.Team.Name:lower():find("tagger")) then
		return false
	end
	return true
end

-- ⚔️ LOGIKA ATTACK HUNTER
local function serangSurvivorPivotLock(targetChar)
	local myChar = LocalPlayer.Character
	if not myChar then return end
	local myHrp = myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar:FindFirstChildOfClass("Humanoid")
	local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
	if not myHrp or not myHum or not targetHrp then return end
	
	local tool = myChar:FindFirstChildOfClass("Tool") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
	if tool and tool.Parent ~= myChar then
		myHum:EquipTool(tool)
		task.wait(0.02)
	end
	
	local startTime = tick()
	while tick() - startTime < 0.3 do
		if not targetHrp or not targetHrp.Parent or not myHrp then break end
		
		myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 0, 0.5)
		myHrp.Velocity = targetHrp.Velocity
		
		if tool then
			tool:Activate()
			local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")
			if handle and firetouchinterest then
				firetouchinterest(handle, targetHrp, 0)
				firetouchinterest(handle, targetHrp, 1)
			end
		end
		
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
		RunService.RenderStepped:Wait()
	end
end

-- 🏃 TOGGLE AUTO SURVIVOR
BtnSurvivor.MouseButton1Click:Connect(function()
	isSurvivorActive = not isSurvivorActive
	if isSurvivorActive then
		isHunterActive = false
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		
		BtnSurvivor.Text = "SURVIVOR MODE: ON"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			while isSurvivorActive do
				if cekPergantianRondeUI() then
					sudahSampaiZona = false
				end
				
				if not sudahSampaiZona then
					local zonaTujuan = cariZonaSeberang()
					if zonaTujuan then
						Status.Text = "Status: Meluncur ke Safe Zone..."
						Status.TextColor3 = Color3.fromRGB(100, 255, 150)
						
						local cframeTarget = zonaTujuan.CFrame * CFrame.new(0, 2, 0)
						terbangMulus(cframeTarget, 110)
						sudahSampaiZona = true
					else
						Status.Text = "Status: Mencari Safe Zone..."
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
					end
				else
					Status.Text = "Status: Standby (Menunggu UI Ronde)..."
					Status.TextColor3 = Color3.fromRGB(100, 200, 255)
				end
				task.wait(0.2)
			end
		end)
	else
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
		if activeTween then activeTween:Cancel() activeTween = nil end
	end
end)

