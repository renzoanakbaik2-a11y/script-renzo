local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Config System
local Settings = {
    Enabled = false,               -- Status Toggle Main
    AutoSwing = true,              -- Auto Swing Toggle
    Keybind = Enum.KeyCode.V,      -- Hotkey ON/OFF
    MaxReachDistance = 40,         -- Radius Deteksi Bola
    DashSpeed = 0.08,              -- Kecepatan Pergerakan
    PingOffsetMultiplier = 0.0015, -- Latency Compensation
}

-- References & Variables
local NetBoundaryZ = 0

-- ====================================================================
-- 1. UTILITY FUNCTIONS
-- ====================================================================

local function GetPing()
    local ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    return ping or 50
end

local function GetBall()
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name:find("Ball") or obj.Name:find("Shuttle") or obj.Name:find("Projectile")) then
            return obj
        end
    end
    return nil
end

local function LocateNet()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("net") or obj.Name:lower():find("jaring")) then
            return obj.Position.Z
        end
    end
    return 0
end

NetBoundaryZ = LocateNet()

-- ====================================================================
-- 2. ZONE CHECK & TRAJECTORY PREDICTION
-- ====================================================================

local function IsBallInMyZone(ballPos)
    local playerSide = HumanoidRootPart.Position.Z > NetBoundaryZ
    if playerSide then
        return ballPos.Z > NetBoundaryZ
    else
        return ballPos.Z < NetBoundaryZ
    end
end

local function PredictLandingPosition(ball)
    local velocity = ball.AssemblyLinearVelocity
    local position = ball.Position
    local ping = GetPing()
    
    local pingCompensation = velocity * (ping * Settings.PingOffsetMultiplier)
    return position + pingCompensation
end

local function PerformHit(ballHeight)
    if not Settings.AutoSwing then return end
    if ballHeight > (HumanoidRootPart.Position.Y + 6) then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Two, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Two, false, game)
    else
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.02)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    end
end

