-- ==========================================
-- [BAGIAN 5] FITUR UTAMA: AUTO COLLECT BEBAS FOLDER
-- ==========================================

local autoCollectBtn = Instance.new("TextButton")
autoCollectBtn.Name = "AutoCollectButton"
autoCollectBtn.Size = UDim2.new(0, 220, 0, 45)
autoCollectBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoCollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoCollectBtn.Text = "Auto Collect: OFF"
autoCollectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoCollectBtn.TextSize = 14
autoCollectBtn.Font = Enum.Font.SourceSansBold
autoCollectBtn.Parent = mainFrame

local autoCollectAktif = false
autoCollectBtn.MouseButton1Click:Connect(function()
    autoCollectAktif = not autoCollectAktif
    
    if autoCollectAktif then
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoCollectBtn.Text = "Auto Collect: ON"
        
        task.spawn(function()
            while autoCollectAktif do
                local karakter = game:GetService("Players").LocalPlayer.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    
                    local targetKetemu = nil
                    
                    -- Jelajahi isi Workspace untuk mencari objek yang bisa diambil
                    for _, obj in ipairs(workspace:GetChildren()) do
                        -- Pastikan BUKAN pemain, BUKAN kamera, dan BUKAN lantai (ArenaTiles)
                        if obj ~= karakter and obj.Name ~= "ArenaTiles" and obj.Name ~= "Terrain" then
                            
                            -- Jika bentuknya Model (biasanya item 3D melayang)
                            if obj:IsA("Model") then
                                local primaryPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                if primaryPart then
                                    -- Pastikan posisinya di atas tanah (tidak di dalam base/tycoon)
                                    targetKetemu = primaryPart
                                    break
                                end
                                
                            -- Jika bentuknya Part biasa yang ada TouchInterest-nya
                            elseif obj:IsA("BasePart") and obj:FindFirstChild("TouchInterest") then
                                targetKetemu = obj
                                break
                            end
                            
                        end
                    end
                    
                    -- Jika itemnya ketemu, langsung teleport badan ke sana!
                    if targetKetemu then
                        karakter.HumanoidRootPart.CFrame = targetKetemu.CFrame + Vector3.new(0, 3, 0) -- Teleport sedikit di atasnya biar aman
                    end
                    
                end
                task.wait(0.5)
            end
        end)
    else
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoCollectBtn.Text = "Auto Collect: OFF"
    end
end)
