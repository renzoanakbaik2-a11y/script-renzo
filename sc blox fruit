-- Loop Utama (Aman & Anti Lag)
RunService.RenderStepped:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local humanoidRootPart = character.HumanoidRootPart

    -- Auto Loot Aksesoris (Hapus item basic)
    if CONFIG.AutoLoot then
        pcall(function()
            for _, item in ipairs(player.Backpack:GetChildren()) do
                if item.Name:lower():find("basic") or item.Name:lower():find("common") then
                    item:Destroy()
                end
            end
        end)
    end

    -- Mencari Target Terdekat di Workspace
    local targetPart = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local name = obj.Name:lower()
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            local hum = obj:FindFirstChildOfClass("Humanoid")

            if root then
                if (CONFIG.AutoPortal and (name:find("portal") or name:find("cove") or name:find("dungeon"))) or
                   (CONFIG.AutoBoss and (name:find("boss") or name:find("skull"))) or
                   (CONFIG.AutoFarm and hum and hum.Health > 0) then
                    targetPart = root
                    break
                end
            end
        end
    end

    -- Eksekusi Teleport & Damage
    if targetPart then
        if (CONFIG.AutoFarm or CONFIG.AutoBoss or CONFIG.AutoPortal) and (humanoidRootPart.Position - targetPart.Position).Magnitude > 15 then
            humanoidRootPart.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 3, 0))
        end

        pcall(function()
            for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                if remote:IsA("RemoteEvent") and (remote.Name:lower():find("damage") or remote.Name:lower():find("hit")) then
                    remote:FireServer(999999999)
                end
            end
        end)
    end
end)

