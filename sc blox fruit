-- 3. LOGIKA AKTUASI TOOL MURNI (TANPA KURSOR / VIRTUAL CLICK)
local isRunning = false

local function PureToolActivate()
    local char = LocalPlayer.Character
    if not char then return end

    -- Ambil senjata dari Character
    local tool = char:FindFirstChildOfClass("Tool")
    
    -- Jika senjata berada di Backpack, otomatis equip
    if not tool then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            tool = backpack:FindFirstChildOfClass("Tool")
            if tool then
                tool.Parent = char
            end
        end
    end

    -- Pemicuan lansung tanpa memicu input mouse/screen cursor
    if tool then
        pcall(function()
            tool:Activate()
        end)
    end

    -- Pemulihan visibilitas UI secara berkala
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "SpeedHubStep1V22UI" then
            for _, frame in ipairs(gui:GetChildren()) do
                if frame:IsA("Frame") or frame:IsA("CanvasGroup") then
                    if not frame.Visible then
                        frame.Visible = true
                    end
                end
            end
        end
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        ToggleBtn.Text = "AUTO ATTACK: ON"
        
        task.spawn(function()
            while isRunning do
                StatusBox.Text = "Status: [v2.2] Pure Tool Attack Active..."
                PureToolActivate()
                task.wait(0.18)
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        ToggleBtn.Text = "AUTO ATTACK: OFF"
        StatusBox.Text = "Status: Dimatikan."
    end
end)
