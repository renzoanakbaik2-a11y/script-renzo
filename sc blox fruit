-- SISTEM CHEST
-- ==========================================
local function getPositionOfObj(obj)
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") and obj.PrimaryPart then
        return obj.PrimaryPart.Position
    elseif obj:FindFirstChildWhichIsA("BasePart") then
        return obj:FindFirstChildWhichIsA("BasePart").Position
    end
    return nil
end

local DeadChests = {}

local function getChestIslands()
    local allChests = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local nameLower = obj.Name:lower()
        if (nameLower:find("chest") or nameLower:find("peti") or nameLower:find("treasure")) and not DeadChests[obj] then
            local pos = getPositionOfObj(obj)
            if pos then
                table.insert(allChests, {Object = obj, Position = pos})
            end
        end
    end

    local islands = {}
    for _, chest in ipairs(allChests) do
        local placed = false
        for _, island in ipairs(islands) do
            if (island.Center - chest.Position).Magnitude < 400 then
                table.insert(island.Chests, chest)
                placed = true
                break
            end
        end
        if not placed then
            table.insert(islands, {
                Center = chest.Position,
                Chests = {chest}
            })
        end
    end
    return islands
end

-- ==========================================
-- BACKGROUND SYSTEM (NOTIFIKASI HANYA BUAH & AUTO FARM)
-- ==========================================
task.spawn(function()
    local lastCount = 0
    local collectedFruits = {}

    while task.wait(0.5) do
        if Settings.FruitNotifier then
            local fruitList = {}
            local targetFruitObj = nil
            local targetFruitHandle = nil

            for _, obj in ipairs(Workspace:GetDescendants()) do
                local isInsidePlayer = false
                local ancestor = obj.Parent
                while ancestor and ancestor ~= game do
                    if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then
                        isInsidePlayer = true
                        break
                    end
                    ancestor = ancestor.Parent
                end

                if not isInsidePlayer then
                    if (obj:IsA("Tool") or obj:IsA("Model")) and (obj:FindFirstChild("Handle") or obj.PrimaryPart or obj:IsA("Tool")) then
                        local nameLower = obj.Name:lower()
                        
                        -- Filter ketat agar HANYA MENDETEKSI BUAH SAJA (Mencegah pedang/senjata ikut terdeteksi)
                        local isRealFruit = false
                        local validFruitKeywords = {
                            "fruit", "blox", "rocket", "spin", "spring", "chop", "spike", "flame", 
                            "falcon", "ice", "sand", "dark", "diamond", "light", "rubber", "barrier", 
                            "ghost", "magma", "quake", "buddha", "love", "spider", "sound", "phoenix", 
                            "portal", "pain", "blizzard", "gravity", "mammoth", "trex", "dough", 
                            "shadow", "venom", "control", "spirit", "dragon", "leopard", "kitsune"
                        }
                        
                        for _, keyword in ipairs(validFruitKeywords) do
                            if nameLower:find(keyword) then
                                isRealFruit = true
                                break
                            end
                        end
                        
                        if isRealFruit and not nameLower:find("sword") and not nameLower:find("gun") and not nameLower:find("musket") and not nameLower:find("rifle") and not nameLower:find("cutlass") then
                            table.insert(fruitList, obj.Name)
                            
                            if not collectedFruits[obj] and targetFruitObj == nil then
                                targetFruitObj = obj
                                targetFruitHandle = obj:FindFirstChild("Handle") or (obj:IsA("Model") and obj.PrimaryPart) or obj:FindFirstChildWhichIsA("BasePart")
                            end
                        end
                    end
                end
            end
            
            local currentCount = #fruitList
            if currentCount > 0 then
                local combinedNames = table.concat(fruitList, ", ")
                NotifText.Text = "BUAH KETEMU: " .. combinedNames
                
                animateNotifIn()

                if currentCount > lastCount then
                    playFruitSound()
                end
                lastCount = currentCount

                if Settings.AutoTeleportFruit and targetFruitObj and targetFruitHandle then
                    local rootPart = getCharacterRootPart()
                    if rootPart then
                        smoothFlyTo(targetFruitHandle.CFrame, "AutoTeleportFruit")
                        collectedFruits[targetFruitObj] = true
                        
                        task.wait(0.5)
                        autoStoreFruits()
                        
                        task.wait(1)
                    end
                end
                
                task.wait(3)
                animateNotifOut()
            else
                collectedFruits = {}
                lastCount = 0
            end
        else
            animateNotifOut()
        end

        if Settings.AutoFlyChest then
            local rootPart = getCharacterRootPart()
            if rootPart then
                local islands = getChestIslands()
                if #islands == 0 then
                    DeadChests = {}
                    islands = getChestIslands()
                end
                for i = #islands, 1, -1 do
                    local validChests = {}
                    for _, cData in ipairs(islands[i].Chests) do
                        if cData.Object and cData.Object.Parent then
                            table.insert(validChests, cData)
                        end
                    end
                    islands[i].Chests = validChests
                    if #islands[i].Chests == 0 then
                        table.remove(islands, i)
                    end
                end
                if #islands > 0 then
                    table.sort(islands, function(a, b)
                        return (rootPart.Position - a.Center).Magnitude < (rootPart.Position - b.Center).Magnitude
                    end)
                    local currentIsland = islands[1]
                    if currentIsland and #currentIsland.Chests > 0 then
                        table.sort(currentIsland.Chests, function(a, b)
                            return (rootPart.Position - a.Position).Magnitude < (rootPart.Position - b.Position).Magnitude
                        end)
                        local targetChestData = currentIsland.Chests[1]
                        local targetChest = targetChestData.Object
                        local targetPos = getPositionOfObj(targetChest)
                        if targetPos and Settings.AutoFlyChest then
                            smoothFlyTo(CFrame.new(targetPos), "AutoFlyChest")
                            if targetChest then
                                DeadChests[targetChest] = true
                            end
                        end
                    end
                end
            end
        end

        if Settings.AutoFlyPlayer then
            local targetPlayer = nil
            if Settings.TargetPlayerName ~= "" then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and string.find(p.Name:lower(), Settings.TargetPlayerName:lower()) then
                        targetPlayer = p
                        break
                    end
                end
            else
                local shortestDist = math.huge
                local rootPart = getCharacterRootPart()
                if rootPart then
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local dist = (rootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                targetPlayer = p
                            end
                        end
                    end
                end
            end
            if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and Settings.AutoFlyPlayer then
                local rootPart = getCharacterRootPart()
                if rootPart then
                    smoothFlyTo(targetPlayer.Character.HumanoidRootPart.CFrame, "AutoFlyPlayer")
                end
            end
        end
    end
end)

