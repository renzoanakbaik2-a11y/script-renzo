-- FORCE EQUIP ITEM TO HAND
local function EquipToolFromBackpack()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local toolInHand = char:FindFirstChildOfClass("Tool")
    if toolInHand then return toolInHand end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChildOfClass("Tool")
        if tool then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(tool)
                task.wait(0.4)
                return tool
            end
        end
    end
    return nil
end

-- PEMBACA KODE 4-DIGIT DINAMIS
local function GetDoorCode()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Text then
            local txt = string.gsub(obj.Text, "%s+", "")
            if #txt == 4 and tonumber(txt) then
                return txt
            end
        end
    end
    return nil
end

-- URUTAN PUZZLE DENGAN AUTO-SHOOT PIGGY DI AKHIR
local SequenceKeywords = {
    {item = "hammer", target = "plank"},
    {item = "wrench", target = "generator"},
    {item = "keycard", target = "reader"},
    {item = "key", target = "door"},
    {item = "gear", target = "machine"},
    {item = "gun", target = "piggy"},
    {item = "crossbow", target = "piggy"}
}

-- FUNGSI TUNGGAL SEKALI KLIK EXECUTE
local function ExecuteCollectAndUseSequence()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, seq in ipairs(SequenceKeywords) do
        local itemKeyword = seq.item
        local targetKeyword = seq.target
        local itemFoundAndUsed = false

        for _, obj in pairs(Workspace:GetDescendants()) do
            if itemFoundAndUsed then break end
            
            if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
                local parentPart = obj.Parent
                if parentPart and parentPart:IsA("BasePart") and parentPart:IsDescendantOf(Workspace) then
                    local name = string.lower(parentPart.Name)
                    
                    if not UsedItems[parentPart] and name:find(itemKeyword) then
                        -- 1. Teleport Ambil Item
                        root.CFrame = parentPart.CFrame
                        task.wait(0.3)
                        
                        if obj:IsA("ClickDetector") then fireclickdetector(obj) end
                        if obj:IsA("ProximityPrompt") then fireproximityprompt(obj) end
                        
                        task.wait(0.5)
                        
                        -- 2. Force Equip Ke Tangan
                        local tool = EquipToolFromBackpack()
                        
                        -- 3. Teleport Langsung Pakai / Tembak Piggy
                        if tool then
                            if itemKeyword == "gun" or itemKeyword == "crossbow" then
                                for _, piggyObj in pairs(Workspace:GetDescendants()) do
                                    if (piggyObj.Name == "Piggy" or piggyObj:FindFirstChild("Piggy")) and piggyObj:FindFirstChild("HumanoidRootPart") then
                                        root.CFrame = CFrame.lookAt(piggyObj.HumanoidRootPart.Position + Vector3.new(0, 0, 12), piggyObj.HumanoidRootPart.Position)
                                        task.wait(0.3)
                                        tool:Activate()
                                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                        break
                                    end
                                end
                            else
                                for _, targetObj in pairs(Workspace:GetDescendants()) do
                                    if targetObj:IsA("ClickDetector") or targetObj:IsA("ProximityPrompt") then
                                        local targetPart = targetObj.Parent
                                        if targetPart and targetPart:IsA("BasePart") and targetPart:IsDescendantOf(Workspace) then
                                            local targetName = string.lower(targetPart.Name)
                                            if targetName:find(targetKeyword) or targetName:find("door") or targetName:find("lock") or targetName:find("padlock") then
                                                root.CFrame = targetPart.CFrame + (targetPart.CFrame.LookVector * 2.5)
                                                task.wait(0.3)
                                                
                                                if targetObj:IsA("ClickDetector") then fireclickdetector(targetObj) end
                                                if targetObj:IsA("ProximityPrompt") then fireproximityprompt(targetObj) end
                                                
                                                task.wait(0.4)
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                        
                        UsedItems[parentPart] = true
                        itemFoundAndUsed = true
                        
                        root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
                        task.wait(0.3)
                    end
                end
            end
        end
    end

    -- SUBMIT KODE PINTU KEYPAD OTOMATIS
    if not CodeSubmitted then
        local doorCode = GetDoorCode()
        if doorCode then
            for _, obj in pairs(Workspace:GetDescendants()) do
                local name = string.lower(obj.Name)
                if name:find("keypad") or name:find("code") or name:find("pad") then
                    local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector")
                    if prompt then
                        root.CFrame = obj.CFrame * CFrame.new(0, 0, -2)
                        task.wait(0.4)
                        if prompt:IsA("ClickDetector") then fireclickdetector(prompt) end
                        if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
                        
                        for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                            if remote:IsA("RemoteEvent") then
                                local rName = string.lower(remote.Name)
                                if rName:find("code") or rName:find("keypad") or rName:find("pad") then
                                    remote:FireServer(doorCode)
                                end
                            end
                        end
                        CodeSubmitted = true
                        root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
                        break
                    end
                end
            end
        end
    end
end

