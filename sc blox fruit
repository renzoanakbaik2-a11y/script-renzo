-- 3. DETEKSI BOLA / TELUR TERDEKAT
local function cariTelur(hrp)
	local target = nil
	local minJarak = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			local nama = obj.Name:lower()
			if nama:find("egg") or nama:find("telur") then
				local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")) or obj
				if part then
					local jarak = (part.Position - hrp.Position).Magnitude
					if jarak < minJarak then
						minJarak = jarak
						target = part
					end
				end
			end
		end
	end
	return target
end

-- 4. SIMPAN ZONA AMAN (KANAN GARIS MERAH)
BtnSafe.MouseButton1Click:Connect(function()
	local char = LocalPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		safeCFrame = char.HumanoidRootPart.CFrame
		BtnSafe.Text = "ZONA AMAN TERSIMPAN!"
		BtnSafe.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
		Status.Text = "Status: Siap Aktifkan Bot"
		Status.TextColor3 = Color3.fromRGB(100, 255, 150)
	end
end)

-- 5. EKSEKUSI AUTOMATIS INSTANT STEAL
BtnToggle.MouseButton1Click:Connect(function()
	isAutoSteal = not isAutoSteal
	
	if isAutoSteal then
		if not safeCFrame then
			Status.Text = "Klik tombol biru dulu!"
			Status.TextColor3 = Color3.fromRGB(255, 100, 100)
			isAutoSteal = false
			return
		end
		
		BtnToggle.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
		BtnToggle.Text = "INSTANT STEAL: ON"
		
		task.spawn(function()
			while isAutoSteal do
				local char = LocalPlayer.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local hrp = char.HumanoidRootPart
					local telur = cariTelur(hrp)
					
					if telur then
						-- Teleport langsung nempel ke telur
						hrp.CFrame = telur.CFrame * CFrame.new(0, 1, 0)
						task.wait(0.02)
						
						-- Trigger Sentuhan (TouchInterest)
						if firetouchinterest then
							firetouchinterest(hrp, telur, 0)
							firetouchinterest(hrp, telur, 1)
						end
						
						-- Trigger ProximityPrompt jika ada
						for _, prompt in ipairs(telur:GetDescendants()) do
							if prompt:IsA("ProximityPrompt") and fireproximityprompt then
								fireproximityprompt(prompt)
							end
						end
						
						-- Instan Teleport Balik ke Zona Aman (Kanan Garis Merah)
						hrp.CFrame = safeCFrame
						Status.Text = "Status: Curi [" .. telur.Name .. "] -> Aman!"
						Status.TextColor3 = Color3.fromRGB(100, 255, 150)
					else
						Status.Text = "Status: Mencari telur di arena..."
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
					end
				end
				task.wait(0.1)
			end
		end)
	else
		BtnToggle.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		BtnToggle.Text = "INSTANT STEAL: OFF"
		Status.Text = "Status: Off"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
