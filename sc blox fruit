-- ==========================================
-- FUNGSI DASAR KARAKTER & TERBANG (KREDIT KAMERA DIAM & PULIH SETELAH SAMPAI)
-- ==========================================
local function getCharacterRootPart()
	local character = LocalPlayer.Character
	if character then
		return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	end
	return nil
end

-- Fungsi Terbang Mulus: Kamera Terkunci di Posisi Awal, Baru Normal Lagi Setelah Sampai
local function smoothFlyTo(targetCFrame)
	local rootPart = getCharacterRootPart()
	if not rootPart then return end

	local currentSpeed = Settings.FlightSpeed
	if currentSpeed > 1000 then currentSpeed = 1000 end
	if currentSpeed < 50 then currentSpeed = 50 end

	local distance = (rootPart.Position - targetCFrame.Position).Magnitude
	local duration = distance / currentSpeed
	if duration < 0.05 then return end

	local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.PlatformStand = true
	end

	-- Simpan posisi & orientasi kamera tepat sebelum terbang agar tidak gerak/liar
	local savedCameraCFrame = Camera.CFrame
	Camera.CameraType = Enum.CameraType.Scriptable

	-- Lock posisi kamera agar diam total selama perjalanan
	local camLockConnection = game:GetService("RunService").RenderStepped:Connect(function()
		Camera.CFrame = savedCameraCFrame
	end)

	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	
	tween:Play()
	tween.Completed:Wait()

	-- Lepaskan kunci kamera setelah sampai di tujuan
	if camLockConnection then
		camLockConnection:Disconnect()
	end

	-- Kembalikan kamera ke mode normal (Custom)
	Camera.CameraType = Enum.CameraType.Custom
	if humanoid then
		humanoid.PlatformStand = false
	end
end


-- ==========================================
-- BACKGROUND SYSTEM (SCANNER BUAH, CHEST, PLAYER DENGAN DELAY)
-- ==========================================
task.spawn(function()
	local lastCount = 0
	while task.wait(2) do
		-- 1. Scan Buah
		if Settings.FruitNotifier then
			local fruitList = {}
			local targetFruitHandle = nil

			for _, obj in ipairs(Workspace:GetChildren()) do
				if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
					table.insert(fruitList, obj.Name)
					if not targetFruitHandle then
						targetFruitHandle = obj.Handle
					end
				end
			end
			
			local currentCount = #fruitList
			if currentCount > 0 then
				local combinedNames = table.concat(fruitList, ", ")
				NotifText.Text = "KETEMU (" .. currentCount .. "): " .. combinedNames
				if currentCount > lastCount then
					playFruitSound()
				end
				lastCount = currentCount

				if Settings.AutoTeleportFruit and targetFruitHandle then
					local rootPart = getCharacterRootPart()
					if rootPart and (rootPart.Position - targetFruitHandle.Position).Magnitude > 15 then
						smoothFlyTo(targetFruitHandle.CFrame)
					end
				end
			else
				NotifText.Text = "Status: Mencari Buah di Map (Kosong)..."
				lastCount = 0
			end
		end

		-- 2. Auto Terbang ke SEMUA Chest / Peti
		if Settings.AutoFlyChest then
			local chestsFound = false
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if not Settings.AutoFlyChest then break end
				if (obj.Name:lower():find("chest") or obj.Name:lower():find("peti")) and obj:IsA("BasePart") then
					chestsFound = true
					local rootPart = getCharacterRootPart()
					if rootPart then
						smoothFlyTo(obj.CFrame)
						task.wait(0.1)
					end
				end
			end
			if chestsFound then
				task.wait(1)
			end
		end

		-- 3. Auto Terbang ke Player (Dengan Delay, Nama Spesifik atau Terdekat)
		if Settings.AutoFlyPlayer then
			task.wait(3) -- Delay sebelum mengeksekusi perpindahan ke player agar tidak langsung ngebut
			local targetPlayer = nil

			-- Cek apakah user mengisi target nama player di settings
			if Settings.TargetPlayerName ~= "" then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and string.find(p.Name:lower(), Settings.TargetPlayerName:lower()) then
						targetPlayer = p
						break
					end
				end
			else
				-- Jika kosong, pilih player terdekat
				local shortestDist = math.huge
				local rootPart = getCharacterRootPart()
				if rootPart then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
							local dist = (rootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
							if dist < shortestDist then
								shortestDist = dist
								targetPlayer = p
							end
						end
					end
				end
			end

			-- Jika target ditemukan, terbang ke player tersebut
			if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local rootPart = getCharacterRootPart()
				if rootPart then
					smoothFlyTo(targetPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0))
					task.wait(2)
				end
			end
		end
	end
end)


-- ==========================================
-- AUTO JOIN TEAM
-- ==========================================
local function joinTeam()
	if not Settings.AutoJoinEnabled then return end
	pcall(function()
		local ReplicatedStorage = game:GetService("ReplicatedStorage")
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		if remotes and remotes:FindFirstChild("CommF_") then
			remotes.CommF_:InvokeServer("SetTeam", Settings.SelectedTeam)
		end
	end)
end

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(2)
	joinTeam()
end)
task.spawn(function()
	task.wait(1)
	joinTeam()
end)


-- ==========================================
-- FPS BOOST
-- ==========================================
local function applyFpsBoost(state)
	if state then
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 999999
		for _, v in ipairs(Workspace:GetDescendants()) do
			if v:IsA("BasePart") then
				v.Material = Enum.Material.SmoothPlastic
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") then
				v.Transparency = 1
			end
		end
	else
		Lighting.GlobalShadows = true
	end
end
if Settings.FpsBoost then applyFpsBoost(true) end


