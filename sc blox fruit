-- Fungsi Menampilkan Isi Folder di Kolom Kanan
local function openFolder(parentFolder, blockName)
    for _, child in pairs(RightScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    StatusLabel.Text = "Folder dari blok [" .. blockName .. "]:\n-> " .. parentFolder.Name
    
    local count = 0
    for _, item in pairs(parentFolder:GetChildren()) do
        count = count + 1
        local itemBtn = Instance.new("TextButton")
        itemBtn.Size = UDim2.new(1, -6, 0, 26)
        itemBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        itemBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
        itemBtn.Font = Enum.Font.Code
        itemBtn.TextSize = 10
        itemBtn.Text = item.Name .. " (" .. item.ClassName .. ")"
        itemBtn.TextXAlignment = Enum.TextXAlignment.Left
        itemBtn.Parent = RightScroll
        Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)
    end
    RightScroll.CanvasSize = UDim2.new(0, 0, 0, count * 30)
end

-- Fungsi Scan Utama
local function scanBlocks()
    for _, child in pairs(LeftScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, child in pairs(RightScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    ESPBoxFolder:ClearAllChildren()
    
    local count = 0
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name then
            count = count + 1
            
            local blockBtn = Instance.new("TextButton")
            blockBtn.Size = UDim2.new(1, -6, 0, 26)
            blockBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            blockBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
