-- ==============================================================================
-- RACKET RIVALS: ADVANCED NET-CROSSING & AUTO HIT/TELEPORT SCRIPT
-- Logika: Teleport ke bola SAAT bola melewati net (menyeberang ke area kita)
-- ==============================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local CONFIG_FILE_NAME = "RacketRivals_NetLogicSettings.json"

local CONFIG = {
    AutoHitEnabled = false,
    AutoTeleportEnabled = false,
    HitDistance = 15,
    TeleportOffset = {0, 3, -2} -- Posisi pas di belakang/bawah bola
}

-- Sistem Save & Load Pengaturan
local function saveSettings()
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(CONFIG)
    end)
    if success and writefile then
        pcall(function() writefile(CONFIG_FILE_NAME, encoded) end)
    end
end

local function loadSettings()
    if readfile and pcall(function() return readfile(CONFIG_FILE_NAME) end) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE_NAME))
        end)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                CONFIG[k] = v
            end
        end
    end
end

loadSettings()

