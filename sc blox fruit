local HighlightFolder = Instance.new("Folder", ScreenGui)
HighlightFolder.Name = "SafeHighlights"

-- Logika Scan Aman (Menggunakan pcall agar tidak pernah error/crash)
ScanBtn.MouseButton1Click:Connect(function()
    ScanBtn.Text = "MEMINDAI..."
    ScanBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    
    pcall(function()
        for _, child in pairs(ScrollFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        HighlightFolder:ClearAllChildren()
        
        local count = 0
        for _, obj in pairs(workspace:GetChildren()) do
            if obj and obj.Name and (obj:IsA("BasePart") or obj:IsA("Model")) then
                count = count + 1
                
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -6, 0, 28)
                btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
                btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                btn.Font = Enum.Font.Code
                btn.TextSize = 10
                btn.Text = "📁 " .. obj.Name .. " [" .. obj.ClassName .. "]"
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = ScrollFrame
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
                
                btn.MouseButton1Click:Connect(function()
                    HighlightFolder:ClearAllChildren()
                    pcall(function()
                        local box = Instance.new("SelectionBox")
                        box.Adornee = obj
                        box.Color3 = Color3.fromRGB(0, 255, 128)
                        box.LineThickness = 0.1
                        box.Parent = HighlightFolder
                    end)
                    StatusLabel.Text = "Terpilih: " .. obj.Name .. " (Parent: " .. tostring(obj.Parent) .. ")"
                end)
            end
        end
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 32)
        StatusLabel.Text = "Scan Berhasil! Ditemukan " .. count .. " objek utama."
    end)
    
    ScanBtn.Text = "🔄 SCAN OBJEK SEKITAR"
    ScanBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
end)

