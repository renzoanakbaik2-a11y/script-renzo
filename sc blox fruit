local keywords = {"key", "plank", "wrench", "gear", "card", "code", "candle", "bone", "gun", "bullet"}
local retryAfter = setmetatable({}, {__mode = "k"})
local function getPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart end
    local handle = obj:FindFirstChild("Handle", true)
    if handle and handle:IsA("BasePart") then return handle end
    return obj:FindFirstChildWhichIsA("BasePart", true)
end
local function characterReady()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    return char, root, hum
end
local function belongsToPlayer(obj)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and obj:IsDescendantOf(player.Character) then return true end
    end
    return false
end
local function findTarget(root)
    local best, bestPart, bestDistance
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart") or obj:IsA("Tool"))
            and (retryAfter[obj] or 0) <= os.clock() and not belongsToPlayer(obj) then
            local name = obj.Name:lower()
            local matched = false
            for _, word in ipairs(keywords) do
                if name:find(word, 1, true) then matched = true; break end
            end
            if matched and not name:find("door") and not name:find("gate") and not name:find("lock") then
                local part = getPart(obj)
                if part then
                    local distance = (root.Position - part.Position).Magnitude
                    if not bestDistance or distance < bestDistance then
                        best, bestPart, bestDistance = obj, part, distance
                    end
                end
            end
        end
    end
    return best, bestPart
end
local function toolSet(char)
    local result = {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    for _, container in ipairs({char, backpack}) do
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Tool") then result[obj] = true end
        end
    end
    return result
end
local function interact(target, part, root)
    local detector = target:FindFirstChildWhichIsA("ClickDetector", true)
        or part:FindFirstChildOfClass("ClickDetector")
    if not detector and part.Parent then detector = part.Parent:FindFirstChildOfClass("ClickDetector") end
    if detector then
        if type(fireclickdetector) ~= "function" then
            return false, "fireclickdetector tidak tersedia; klik item secara manual."
        end
        fireclickdetector(detector)
        return true, "Klik dicoba"
    end
    local touch = target:FindFirstChildWhichIsA("TouchTransmitter", true)
    local touchPart = touch and touch.Parent
    if touchPart and touchPart:IsA("BasePart") then
        if type(firetouchinterest) ~= "function" then
            return false, "firetouchinterest tidak tersedia."
        end
        firetouchinterest(root, touchPart, 0)
        task.wait()
        firetouchinterest(root, touchPart, 1)
        return true, "Sentuhan dicoba"
    end
    return false, "Interaksi item tidak dikenali; coba klik manual."
end
local function attempt()
    local char, root = characterReady()
    if not char then status("Menunggu karakter hidup..."); return end
    local target, part = findTarget(root)
    if not target then status("Tidak ada kandidat item. Nama/struktur item mungkin berbeda, atau masih cooldown."); return end
    retryAfter[target] = os.clock() + 10
    status("Target: " .. target.Name)
    print("[Collect] Target:", target:GetFullName(), "Part:", part:GetFullName())
    local before = toolSet(char)
    if not Settings.AutoEscape or not part:IsDescendantOf(Workspace) then return end
    root.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    task.wait(0.25)
    if not Settings.AutoEscape or LocalPlayer.Character ~= char or not root.Parent then return end
    if not part:IsDescendantOf(Workspace) then status("Target sudah hilang sebelum interaksi."); return end
    if (root.Position - part.Position).Magnitude > 12 then
        status("Posisi tidak bertahan dekat item; teleport belum berhasil.")
        task.wait(1)
        return
    end
    local invoked, detail = interact(target, part, root)
    if not invoked then status(detail); task.wait(1.5); return end
    local deadline = os.clock() + 2
    repeat
        if not Settings.AutoEscape or LocalPlayer.Character ~= char then return end
        for tool in pairs(toolSet(char)) do
            if not before[tool] then
                status("Tool baru terdeteksi: " .. tool.Name)
                retryAfter[target] = os.clock() + 30
                task.wait(1)
                return
            end
        end
        task.wait(0.1)
    until os.clock() >= deadline
    status(detail .. "; belum ada Tool baru. Pengambilan belum terkonfirmasi.")
    task.wait(1)
end
task.spawn(function()
