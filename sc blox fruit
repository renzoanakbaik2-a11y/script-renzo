-- FUNGSI INSPEKSI HIRARKI (INDUK & ISI)
local function PerformSearch(query)
    -- Bersihkan hasil lama
    for _, child in ipairs(Scroll:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    if query == "" then return end
    local cleanQuery = query:lower()

    local targetsToScan = {
        Workspace,
        ReplicatedStorage,
        PlayerGui
    }

    local matchCount = 0

    for _, rootLocation in ipairs(targetsToScan) do
        for _, obj in ipairs(rootLocation:GetDescendants()) do
            local nameMatch = obj.Name:lower():find(cleanQuery, 1, true)
            local textMatch = false

            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                if obj.Text and obj.Text:lower():find(cleanQuery, 1, true) then
                    textMatch = true
                end
            end

            if nameMatch or textMatch then
                matchCount = matchCount + 1
                if matchCount > 50 then break end -- Batasi 50 hasil agar tidak lag

                local Card = Instance.new("Frame")
                Card.Size = UDim2.new(1, -8, 0, 65)
                Card.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
                Card.Parent = Scroll

                local CardCorner = Instance.new("UICorner")
                CardCorner.CornerRadius = UDim.new(0, 4)
                CardCorner.Parent = Card

                local InfoText = Instance.new("TextLabel")
                InfoText.Size = UDim2.new(1, -10, 1, -10)
                InfoText.Position = UDim2.new(0, 5, 0, 5)
                InfoText.BackgroundTransparency = 1
                InfoText.TextColor3 = Color3.fromRGB(220, 220, 230)
                InfoText.Font = Enum.Font.Code
                InfoText.TextSize = 9
                InfoText.TextXAlignment = Enum.TextXAlignment.Left
                InfoText.TextYAlignment = Enum.TextYAlignment.Top
                InfoText.TextWrapped = true

                local parentName = obj.Parent and obj.Parent.Name or "GAK ADA (ROOT)"
                local fullPath = obj:GetFullName()
                local extraInfo = ""

                if obj:IsA("StringValue") or obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("BoolValue") then
                    extraInfo = " | Value: " .. tostring(obj.Value)
                elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    extraInfo = " | Text: '" .. tostring(obj.Text) .. "'"
                end

                InfoText.Text = "📌 OBJEK: " .. obj.Name .. " (" .. obj.ClassName .. ")" .. extraInfo ..
                                "\n👨‍👦 INDUK (PARENT): " .. parentName ..
                                "\n📂 PATH: " .. fullPath

                InfoText.Parent = Card
            end
        end
        if matchCount > 50 then break end
    end

    if matchCount == 0 then
        local EmptyCard = Instance.new("TextLabel")
        EmptyCard.Size = UDim2.new(1, 0, 0, 30)
        EmptyCard.BackgroundTransparency = 1
        EmptyCard.Text = "Tidak ditemukan objek dengan kata kunci '" .. query .. "'"
        EmptyCard.TextColor3 = Color3.fromRGB(255, 100, 100)
        EmptyCard.Font = Enum.Font.SourceSans
        EmptyCard.TextSize = 11
        EmptyCard.Parent = Scroll
    end

    task.wait(0.05)
    Scroll.CanvasSize = UDim2.new(0, 0, 0, ScrollLayout.AbsoluteContentSize.Y + 10)
end

SearchBtn.MouseButton1Click:Connect(function()
    PerformSearch(SearchBox.Text)
end)

SearchBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        PerformSearch(SearchBox.Text)
    end
