-- Pengaturan Fitur
local CONFIG = {
    AutoFarm = false,
    AutoBoss = false,
    AutoPortal = false,
    AutoLoot = true
}

local function addToggle(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.Text = text .. ": OFF"
    btn.Parent = MainFrame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        callback(state)
    end)
end

addToggle("Auto Farm Musuh", 45, function(v) CONFIG.AutoFarm = v end)
addToggle("Auto Boss Killer", 90, function(v) CONFIG.AutoBoss = v end)
addToggle("Auto Portal Dungeon", 135, function(v) CONFIG.AutoPortal = v end)
addToggle("Auto Loot Aksesoris", 180, function(v) CONFIG.AutoLoot = v end)

