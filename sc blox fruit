-- LOGIKA REVISI TOTAL: AMBIL ITEM DAN GUNAKAN KE PINTU/OBJEK
local function CollectAndUseItem(itemKeyword, targetKeyword)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Pengecekan awal ketersediaan item
    local currentTool = char:FindFirstChildOfClass("Tool") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
    
    -- Langkah 1: Ambil Item dari Map jika belum ada di inventori
    if not currentTool then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
                local parentPart = obj.Parent
                if parentPart and parentPart:IsA("BasePart") and parentPart:IsDescendantOf(Workspace) then
                    local name = string.lower(parentPart.Name)
                    if name:find(itemKeyword) then
                        root.CFrame = parentPart.CFrame
                        task.wait(0.3)
                        
                        if obj:IsA("ClickDetector") then fireclickdetector(obj) end
                        if obj:IsA("ProximityPrompt") then fireproximityprompt(obj) end
                        
                        task.wait(0.5)
                        break
                    end
                end
            end
        end
    end

    -- Langkah 2: Paksa Pasang Item ke Tangan
    currentTool = EquipToolFromBackpack()

    -- Langkah 3: Eksekusi Penggunaan Item ke Pintu / Gembok Target
    if currentTool then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("ClickDetector") or obj:IsA("ProximityPrompt") then
                local targetPart = obj.Parent
                if targetPart and targetPart:IsA("BasePart") and targetPart:IsDescendantOf(Workspace) then
                    local targetName = string.lower(targetPart.Name)
                    if targetName:find(targetKeyword) or targetName:find("door") or targetName:find("lock") or targetName:find("padlock") then
                        -- Teleport presisi tepat di depan objek target
                        root.CFrame = targetPart.CFrame + (targetPart.CFrame.LookVector * 2.5)
                        task.wait(0.3)
                        
                        if obj:IsA("ClickDetector") then fireclickdetector(obj) end
                        if obj:IsA("ProximityPrompt") then fireproximityprompt(obj) end
                        
                        task.wait(0.4)
                        break
                    end
                end
            end
        end
    end

    -- Langkah 4: Kembali Melayang Aman di Udara
    root.CFrame = root.CFrame * CFrame.new(0, 14, 0)
end

