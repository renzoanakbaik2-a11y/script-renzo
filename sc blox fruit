local function CreateToggleButton(text, positionY, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Position = UDim2.new(0, 15, 0, positionY)
    btn.Size = UDim2.new(0, 230, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
    btn.Font = Enum.Font.SourceSansSemibold
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(255, 85, 85)
    btn.TextSize = 14
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            btn.Text = text .. ": ON"
            btn.TextColor3 = Color3.fromRGB(85, 255, 127)
            btn.BackgroundColor3 = Color3.fromRGB(50, 70, 60)
        else
            btn.Text = text .. ": OFF"
            btn.TextColor3 = Color3.fromRGB(255, 85, 85)
            btn.BackgroundColor3 = Color3.fromRGB(40, 45, 55)
        end
        callback(state)
    end)
    return btn
end

