--// Animasi Membuka/Menutup Menu (Smooth & Natural)
local isMenuOpen = false
local function ToggleMenuAnimation()
    if not isMenuOpen then
        isMenuOpen = true
        MainFrame.Visible = true
        MainFrame.Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 0)
        local targetSize = GetSizeDimensions(Settings.MenuSize)
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = targetSize}):Play()
    else
        isMenuOpen = false
        local tweenClose = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 0)})
        tweenClose:Play()
        tweenClose.Completed:Connect(function()
            if not isMenuOpen then
                MainFrame.Visible = false
            end
        end)
    end
end

OpenButton.MouseButton1Click:Connect(ToggleMenuAnimation)
