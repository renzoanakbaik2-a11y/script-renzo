end)

-- MAIN FARMING LOOP (FULL STABILITY & ZERO STUCK)
task.spawn(function()
    while true do
        task.wait(0.03)
        if Settings.AutoFarm then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 10 then
                DisableGravity(root)

                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    local targetMob = nil

                    -- Tahap 1: Cari mob di sekitar radius player
                    for _, mob in pairs(enemies:GetChildren()) do
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        local mRoot = mob:FindFirstChild("HumanoidRootPart")
                        if mHum and mHum.Health > 0 and mRoot then
                            if (mRoot.Position - root.Position).Magnitude <= Settings.MagnetRadius then
                                targetMob = mob
                                break
                            end
                        end
                    end

                    -- Tahap 2: Fallback ke mob mana saja jika di area sekitar kosong
                    if not targetMob then
                        for _, mob in pairs(enemies:GetChildren()) do
                            local mHum = mob:FindFirstChildOfClass("Humanoid")
                            local mRoot = mob:FindFirstChild("HumanoidRootPart")
                            if mHum and mHum.Health > 0 and mRoot then
                                targetMob = mob
                                break
                            end
                        end
                    end

                    if targetMob then
                        local targetRoot = targetMob.HumanoidRootPart
                        local centerPos = targetRoot.Position
                        
                        root.CFrame = CFrame.lookAt(centerPos + Vector3.new(0, Settings.FarmDistance, 0), centerPos)

                        -- LOGIKA BRING MOB REAL
                        for _, mob in pairs(enemies:GetChildren()) do
                            local mHum = mob:FindFirstChildOfClass("Humanoid")
                            local mRoot = mob:FindFirstChild("HumanoidRootPart")

                            if mHum and mHum.Health > 0 and mRoot then
                                if (mRoot.Position - centerPos).Magnitude <= Settings.MagnetRadius then
                                    for _, mPart in pairs(mob:GetChildren()) do
                                        if mPart:IsA("BasePart") then
                                            mPart.CanCollide = false
                                        end
                                    end
                                    
                                    mRoot.CFrame = CFrame.new(centerPos)
                                    mRoot.Velocity = Vector3.new(0, 0, 0)
                                    mRoot.RotVelocity = Vector3.new(0, 0, 0)
                                    mHum.WalkSpeed = 0
                                end
                            end
                        end

                        -- Trigger Attack
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end
                end
            end
        else
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then EnableGravity(root) end
        end
    end
end)
