--// Fungsi Deteksi Pulau
local function GetIslandName(pos)
    if pos.Z > 20000 then
        return "Third Sea Island"
    elseif pos.Z < -10000 and pos.Z > -30000 then
        return "Second Sea Island"
    else
        return "First Sea Island / Main Area"
    end
end

--// Notifikasi Dinamis dengan Animasi Smooth & Rainbow Border
local function ShowDynamicPopup(titleText, isFound)
    pcall(function()
        local popupGui = Instance.new("ScreenGui")
        popupGui.Name = "FruitDynamicNotification"
        popupGui.Parent = CoreGui
        
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 460, 0, 50)
        frame.Position = UDim2.new(0.5, -230, 0, -80)
        frame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
        frame.Parent = popupGui
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = frame
        
        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 2.5
        stroke.Parent = frame
        
        -- Animasi Rainbow Berjalan Mulus
        local runConn
        local hue = 0
        runConn = RunService.RenderStepped:Connect(function(dt)
            hue = (hue + dt * 0.4) % 1
            stroke.Color = Color3.fromHSV(hue, 1, 1)
        end)
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -20, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = isFound and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        label.TextSize = 14
        label.Font = Enum.Font.SourceSansBold
        label.Text = titleText
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.Parent = frame
        
        -- Animasi Masuk Smooth (Bounce Out Elegan)
        local tweenIn = TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Bounce, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -230, 0, 30)})
        tweenIn:Play()
        
        task.delay(3.5, function()
            if runConn then runConn:Disconnect() end
            -- Animasi Keluar Smooth
            local tweenOut = TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -230, 0, -80)})
            tweenOut:Play()
            tweenOut.Completed:Connect(function()
                popupGui:Destroy()
            end)
        end)
    end)
end

--// Filter Validasi Buah (Memastikan Buah Asli Spawn di Map, Bukan NPC/Dealer)
local function IsValidRealFruit(obj)
    if not obj or not obj.Parent then return false end
    
    if not obj.Name:find("Fruit") then return false end
    
    local ancestor = obj.Parent
    while ancestor and ancestor ~= Workspace do
        if ancestor:IsA("Player") or ancestor.Name:find("Shop") or ancestor.Name:find("Dealer") or ancestor.Name:find("Storage") or ancestor.Name:find("Inventory") then
            return false
        end
        ancestor = ancestor.Parent
    end
    
    if ancestor ~= Workspace then return false end
    return true
end

