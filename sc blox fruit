-- ==========================================================
-- FUNGSI PENCARIAN BUAH (Cek Terus, Baru/Lama Ketemu Langsung Ambil)
-- ==========================================================
local function findFruit()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("Tool") and (obj.Name:find("Fruit") or obj:FindFirstChild("Handle")) then
			return obj
		end
	end
	return nil
end

-- ==========================================================
-- LOGIKA UTAMA SERVER HOP & PENCARIAN SERVER AMAN (ANTI FULL SERVER)
-- ==========================================================
local function hopToNewServer()
	if not config.autoHopActive then return end
	
	print("[Blox Fruits] Mencari server publik alternatif...")
	local success, result = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
		return HttpService:JSONDecode(game:HttpGet(url))
	end)

	if success and result and result.data then
		local servers = {}
		for _, server in ipairs(result.data) do
			-- Pastikan server belum penuh dan bukan server saat ini
			if server.playing < server.maxPlayers and server.id ~= game.JobId then
				table.insert(servers, server.id)
			end
		end

		if #servers > 0 then
			local randomServerId = servers[math.random(1, #servers)]
			TeleportService:TeleportToPlaceInstance(placeId, randomServerId, player, { autoHop = true })
		else
			-- Jika daftar server habis/penuh, tunggu sebentar lalu ulangi lagi pencarian server
			task.wait(SEARCH_DELAY)
			hopToNewServer()
		end
	else
		-- Jika gagal mengambil API, coba ulang lagi sampai dapat
		task.wait(SEARCH_DELAY)
		hopToNewServer()
	end
end

local function startMainLoop()
	task.spawn(function()
		task.wait(2)
		autoSelectTeam()

		while true do
			if not config.autoHopActive then
				task.wait(1)
				continue
			end

			-- Cek apakah ada buah di server (Baik baru join maupun sudah lama)
			if config.fruitFinderActive then
				local detectedFruit = findFruit()
				if detectedFruit then
					print("========================================")
					print("[SUKSES] Buah Ditemukan: " .. detectedFruit.Name .. "!")
					print("Auto Hop Dihentikan. Karakter diam & teleport ke buah.")
					print("========================================")
					
					-- Matikan Auto Hop agar diam di server ini
					config.autoHopActive = false
					saveConfig()
					
					ToggleHopBtn.Text = "Auto Hop: OFF (Buah Ketemu)"
					ToggleHopBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
					
					-- Teleport instan ke dekat buah
					if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
						local handle = detectedFruit:FindFirstChild("Handle") or detectedFruit:FindFirstChildWhichIsA("BasePart")
						if handle then
							player.Character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 5, 0)
						end
					end
					break
				end
			end

			-- Jika tidak ada buah dan Auto Hop aktif, pindah server
			print("[Blox Fruits] Tidak ada buah. Melakukan Auto Hop ke server lain...")
			hopToNewServer()
			break
		end
	end)
end

