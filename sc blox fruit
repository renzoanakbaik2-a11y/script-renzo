end)

-- CONTINUOUS LOOP (RenderStepped)
RunService.RenderStepped:Connect(function()
    if not isSpamActive then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    if not isZoneLocked then
        CreateSensorZone()
    end

    local targetPart = GetBallInZone()

    if targetPart then
        StatusText.Text = "Status: SPAMMING HIT ON BALL!"

        -- 1. Teleport nempel terus ke posisi X, Z bola saat itu juga
        local ballPos = targetPart.Position
        HRP.CFrame = CFrame.new(Vector3.new(ballPos.X, HRP.Position.Y, ballPos.Z), Vector3.new(ballPos.X, HRP.Position.Y, ballPos.Z))

        -- 2. Spam pukul tanpa jeda!
        FastSpamClick()
    else
        StatusText.Text = "Status: Waiting Ball in Zone..."
    end
end)
