-- ==============================================================================
-- PENCARIAN OBJEK BOLA / KOK (DENGAN DETEKSI POSISI NET)
-- ==============================================================================
local function findBallAndNetStatus()
    local targetBall = nil
    local isCrossedNet = false
    local shortestDistance = math.huge
    
    -- Mencari letak Net secara otomatis di lapangan untuk acuan batas
    local netPositionZ = 0
    local foundNet = false
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(string.lower(obj.Name), "net") then
            netPositionZ = obj.Position.Z
            foundNet = true
            break
        end
    end

    -- Memindai objek bola/kok di seluruh Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "shuttle") or string.find(nameLower, "ball") or string.find(nameLower, "kok") then
                if not obj:IsDescendantOf(character) then
                    local distance = (humanoidRootPart.Position - obj.Position).Magnitude
                    
                    -- Logika Penentu Apakah Bola Sudah Lewat Batas Net ke Area Kita
                    -- (Bergantung pada posisi Z net dan arah laju bola)
                    if foundNet then
                        -- Jika posisi Z bola sudah berada di sisi pemain (melewati garis net)
                        local playerZ = humanoidRootPart.Position.Z
                        -- Cek apakah bola bergerak ke arah sisi player
                        if (playerZ > netPositionZ and obj.Position.Z > netPositionZ) or 
                           (playerZ < netPositionZ and obj.Position.Z < netPositionZ) then
                            isCrossedNet = true
                        end
                    else
                        -- Jika net tidak terdeteksi spesifik, asumsikan aktif jika bola sudah mendekat
                        isCrossedNet = true 
                    end

                    if distance < shortestDistance then
                        shortestDistance = distance
                        targetBall = obj
                    end
                end
            end
        end
    end
    
    return targetBall, shortestDistance, isCrossedNet
end

-- ==============================================================================
-- EKSEKUSI UTAMA (LOGIKA TELEPORT SAAT LEWAT NET & AUTO HIT)
-- ==============================================================================
RunService.RenderStepped:Connect(function()
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        character = player.Character
        if character then
            humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        end
        return 
    end

    local ball, distance, crossedNet = findBallAndNetStatus()
    
    if ball then
        -- 1. Logika Auto Teleport: Hanya teleport saat bola sudah melewati batas net ke area kita
        if CONFIG.AutoTeleportEnabled and crossedNet and distance > CONFIG.HitDistance then
            local offset = Vector3.new(CONFIG.TeleportOffset[1], CONFIG.TeleportOffset[2], CONFIG.TeleportOffset[3])
            humanoidRootPart.CFrame = CFrame.new(ball.Position + offset, ball.Position)
        end
        
        -- 2. Logika Auto Hit: Langsung pukul bola begitu masuk dalam jangkauan raket
        if CONFIG.AutoHitEnabled and distance <= CONFIG.HitDistance then
            -- Eksekusi lewat Tool yang dipegang
            local tool = character:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
            
            -- Eksekusi cadangan lewat RemoteEvent server game (jika ada event pukul)
            for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                if remote:IsA("RemoteEvent") and (string.find(string.lower(remote.Name), "hit") or string.find(string.lower(remote.Name), "swing") or string.find(string.lower(remote.Name), "shot")) then
                    remote:FireServer(ball)
                end
            end
        end
    end
end)

