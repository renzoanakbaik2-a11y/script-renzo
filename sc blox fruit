-- AUTO STORE
-- =====================================================================
local function autoStoreFruits()
    if not Settings.AutoStoreFruit then return end
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:FindFirstChild("MainRemote")
        local commF = remotes and (remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("Data"))
        if not commF then return end
        
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local character = LocalPlayer.Character
        
        local function checkAndStore(item)
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("fruit") or name:find("rocket") or name:find("spin") or name:find("kitsune") or name:find("dragon") or name:find("dough") or name:find("buddha") or name:find("trex") then
                    local originalName = item:GetAttribute("OriginalName") or item.Name
                    pcall(function() commF:InvokeServer("StoreFruit", originalName, item) end)
                    pcall(function() commF:InvokeServer("StoreFruit", item.Name) end)
                end
            end
        end
        
        if backpack then for _, item in ipairs(backpack:GetChildren()) do checkAndStore(item) end end
        if character then for _, item in ipairs(character:GetChildren()) do checkAndStore(item) end end
    end)
end

-- =====================================================================
-- MONITORING & 4 OPSI SERVER HOP
-- =====================================================================
local sessionStartTime = tick()

task.spawn(function()
    local lastStatus = nil 
    task.wait(5) 
    while task.wait(3) do 
        pcall(function()
            autoStoreFruits()
            updateFruitESP()

            local fruitCount = 0
            local hasRareFruit = false
            for _, obj in ipairs(Workspace:GetChildren()) do
                if isRealSpawnedFruit(obj) then
                    fruitCount = fruitCount + 1
                    local name = obj.Name:lower()
                    if name:find("kitsune") or name:find("dragon") or name:find("dough") or name:find("buddha") or name:find("trex") or name:find("portal") then
                        hasRareFruit = true
                    end
                end
            end

            FruitCountLabel.Text = "Buah di Map: " .. fruitCount

            local uptimeSeconds = math.floor(Workspace.DistributedGameTime)
            local hours = math.floor(uptimeSeconds / 3600)
            local minutes = math.floor((uptimeSeconds % 3600) / 60)
            local seconds = uptimeSeconds % 60
            ServerTimeLabel.Text = string.format("Server Aktif: %02d:%02d:%02d", hours, minutes, seconds)

            if fruitCount > 0 and lastStatus ~= "Ada" then
                playFruitSound()
                showCustomNotification("✅ ADA " .. fruitCount .." BUAH DI MAP!", Color3.fromRGB(46, 204, 113))
                lastStatus = "Ada"
            elseif fruitCount == 0 and lastStatus ~= "Kosong" then
                showCustomNotification("❌ Tidak ada buah di map.", Color3.fromRGB(231, 76, 60))
                lastStatus = "Kosong"
            end

            if fruitCount > 0 and Settings.AutoCollectFruit and not activeFlyConnection then
                collectNearestFruit()
            end

            -- 4 OPSI AUTO SERVER HOP
            if Settings.HopIfEmpty and fruitCount == 0 then
                serverHop()
                return
            end

            if Settings.HopIfNoRare and not hasRareFruit and fruitCount > 0 then
                serverHop()
                return
            end

            if Settings.HopTimerEnabled then
                local elapsedMinutes = (tick() - sessionStartTime) / 60
                if elapsedMinutes >= Settings.HopTimerMinutes then
                    serverHop()
                    return
                end
            end
        end)
    end
end)

