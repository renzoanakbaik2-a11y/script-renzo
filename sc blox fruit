        local allItems = {}
        if backpack then for _, item in ipairs(backpack:GetChildren()) do table.insert(allItems, item) end end
        if character then for _, item in ipairs(character:GetChildren()) do table.insert(allItems, item) end end
        
        for _, item in ipairs(allItems) do
            if item:IsA("Tool") and isRealSpawnedFruit(item) then
                remotes.CommF_:InvokeServer("StoreFruit", item.Name)
                task.wait(0.8)
            end
        end
    end)
end

