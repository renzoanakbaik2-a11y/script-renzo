-- 3. LOGIKA AUTO COLLECT CASH IN-GAME
task.spawn(function()
    while true do
        task.wait(0.3)
        if Settings.AutoFarmCash and HumanoidRootPart then
            local cashFound = nil
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local name = obj.Name:lower()
                    if name:find("cash") or name:find("money") or name:find("pink") or name:find("star") then
                        cashFound = obj
                        break
                    end
                end
            end
            if cashFound then
                local targetPart = cashFound:IsA("BasePart") and cashFound or cashFound:FindFirstChildOfClass("BasePart")
                if targetPart then
                    HumanoidRootPart.CFrame = targetPart.CFrame
                    if firetouchinterest then
                        firetouchinterest(HumanoidRootPart, targetPart, 0)
                        task.wait()
                        firetouchinterest(HumanoidRootPart, targetPart, 1)
                    end
                    task.wait(0.1)
                end
            end
        end
    end
end)
