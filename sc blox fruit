-- 3. BACKGROUND ENGINE & GODMODE PROTECTION
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")

        -- Speedboost
        if hum and Settings.Speed then
            hum.WalkSpeed = 28
        end

        -- Noclip
        if Settings.Noclip then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        -- GODMODE & ANTI-PIGGY CATCH
        if Settings.GodMode then
            -- Netralkan Trap Piggy & Hitbox Monster
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj.Name == "Trap" or obj.Name == "Piggy" or obj.Name == "BearTrap" then
                    if obj:IsA("BasePart") then
                        obj.CanTouch = false
                    elseif obj:IsA("Model") then
                        for _, p in pairs(obj:GetChildren()) do
                            if p:IsA("BasePart") then p.CanTouch = false end
                        end
                    end
                end
            end
        end
    end
end)

-- 4. X-RAY / ESP HIGHLIGHTER
task.spawn(function()
    while task.wait(1) do
        if Settings.ESP then
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    -- Highlight Item / Kunci / Pintu
                    local name = string.lower(obj.Name)
                    if name:find("key") or name:find("plank") or name:find("wrench") or name:find("hammer") or name:find("door") or name:find("piggy") then
                        if not obj:FindFirstChild("PiggyESP") then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "PiggyESP"
                            highlight.FillTransparency = 0.5
                            highlight.OutlineTransparency = 0
                            
                            if name:find("piggy") then
                                highlight.FillColor = Color3.fromRGB(255, 0, 0) -- Merah buat Piggy
                            else
                                highlight.FillColor = Color3.fromRGB(0, 255, 128) -- Hijau buat Item/Kunci
                            end
                            highlight.Parent = obj
                        end
                    end
                end
            end
        end
    end
end)
