statusLabel.TextYAlignment = Enum.TextYAlignment.Top
statusLabel.Parent = frame

local alive = true
local busy = false
local attemptId = 0
local connections = {}

local function report(message)
    print("[TeleportTest] " .. message)
    if alive then
        statusLabel.Text = message
    end
end

local function setBusy(value)
    busy = value
    if alive then
        button.Text = value
            and "MENUNGGU HASIL..."
            or "TES TELEPORT SEKALI"
        button.AutoButtonColor = not value
    end
end

-- Ini nama dugaan dari script awal, bukan database resmi game.
local candidateNames = {
    TeleportToDungeon = true,
    EnterDungeon = true,
    JoinQueue = true,
}

local function findCandidates()
    local candidates = {}

    for _, object in ipairs(ReplicatedStorage:GetDescendants()) do
        if candidateNames[object.Name] and (
            object:IsA("RemoteEvent")
            or object:IsA("RemoteFunction")
        ) then
            table.insert(candidates, object)
            print(
                "[TeleportTest] Kandidat:",
                object:GetFullName(),
                object.ClassName
            )
        end
    end

    return candidates
end

-- Pantau event teleport sebenarnya, bukan sekadar keberhasilan FireServer.
table.insert(connections, player.OnTeleport:Connect(function(state)
    if not alive then return end

    attemptId = attemptId + 1

    if state == Enum.TeleportState.Failed then
        setBusy(false)
        report("Roblox melaporkan teleport gagal.")
    else
        setBusy(true)
        report(
            "Status teleport Roblox: " .. state.Name
            .. "\nBelum memastikan dungeon tujuan benar."
        )
    end
end))

table.insert(connections, TeleportService.TeleportInitFailed:Connect(
    function(who, result, message)
        if not alive or who ~= player then return end

        attemptId = attemptId + 1
        setBusy(false)
        report(
            "Teleport gagal: " .. result.Name
            .. "\n" .. tostring(message)
        )
    end
))

local function triggerTeleport()
    if busy or not alive then return end
    setBusy(true)

    local candidates = findCandidates()

    if #candidates == 0 then
        setBusy(false)
        report(
            "Remote dengan nama dugaan tidak ditemukan."
            .. "\nBuka menu dungeon lalu coba lagi."
            .. "\nJika tetap kosong, perlu nama/path remote yang benar."
        )
        return
    end

    if #candidates > 1 then
        setBusy(false)
        report(
            "Ditemukan " .. #candidates .. " kandidat."
            .. "\nTidak mengirim ke remote sembarang."
            .. "\nLihat daftar path di console."
        )
        return
    end

    local remote = candidates[1]
    attemptId = attemptId + 1
    local thisAttempt = attemptId
    local finished = false
    local timedOut = false

    report(
        "Menguji: " .. remote:GetFullName()
        .. "\nParameter dari script awal belum terverifikasi."
    )

    task.delay(15, function()
        if not alive or thisAttempt ~= attemptId then return end
        timedOut = true

        if finished then
            setBusy(false)
            report(
                "Panggilan selesai, tetapi belum ada event teleport."
                .. "\nRemote/payload mungkin tidak cocok atau masih antre."
            )
        else
            report(
                "InvokeServer belum merespons setelah 15 detik."
                .. "\nTombol dikunci agar request tidak bertumpuk."
                .. "\nPermintaan server belum dibatalkan."
            )
        end
    end)

    task.spawn(function()
        local ok, response = pcall(function()
            -- Dipertahankan dari kode awal; format belum terverifikasi.
            local dungeonData = {
                World = 1,
                Dungeon = 1,
                Name = "Crabby Crusade",
                Difficulty = "Normal",
            }

            if remote:IsA("RemoteEvent") then
                remote:FireServer(dungeonData)
                return "Permintaan dikirim; belum ada konfirmasi server."
            elseif remote:IsA("RemoteFunction") then
                return remote:InvokeServer(dungeonData)
            else
                error("Objek bukan RemoteEvent/RemoteFunction.")
            end
        end)

        finished = true

        if not alive or thisAttempt ~= attemptId then return end

        if not ok then
            attemptId = attemptId + 1
            setBusy(false)
            report("Error:\n" .. tostring(response))
            return
        end

        report(
            "Hasil panggilan: " .. tostring(response)
            .. "\nIni belum berarti berhasil masuk dungeon."
        )

        -- Respons terlambat: beri waktu tambahan untuk event teleport.
        if timedOut then
            task.delay(15, function()
                if not alive or thisAttempt ~= attemptId then return end
                setBusy(false)
                report(
                    "Respons sudah diterima, tetapi belum ada event teleport."
                    .. "\nPerlu verifikasi remote, parameter, dan syarat join."
                )
            end)
        end
    end)
end

button.Activated:Connect(function()
    local ok, err = xpcall(triggerTeleport, debug.traceback)
    if not ok and alive then
        attemptId = attemptId + 1
        setBusy(false)
        report("Error tester:\n" .. tostring(err))
    end
end)

gui.Destroying:Connect(function()
    alive = false
    attemptId = attemptId + 1

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
end)

report(
    "Siap. Tekan TES TELEPORT SEKALI."
    .. "\nPlace saat ini: " .. tostring(game.PlaceId)
    .. "\nHasil pemeriksaan muncul di sini."
)
