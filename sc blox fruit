-- Update Button Styles Function
local function UpdateUI()
    if Settings.Enabled then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "AUTO PARRY: ON"
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        ToggleBtn.Text = "AUTO PARRY: OFF"
    end
    
    if Settings.AutoSwing then
        SwingBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        SwingBtn.Text = "AUTO SWING: ON"
    else
        SwingBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        SwingBtn.Text = "AUTO SWING: OFF"
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled
    UpdateUI()
end)

SwingBtn.MouseButton1Click:Connect(function()
    Settings.AutoSwing = not Settings.AutoSwing
    UpdateUI()
end)

-- ====================================================================
-- 4. MAIN LOOP & KEYBIND TOGGLE
-- ====================================================================

RunService.RenderStepped:Connect(function()
    if not Settings.Enabled then return end
    
    Character = LocalPlayer.Character
    if not Character or not Character:FindFirstChild("HumanoidRootPart") then return end
    HumanoidRootPart = Character.HumanoidRootPart

    local currentBall = GetBall()
    if not currentBall then return end

    local ballPos = currentBall.Position
    local distance = (HumanoidRootPart.Position - ballPos).Magnitude

    -- Hanya aktif saat bola berada di area lapangan kita
    if IsBallInMyZone(ballPos) and distance <= Settings.MaxReachDistance then
        local targetPos = PredictLandingPosition(currentBall)
        local destinationCFrame = CFrame.new(targetPos.X, HumanoidRootPart.Position.Y, targetPos.Z) * HumanoidRootPart.CFrame.Rotation
        
        HumanoidRootPart.CFrame = HumanoidRootPart.CFrame:Lerp(destinationCFrame, Settings.DashSpeed)

        if distance <= 12 then
            PerformHit(ballPos.Y)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Settings.Keybind then
        MainFrame.Visible = not MainFrame.Visible
    end
end)
