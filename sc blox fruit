-- ==============================================================================
-- SISTEM PENCARIAN BOLA DENGAN FILTER BATAS NET (Z-AXIS / X-AXIS)
-- ==============================================================================
local function getTacticalTarget()
    local targetBall = nil
    local shortestDist = math.huge
    local isAtOurSide = false

    -- 1. Deteksi letak pembatas net lapangan
    local netPos = nil
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "net") then
            netPos = v.Position
            break
        end
    end

    -- 2. Scan objek bergerak (bola/kok)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
            if obj.Size.Magnitude < 20 and not obj.Anchored then
                local dist = (humanoidRootPart.Position - obj.Position).Magnitude
                
                -- Logika Utama Pemilahan Sisi Net:
                -- Jika bola berada di wilayah musuh (jangan dikejar), jika sudah lewat net ke area kita (teleport).
                -- Kita gunakan perbandingan sumbu Z atau X tergantung orientasi map game.
                if netPos then
                    local playerSide = humanoidRootPart.Position.Z
                    local netSide = netPos.Z
                    local ballSide = obj.Position.Z

                    -- Memastikan bola sudah melewati net dan masuk ke sisi area pemain
                    if (playerSide > netSide and ballSide > netSide) or (playerSide < netSide and ballSide < netSide) then
                        isAtOurSide = true
                    else
                        isAtOurSide = false -- Masih di area musuh, JANGAN DIKEJAR!
                    end
                else
                    isAtOurSide = true -- Fallback jika net tidak terdeteksi
                end

                if dist < shortestDist then
                    shortestDist = dist
                    targetBall = obj
                end
            end
        end
    end

    return targetBall, shortestDist, isAtOurSide
end

-- ==============================================================================
-- FUNGSI PUKULAN ADAPTIF (POWER SMASH JIKA POSISI TINGGI/BAGUS, SLOW DROP JIKA SULIT)
-- ==============================================================================
local function adaptiveHit(targetBall)
    -- Evaluasi Posisi Bola (Ketinggian Y relatif terhadap pemain)
    local heightDifference = targetBall.Position.Y - humanoidRootPart.Position.Y
    local isGoodPosition = heightDifference > 2 -- Posisi bola di atas kepala/bagus untuk dismash

    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end

    pcall(function()
        if isGoodPosition then
            -- Kondisi Posisi Bagus: Power Kuat / Smash ke arah Bawah
            VirtualUser:Button1Down(Vector2.new(0,0))
            task.wait(0.05) -- Tahan sebentar untuk memicu power tinggi
            VirtualUser:Button1Up(Vector2.new(0,0))
        else
            -- Kondisi Posisi Jelek/Terlambat: Pukul Pelan (Slow Shot) agar tidak out / keluar lapangan
            VirtualUser:Button1Down(Vector2.new(0,0))
            VirtualUser:Button1Up(Vector2.new(0,0)) -- Klik cepat tanpa tahan untuk daya minimal
        end
    end)

    -- Bypass Remote Game untuk memastikan perintah pukul terkirim ke server
    for _, container in ipairs({ReplicatedStorage, player:FindFirstChild("PlayerGui"), Workspace}) do
        if container then
            for _, remote in ipairs(container:GetDescendants()) do
                if remote:IsA("RemoteEvent") then
                    pcall(function()
                        remote:FireServer(targetBall, isGoodPosition)
                        remote:FireServer()
                    end)
                end
            end
        end
    end
end

-- ==============================================================================
-- EKSEKUSI UTAMA (LOOPING)
-- ==============================================================================
RunService.RenderStepped:Connect(function()
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        character = player.Character
        if character then humanoidRootPart = character:WaitForChild("HumanoidRootPart") end
        return 
    end

    local ball, distance, atOurSide = getTacticalTarget()
    
    if ball then
        -- Cek apakah posisi bola tinggi atau rendah untuk teks info menu
        local heightDiff = ball.Position.Y - humanoidRootPart.Position.Y
        local modeText = heightDiff > 2 and "Power Smash ⚡" or "Slow Drop 🛡️"
        
        if atOurSide then
            InfoLabel.Text = "Area: Sisi Kita | " .. modeText
            
            -- 1. Auto Teleport mengikuti posisi bola (termasuk ketinggian atas/bawah) SEGERA setelah melewati net ke area kita
            if CONFIG.AutoTeleportEnabled and distance > CONFIG.HitDistance then
                -- Mengikuti posisi bola secara akurat (X, Y, Z) agar ikut terbang/naik jika bola di atas
                humanoidRootPart.CFrame = CFrame.new(ball.Position)
            end
            
            -- 2. Auto Hit Adaptif (Kuat kalau posisi bagus, pelan kalau posisi jelek)
            if CONFIG.AutoHitEnabled and distance <= CONFIG.HitDistance then
                adaptiveHit(ball)
            end
        else
            InfoLabel.Text = "Area: Sisi Musuh (Diam/Menunggu)"
        end
    else
        InfoLabel.Text = "Status: Menunggu Bola Masuk..."
    end
end)

