-- 4. MATIKAN TABRAKAN (Noclip)
local function setNoclip(char, active)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = not active
		end
	end
end

-- 5. SERANG OTOMATIS
local function autoAttack()
	local char = LocalPlayer.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		tool:Activate()
	end
end

-- 6. CARI MOB TERDEKAT (SUPER FILTER KHUSUS MOBS)
local function cariMobTerdekat(hrp)
	local target = nil
	local minJarak = math.huge

	-- Prioritas folder khusus musuh
	local folderMusuh = Workspace:FindFirstChild("Mobs") 
		or Workspace:FindFirstChild("Enemies") 
		or Workspace:FindFirstChild("Monsters")
		or Workspace:FindFirstChild("Live")

	local areaScan = folderMusuh and folderMusuh:GetDescendants() or Workspace:GetDescendants()

	for _, obj in ipairs(areaScan) do
		if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			local mobHrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
			
			local parentName = obj.Parent and obj.Parent.Name:lower() or ""
			local diFolderAman = parentName:find("npc") or parentName:find("shop") or parentName:find("town") or parentName:find("safe") or parentName:find("quest") or parentName:find("vendor") or parentName:find("store") or parentName:find("jual")
			
			local isPemain = Players:GetPlayerFromCharacter(obj)
			local adaTombolBeli = obj:FindFirstChildOfClass("ProximityPrompt", true) or obj:FindFirstChildOfClass("ClickDetector", true)
			local isAnchored = mobHrp and mobHrp.Anchored

			if mobHrp and hum and hum.Health > 0 and obj.Name ~= LocalPlayer.Name and not isPemain and not diFolderAman and not adaTombolBeli and not isAnchored then
				local jarak = (mobHrp.Position - hrp.Position).Magnitude
				if jarak < minJarak then
					minJarak = jarak
					target = mobHrp
				end
			end
		end
	end
	return target
end

-- 7. EKSEKUSI TOMBOL AUTO FARM
BtnFarm.MouseButton1Click:Connect(function()
	isFarming = not isFarming
	
	if isFarming then
		BtnFarm.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
		BtnFarm.Text = "AUTO FARM MOBS: ON"
		
		task.spawn(function()
			while isFarming do
				local char = LocalPlayer.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local hrp = char.HumanoidRootPart
					setNoclip(char, true)
					
					local targetMobHrp = cariMobTerdekat(hrp)
					if targetMobHrp and targetMobHrp.Parent then
						local mobName = targetMobHrp.Parent.Name
						Status.Text = "Status: Bantai [" .. mobName .. "]"
						Status.TextColor3 = Color3.fromRGB(100, 255, 150)
						
						-- Teleport melayang 6 stud di atas musuh & menghadap ke bawah
						hrp.CFrame = targetMobHrp.CFrame * CFrame.new(0, 6, 0) * CFrame.Angles(math.rad(-90), 0, 0)
						autoAttack()
					else
						Status.Text = "Status: Mencari musuh di sekitar..."
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
					end
				end
				task.wait(0.05)
			end
		end)
	else
		BtnFarm.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		BtnFarm.Text = "AUTO FARM MOBS: OFF"
		Status.Text = "Status: Off"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
		
		if LocalPlayer.Character then
			setNoclip(LocalPlayer.Character, false)
		end
	end
end)
