-- CONFIGURATION
local CONFIG = {
    FLY_HEIGHT = 12.0 -- Ketinggian melayang di atas musuh (studs)
}

local isAutoFarm = false
local isLooting = false
local currentTargetRoot = nil
local heartbeatConnection = nil
local bodyVel = nil
local bodyGyro = nil

