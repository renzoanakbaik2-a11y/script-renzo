-- Folder penampung kotak ESP visual di map
local espFolder = Instance.new("Folder")
espFolder.Name = "PixelQuestESP_Container"
espFolder.Parent = CoreGui

local function clearESP()
    espFolder:ClearAllChildren()
end

-- Fungsi mencari karakter pemain di map 2D Pixel Quest
local function getMyCharacterPart()
    -- Cek berbagai kemungkinan part karakter di game 2D
    if player.Character then
        local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head") or player.Character.PrimaryPart
        if root then return root end
    end
    -- Cari part aktif milik player di workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "HumanoidRootPart" or obj.Name == "Head" or obj.Name == "Root") then
            if obj.Parent and obj.Parent.Name == player.Name then
                return obj
            end
        end
    end
    return nil
end

-- Fungsi melacak musuh/monster di map 2D
local function findPixelEnemies()
    local enemies = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            -- Karena ini game 2D bullet hell, musuh biasanya dinamai berdasarkan mob/enemy/bullet/npc
            if name:find("enemy") or name:find("monster") or name:find("mob") or name:find("slime") or name:find("zombie") or name:find("boss") then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")) or obj
                if targetPart and targetPart ~= getMyCharacterPart() then
                    table.insert(enemies, targetPart)
                end
            end
        end
    end
    return enemies
end

RunService.RenderStepped:Connect(function()
    local myRoot = getMyCharacterPart()
    if not myRoot then return end

    local enemies = findPixelEnemies()

    -- 1. FITUR ESP GARIS & KOTAK DI MAP
    clearESP()
    if CONFIG.MapESP then
        for _, enemyPart in ipairs(enemies) do
            if enemyPart and enemyPart.Parent then
                -- Buat kotak penanda (Box ESP) di atas kepala musuh di map
                local box = Instance.new("BoxHandleAdornment")
                box.Size = Vector3.new(3, 3, 3)
                box.Adornee = enemyPart
                box.AlwaysOnTop = true
                box.ZIndex = 10
                box.Color3 = Color3.fromRGB(255, 0, 0)
                box.Transparency = 0.3
                box.Parent = espFolder

                -- Buat garis penunjuk arah dari pemain ke musuh di map
                local line = Instance.new("LineHandleAdornment")
                line.Adornee = myRoot
                line.Length = (myRoot.Position - enemyPart.Position).Magnitude
                line.Color3 = Color3.fromRGB(0, 255, 128)
                line.Thickness = 3
                line.AlwaysOnTop = true
                line.Transparency = 0.2
                -- Arahkan garis ke posisi musuh
                pcall(function()
                    line.CFrame = CFrame.new(myRoot.Position, enemyPart.Position):ToObjectSpace(myRoot.CFrame):Inverse()
                end)
                line.Parent = espFolder
            end
        end
    end

    -- 2. FITUR AUTO FARM (Teleport otomatis mendekati musuh terdekat di map 2D)
    if CONFIG.AutoFarm and #enemies > 0 then
        local closestEnemy = nil
        local shortestDist = math.huge

        for _, enemyPart in ipairs(enemies) do
            local dist = (myRoot.Position - enemyPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestEnemy = enemyPart
            end
        end

        if closestEnemy and closestEnemy.Parent then
            -- Teleport pas di dekat musuh
            myRoot.CFrame = CFrame.new(closestEnemy.Position + Vector3.new(0, 2, 0))
        end
    end
end)

