-- LOOP REALTIME (MURNI LOKAL SYSTEM TIME)
local startTime = os.time()

task.spawn(function()
    while task.wait(1) do
        if not ScreenGui or not ScreenGui.Parent then break end

        -- 1. Jam Sistem HP Instan
        local localTimeStr = os.date("%H:%M:%S")

        -- 2. Playtime
        local elapsed = os.time() - startTime
        local hrs = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60
        local playtimeStr = string.format("%02dh %02dm %02ds", hrs, mins, secs)

        -- 3. Total Players
        local allPlayers = Players:GetPlayers()
        local playerAmount = #allPlayers
        local maxPlayers = Players.MaxPlayers or 6

        -- 4. Richest Player
        local richestName = "None"
        local maxCash = -1

        for _, plr in ipairs(allPlayers) do
            local leaderstats = plr:FindFirstChild("leaderstats")
            if leaderstats then
                local cashVal = leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("$")
                if cashVal and cashVal.Value > maxCash then
                    maxCash = cashVal.Value
                    richestName = plr.Name
                end
            end
        end

        local richestStr = richestName
        if maxCash > -1 then
            richestStr = richestName .. " (" .. tostring(maxCash) .. "$)"
        end

        StatsText.Text = string.format(
            "SERVER INFO:\n\n• Time          : %s\n• Time Played  : %s\n• Server Players: %d / %d Players\n• Richest Player: %s",
            localTimeStr,
            playtimeStr,
            playerAmount,
            maxPlayers,
            richestStr
        )
    end
end)

