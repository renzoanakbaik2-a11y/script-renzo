-- [[ GURITA HUB - TEAM & FRUIT NOTIFICATION MODULE ]] --

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

-- PENGATURAN DEFAULT
local config = {
	autoJoinTeamActive = false,
	selectedTeam = "Pirates"
}

-- ==========================================================
-- FUNGSI NOTIFIKASI DI LAYAR
-- ==========================================================
local function sendNotification(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = duration or 3
		})
	end)
end

-- ==========================================================
-- FUNGSI AUTO JOIN TIM
-- ==========================================================
local function autoSelectTeam()
	local re = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
	if re then
		pcall(function()
			re:InvokeServer("SetTeam", config.selectedTeam)
		end)
	end
end

-- ==========================================================
-- DETEKSI BUAH & NOTIFIKASI BUAH
-- ==========================================================
local function checkFruit()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name:find("Fruit") or obj.Name:find("BloxFruit") or (obj:IsA("Tool") and obj:FindFirstChild("Handle")) then
			sendNotification("Gurita Hub", "Ada Buah: " .. obj.Name .. "!", 6)
			break
		end
	end
end

task.spawn(function()
	while task.wait(5) do
		pcall(checkFruit)
	end
end)

-- ==========================================================
-- TAMPILAN GUI MENU UTAMA
-- ==========================================================
if player.PlayerGui:FindFirstChild("GuritaHubGUI") then
	player.PlayerGui.GuritaHubGUI:Destroy()
end

local screenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
screenGui.Name = "GuritaHubGUI"
screenGui.ResetOnSpawn = false

-- Tombol Buka/Tutup Menu (Ikon Garis Tiga ≡)
local ToggleMenuBtn = Instance.new("TextButton", screenGui)
ToggleMenuBtn.Size = UDim2.new(0, 85, 0, 40)
ToggleMenuBtn.Position = UDim2.new(0, 20, 0.4, 0)
ToggleMenuBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ToggleMenuBtn.Text = "MENU ≡"
ToggleMenuBtn.TextColor3 = Color3.fromRGB(0, 220, 255)
ToggleMenuBtn.Font = Enum.Font.GothamBlack
ToggleMenuBtn.TextSize = 13
Instance.new("UICorner", ToggleMenuBtn)
local ToggleMenuStroke = Instance.new("UIStroke", ToggleMenuBtn)
ToggleMenuStroke.Color = Color3.fromRGB(0, 170, 255)
ToggleMenuStroke.Thickness = 2

-- Frame Utama Menu
local Main = Instance.new("Frame", screenGui)
Main.Size = UDim2.new(0, 240, 0, 180)
Main.Position = UDim2.new(0.5, -120, 0.5, -90)
Main.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
Main.Visible = true
Instance.new("UICorner", Main)
local Stroke = Instance.new("UIStroke", Main)
Stroke.Color = Color3.fromRGB(0, 170, 255)
Stroke.Thickness = 2

local Title = Instance.new("TextLabel", Main)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Position = UDim2.new(0, 0, 0, 5)
Title.Text = "GURITA HUB - MODULE\nBLOX FRUITS"
Title.Font = Enum.Font.GothamBlack
Title.TextSize = 11
Title.BackgroundTransparency = 1
Title.TextColor3 = Color3.fromRGB(0, 170, 255)

local function CreateBtn(pos)
	local b = Instance.new("TextButton", Main)
	b.Size = UDim2.new(0, 200, 0, 34)
	b.Position = pos
	b.Font = Enum.Font.GothamBlack
	b.TextSize = 12
	b.TextColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", b)
	local s = Instance.new("UIStroke", b)
	s.Color = Color3.fromRGB(0, 170, 255)
	s.Thickness = 1.2
	return b
end

local TeamBtn        = CreateBtn(UDim2.new(0, 20, 0, 55))
local ToggleJoinTeam = CreateBtn(UDim2.new(0, 20, 0, 105))

-- Update Teks & Warna Tombol Berdasarkan Config
TeamBtn.Text = "Tim: " .. config.selectedTeam
TeamBtn.BackgroundColor3 = Color3.fromRGB(52, 152, 219)

ToggleJoinTeam.Text = config.autoJoinTeamActive and "Auto Join Team: ON" or "Auto Join Team: OFF"
ToggleJoinTeam.BackgroundColor3 = config.autoJoinTeamActive and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)

ToggleMenuBtn.MouseButton1Down:Connect(function()
	Main.Visible = not Main.Visible
end)

-- ==========================================================
-- KONTROL TOMBOL INTERAKTIF MENU
-- ==========================================================
TeamBtn.MouseButton1Click:Connect(function()
	if config.selectedTeam == "Pirates" then
		config.selectedTeam = "Marines"
	else
		config.selectedTeam = "Pirates"
	end
	TeamBtn.Text = "Tim: " .. config.selectedTeam
	if config.autoJoinTeamActive then
		autoSelectTeam()
	end
end)

ToggleJoinTeam.MouseButton1Click:Connect(function()
	config.autoJoinTeamActive = not config.autoJoinTeamActive
	ToggleJoinTeam.Text = config.autoJoinTeamActive and "Auto Join Team: ON" or "Auto Join Team: OFF"
	ToggleJoinTeam.BackgroundColor3 = config.autoJoinTeamActive and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
	
	if config.autoJoinTeamActive then
		autoSelectTeam()
	end
end)
