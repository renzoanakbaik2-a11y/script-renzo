-- Fungsi Karakter & Terbang Aman
local function getCharacterRootPart()
	local char = LocalPlayer.Character
	if char then
		return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	end
	return nil
end

local function smoothFlyTo(targetCFrame)
	pcall(function()
		local rootPart = getCharacterRootPart()
		if not rootPart then return end

		local speed = math.clamp(Settings.FlightSpeed, 20, 1000)
		local height = math.clamp(Settings.FlyHeight, 0, 10)
		local dest = targetCFrame + Vector3.new(0, height, 0)

		local dist = (rootPart.Position - dest.Position).Magnitude
		local duration = dist / speed
		if duration < 0.05 then return end

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum then hum.PlatformStand = true end

		local bv = Instance.new("BodyVelocity")
		bv.Velocity = Vector3.new(0, 0, 0)
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Parent = rootPart

		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bg.CFrame = rootPart.CFrame
		bg.Parent = rootPart

		local startTick = tick()
		local startCF = rootPart.CFrame

		while tick() - startTick < duration do
			if not rootPart or not char.Parent then break end
			local alpha = math.clamp((tick() - startTick) / duration, 0, 1)
			rootPart.CFrame = startCF:Lerp(dest, alpha * (2 - alpha))
			bg.CFrame = rootPart.CFrame
			RunService.RenderStepped:Wait()
		end

		rootPart.CFrame = dest
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
		if hum then hum.PlatformStand = false end
	end)
end

-- Sistem Chest Sederhana & Stabil
local DeadChests = {}
local function getChestIslands()
	local chests = {}
	pcall(function()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name:lower():find("chest") and not DeadChests[obj] then
				local part = obj:IsA("BasePart") and obj or (obj:IsA("Model") and obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart"))
				if part then
					table.insert(chests, {Object = obj, Position = part.Position})
				end
			end
		end
	end)
	return chests
end

-- Background Loop Aman
task.spawn(function()
	while task.wait(1.5) do
		pcall(function()
			-- Deteksi Buah
			if Settings.FruitNotifier then
				local fruits = {}
				local targetFruitHandle = nil
				for _, obj in ipairs(Workspace:GetChildren()) do
					if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
						table.insert(fruits, obj.Name)
						if not targetFruitHandle then targetFruitHandle = obj.Handle end
					end
				end
				
				if #fruits > 0 then
					NotifText.Text = "KETEMU (" .. #fruits .. "): " .. table.concat(fruits, ", ")
					if Settings.AutoTeleportFruit and targetFruitHandle then
						local rp = getCharacterRootPart()
						if rp and (rp.Position - targetFruitHandle.Position).Magnitude > 15 then
							smoothFlyTo(targetFruitHandle.CFrame)
						end
					end
				else
					NotifText.Text = "Status: Mencari Buah di Map..."
				end
			end

			-- Auto Chest
			if Settings.AutoFlyChest then
				local rp = getCharacterRootPart()
				if rp then
					local chests = getChestIslands()
					if #chests > 0 then
						table.sort(chests, function(a, b)
							return (rp.Position - a.Position).Magnitude < (rp.Position - b.Position).Magnitude
						end)
						smoothFlyTo(CFrame.new(chests[1].Position))
						task.wait(0.3)
						DeadChests[chests[1].Object] = true
					end
				end
			end

			-- Auto Teleport Player
			if Settings.AutoFlyPlayer then
				task.wait(2)
				local targetP = nil
				if Settings.TargetPlayerName ~= "" then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and p.Name:lower():find(Settings.TargetPlayerName:lower()) then
							targetP = p
							break
						end
					end
				else
					local shortest = math.huge
					local rp = getCharacterRootPart()
					if rp then
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
								local dist = (rp.Position - p.Character.HumanoidRootPart.Position).Magnitude
								if dist < shortest then
									shortest = dist
									targetP = p
								end
							end
						end
					end
				end

				if targetP and targetP.Character and targetP.Character:FindFirstChild("HumanoidRootPart") then
					smoothFlyTo(targetP.Character.HumanoidRootPart.CFrame)
					task.wait(1.5)
				end
			end
		end)
	end
end)

-- Auto Join Tim
local function joinTeam()
	if not Settings.AutoJoinEnabled then return end
	pcall(function()
		local remotes = ReplicatedStorage:FindFirstChild("Remotes")
		if remotes and remotes:FindFirstChild("CommF_") then
			remotes.CommF_:InvokeServer("SetTeam", Settings.SelectedTeam)
		end
	end)
end

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(2)
	joinTeam()
end)
task.spawn(function()
	task.wait(1)
	joinTeam()
end)

-- FPS Boost
local function applyFpsBoost(state)
	pcall(function()
		Lighting.GlobalShadows = not state
		if state then
			Lighting.FogEnd = 999999
			for _, v in ipairs(Workspace:GetDescendants()) do
				if v:IsA("BasePart") then
					v.Material = Enum.Material.SmoothPlastic
					v.Reflectance = 0
				elseif v:IsA("Decal") or v:IsA("Texture") then
					v.Transparency = 1
				end
			end
		end
	end)
end

