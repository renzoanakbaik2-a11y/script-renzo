-- ==============================================================================
-- SISTEM VISUAL MAP ESP & GARIS PANDUAN TARGET 2D
-- ==============================================================================
local espContainer = Instance.new("Folder")
espContainer.Name = "PixelQuest_ESP_Visuals"
espContainer.Parent = CoreGui

RunService.RenderStepped:Connect(function()
    espContainer:ClearAllChildren()

    if not CONFIG.ESPMapLines then return end

    -- Cari posisi pemain (bisa berupa part atau model di game 2D)
    local myPosition = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("root") or obj.Name:lower():find("head") or obj.Name:lower():find("player")) then
            if obj.Parent and obj.Parent.Name == player.Name then
                myPosition = obj.Position
                break
            end
        end
    end

    if not myPosition and player.Character and player.Character.PrimaryPart then
        myPosition = player.Character.PrimaryPart.Position
    end

    if not myPosition then return end

    -- Scan musuh di map 2D berdasarkan part aktif
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            -- Deteksi objek yang berpotensi sebagai musuh/mob di map 2D Pixel Quest
            if name:find("enemy") or name:find("monster") or name:find("mob") or name:find("boss") or name:find("slime") then
                -- Buat kotak penanda merah di atas musuh
                local box = Instance.new("BoxHandleAdornment")
                box.Size = Vector3.new(2.5, 2.5, 2.5)
                box.Adornee = obj
                box.AlwaysOnTop = true
                box.ZIndex = 5
                box.Color3 = Color3.fromRGB(255, 50, 50)
                box.Transparency = 0.2
                box.Parent = espContainer

                -- Buat garis hijau penunjuk dari posisi kita ke musuh tersebut
                local line = Instance.new("LineHandleAdornment")
                line.Adornee = obj
                line.Length = (myPosition - obj.Position).Magnitude
                line.Color3 = Color3.fromRGB(0, 255, 128)
                line.Thickness = 2
                line.AlwaysOnTop = true
                line.Transparency = 0.3
                line.Parent = espContainer
            end
        end
    end
end)

print("⚡ PIXEL QUEST 2D TRACKER BERHASIL DIMUAT! ⚡")
