local function UpdateUI()
    ToggleFarmBtn.Text = Settings.AutoFarm and "Auto Farm: ON" or "Auto Farm: OFF"
    ToggleFarmBtn.BackgroundColor3 = Settings.AutoFarm and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)

    ToggleMagnetBtn.Text = Settings.MobMagnet and "Mob Magnet: ON" or "Mob Magnet: OFF"
    ToggleMagnetBtn.BackgroundColor3 = Settings.MobMagnet and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
end
UpdateUI()

ToggleFarmBtn.MouseButton1Click:Connect(function()
    Settings.AutoFarm = not Settings.AutoFarm
    UpdateUI()
    SaveSettings()
end)

ToggleMagnetBtn.MouseButton1Click:Connect(function()
    Settings.MobMagnet = not Settings.MobMagnet
    UpdateUI()
    SaveSettings()
end)

-- Keybind Open/Close UI (Right Control)
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- Anti AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- 3. HELPER FUNCTIONS
local function DisableGravity(root)
    if not root:FindFirstChild("FarmBV") then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "FarmBV"
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = root
    end
end

local function EnableGravity(root)
    if root and root:FindFirstChild("FarmBV") then
        root.FarmBV:Destroy()
    end
end

-- NOCLIP LOOP
task.spawn(function()
    while true do
        task.wait()
        if Settings.AutoFarm then
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end
end)

-- 4. MAIN FARMING & MOB MAGNET LOOP
task.spawn(function()
    while true do
        task.wait(0.03)
        if Settings.AutoFarm then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                DisableGravity(root)

                -- Auto Equip Weapon
                if not char:FindFirstChildOfClass("Tool") then
                    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            hum:EquipTool(tool)
                            break
                        end
                    end
                end

                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    local targetMob = nil

                    for _, mob in pairs(enemies:GetChildren()) do
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        local mRoot = mob:FindFirstChild("HumanoidRootPart")
                        if mHum and mHum.Health > 0 and mRoot then
                            targetMob = mob
                            break
                        end
                    end

                    if targetMob then
                        local targetRoot = targetMob.HumanoidRootPart
                        local farmPos = targetRoot.CFrame * CFrame.new(0, Settings.FarmDistance, 0)

                        -- Hovering Above Mob Target
                        root.CFrame = farmPos

                        -- Fix Rubberbanding Mob Magnet Logic
                        if Settings.MobMagnet then
                            local magnetPoint = root.Position - Vector3.new(0, Settings.FarmDistance, 0)
                            for _, mob in pairs(enemies:GetChildren()) do
                                local mHum = mob:FindFirstChildOfClass("Humanoid")
                                local mRoot = mob:FindFirstChild("HumanoidRootPart")

                                if mHum and mHum.Health > 0 and mRoot then
                                    if (mRoot.Position - root.Position).Magnitude <= Settings.MagnetRadius then
                                        for _, mPart in pairs(mob:GetChildren()) do
                                            if mPart:IsA("BasePart") then
                                                mPart.CanCollide = false
                                            end
                                        end

                                        -- Teleport posisi tanpa mengubah orientasi CFrame mob
                                        mRoot.CFrame = CFrame.new(magnetPoint) * (mRoot.CFrame - mRoot.CFrame.Position)
                                        mRoot.Velocity = Vector3.new(0, 0, 0)
                                        mHum.WalkSpeed = 0
                                    end
                                end
                            end
                        end

                        -- Attack Execution
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end
                end
            end
        else
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then EnableGravity(root) end
        end
    end
end)
