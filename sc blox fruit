-- LOGIKA SURVIVOR MODE (FIXED: AUTO-RESET ON TELEPORT)
BtnSurvivor.MouseButton1Click:Connect(function()
	isSurvivorActive = not isSurvivorActive
	if isSurvivorActive then
		isHunterActive = false
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		
		BtnSurvivor.Text = "SURVIVOR MODE: ON"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			while isSurvivorActive do
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				
				if myHrp then
					-- Cek apakah posisi player dipindah jauh balik ke Safe Zone 1 oleh server
					if kordinatZonaTerkunci then
						local jarakKeZona = (myHrp.Position - kordinatZonaTerkunci.Position).Magnitude
						if jarakKeZona > 20 then
							sudahSampaiZona = false -- Picu penerbangan ulang otomatis
						end
					end
					
					if not sudahSampaiZona then
						if not kordinatZonaTerkunci then
							local targetGaris = cariGarisAmanUjung()
							if targetGaris then
								kordinatZonaTerkunci = targetGaris.CFrame * CFrame.new(0, 2, 0)
							end
						end
						
						if kordinatZonaTerkunci then
							Status.Text = "Status: Meluncur ke Safe Zone Depan..."
							Status.TextColor3 = Color3.fromRGB(100, 255, 150)
							
							terbangMulus(kordinatZonaTerkunci, 90)
							
							sudahSampaiZona = true
						else
							Status.Text = "Status: Mencari Safe Zone Depan..."
							Status.TextColor3 = Color3.fromRGB(200, 200, 100)
						end
					else
						Status.Text = "Status: Aman di Safe Zone (Standby Ronde)"
						Status.TextColor3 = Color3.fromRGB(100, 200, 255)
					end
				end
				task.wait(0.3)
			end
		end)
	else
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
		if activeTween then
			activeTween:Cancel()
			activeTween = nil
		end
	end
end)

-- LOGIKA HUNTER MODE (FIXED: STICKY POSITION & VELOCITY PREDICTION)
BtnHunter.MouseButton1Click:Connect(function()
	isHunterActive = not isHunterActive
	if isHunterActive then
		isSurvivorActive = false
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		
		BtnHunter.Text = "HUNTER MODE: ON"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			while isHunterActive do
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				
				if myHrp then
					local survivorDitemukan = false
					
					for _, targetPlayer in ipairs(Players:GetPlayers()) do
						if targetPlayer ~= LocalPlayer and targetPlayer.Character then
							local targetChar = targetPlayer.Character
							local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
							local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
							
							if targetHrp and targetHum and targetHum.Health > 0 and isPemainSurvivor(targetPlayer) then
								survivorDitemukan = true
								Status.Text = "Status: Memburu [" .. targetPlayer.Name .. "]"
								Status.TextColor3 = Color3.fromRGB(255, 100, 100)
								
								local startTime = tick()
								local stickyConnection
								
								stickyConnection = RunService.Heartbeat:Connect(function()
									if isHunterActive and targetHrp and targetHum.Health > 0 and (tick() - startTime < 0.35) then
										myHrp.AssemblyLinearVelocity = Vector3.zero
										
										-- Prediksi posisi depan arah lari Survivor
										local targetPos = targetHrp.Position
										local arahLari = targetHrp.AssemblyLinearVelocity * 0.05
										local posTujuan = targetPos + arahLari
										
										myHrp.CFrame = CFrame.new(posTujuan, targetPos)
										eksekusiPukulInstan(targetChar)
									else
										if stickyConnection then
											stickyConnection:Disconnect()
										end
									end
								end)
								
								task.wait(0.35)
								if stickyConnection then stickyConnection:Disconnect() end
								break
							end
						end
					end
					
					if not survivorDitemukan then
						Status.Text = "Status: Tidak Ada Survivor Terdeteksi"
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
					end
				end
				task.wait(0.08)
			end
		end)
	else
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
