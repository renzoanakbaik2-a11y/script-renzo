local function DoAttack()
    local char = LocalPlayer.Character
    if char then
        -- 1. Pemicu Senjata Aktif di Tangan (Tool Activation)
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end
    end

