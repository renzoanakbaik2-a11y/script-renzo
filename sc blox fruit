-- ==============================================================================
-- SISTEM INTELIGEN: INSTANT AREA KILL & ESP (ANTI-LAG OPTIMIZED)
-- ==============================================================================
local espContainer = Instance.new("Folder")
espContainer.Name = "PixelQuest_AreaESP"
espContainer.Parent = CoreGui

local lastCheck = 0
local checkInterval = 0.2 -- Jeda waktu (delay) 0.2 detik agar tidak bikin game patah-patah/lag

RunService.RenderStepped:Connect(function()
    espContainer:ClearAllChildren()

    local currentTime = tick()
    if currentTime - lastCheck < checkInterval then return end
    lastCheck = currentTime

    -- Cari posisi karakter pemain di map
    local myPosition = nil
    if player.Character and player.Character.PrimaryPart then
        myPosition = player.Character.PrimaryPart.Position
    end

    if not myPosition then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Parent and obj.Parent.Name == player.Name then
                myPosition = obj.Position
                break
            end
        end
    end

    if not myPosition then return end

    -- Scan dan proses musuh dalam radius dekat
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("enemy") or name:find("monster") or name:find("mob") or name:find("boss") or name:find("slime") then
                local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                
                if targetPart then
                    local distance = (myPosition - targetPart.Position).Magnitude

                    -- Batasi radius jarak dekat (misal di bawah 30 stud) agar tidak lag & tepat sasaran
                    if distance <= 30 then
                        -- 1. Visual ESP Kotak untuk melihat musuh dalam radius
                        if CONFIG.VisualESP then
                            local box = Instance.new("BoxHandleAdornment")
                            box.Size = Vector3.new(3, 3, 3)
                            box.Adornee = targetPart
                            box.AlwaysOnTop = true
                            box.ZIndex = 10
                            box.Color3 = Color3.fromRGB(255, 50, 50)
                            box.Transparency = 0.3
                            box.Parent = espContainer
                        end

                        -- 2. Logika Instant Area Kill (Menghapus / menonaktifkan musuh di area dekat tanpa bikin lag)
                        if CONFIG.InstantAreaKill then
                            pcall(function()
                                local modelParent = targetPart.Parent
                                if modelParent and modelParent:IsA("Model") then
                                    -- Cek apakah ada komponen health atau langsung hancurkan model musuh terdekat
                                    for _, child in ipairs(modelParent:GetChildren()) do
                                        if child:IsA("Humanoid") then
                                            child.Health = 0
                                        end
                                    end
                                    modelParent:Destroy()
                                end
                            end)
                        end
                    end
                end
            end
        end
    end
end)

