local function refreshPlayerList()
    for _, child in ipairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local activePlayers = Players:GetPlayers()
    for _, p in ipairs(activePlayers) do
        if p ~= LocalPlayer then
            local pLevel = "?"
            pcall(function()
                local leaderstats = p:FindFirstChild("leaderstats")
                if leaderstats then
                    local lvlVal = leaderstats:FindFirstChild("Level")
                    if lvlVal then
                        pLevel = tostring(lvlVal.Value)
                    end
                end
            end)

            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 30)
            pBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Text = "  " .. p.Name .. "  [Lvl: " .. pLevel .. "]"
            pBtn.TextSize, pBtn.Font = 10, Enum.Font.Gotham
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.ZIndex = 103
            pBtn.Parent = PlayerListScroll

            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 4)
            c.Parent = pBtn

            pBtn.MouseButton1Click:Connect(function()
                Settings.TargetPlayerName = p.Name
                TargetStatusLabel.Text = "Target: " .. p.Name
                saveSettings()
            end)
        end
    end
    PlayerListScroll.CanvasSize = UDim2.new(0, 0, 0, (#activePlayers - 1) * 34)
end

refreshPlayerList()
Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

