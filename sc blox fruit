-- 4. NOCLIP (Tembus Tembok Pas Terbang)
local function enableNoclip(char)
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end

-- 5. FUNGSI TERBANG MELAYANG (TWEEN FLY)
local function terbangKe(cframeTujuan, speed)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	enableNoclip(char)
	
	local jarak = (hrp.Position - cframeTujuan.Position).Magnitude
	local durasi = jarak / (speed or 180)
	
	local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(hrp, tweenInfo, {CFrame = cframeTujuan})
	tween:Play()
	tween.Completed:Wait()
end

-- 6. PUKUL OTOMATIS
local function hitTarget()
	local char = LocalPlayer.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		tool:Activate()
	end
end

-- 7. DETEKSI STATUS TEKS MISI DI UI GAME
local function dapatkanInfoQuestUI()
	for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
		if gui:IsA("TextLabel") and gui.Visible and gui.Text ~= "" then
			local txt = gui.Text:lower()
			if txt:find("kill") or txt:find("defeat") or txt:find("collect") or txt:find("talk") or txt:find("find") or txt:find("0/") or txt:find("1/") then
				return txt
			end
		end
	end
	return ""
end

-- 8. EKSEKUSI TOMBOL UTAMA
BtnQuest.MouseButton1Click:Connect(function()
	isQuestActive = not isQuestActive
	
	if isQuestActive then
		BtnQuest.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
		BtnQuest.Text = "AUTO QUEST MASTER: ON"
		
		task.spawn(function()
			while isQuestActive do
				local char = LocalPlayer.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local hrp = char.HumanoidRootPart
					local questText = dapatkanInfoQuestUI()
					
					-- A. Jika belum ambil misi / misi selesai -> Terbang ke NPC Misi
					if questText == "" then
						Status.Text = "Status: Ambil / Klaim Misi ke NPC..."
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
						
						for _, obj in ipairs(Workspace:GetDescendants()) do
							if obj:IsA("Model") and (obj.Name:lower():find("quest") or obj.Name:lower():find("npc")) then
								local npcHrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
								if npcHrp then
									terbangKe(npcHrp.CFrame * CFrame.new(0, 0, -3))
									for _, prompt in ipairs(obj:GetDescendants()) do
										if prompt:IsA("ProximityPrompt") and fireproximityprompt then
											fireproximityprompt(prompt)
										end
									end
									break
								end
							end
						end
					else
						Status.Text = "Status: Mengerjakan Misi...\n[" .. questText .. "]"
						Status.TextColor3 = Color3.fromRGB(100, 255, 150)
						
						-- B. Jika Misi Bertarung (Kill / Defeat)
						if questText:find("kill") or questText:find("defeat") or questText:find("kalahkan") then
							for _, mob in ipairs(Workspace:GetDescendants()) do
								if mob:IsA("Model") and mob:FindFirstChildOfClass("Humanoid") then
									local mobHrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
									local hum = mob:FindFirstChildOfClass("Humanoid")
									if mobHrp and hum and hum.Health > 0 and mob.Name ~= LocalPlayer.Name then
										-- Terbang melayang tepat di atas Mob
										terbangKe(mobHrp.CFrame * CFrame.new(0, 6, 0) * CFrame.Angles(math.rad(-90), 0, 0), 200)
										hitTarget()
										break
									end
								end
							end
						-- C. Jika Misi Non-Bertarung (Ambil Item / Bicara NPC / Antar Barang)
						else
							for _, obj in ipairs(Workspace:GetDescendants()) do
								if obj:IsA("BasePart") or obj:IsA("Model") then
									local namaObj = obj.Name:lower()
									if namaObj:find("item") or namaObj:find("candy") or namaObj:find("chest") or namaObj:find("target") then
										local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")) or obj
										if part then
											terbangKe(part.CFrame, 200)
											if firetouchinterest then
												firetouchinterest(hrp, part, 0)
												firetouchinterest(hrp, part, 1)
											end
											for _, prompt in ipairs(obj:GetDescendants()) do
												if prompt:IsA("ProximityPrompt") and fireproximityprompt then
													fireproximityprompt(prompt)
												end
											end
											break
										end
									end
								end
							end
						end
					end
				end
				task.wait(0.1)
			end
		end)
	else
		BtnQuest.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		BtnQuest.Text = "AUTO QUEST MASTER: OFF"
		Status.Text = "Status: Off"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
