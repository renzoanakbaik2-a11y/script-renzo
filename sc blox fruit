UserInputService.InputBegan:Connect(function(input, gpe)
    if not MapClickMode or gpe then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local mousePos = UserInputService:GetMouseLocation()
        local unitRay = camera:ViewportPointToRay(mousePos.X, mousePos.Y)
        
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {player.Character, HighlightFolder}
        
        local result = workspace:Raycast(unitRay.Origin, unitRay.Direction * 3000, rayParams)
        if result and result.Instance then
            local hitPart = result.Instance
            HighlightFolder:ClearAllChildren()
            
            local box = Instance.new("SelectionBox")
            box.Adornee = hitPart
            box.Color3 = Color3.fromRGB(0, 255, 128)
            box.LineThickness = 0.1
            box.Parent = HighlightFolder
            
            MainFrame.Visible = true
            renderHierarchy(hitPart, hitPart.Name)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if PullMode then
        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local myPos = char.HumanoidRootPart.CFrame
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and not obj.Anchored and obj ~= char and not obj:IsDescendantOf(char) then
                        if obj.Size.X < 5 and obj.Size.Y < 5 and obj.Size.Z < 5 then
                            obj.CFrame = myPos + Vector3.new(0, 2, 0)
                        end
                    end
                end
            end
        end)
    end
    
    if FullbrightMode then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
    end
    
    if NoclipMode then
        pcall(function()
            local char = player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end)

