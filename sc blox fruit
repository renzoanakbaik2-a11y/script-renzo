local function getIslandName(position)
    local x, z = position.X, position.Z
    if math.abs(x) < 2000 and math.abs(z) < 2000 then
        return "Starter Area"
    elseif x > 2000 then
        return "Marine Fortress"
    elseif x < -2000 then
        return "Skypiea"
    elseif z > 3000 then
        return "Ice Island"
    elseif z < -3000 then
        return "Magma Island"
    else
        return "Open Sea"
    end
end

local function isRealSpawnedFruit(obj)
    if not obj or not obj.Parent then return false end
    if obj.Parent ~= Workspace then return false end

    local officialFruits = {
        "rocket", "spin", "spring", "chop", "spike", "flame", "falcon", "ice", 
        "sand", "dark", "diamond", "light", "rubber", "barrier", "ghost", 
        "magma", "quake", "buddha", "love", "spider", "phoenix", 
        "portal", "pain", "blizzard", "gravity", "mammoth", "trex", "dough", 
        "shadow", "venom", "control", "spirit", "dragon", "leopard", "kitsune"
    }

    local objNameLower = obj.Name:lower()
    for _, fruitName in ipairs(officialFruits) do
        if objNameLower:find(fruitName) then
            if not objNameLower:find("pot") and not objNameLower:find("controller") then
                return obj:IsA("Tool") or objNameLower:sub(-5) == "fruit" or obj:FindFirstChild("Handle")
            end
        end
    end
    return false
end

