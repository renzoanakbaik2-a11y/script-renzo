-- ==============================================================================
-- LOGIKA UTAMA: PENCARIAN OBJEK "SHUTTLE" + AUTO HIT & TELEPORT
-- ==============================================================================
local function findNearestShuttle()
    local nearestShuttle = nil
    local shortestDistance = math.huge
    
    -- Menggunakan GetDescendants agar bisa mencari sampai ke dalam folder di Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "Shuttle" or obj.Name == "Shuttlecock" or obj.Name == "Ball") then
            local distance = (humanoidRootPart.Position - obj.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestShuttle = obj
            end
        end
    end
    
    return nearestShuttle, shortestDistance
end

RunService.RenderStepped:Connect(function()
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        character = player.Character
        if character then
            humanoidRootPart = character:WaitForChild("HumanoidRootPart")
        end
        return 
    end

    local shuttle, distance = findNearestShuttle()
    
    if shuttle then
        -- 1. Logika Auto Teleport mendekati Shuttle
        if CONFIG.AutoTeleportEnabled and distance <= CONFIG.TeleportDistance and distance > CONFIG.HitDistance then
            local offset = Vector3.new(CONFIG.TeleportOffset[1], CONFIG.TeleportOffset[2], CONFIG.TeleportOffset[3])
            local targetPosition = shuttle.Position + offset
            humanoidRootPart.CFrame = CFrame.new(targetPosition, shuttle.Position)
        end
        
        -- 2. Logika Auto Hit ketika Shuttle berada di jangkauan pukul
        if CONFIG.AutoHitEnabled and distance <= CONFIG.HitDistance then
            local characterTool = character:FindFirstChildOfClass("Tool")
            if characterTool then
                characterTool:Activate()
            end
        end
    end
end)

