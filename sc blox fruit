-- 2. PENULUSURAN TARGET MOBS DINAMIS
local function GetNearestTarget()
    local nearestEnemy = nil
    local shortestDistance = math.huge
    
    local mobsFolder = Workspace:FindFirstChild("Mobs") or Workspace:FindFirstChild("Enemies")
    if not mobsFolder then return nil end

    for _, subFolder in ipairs(mobsFolder:GetChildren()) do
        local models = subFolder:IsA("Model") and {subFolder} or subFolder:GetChildren()
        for _, enemyModel in ipairs(models) do
            if enemyModel:IsA("Model") and enemyModel ~= Character then
                local enemyHum = enemyModel:FindFirstChildOfClass("Humanoid")
                local enemyRoot = enemyModel:FindFirstChild("HumanoidRootPart") or enemyModel.PrimaryPart
                
                if enemyRoot and enemyHum and enemyHum.Health > 0 then
                    local dist = (RootPart.Position - enemyRoot.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearestEnemy = enemyRoot
                    end
                end
            end
        end
    end
    
    return nearestEnemy
end

-- 3. AUTO-EQUIP & ATTACK
local function AutoAttack()
    local now = tick()
    if now - lastAttackTime < CONFIG.ATTACK_DELAY then return end
    lastAttackTime = now

    local tool = Character:FindFirstChildOfClass("Tool")
    if not tool then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local backpackTool = backpack:FindFirstChildOfClass("Tool")
            if backpackTool then
                Humanoid:EquipTool(backpackTool)
                tool = backpackTool
            end
        end
    end
    
    if tool then
        tool:Activate()
    end
end

-- 4. GACHA 2 PETI (KLAIM 2 DARI 3 PETI GRATIS)
local function ClaimGachaChests()
    if isLooting then return end
    isLooting = true
    
    task.wait(1.5)
    
    local chestsFolder = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
    if chestsFolder then
        local allChests = chestsFolder:GetChildren()
        if #allChests >= 3 then
            local availableIndices = {1, 2, 3}
            local selectedChests = {}
            
            for i = 1, 2 do
                local randomIndex = math.random(1, #availableIndices)
                table.insert(selectedChests, allChests[availableIndices[randomIndex]])
                table.remove(availableIndices, randomIndex)
            end
            
            for _, chest in ipairs(selectedChests) do
                local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt)
                    task.wait(0.8)
                end
            end
        end
    end
    
    task.wait(1)
    isLooting = false
end

-- 5. CALCULATE FLYING ORBIT CFRAME
local function CalculateFlyOrbitCFrame(enemyRoot, dt)
    orbitAngle = orbitAngle + (dt * CONFIG.ORBIT_SPEED)
    
    local enemyPos = enemyRoot.Position
    -- Hitung koordinat melingkar di udara di atas kepala musuh
    local offsetX = math.cos(orbitAngle) * CONFIG.ORBIT_RADIUS
    local offsetZ = math.sin(orbitAngle) * CONFIG.ORBIT_RADIUS
    local flyPos = Vector3.new(enemyPos.X + offsetX, enemyPos.Y + CONFIG.FLY_HEIGHT, enemyPos.Z + offsetZ)
    
    -- Karakter melayang sambil terus menghadap ke arah posisi musuh
    return CFrame.new(flyPos, enemyPos)
end

-- 6. TOGGLE EVENT & MAIN LOOP
ToggleBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    
    if isAutoFarm then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "AUTO FARM: ON"
        
        heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
            if not isAutoFarm then return end
            
            Character = LocalPlayer.Character
            if not Character then return end
            RootPart = Character:FindFirstChild("HumanoidRootPart")
            Humanoid = Character:FindFirstChildOfClass("Humanoid")
            if not RootPart or not Humanoid then return end
            
            -- Netralkan Gravitasi Roblox agar Karakter Melayang Mulus di Udara
            RootPart.AssemblyLinearVelocity = Vector3.zero
            
            -- Validasi Target Terkini
            local isTargetValid = false
            if currentTargetRoot and currentTargetRoot.Parent then
                local enemyHum = currentTargetRoot.Parent:FindFirstChildOfClass("Humanoid")
                if enemyHum and enemyHum.Health > 0 then
                    isTargetValid = true
                end
            end
            
            if not isTargetValid then
                currentTargetRoot = GetNearestTarget()
            end
            
            if currentTargetRoot then
                -- Pindahkan CFrame karakter melayang + memutar di atas musuh
                RootPart.CFrame = CalculateFlyOrbitCFrame(currentTargetRoot, dt)
                AutoAttack()
            else
                -- Jika musuh habis (Dungeon selesai), klaim gacha 2 peti
                local chests = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
                if chests and #chests:GetChildren() > 0 and not isLooting then
                    ClaimGachaChests()
                end
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleBtn.Text = "AUTO FARM: OFF"
        currentTargetRoot = nil
        
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end
end)
