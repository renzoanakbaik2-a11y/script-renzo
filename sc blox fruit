                end
                lastStatus = "Ada"
            elseif not hasFruitNow and lastStatus ~= "Kosong" then
                if Settings.FruitNotifier then
                    showCustomNotification("❌ Tidak ada buah di map.", Color3.fromRGB(231, 76, 60))
                end
                lastStatus = "Kosong"
            end

            if hasFruitNow then
                if Settings.AutoCollectFruit and not activeFlyConnection then
                    collectNearestFruit()
                end
            end
        end)
    end
end)

