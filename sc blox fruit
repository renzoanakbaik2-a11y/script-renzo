-- 2. CARI MUSUH TERDEKAT (Nearest Mob First)
local function GetNearestTarget()
    local nearestEnemy = nil
    local shortestDistance = math.huge
    local folderEnemies = Workspace:FindFirstChild("Enemies") or Workspace:FindFirstChild("Mobs")
    
    if not folderEnemies then return nil end

    for _, enemy in pairs(folderEnemies:GetChildren()) do
        local enemyRoot = enemy:FindFirstChild("HumanoidRootPart") or enemy:FindFirstChild("PrimaryPart")
        local enemyHumanoid = enemy:FindFirstChildOfClass("Humanoid")
        
        if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 then
            local distance = (RootPart.Position - enemyRoot.Position).Magnitude
            
            -- Raycast obstacle check
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {Character, enemy}
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            local rayResult = Workspace:Raycast(RootPart.Position, (enemyRoot.Position - RootPart.Position), rayParams)
            
            if not rayResult and distance < shortestDistance then
                shortestDistance = distance
                nearestEnemy = enemy
            end
        end
    end
    return nearestEnemy
end

-- 3. LOGIKA GACHA 2 PETI (RECURSIVE PROXIMITY PROMPT FIX)
local function ClaimGachaChests()
    if isLooting then return end
    isLooting = true
    
    task.wait(1.5)
    
    local chestsFolder = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
    
    if chestsFolder then
        local allChests = chestsFolder:GetChildren()
        
        if #allChests >= 3 then
            local availableIndices = {1, 2, 3}
            local selectedChests = {}
            
            -- Gacha kocok 2 dari 3
            for i = 1, 2 do
                local randomIndex = math.random(1, #availableIndices)
                table.insert(selectedChests, allChests[availableIndices[randomIndex]])
                table.remove(availableIndices, randomIndex)
            end
            
            -- Buka peti hasil gacha (Recursive prompt search)
            for _, chest in ipairs(selectedChests) do
                local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt)
                    task.wait(0.8)
                end
            end
        end
    end
    
    task.wait(1)
    isLooting = false
end

-- 4. HITUNG POSISI ORBIT (HEIGHT LOCK FIX)
local function CalculateBackArcCFrame(enemyRoot, dt)
    orbitTime = orbitTime + (dt * CONFIG.ORBIT_SPEED)
    local angleOffset = math.sin(orbitTime) * math.rad(CONFIG.ORBIT_ANGLE_MAX)
    
    -- Ambil CFrame musuh tapi sesuaikan Y-Axis agar tidak melayang
    local enemyPos = enemyRoot.Position
    local targetPos = Vector3.new(enemyPos.X, RootPart.Position.Y, enemyPos.Z)
    local adjustedEnemyCFrame = CFrame.new(targetPos, targetPos + enemyRoot.CFrame.LookVector)
    
    local backPos = adjustedEnemyCFrame * CFrame.Angles(0, math.pi + angleOffset, 0) * CFrame.new(0, 0, CONFIG.ATTACK_RANGE)
    return CFrame.new(backPos.Position, targetPos)
end

-- 5. SIMULASI SERANGAN AUTOMATIS
local function AutoAttack()
    -- Mengirim klik kiri mouse untuk menebas pedang
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- 6. TOGGLE EVENT & HEARTBEAT DISCONNECT FIX
ToggleBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    
    if isAutoFarm then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "AUTO FARM: ON"
        
        -- Start Loop
        heartbeatConnection = RunService.Heartbeat:Connect(function(dt)
            if not isAutoFarm then return end
            
            -- Anti Stun State Check
            local state = Humanoid:GetState()
            if state == Enum.HumanoidStateType.Physics or state == Enum.HumanoidStateType.Ragdoll then
                return 
            end
            
            -- Re-check target
            if not currentTarget or not currentTarget:FindFirstChildOfClass("Humanoid") or currentTarget:FindFirstChildOfClass("Humanoid").Health <= 0 then
                currentTarget = GetNearestTarget()
            end
            
            if currentTarget then
                local enemyRoot = currentTarget:FindFirstChild("HumanoidRootPart") or currentTarget:FindFirstChild("PrimaryPart")
                if enemyRoot then
                    local dist = (RootPart.Position - enemyRoot.Position).Magnitude
                    
                    if dist > CONFIG.MAX_APPROACH_DIST then
                        -- Jika terlalu jauh, dekati pakai MoveTo biar tidak terdeteksi teleport anti-cheat
                        Humanoid:MoveTo(enemyRoot.Position)
                    else
                        -- Jika sudah dekat, kunci dengan Back-Arc Orbit
                        RootPart.CFrame = RootPart.CFrame:Lerp(CalculateBackArcCFrame(enemyRoot, dt), 0.3)
                        AutoAttack() -- Serang musuh!
                    end
                end
            else
                -- Jika musuh habis, buka gacha peti
                local chests = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
                if chests and #chests:GetChildren() > 0 and not isLooting then
                    ClaimGachaChests()
                end
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleBtn.Text = "AUTO FARM: OFF"
        currentTarget = nil
        
        -- Disconnect Event untuk cegah memory leak
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end
end)
