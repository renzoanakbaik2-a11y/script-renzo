-- ==============================================================================
-- SISTEM GARIS ESP & AUTO FARM DENGAN DAMAGE 999999
-- ==============================================================================
local espBeam = Drawing.new("Line")
espBeam.Visible = false
espBeam.Color = Color3.fromRGB(0, 255, 128)
espBeam.Thickness = 2
espBeam.Transparency = 1

RunService.RenderStepped:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        espBeam.Visible = false
        return
    end
    
    local humanoidRootPart = character.HumanoidRootPart
    local targetPart = nil
    local shortestDist = math.huge

    -- Cari target musuh terdekat
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
            if hum and hum.Health > 0 and root then
                local dist = (humanoidRootPart.Position - root.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    targetPart = root
                end
            end
        end
    end

    -- Update Garis ESP ke Target (Killer Area)
    if CONFIG.ESPLine and targetPart then
        local vector, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            espBeam.From = Vector2.new(Workspace.CurrentCamera.ViewportSize.X / 2, Workspace.CurrentCamera.ViewportSize.Y)
            espBeam.To = Vector2.new(vector.X, vector.Y)
            espBeam.Visible = true
        else
            espBeam.Visible = false
        end
    else
        espBeam.Visible = false
    end

    -- Eksekusi Auto Farm, Teleport, & Damage 999999
    if CONFIG.AutoFarm and targetPart then
        if (humanoidRootPart.Position - targetPart.Position).Magnitude > 15 then
            humanoidRootPart.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 3, 0))
        end
        
        -- Mengirim Damage 999999 ke Remote Event game
        pcall(function()
            for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                if remote:IsA("RemoteEvent") and (remote.Name:lower():find("damage") or remote.Name:lower():find("hit") or remote.Name:lower():find("attack")) then
                    remote:FireServer(999999)
                end
            end
        end)
    end
end)

print("⚡ PIXEL QUEST: MENU + DAMAGE 999999 & ESP BERHASIL DIMUAT! ⚡")
