-- LOGIKA SURVIVOR MODE (MASUK DALAM ZONA AMAN)
BtnSurvivor.MouseButton1Click:Connect(function()
	isSurvivorActive = not isSurvivorActive
	if isSurvivorActive then
		isHunterActive = false
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		
		BtnSurvivor.Text = "SURVIVOR MODE: ON"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			while isSurvivorActive do
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				
				if myHrp then
					if reachedZonePart then
						if not reachedZonePart:IsDescendantOf(Workspace) or (reachedZonePart.Position - myHrp.Position).Magnitude > 45 then
							reachedZonePart = nil
						end
					end
					
					if not reachedZonePart then
						local targetGaris = cariGarisAmanTerdepan()
						if targetGaris then
							Status.Text = "Status: Terbang Masuk dalam Zona Aman..."
							Status.TextColor3 = Color3.fromRGB(100, 255, 150)
							
							-- Mendorong titik pendaratan 8 stud MELEWATI garis ke dalam zona aman
							local arahTerbang = (targetGaris.Position - myHrp.Position).Unit
							local cframeDalamZona = CFrame.new(targetGaris.Position + (arahTerbang * 8) + Vector3.new(0, 2, 0), targetGaris.Position + (arahTerbang * 15))
							
							terbangMulus(cframeDalamZona, 85)
							
							-- Trigger fisik ke garis dan area sekitar
							if firetouchinterest then
								firetouchinterest(myHrp, targetGaris, 0)
								firetouchinterest(myHrp, targetGaris, 1)
							end
							
							reachedZonePart = targetGaris
						else
							Status.Text = "Status: Standby (Menunggu Zona Depan)"
							Status.TextColor3 = Color3.fromRGB(200, 200, 100)
						end
					else
						Status.Text = "Status: Aman Dalam Zona (Terkunci)"
						Status.TextColor3 = Color3.fromRGB(100, 200, 255)
					end
				end
				task.wait(0.3)
			end
		end)
	else
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
		reachedZonePart = nil
		if activeTween then
			activeTween:Cancel()
			activeTween = nil
		end
	end
end)

-- LOGIKA HUNTER MODE
BtnHunter.MouseButton1Click:Connect(function()
	isHunterActive = not isHunterActive
	if isHunterActive then
		isSurvivorActive = false
		BtnSurvivor.Text = "SURVIVOR MODE: OFF"
		BtnSurvivor.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		
		BtnHunter.Text = "HUNTER MODE: ON"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
		
		task.spawn(function()
			while isHunterActive do
				local myChar = LocalPlayer.Character
				local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
				
				if myHrp then
					local targetPlayer = cariTargetSurvivorPresisi()
					
					if targetPlayer and targetPlayer.Character then
						local targetChar = targetPlayer.Character
						local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
						
						if targetHrp then
							Status.Text = "Status: Lock On [" .. targetPlayer.Name .. "]"
							Status.TextColor3 = Color3.fromRGB(255, 100, 100)
							
							local startTime = tick()
							local stickyConnection
							
							stickyConnection = RunService.Heartbeat:Connect(function()
								if isHunterActive and targetHrp and targetHrp.Parent and (tick() - startTime < 0.4) then
									netralkanFisika(myChar)
									
									local targetPos = targetHrp.Position
									local arahLari = targetHrp.AssemblyLinearVelocity * 0.03
									local posTujuan = targetPos + arahLari
									
									myHrp.CFrame = CFrame.lookAt(posTujuan, targetPos)
									eksekusiPukulHunter(targetChar)
								else
									if stickyConnection then
										stickyConnection:Disconnect()
									end
								end
							end)
							
							task.wait(0.4)
							if stickyConnection then stickyConnection:Disconnect() end
							netralkanFisika(myChar)
						end
					else
						Status.Text = "Status: Mencari Target Survivor..."
						Status.TextColor3 = Color3.fromRGB(200, 200, 100)
					end
				end
				task.wait(0.05)
			end
		end)
	else
		BtnHunter.Text = "HUNTER MODE: OFF"
		BtnHunter.BackgroundColor3 = Color3.fromRGB(215, 40, 40)
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
