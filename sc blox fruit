-- LOGIKA DEEP SCANNER
ScanBtn.MouseButton1Click:Connect(function()
    LogBox.Text = "Scanning Deep Garbage Collector & Nil Instances..."
    task.wait(0.2)

    local report = "=== HASIL BONGKAR MEMORI GAME ===\n\n"

    -- 1. SCAN DARI GARBAGE COLLECTOR (getgc)
    report = report .. "[1. MODUL & FUNCTION TERSEMBUNYI (GETGC)]\n"
    if getgc then
        local gc = getgc(true)
        local gcCount = 0
        for _, v in ipairs(gc) do
            if type(v) == "table" then
                for k2, v2 in pairs(v) do
                    local strK = tostring(k2):lower()
                    if strK:find("buy") or strK:find("purchase") or strK:find("roll") or strK:find("fisherman") then
                        report = report .. "-> GC Table Key: " .. tostring(k2) .. " | Value: " .. tostring(v2) .. "\n"
                        gcCount = gcCount + 1
                        if gcCount >= 10 then break end
                    end
                end
            elseif type(v) == "function" and islclosure and islclosure(v) and not isexecutorclosure(v) then
                local info = debug.getinfo(v)
                if info.name and (info.name:lower():find("buy") or info.name:lower():find("purchase")) then
                    report = report .. "-> Func: " .. info.name .. " (Line: " .. tostring(info.linedefined) .. ")\n"
                end
            end
            if gcCount >= 10 then break end
        end
    else
        report = report .. "getgc tidak didukung executor ini.\n"
    end

    -- 2. SCAN NIL INSTANCES (OBJEK DISAMBUNG DARI WORKSPACE)
    report = report .. "\n[2. NIL INSTANCES / OBJEK TERSEMBUNYI]\n"
    if getnilinstances then
        local nilObjs = getnilinstances()
        for _, obj in ipairs(nilObjs) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                report = report .. "-> Nil Remote: " .. obj.Name .. " (" .. obj.ClassName .. ")\n"
            end
        end
    else
        report = report .. "getnilinstances tidak didukung.\n"
    end

    -- 3. SCAN SELURUH REPLICATEDSTORAGE TANPA FILTER NAMA
    report = report .. "\n[3. DAFTAR SEMUA REMOTE DI REPLICATEDSTORAGE]\n"
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("BindableEvent") then
            report = report .. "-> " .. obj.ClassName .. ": " .. obj.Name .. " | Parent: " .. obj.Parent.Name .. "\n"
        end
    end

    -- 4. SCAN SEMUA BILLBOARD/SURFACE GUI DI WORKSPACE
    report = report .. "\n[4. GUI 3D / BILLBOARD DI WORKSPACE]\n"
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BillboardGui") or obj:IsA("SurfaceGui") then
            report = report .. "-> GUI 3D: " .. obj.Name .. " | Parent: " .. obj.Parent.Name .. "\n"
            for _, child in ipairs(obj:GetDescendants()) do
                if child:IsA("TextLabel") or child:IsA("TextButton") then
                    report = report .. "   └ Teks: '" .. child.Text .. "' (" .. child.Name .. ")\n"
                end
            end
        end
    end

    report = report .. "\n=== PEMINDAIAN SELESAI ==="
    LogBox.Text = report
end)
