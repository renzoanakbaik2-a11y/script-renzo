-- 2. SCAN TARGET DINAMIS SUB-FOLDER MOBS
local function GetNearestTargetDynamic()
    local nearestEnemy = nil
    local shortestDistance = math.huge
    
    local mobsFolder = Workspace:FindFirstChild("Mobs") or Workspace:FindFirstChild("Enemies")
    if not mobsFolder then return nil end

    for _, subItem in pairs(mobsFolder:GetChildren()) do
        local targetsToScan = subItem:IsA("Model") and {subItem} or subItem:GetChildren()
        
        for _, enemyModel in pairs(targetsToScan) do
            if enemyModel:IsA("Model") then
                local enemyHumanoid = enemyModel:FindFirstChildOfClass("Humanoid")
                local enemyRoot = enemyModel:FindFirstChild("HumanoidRootPart") or enemyModel.PrimaryPart
                
                if enemyHumanoid and enemyRoot and enemyHumanoid.Health > 0 then
                    local distance = (RootPart.Position - enemyRoot.Position).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        nearestEnemy = enemyRoot
                    end
                end
            end
        end
    end
    
    return nearestEnemy
end

-- 3. AUTO-EQUIP & ATTACK
local function AutoAttack()
    local tool = Character:FindFirstChildOfClass("Tool")
    
    if not tool then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local backpackTool = backpack:FindFirstChildOfClass("Tool")
            if backpackTool then
                Humanoid:EquipTool(backpackTool)
                tool = backpackTool
            end
        end
    end
    
    if tool then
        tool:Activate()
    end
end

-- 4. GACHA 2 CHEST CLAIM
local function ClaimGachaChests()
    if isLooting then return end
    isLooting = true
    
    task.wait(1.5)
    
    local chestsFolder = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
    
    if chestsFolder then
        local allChests = chestsFolder:GetChildren()
        
        if #allChests >= 3 then
            local availableIndices = {1, 2, 3}
            local selectedChests = {}
            
            for i = 1, 2 do
                local randomIndex = math.random(1, #availableIndices)
                table.insert(selectedChests, allChests[availableIndices[randomIndex]])
                table.remove(availableIndices, randomIndex)
            end
            
            for _, chest in ipairs(selectedChests) do
                local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt)
                    task.wait(0.8)
                end
            end
        end
    end
    
    task.wait(1)
    isLooting = false
end

-- 5. KONTROL TERBANG & ANTI-GRAVITASI
local function EnableFlyPhysics()
    if not bodyVel then
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVel.Velocity = Vector3.new(0, 0, 0)
        bodyVel.Parent = RootPart
    end
    
    if not bodyGyro then
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
        bodyGyro.P = 10000
        bodyGyro.Parent = RootPart
    end
    
    Humanoid.PlatformStand = true
end

local function DisableFlyPhysics()
    if bodyVel then
        bodyVel:Destroy()
        bodyVel = nil
    end
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    
    Humanoid.PlatformStand = false
end

-- 6. TOGGLE EVENT & CORE LOOP
ToggleBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    
    if isAutoFarm then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "AUTO FARM: ON"
        
        EnableFlyPhysics()
        
        heartbeatConnection = RunService.Heartbeat:Connect(function()
            if not isAutoFarm then return end
            
            -- Re-check Character & RootPart
            if not Character or not RootPart or not Humanoid then return end
            
            -- Validasi Target Musuh
            local isTargetValid = false
            if currentTargetRoot and currentTargetRoot.Parent and currentTargetRoot:IsDescendantOf(Workspace) then
                local enemyHum = currentTargetRoot.Parent:FindFirstChildOfClass("Humanoid")
                if enemyHum and enemyHum.Health > 0 then
                    isTargetValid = true
                end
            end
            
            if not isTargetValid then
                currentTargetRoot = GetNearestTargetDynamic()
            end
            
            if currentTargetRoot then
                local enemyPos = currentTargetRoot.Position
                local targetFlyPos = Vector3.new(enemyPos.X, enemyPos.Y + CONFIG.FLY_HEIGHT, enemyPos.Z)
                
                -- Pindahkan posisi secara fisik di udara
                RootPart.CFrame = CFrame.new(targetFlyPos, enemyPos)
                if bodyGyro then bodyGyro.CFrame = CFrame.new(targetFlyPos, enemyPos) end
                
                AutoAttack()
            else
                -- Jika musuh habis, klaim 2 peti acak
                local chests = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
                if chests and #chests:GetChildren() > 0 and not isLooting then
                    ClaimGachaChests()
                end
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleBtn.Text = "AUTO FARM: OFF"
        currentTargetRoot = nil
        
        DisableFlyPhysics()
        
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end
end)
