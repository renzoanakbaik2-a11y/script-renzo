-- 3. LOGIKA CARI BOLA (LEBIH PINTAR & LENGKAP)
local function cariBola()
	-- Cari di seluruh Workspace (termasuk di dalam folder-folder)
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local nama = obj.Name:lower()
			-- Deteksi berbagai kemungkinan nama bola di Roblox
			if nama:find("ball") or nama:find("bola") or nama:find("tps") or nama:find("football") or nama:find("soccer") then
				return obj
			end
		end
	end
	return nil
end

-- 4. LOGIKA MUKUL LENGKAP
local function eksekusiMukul(tool)
	if not tool then return end
	
	-- Cara 1: Menggunakan :Activate() standar Roblox
	pcall(function()
		tool:Activate()
	end)
	
	-- Cara 2: Jika alat punya event / script pemukul bawaan (RemoteEvent)
	for _, child in ipairs(tool:GetDescendants()) do
		if child:IsA("RemoteEvent") then
			pcall(function()
				child:FireServer()
			end)
		end
	end
end

-- 5. LOGIKA UTAMA TELEPORT + MUKUL
local isRunning = false

local function kejarDanPukul()
	local char = LocalPlayer.Character
	if not char then return end
	
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	-- Equip Senjata Otomatis
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			tool = backpack:FindFirstChildOfClass("Tool")
			if tool then
				tool.Parent = char
			end
		end
	end
	
	-- Cari Bola
	local bola = cariBola()
	if bola then
		-- Teleport Tepat di Samping/Atas Bola
		hrp.CFrame = bola.CFrame * CFrame.new(0, 2, 2)
		
		-- Eksekusi Pemukul
		eksekusiMukul(tool)
		
		Status.Text = "Status: Menemukan [" .. bola.Name .. "] & Mukul!"
		Status.TextColor3 = Color3.fromRGB(100, 255, 150)
	else
		Status.Text = "Status: Bola tidak ditemukan di Workspace!"
		Status.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
end

-- 6. PENGHUBUNG TOMBOL
Tombol.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	
	if isRunning then
		Tombol.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
		Tombol.Text = "AUTO CHASE & HIT: ON"
		
		task.spawn(function()
			while isRunning do
				kejarDanPukul()
				task.wait(0.05) -- Jeda lebih cepat biar langsung nempel & mukul terus
			end
		end)
	else
		Tombol.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		Tombol.Text = "AUTO CHASE & HIT: OFF"
		Status.Text = "Status: Off"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
