local CONFIG = {
    FLY_HEIGHT = 10.0,   -- Ketinggian melayang di atas musuh (studs)
    ORBIT_RADIUS = 6.0,  -- Radius lingkaran orbit di atas musuh
    ORBIT_SPEED = 2.5,   -- Kecepatan putaran orbit
    ATTACK_DELAY = 0.12 -- Jeda tebasan pedang
}

local isAutoFarm = false
local isLooting = false
local currentTargetRoot = nil
local heartbeatConnection = nil
local orbitAngle = 0
local lastAttackTime = 0

