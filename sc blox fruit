                -- Ambil folder induknya (Parent)
                local parentFolder = obj.Parent
                if parentFolder then
                    openFolder(parentFolder, obj.Name)
                else
                	StatusLabel.Text = "Blok [" .. obj.Name .. "] tidak punya folder induk."
                end
