local function renderHierarchy(targetObj, objectName)
    for _, child in pairs(RightScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    
    StatusLabel.Text = "Target Dikunci: [" .. objectName .. "]"
    
    local current = targetObj.Parent
    local lineage = {}
    while current and current ~= game do
        table.insert(lineage, 1, current)
        current = current.Parent
    end
    
    local count = 0
    for _, folderItem in ipairs(lineage) do
        count = count + 1
        local fBtn = Instance.new("TextButton")
        fBtn.Size = UDim2.new(1, -6, 0, 28)
        fBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        fBtn.TextColor3 = Color3.fromRGB(255, 215, 0)
        fBtn.Font = Enum.Font.Code
        fBtn.TextSize = 10
        fBtn.Text = "📁 " .. folderItem.Name .. " [" .. folderItem.ClassName .. "]"
        fBtn.TextXAlignment = Enum.TextXAlignment.Left
        fBtn.Parent = RightScroll
        Instance.new("UICorner", fBtn).CornerRadius = UDim.new(0, 5)
        
        fBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(RightScroll:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            StatusLabel.Text = "Isi folder: " .. folderItem.Name
            
            local subCount = 0
            for _, subObj in pairs(folderItem:GetChildren()) do
                subCount = subCount + 1
                local subBtn = Instance.new("TextButton")
                subBtn.Size = UDim2.new(1, -6, 0, 26)
                subBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
                subBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
                subBtn.Font = Enum.Font.Code
                subBtn.TextSize = 10
                subBtn.Text = "   - " .. subObj.Name .. " [" .. subObj.ClassName .. "]"
                subBtn.TextXAlignment = Enum.TextXAlignment.Left
                subBtn.Parent = RightScroll
                Instance.new("UICorner", subBtn).CornerRadius = UDim.new(0, 5)
            end
            RightScroll.CanvasSize = UDim2.new(0, 0, 0, subCount * 30)
        end)
    end
    RightScroll.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

