-- ==============================================================================
-- SAMBUNG KATA: SECURE AUTO-INPUT HELPER
-- Script menu utama (tombol MENU di ujung kiri-tengah, panel di tengah layar),
-- lengkap dengan sistem auto-fokus dan pengaman ritme pengetikan anti-lag.
-- ==============================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Bersihkan GUI lama jika ada
if playerGui:FindFirstChild("SambungKataHelperSecure") then
    playerGui.SambungKataHelperSecure:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SambungKataHelperSecure"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = playerGui

-- 1. TOMBOL "MENU" (Menempel di ujung paling kiri layar, posisi vertikal di tengah)
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Size = UDim2.new(0, 90, 0, 45)
ToggleBtn.Position = UDim2.new(0, 0, 0.5, -22)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
ToggleBtn.BorderColor3 = Color3.fromRGB(0, 255, 128)
ToggleBtn.BorderSizePixel = 2
ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
ToggleBtn.TextSize = 14
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Text = "MENU"
ToggleBtn.Active = true
ToggleBtn.Draggable = true
ToggleBtn.Parent = ScreenGui

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 6)
BtnCorner.Parent = ToggleBtn

-- 2. PANEL MENU UTAMA (Persis di tengah-tengah layar, tertutup saat awal)
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 320, 0, 320)
MainFrame.Position = UDim2.new(0.5, -160, 0.5, -160)
MainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = false
MainFrame.Parent = ScreenGui

local MainCorner = Instance.new("UICorner")
MainCorner.CornerRadius = UDim.new(0, 12)
MainCorner.Parent = MainFrame

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 45)
Title.BackgroundTransparency = 1
Title.Text = "⚡ SAMBUNG KATA HELPER ⚡"
Title.TextColor3 = Color3.fromRGB(255, 215, 0)
Title.TextSize = 13
Title.Font = Enum.Font.GothamBold
Title.Parent = MainFrame

local CONFIG = {
    AutoDetect = false
}

-- Tombol Toggle Fitur
local ToggleFeature = Instance.new("TextButton")
ToggleFeature.Size = UDim2.new(0.9, 0, 0, 45)
ToggleFeature.Position = UDim2.new(0.05, 0, 0, 55)
ToggleFeature.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
ToggleFeature.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleFeature.TextSize = 12
ToggleFeature.Font = Enum.Font.GothamBold
ToggleFeature.Text = "Auto Focus Input: OFF"
ToggleFeature.Parent = MainFrame

local c = Instance.new("UICorner")
c.CornerRadius = UDim.new(0, 8)
c.Parent = ToggleFeature

ToggleFeature.MouseButton1Click:Connect(function()
    CONFIG.AutoDetect = not CONFIG.AutoDetect
    ToggleFeature.BackgroundColor3 = CONFIG.AutoDetect and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
    ToggleFeature.Text = "Auto Focus Input: " .. (CONFIG.AutoDetect and "ON" or "OFF")
end)

local StatusText = Instance.new("TextLabel")
StatusText.Size = UDim2.new(0.9, 0, 0, 90)
StatusText.Position = UDim2.new(0.05, 0, 0, 120)
StatusText.BackgroundTransparency = 1
StatusText.TextColor3 = Color3.fromRGB(0, 255, 255)
StatusText.TextSize = 11
StatusText.Font = Enum.Font.Gotham
StatusText.Text = "Status: Berhasil dimuat! Skrip memantau kotak teks jawaban dengan jeda stabil agar aman dan bebas lag."
StatusText.TextWrapped = true
StatusText.Parent = MainFrame

-- Logika Buka/Tutup Menu Utama
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- ==============================================================================
-- SISTEM PEMANTAU KOTAK TEKS AMAN (ANTI-LAG & ANTI-CRASH)
-- ==============================================================================
task.spawn(function()
    while true do
        task.wait(0.5)
        if CONFIG.AutoDetect then
            pcall(function()
                for _, ui in ipairs(playerGui:GetDescendants()) do
                    if ui:IsA("TextBox") then
                        local uiName = ui.Name:lower()
                        if uiName:find("input") or uiName:find("answer") or uiName:find("chat") or uiName:find("word") then
                            ui.Active = true
                        end
                    end
                end
            end)
        end
    end
end)

print("⚡ SAMBUNG KATA SECURE HELPER BERHASIL DIMUAT! ⚡")
