-- 2. DETEKSI PULAU / LOKASI BERDASARKAN POSISI
-- =====================================================================
local function getIslandName(position)
    -- Deteksi sederhana area pulau di Blox Fruits berdasarkan koordinat X dan Z
    local x, z = position.X, position.Z
    if math.abs(x) < 2000 and math.abs(z) < 2000 then
        return "Starter / Middle Area"
    elseif x > 2000 then
        return "Marine Fortress / Prison Area"
    elseif x < -2000 then
        return "Skypiea / Jungle Area"
    elseif z > 3000 then
        return "Ice / Volcano Area"
    elseif z < -3000 then
        return "Magma / Underwater Area"
    else
        return "Open Sea / Island"
    end
end

-- =====================================================================
-- 3. SISTEM TERBANG MULUS + NOCLIP + ANTI-CAMERA BUG
-- =====================================================================
local activeFlyConnection = nil
local function smoothFlyTo(targetCFrame, checkSettingKey)
    local rootPart = getCharacterRootPart()
    if not rootPart then return end

    if activeFlyConnection then
        activeFlyConnection:Disconnect()
        activeFlyConnection = nil
    end

    local currentSpeed = math.clamp(Settings.FlightSpeed, 30, 500)
    local currentHeight = math.clamp(Settings.FlyHeight, 0, 15)
    local adjustedTarget = targetCFrame.Position + Vector3.new(0, currentHeight, 0)

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = true end

    local noclipConnection
    noclipConnection = RunService.Stepped:Connect(function()
        pcall(function()
            if character then
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end)

    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Parent = rootPart

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart

    activeFlyConnection = RunService.Heartbeat:Connect(function()
        if checkSettingKey and not Settings[checkSettingKey] then
            if noclipConnection then noclipConnection:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        local currentRoot = getCharacterRootPart()
        if not currentRoot or not character or not character.Parent then
            if noclipConnection then noclipConnection:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        local currentPos = currentRoot.Position
        local targetPos = adjustedTarget
        local direction = (targetPos - currentPos)
        local distance = direction.Magnitude

        if distance < 4 then
            if noclipConnection then noclipConnection:Disconnect() end
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
            if humanoid then humanoid.PlatformStand = false end
            if activeFlyConnection then activeFlyConnection:Disconnect() activeFlyConnection = nil end
            return
        end

        bodyVelocity.Velocity = direction.Unit * math.min(currentSpeed, distance * 15)
        bodyGyro.CFrame = CFrame.new(currentPos, targetPos)
    end)
end

-- =====================================================================
-- 4. FILTER BUAH & ESP BUAH MENGETAHUI JARAK, NAMA, & PULAU
-- =====================================================================
local function isRealSpawnedFruit(obj)
    if not obj or not obj.Parent then return false end
    if obj.Parent ~= Workspace then return false end

    local officialFruits = {
        "rocket", "spin", "spring", "chop", "spike", "flame", "falcon", "ice", 
        "sand", "dark", "diamond", "light", "rubber", "barrier", "ghost", 
        "magma", "quake", "buddha", "love", "spider", "phoenix", 
        "portal", "pain", "blizzard", "gravity", "mammoth", "trex", "dough", 
        "shadow", "venom", "control", "spirit", "dragon", "leopard", "kitsune"
    }

    local objNameLower = obj.Name:lower()
    for _, fruitName in ipairs(officialFruits) do
        if objNameLower:find(fruitName) then
            if not objNameLower:find("pot") and not objNameLower:find("controller") then
                return obj:IsA("Tool") or objNameLower:sub(-5) == "fruit" or obj:FindFirstChild("Handle")
            end
        end
    end
    return false
end

-- Container ESP
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "FruitESPFolder"
ESPFolder.Parent = CoreGui

local function clearESP()
    ESPFolder:ClearAllChildren()
end

local function updateFruitESP()
    clearESP()
    if not Settings.FruitESP then return end

    pcall(function()
        local rootPart = getCharacterRootPart()
        for _, obj in ipairs(Workspace:GetChildren()) do
            if isRealSpawnedFruit(obj) then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                if handle then
                    local distance = rootPart and math.floor((rootPart.Position - handle.Position).Magnitude) or 0
                    local island = getIslandName(handle.Position)

                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = "ESP_" .. obj.Name
                    billboard.Size = UDim2.new(0, 200, 0, 50)
                    billboard.AlwaysOnTop = true
                    billboard.Adornee = handle
                    billboard.Parent = ESPFolder

                    local textLabel = Instance.new("TextLabel")
                    textLabel.Size = UDim2.new(1, 0, 1, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                    textLabel.TextStrokeTransparency = 0
                    textLabel.TextSize = 12
                    textLabel.Font = Enum.Font.GothamBold
                    textLabel.Text = string.format("🍎 %s\n📍 [%s]\n📏 [%dm]", obj.Name, island, distance)
                    textLabel.Parent = billboard
                end
            end
        end
    end)
end

