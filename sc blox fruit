        end

        if not targetTool then
            for _, child in ipairs(character:GetChildren()) do
                if child:IsA("Tool") and matchesCategory(child.Name, targetType) then
                    targetTool = child
                    break
                end
            end
        end

        if targetTool and targetTool.Parent == backpack then
            character.Humanoid:EquipTool(targetTool)
        end
    end)
