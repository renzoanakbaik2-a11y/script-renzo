-- Animasi Buka/Tutup Menu Utama
local menuVisible = true
local function toggleMenu()
	menuVisible = not menuVisible
	if menuVisible then
		MainFrame.Visible = true
		TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 260, 0, 310)}):Play()
	else
		local tween = TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 260, 0, 0)})
		tween:Play()
		tween.Completed:Wait()
		MainFrame.Visible = false
	end
end

OpenButton.MouseButton1Click:Connect(toggleMenu)
CloseButton.MouseButton1Click:Connect(toggleMenu)
