-- Folder Penampung Kotak Visual di Game
local ESPBoxFolder = Instance.new("Folder", ScreenGui)
ESPBoxFolder.Name = "DirectFolderSelection"

-- Fungsi Menelusuri Path Folder Objek
local function getFullPath(obj)
    local path = obj.Name
    local parent = obj.Parent
    while parent and parent ~= workspace and parent ~= game do
        path = parent.Name .. " -> " .. path
        parent = parent.Parent
    end
    return "workspace -> " .. path
end

-- Fungsi Utama Load Objek & Direct Folder
local function loadWorkspaceFolders()
    for _, child in pairs(ScrollContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    ESPBoxFolder:ClearAllChildren()
    local count = 0
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj.Name and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder")) then
            count = count + 1
            
            local itemBtn = Instance.new("TextButton")
            itemBtn.Size = UDim2.new(1, -10, 0, 28)
            itemBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
            itemBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            itemBtn.Font = Enum.Font.Code
            itemBtn.TextSize = 11
            itemBtn.Text = "  • " .. obj.Name .. " [" .. obj.ClassName .. "]"
            itemBtn.TextXAlignment = Enum.TextXAlignment.Left
            itemBtn.Parent = ScrollContainer
            Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 4)
            
            -- LOGIKA KETIKA ITEM DI-KLIK: LANGSUNG PILIH FOLDER / LOKASI ASLINYA
            itemBtn.MouseButton1Click:Connect(function()
                ESPBoxFolder:ClearAllChildren()
                
                -- Tampilkan jalur lengkap (Path Folder) di layar
                local fullPath = getFullPath(obj)
                StatusLabel.Text = "Target Dipilih:\n" .. fullPath
                
                -- Jika objek punya wujud fisik (Part atau Model), langsung tandai dengan kotak biru
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    local box = Instance.new("SelectionBox")
                    box.Adornee = obj
                    box.Color3 = Color3.fromRGB(0, 170, 255)
                    box.LineThickness = 0.08
                    box.Parent = ESPBoxFolder
                end
                
                -- Efek visual tombol
                itemBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 200)
                itemBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                task.wait(0.4)
                itemBtn.BackgroundColor3 = Color3.fromRGB(22, 22, 22)
                itemBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end)
        end
    end
    
    ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

RefreshBtn.MouseButton1Click:Connect(function()
    RefreshBtn.Text = "SEDANG MEMINDAI FOLDER..."
    RefreshBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    task.spawn(function()
        loadWorkspaceFolders()
        RefreshBtn.Text = "🔄 AMBIL & PILIH FOLDER OBJEK"
        RefreshBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    end)
end)

