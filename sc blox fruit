MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 35)
Title.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
Title.Text = "Bring Mob Auto-Farm [RCtrl]"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 13
Title.Font = Enum.Font.SourceSansBold
Title.Parent = MainFrame

local ToggleFarmBtn = Instance.new("TextButton")
ToggleFarmBtn.Size = UDim2.new(0.9, 0, 0, 50)
ToggleFarmBtn.Position = UDim2.new(0.05, 0, 0.38, 0)
ToggleFarmBtn.Font = Enum.Font.SourceSansBold
ToggleFarmBtn.TextSize = 14
ToggleFarmBtn.Parent = MainFrame

local function UpdateUI()
    ToggleFarmBtn.Text = Settings.AutoFarm and "Bring Mob Farm: ON" or "Bring Mob Farm: OFF"
    ToggleFarmBtn.BackgroundColor3 = Settings.AutoFarm and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)
end
UpdateUI()

ToggleFarmBtn.MouseButton1Click:Connect(function()
    Settings.AutoFarm = not Settings.AutoFarm
    UpdateUI()
    SaveSettings()
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.RightControl then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

-- Anti AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

local function DisableGravity(root)
    if not root:FindFirstChild("FarmBV") then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Name = "FarmBV"
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = root
    end
end

local function EnableGravity(root)
    if root and root:FindFirstChild("FarmBV") then
        root.FarmBV:Destroy()
    end
end

-- NOCLIP SAFE LOOP
task.spawn(function()
    while true do
        task.wait(0.1)
        if Settings.AutoFarm then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then root.CanCollide = false end
        end
