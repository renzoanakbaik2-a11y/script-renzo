-- ==========================================
-- FUNGSI DASAR KARAKTER & STABILISASI KAMERA SUPER MULUS
-- ==========================================
local function getCharacterRootPart()
	local character = LocalPlayer.Character
	if character then
		return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	end
	return nil
end

-- Terbang Super Stabil & Mulus Tanpa Goyang/Getar Kamera
local function smoothFlyTo(targetCFrame)
	local rootPart = getCharacterRootPart()
	if not rootPart then return end

	local currentSpeed = Settings.FlightSpeed
	if currentSpeed > 1000 then currentSpeed = 1000 end
	if currentSpeed < 20 then currentSpeed = 20 end

	local currentHeight = Settings.FlyHeight
	if currentHeight > 10 then currentHeight = 10 end
	if currentHeight < 0 then currentHeight = 0 end

	local adjustedTargetCFrame = targetCFrame + Vector3.new(0, currentHeight, 0)

	local distance = (rootPart.Position - adjustedTargetCFrame.Position).Magnitude
	local duration = distance / currentSpeed
	if duration < 0.05 then return end

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
	if humanoid then
		humanoid.PlatformStand = true
	end

	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Velocity = Vector3.new(0, 0, 0)
	bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVelocity.Parent = rootPart

	local bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bodyGyro.CFrame = rootPart.CFrame
	bodyGyro.Parent = rootPart

	Camera.CameraType = Enum.CameraType.Custom

	local startTime = tick()
	local startCFrame = rootPart.CFrame

	while tick() - startTime < duration do
		if not rootPart or not character or not character.Parent then break end
		local alpha = math.clamp((tick() - startTime) / duration, 0, 1)
		local smoothAlpha = alpha * (2 - alpha)
		
		rootPart.CFrame = startCFrame:Lerp(adjustedTargetCFrame, smoothAlpha)
		bodyGyro.CFrame = rootPart.CFrame
		RunService.RenderStepped:Wait()
	end

	rootPart.CFrame = adjustedTargetCFrame

	if bodyVelocity then bodyVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end

	if humanoid then
		humanoid.PlatformStand = false
	end
end


-- ==========================================
-- SISTEM PENGELOMPOKKAN PULAU & AUTO COLLECT CHEST BERDASARKAN PULAU TERDEKAT
-- ==========================================
local function getPositionOfObj(obj)
	if obj:IsA("BasePart") then
		return obj.Position
	elseif obj:IsA("Model") and obj.PrimaryPart then
		return obj.PrimaryPart.Position
	elseif obj:FindFirstChildWhichIsA("BasePart") then
		return obj:FindFirstChildWhichIsA("BasePart").Position
	end
	return nil
end

local function getChestIslands()
	local allChests = {}
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if (obj.Name:lower():find("chest") or obj.Name:lower():find("peti")) then
			local pos = getPositionOfObj(obj)
			if pos then
				table.insert(allChests, {Object = obj, Position = pos})
			end
		end
	end

	local islands = {}
	for _, chest in ipairs(allChests) do
		local placed = false
		for _, island in ipairs(islands) do
			if (island.Center - chest.Position).Magnitude < 400 then
				table.insert(island.Chests, chest)
				placed = true
				break
			end
		end
		if not placed then
			table.insert(islands, {
				Center = chest.Position,
				Chests = {chest}
			})
		end
	end
	return islands
end


-- ==========================================
-- BACKGROUND SYSTEM (SCANNER BUAH, CHEST PER PULAU, PLAYER)
-- ==========================================
task.spawn(function()
	local lastCount = 0
	while task.wait(2) do
		-- 1. Scan Buah
		if Settings.FruitNotifier then
			local fruitList = {}
			local targetFruitHandle = nil

			for _, obj in ipairs(Workspace:GetChildren()) do
				if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
					table.insert(fruitList, obj.Name)
					if not targetFruitHandle then
						targetFruitHandle = obj.Handle
					end
				end
			end
			
			local currentCount = #fruitList
			if currentCount > 0 then
				local combinedNames = table.concat(fruitList, ", ")
				NotifText.Text = "KETEMU (" .. currentCount .. "): " .. combinedNames
				if currentCount > lastCount then
					playFruitSound()
				end
				lastCount = currentCount

				if Settings.AutoTeleportFruit and targetFruitHandle then
					local rootPart = getCharacterRootPart()
					if rootPart and (rootPart.Position - targetFruitHandle.Position).Magnitude > 15 then
						smoothFlyTo(targetFruitHandle.CFrame)
					end
				end
			else
				NotifText.Text = "Status: Mencari Buah di Map (Kosong)..."
				lastCount = 0
			end
		end

		-- 2. Auto Collect Chest (Peti) Berdasarkan Pulau Terdekat & Berpindah Otomatis
		if Settings.AutoFlyChest then
			local rootPart = getCharacterRootPart()
			if rootPart then
				local islands = getChestIslands()
				if #islands > 0 then
					table.sort(islands, function(a, b)
						return (rootPart.Position - a.Center).Magnitude < (rootPart.Position - b.Center).Magnitude
					end)

					local currentIsland = islands[1]
					if currentIsland and #currentIsland.Chests > 0 then
						table.sort(currentIsland.Chests, function(a, b)
							return (rootPart.Position - a.Position).Magnitude < (rootPart.Position - b.Position).Magnitude
						end)

						local targetChest = currentIsland.Chests[1].Object
						local targetPos = getPositionOfObj(targetChest)
						if targetPos then
							smoothFlyTo(CFrame.new(targetPos))
							task.wait(0.2)
						end
					end
				end
			end
			task.wait(0.5)
		end

		-- 3. Auto Terbang ke Player
		if Settings.AutoFlyPlayer then
			task.wait(3)
			local targetPlayer = nil

			if Settings.TargetPlayerName ~= "" then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and string.find(p.Name:lower(), Settings.TargetPlayerName:lower()) then
						targetPlayer = p
						break
					end
				end
			else
				local shortestDist = math.huge
				local rootPart = getCharacterRootPart()
				if rootPart then
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
							local dist = (rootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
							if dist < shortestDist then
								shortestDist = dist
								targetPlayer = p
							end
						end
					end
				end
			end

			if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local rootPart = getCharacterRootPart()
				if rootPart then
					smoothFlyTo(targetPlayer.Character.HumanoidRootPart.CFrame)
					task.wait(2)
				end
			end
		end
	end
end)


