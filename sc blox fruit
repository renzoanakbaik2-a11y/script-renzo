-- 3. FITUR AUTO PULL ITEM / TELUR SEKITAR
PullBtn.MouseButton1Click:Connect(function()
    PullMode = not PullMode
    PullBtn.Text = PullMode and "🧲 PULL ITEM: ON" or "🧲 PULL ITEM: OFF"
    PullBtn.BackgroundColor3 = PullMode and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
