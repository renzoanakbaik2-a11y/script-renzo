-- 2. SMART NOCLIP (LANTAI SAFE)
RunService.Stepped:Connect(function()
    if not Settings.SmartNoclip or not Character then return end
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.CanCollide = false
        end
    end
end)

-- 3. DISABLE PIGGY HITBOX
RunService.RenderStepped:Connect(function()
    if not Settings.AntiPiggy then return end
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and (model.Name:lower():find("piggy") or model:FindFirstChild("Piggy") or model:FindFirstChild("Enemy")) then
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("TouchTransmitter") then
                    part:Destroy()
                elseif part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- 4. BONGKAR INTI: CLICKDETECTOR & REMOTE FIRE ENGINE
local function RawClickInteraction(targetObj)
    if not targetObj then return false end
    
    -- Memicu ClickDetector secara langsung (Inti Sistem Ambil Item Piggy)
    local clickDetector = targetObj:FindFirstChildOfClass("ClickDetector") or targetObj.Parent:FindFirstChildOfClass("ClickDetector")
    if clickDetector and fireclickdetector then
        fireclickdetector(clickDetector, 0) -- Fire jarak 0
        fireclickdetector(clickDetector)    -- Fire standar
        return true
    end
    
    -- Memicu TouchTransmitter jika berbentuk Part Sentuh
    local targetPart = targetObj:IsA("BasePart") and targetObj or targetObj:FindFirstChildOfClass("BasePart")
    if HumanoidRootPart and targetPart and firetouchinterest then
        firetouchinterest(HumanoidRootPart, targetPart, 0)
        task.wait()
        firetouchinterest(HumanoidRootPart, targetPart, 1)
        return true
    end
    
    return false
end

-- Cari RemoteEvent bawaan Piggy di ReplicatedStorage untuk fallback
local RemoteEventCache = nil
for _, res in ipairs(ReplicatedStorage:GetDescendants()) do
    if res:IsA("RemoteEvent") and (res.Name:lower():find("item") or res.Name:lower():find("trigger") or res.Name:lower():find("remotefunction")) then
        RemoteEventCache = res
        break
    end
end

-- 5. LOGIKA EKSEKUSI AUTO COLLECT & AUTO ESCAPE
task.spawn(function()
    while true do
        task.wait(0.3)
        if Settings.AutoEscape and HumanoidRootPart and Humanoid then
            local targetItem = nil
            
            -- Scan Item Murni di Workspace (Key, Plank, Wrench, Gear, Card, Bone, Candle, Gun)
            for _, v in ipairs(Workspace:GetDescendants()) do
                if not BlacklistedItems[v] and v ~= Character and not v:IsDescendantOf(Character) then
                    local name = v.Name:lower()
                    local parentName = v.Parent and v.Parent.Name:lower() or ""
                    
                    if v:FindFirstChildOfClass("ClickDetector") or v:FindFirstChildOfClass("TouchTransmitter") or v:IsA("Tool") or v:FindFirstChild("Handle") then
                        if name:find("key") or name:find("plank") or name:find("wrench") or name:find("gear") or name:find("card") or name:find("code") or name:find("candle") or name:find("bone") or name:find("gun") or name:find("bullet") then
                            if not name:find("door") and not name:find("gate") and not name:find("lock") and not parentName:find("door") then
                                targetItem = v
                                break
                            end
                        end
                    end
                end
            end
            
            if targetItem then
                local itemPart = targetItem:IsA("BasePart") and targetItem or targetItem:FindFirstChildOfClass("BasePart") or targetItem:FindFirstChild("Handle")
                
                if itemPart then
                    -- Step A: Teleport Tepat di Samping Item
                    HumanoidRootPart.CFrame = itemPart.CFrame + Vector3.new(0, 1, 0)
                    task.wait(0.1)
                    
                    -- Step B: Eksekusi Direct Click
                    RawClickInteraction(targetItem)
                    if RemoteEventCache then
                        pcall(function() RemoteEventCache:FireServer(targetItem) end)
                    end
                    
                    BlacklistedItems[targetItem] = true
                    task.wait(0.25)
                    
                    -- Step C: Auto Equip dari Backpack
                    local heldTool = Character:FindFirstChildOfClass("Tool")
                    if not heldTool then
                        local bpTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if bpTool then
                            Humanoid:EquipTool(bpTool)
                            task.wait(0.2)
                            heldTool = bpTool
                        end
                    end
                    
                    -- Step D: Cari Pintu Pasangannya
                    local activeName = heldTool and heldTool.Name:lower() or targetItem.Name:lower()
                    local doorTarget = nil
                    
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if not UsedTargets[obj] then
                            local oName = obj.Name:lower()
                            if (activeName:find("key") and (oName:find("door") or oName:find("lock") or oName:find("padlock"))) or
                               (activeName:find("plank") and (oName:find("plank") or oName:find("bridge"))) or
                               (activeName:find("wrench") and (oName:find("circuit") or oName:find("box") or oName:find("gate"))) or
                               (activeName:find("gear") and (oName:find("machine") or oName:find("clock"))) or
                               (activeName:find("card") and (oName:find("reader") or oName:find("swipe"))) or
                               (activeName:find("gun") and oName:find("piggy")) then
                                
                                doorTarget = obj
                                break
                            end
                        end
                    end
                    
                    -- Step E: Teleport & Klik Pintu / Objek
                    if doorTarget then
                        local doorPart = doorTarget:IsA("BasePart") and doorTarget or doorTarget:FindFirstChildOfClass("BasePart")
                        if doorPart then
                            HumanoidRootPart.CFrame = doorPart.CFrame + Vector3.new(0, 1, 0)
                            task.wait(0.1)
                            RawClickInteraction(doorTarget)
                            if RemoteEventCache then
                                pcall(function() RemoteEventCache:FireServer(doorTarget) end)
                            end
                            UsedTargets[doorTarget] = true
                            task.wait(0.3)
                        end
                    end
                end
            end
        end
    end
end)
