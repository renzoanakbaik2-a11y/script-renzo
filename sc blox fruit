-- 3. LOGIKA PEREKAM SINYAL (HOOKING)
local capturedRemote = nil
local capturedArgs = nil
local isRunning = false

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    
    -- Tangkap sinyal FireServer saat player mukul manual
    if method == "FireServer" and not checkcaller() then
        local rName = tostring(self.Name):lower()
        -- Abaikan sinyal ga penting kayak gerak atau kamera
        if not rName:find("mouse") and not rName:find("camera") and not rName:find("move") and not rName:find("ping") then
            capturedRemote = self
            capturedArgs = {...}
        end
    end
    
    return oldNamecall(self, ...)
end)

-- Update layar status biar lu tau kalo datanya udah direkam
task.spawn(function()
    while task.wait(0.5) do
        if not isRunning then
            if capturedRemote then
                StatusBox.Text = "Status: Data Terekam! (" .. tostring(capturedRemote.Name) .. ")\nSiap Auto Attack Visual!"
            else
                StatusBox.Text = "Status: MUKUL MANUAL 1X DULU buat ngerekam data..."
            end
        end
    end
end)

-- 4. LOGIKA AUTO ATTACK VISUAL
ToggleBtn.MouseButton1Click:Connect(function()
    if not capturedRemote then
        StatusBox.Text = "GAGAL: Lu harus mukul manual 1x dulu, bro!"
        return
    end

    isRunning = not isRunning
    if isRunning then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        ToggleBtn.Text = "AUTO ATTACK: ON"
        
        task.spawn(function()
            while isRunning do
                StatusBox.Text = "Status: [v2.0] Attack Visual Aktif (Bypass UI)"
                pcall(function()
                    -- Tembak langsung ke server pake data yang udah dicuri tadi
                    capturedRemote:FireServer(unpack(capturedArgs))
                end)
                task.wait(0.15)
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
        ToggleBtn.Text = "AUTO ATTACK: OFF"
        StatusBox.Text = "Status: Dimatikan."
    end
end)
