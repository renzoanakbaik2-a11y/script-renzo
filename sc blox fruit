ScanBtn.MouseButton1Click:Connect(function()
    LogBox.Text = "Sedang memindai seluruh memori game...\nMohon tunggu 2 detik..."
    task.wait(0.5)

    local report = "=== HASIL TEMUAN DETEKTIF ===\n\n"
    local foundCount = 0

    -- 1. Cek semua RemoteEvent di ReplicatedStorage (Cari Remote Buy/Purchase)
    report = report .. "[1. REMOTE EVENT PEMBELIAN]\n"
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local nameLower = string.lower(obj.Name)
            if string.find(nameLower, "buy") or string.find(nameLower, "purchase") or string.find(nameLower, "roll") or string.find(nameLower, "stand") or string.find(nameLower, "claim") then
                report = report .. "-> Remote: " .. obj.Name .. " (Path: " .. obj:GetFullName() .. ")\n"
                foundCount = foundCount + 1
            end
        end
    end

    -- 2. Cek Atribut atau Value di dalam RollStands
    report = report .. "\n[2. NILAI/ATRIBUT DI ROLLSTANDS]\n"
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "RollStands" then
            for _, stand in ipairs(obj:GetChildren()) do
                report = report .. "Stand: " .. stand.Name .. "\n"
                -- Cek Attributes
                local attrs = stand:GetAttributes()
                for attrName, attrVal in pairs(attrs) do
                    report = report .. "  Attr: " .. tostring(attrName) .. " = " .. tostring(attrVal) .. "\n"
                end
                -- Cek anak-anak objeknya
                for _, child in ipairs(stand:GetChildren()) do
                    if child:IsA("StringValue") or child:IsA("ObjectValue") then
                        report = report .. "  Value: " .. child.Name .. " = " .. tostring(child.Value) .. "\n"
                    end
                end
            end
        end
    end

    -- 3. Cek Teks GUI Pembelian di PlayerGui
    report = report .. "\n[3. TEKS BUTTON BUY DI PLAYERGUI]\n"
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "FinderUI" and gui.Name ~= "SpeedHubFinalUI" then
            for _, desc in ipairs(gui:GetDescendants()) do
                if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Visible then
                    local txt = string.lower(desc.Text)
                    if string.find(txt, "buy") or string.find(txt, "250") or string.find(txt, "$") then
                        report = report .. "-> GUI Teks: '" .. desc.Text .. "' | Parent: " .. desc.Parent.Name .. " (Path: " .. desc:GetFullName() .. ")\n"
                    end
                end
            end
        end
    end

    report = report .. "\n=== PEMINDAIAN SELESAI ==="
    LogBox.Text = report
end)local Players = game:GetService("Players")
