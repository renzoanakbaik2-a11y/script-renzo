-- 3. DETEKSI BOLA / SHUTTLECOCK (LEBIH PINTAR & LENGKAP)
local function cariShuttle()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local namaObj = obj.Name:lower()
			local namaParent = obj.Parent and obj.Parent.Name:lower() or ""
			
			-- Cek apakah nama Part ATAU nama Model Induknya mengandung kata kunci bola
			local kataKunci = namaObj:find("shuttle") or namaObj:find("ball") or namaObj:find("kok") or namaObj:find("projectile") or
				namaParent:find("shuttle") or namaParent:find("ball") or namaParent:find("kok") or namaParent:find("projectile")
			
			if kataKunci then
				-- Abaikan HANYA jika bola jatuh ke void paling dasar (Y < -30)
				if obj.Position.Y > -30 then
					return obj
				end
			end
		end
	end
	return nil
end

-- 4. DETEKSI NET / JARING LAPANGAN
local function cariNet()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local nama = obj.Name:lower()
			if nama:find("net") or nama:find("jaring") then
				return obj
			end
		end
	end
	return nil
end

-- 5. PEMERIKSAAN ZONA BERDASARKAN NET / JARAK
local function apakahDiZonaKita(hrp, shuttle, net)
	if not net then
		-- Jika Net tidak ditemukan di Workspace, pakai toleransi jarak 35 stud
		return (shuttle.Position - hrp.Position).Magnitude <= 35
	end
	
	-- Menghitung posisi relatif terhadap Net
	local bedaKarakterZ = hrp.Position.Z - net.Position.Z
	local bedaShuttleZ = shuttle.Position.Z - net.Position.Z
	
	local bedaKarakterX = hrp.Position.X - net.Position.X
	local bedaShuttleX = shuttle.Position.X - net.Position.X
	
	local samaDiZ = (bedaKarakterZ * bedaShuttleZ) > 0
	local samaDiX = (bedaKarakterX * bedaShuttleX) > 0
	
	return samaDiZ and samaDiX
end

-- 6. PERINTAH AYUN RAKET / MUKUL
local function pukulRaket(char)
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			tool = backpack:FindFirstChildOfClass("Tool")
			if tool then tool.Parent = char end
		end
	end
	
	if tool then
		pcall(function() tool:Activate() end)
		for _, child in ipairs(tool:GetDescendants()) do
			if child:IsA("RemoteEvent") then
				pcall(function() child:FireServer() end)
			end
		end
	end
end

-- 7. EKSEKUSI UTAMA BOT
local function eksekusiBot()
	local char = LocalPlayer.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	if hrp.Position.Y < -20 then return end

	local shuttle = cariShuttle()
	local net = cariNet()
	
	if shuttle then
		if apakahDiZonaKita(hrp, shuttle, net) then
			-- Teleport ke bola & Pukul
			hrp.CFrame = shuttle.CFrame * CFrame.new(0, 2, 2)
			pukulRaket(char)
			
			Status.Text = "Status: Deteksi [" .. shuttle.Name .. "] di Zona KITA! Teleport & Smash!"
			Status.TextColor3 = Color3.fromRGB(100, 255, 150)
		else
			-- Diam jika di area lawan
			Status.Text = "Status: Deteksi [" .. shuttle.Name .. "] di Zona Lawan (Diam...)"
			Status.TextColor3 = Color3.fromRGB(255, 200, 100)
		end
	else
		Status.Text = "Status: Mencari bola... (Belum terdeteksi di Workspace)"
		Status.TextColor3 = Color3.fromRGB(255, 120, 120)
	end
end

