-- 3. REVISI LOGIKA FREEZE PIGGY (SANGAT KETAT)
RunService.Heartbeat:Connect(function()
    if not Settings.FreezePiggy then return end
    
    for _, model in ipairs(Workspace:GetChildren()) do
        if model:IsA("Model") and (model.Name:lower():find("piggy") or model:FindFirstChild("Piggy") or model:FindFirstChild("NPC")) then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 0
            end
            for _, part in ipairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                end
            end
        end
    end
end)

-- Helper Teleport
local function SafeTeleport(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = targetCFrame + Vector3.new(0, 2, 0)
        task.wait(0.25)
    end
end

-- Helper Interaksi Prompt / Clicker
local function Interact(target)
    if not target then return end
    
    -- ProximityPrompt
    local prompt = target:FindFirstChildOfClass("ProximityPrompt") or target.Parent:FindFirstChildOfClass("ProximityPrompt")
    if prompt and fireproximityprompt then
        fireproximityprompt(prompt)
        task.wait(0.2)
    end
    
    -- ClickDetector
    local click = target:FindFirstChildOfClass("ClickDetector") or target.Parent:FindFirstChildOfClass("ClickDetector")
    if click and fireclickdetector then
        fireclickdetector(click)
        task.wait(0.2)
    end
end

-- 4. REVISI LOGIKA AUTO COLLECT & ESCAPE
task.spawn(function()
    while true do
        task.wait(0.4)
        if Settings.AutoEscape then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum then
                local foundItem = nil
                
                -- Cari Item (Tool atau Model yang punya ProximityPrompt/ClickDetector/Item Name)
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if not BlacklistedItems[obj] then
                        if obj:IsA("Tool") or 
                           (obj:IsA("Model") and (obj.Name:lower():find("key") or obj.Name:lower():find("plank") or obj.Name:lower():find("wrench") or obj.Name:lower():find("gear") or obj.Name:lower():find("card"))) or
                           (obj:IsA("BasePart") and (obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector"))) then
                            
                            -- Pastikan objek bukan bagian dari Pintu
                            if not obj.Name:lower():find("door") and not obj.Name:lower():find("gate") then
                                foundItem = obj
                                break
                            end
                        end
                    end
                end
                
                if foundItem then
                    local handle = foundItem:IsA("BasePart") and foundItem or foundItem:FindFirstChild("Handle") or foundItem:FindFirstChildOfClass("BasePart")
                    
                    if handle then
                        -- Step 1: Teleport ke Item & Ambil
                        SafeTeleport(handle.CFrame)
                        
                        Interact(foundItem)
                        if firetouchinterest then
                            firetouchinterest(hrp, handle, 0)
                            firetouchinterest(hrp, handle, 1)
                        end
                        
                        task.wait(0.3)
                        BlacklistedItems[foundItem] = true
                        
                        -- Equip Tool jika masuk ke Backpack
                        local backpackTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
                        if backpackTool then
                            hum:EquipTool(backpackTool)
                            task.wait(0.2)
                        end
                        
                        -- Step 2: Cari Pintu / Target yang Sesuai
                        local itemName = (backpackTool and backpackTool.Name or foundItem.Name):lower()
                        local targetObject = nil
                        
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if (obj:IsA("BasePart") or obj:IsA("Model")) and not UsedTargets[obj] then
                                local objName = obj.Name:lower()
                                if (itemName:find("key") and (objName:find("door") or objName:find("lock"))) or
                                   (itemName:find("plank") and objName:find("plank")) or
                                   (itemName:find("wrench") and (objName:find("circuit") or objName:find("box"))) or
                                   (itemName:find("gear") and objName:find("machine")) or
                                   (itemName:find("card") and objName:find("reader")) then
                                    
                                    targetObject = obj
                                    break
                                end
                            end
                        end
                        
                        -- Step 3: Teleport ke Pintu & Gunakan
                        if targetObject then
                            local targetPart = targetObject:IsA("BasePart") and targetObject or targetObject:FindFirstChildOfClass("BasePart")
                            if targetPart then
                                SafeTeleport(targetPart.CFrame)
                                Interact(targetObject)
                                UsedTargets[targetObject] = true
                            end
                        end
                    end
                end
            end
        end
    end
end)-- =================================================================
