--// Event Handler untuk Tombol Menu
OpenButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

ChestToggleBtn.MouseButton1Click:Connect(function()
    Settings.AutoChest = not Settings.AutoChest
    ChestToggleBtn.BackgroundColor3 = Settings.AutoChest and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    ChestToggleBtn.Text = "Auto Collect Chest: " .. (Settings.AutoChest and "ON" or "OFF")
    SaveSettings()
end)

--// Noclip Loop
RunService.Stepped:Connect(function()
    pcall(function()
        if Settings.AutoChest then
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end)

--// Sistem Terbang Terpisah (Fitur Terbang Aktif Duluan, Baru Cari & Collect Chest)
task.spawn(function()
    local attachment, linearVelocity, alignOrientation
    
    while true do
        task.wait(0.1)
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChild("Humanoid")
            
            if Settings.AutoChest and hrp and humanoid and humanoid.Health > 0 then
                -- 1. Aktifkan mode terbang terlebih dahulu (PlatformStand)
                humanoid.PlatformStand = true
                
                -- Setup Physics Constraint untuk Terbang
                if not hrp:FindFirstChild("RootAttachmentCustom") then
                    attachment = Instance.new("Attachment")
                    attachment.Name = "RootAttachmentCustom"
                    attachment.Parent = hrp
                else
                    attachment = hrp:FindFirstChild("RootAttachmentCustom")
                end
                
                if not hrp:FindFirstChild("CustomLinearVelocity") then
                    linearVelocity = Instance.new("LinearVelocity")
                    linearVelocity.Name = "CustomLinearVelocity"
                    linearVelocity.Attachment0 = attachment
                    linearVelocity.MaxForce = math.huge
                    linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                    linearVelocity.Parent = hrp
                else
                    linearVelocity = hrp:FindFirstChild("CustomLinearVelocity")
                end
                
                if not hrp:FindFirstChild("CustomAlignOrientation") then
                    alignOrientation = Instance.new("AlignOrientation")
                    alignOrientation.Name = "CustomAlignOrientation"
                    alignOrientation.Attachment0 = attachment
                    alignOrientation.MaxTorque = math.huge
                    alignOrientation.Responsiveness = 200
                    alignOrientation.Parent = hrp
                else
                    alignOrientation = hrp:FindFirstChild("CustomAlignOrientation")
                end
                
                -- 2. Cari Chest (Bronze, Silver, Gold, Diamond, atau universal) setelah terbang aktif
                local targetChest = nil
                local shortestDistance = math.huge
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    local name = obj.Name
                    if name == "Bronze Chest" or name == "Silver Chest" or name == "Gold Chest" or name == "Diamond Chest" or name:lower():find("chest") then
                        local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                        if part then
                            local dist = (hrp.Position - part.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                targetChest = part
                            end
                        end
                    end
                end
                
                -- 3. Gerakkan karakter terbang menuju chest yang ditemukan
                if targetChest and targetChest.Parent then
                    local targetPos = targetChest.Position + Vector3.new(0, 3, 0)
                    local direction = (targetPos - hrp.Position)
                    local distance = direction.Magnitude
                    
                    if distance > 3 then
                        linearVelocity.VectorVelocity = direction.Unit * 300
                        alignOrientation.CFrame = CFrame.new(hrp.Position, targetPos)
                    else
                        linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                    end
                else
                    -- Jika belum ada chest terdekat, tetap terbang mengambang stabil di tempat
                    linearVelocity.VectorVelocity = Vector3.new(0, 5, 0)
                    alignOrientation.CFrame = hrp.CFrame
                end
            else
                -- Matikan sistem terbang jika fitur dimatikan atau karakter mati
                if hrp then
                    if hrp:FindFirstChild("CustomLinearVelocity") then hrp.CustomLinearVelocity:Destroy() end
                    if hrp:FindFirstChild("CustomAlignOrientation") then hrp.CustomAlignOrientation:Destroy() end
                    if hrp:FindFirstChild("RootAttachmentCustom") then hrp.RootAttachmentCustom:Destroy() end
                end
                if humanoid then
                    humanoid.PlatformStand = false
                end
            end
        end)
    end
end)
