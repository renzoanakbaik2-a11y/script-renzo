local isSpamActive = false
local isZoneLocked = false
local sensorPart = nil

-- Buat Area Sensor Lapangan (Zona Kita)
local function CreateSensorZone()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    if not sensorPart or not sensorPart.Parent then
        sensorPart = Instance.new("Part")
        sensorPart.Name = "SpeedHub_CourtSensorZone"
        sensorPart.Anchored = true
        sensorPart.CanCollide = false
        sensorPart.Material = Enum.Material.ForceField
        sensorPart.Color = Color3.fromRGB(0, 255, 120)
        sensorPart.Transparency = 0.7
        sensorPart.Size = Vector3.new(45, 30, 45) -- Area Lapangan 45x45 Studs
        sensorPart.Parent = Workspace
    end

    if not isZoneLocked then
        sensorPart.CFrame = CFrame.new(HRP.Position.X, HRP.Position.Y + 10, HRP.Position.Z)
    end
end

-- Spam Click Hit
local function FastSpamClick()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.01)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- Deteksi Part Apapun di Zona Lapangan Kita
local function GetBallInZone()
    if not sensorPart then return nil end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    if LocalPlayer.Character then
        overlapParams.FilterDescendantsInstances = {LocalPlayer.Character, sensorPart}
    end

    local partsInZone = Workspace:GetPartsInPart(sensorPart, overlapParams)

    for _, part in pairs(partsInZone) do
        if part:IsA("BasePart") then
            local name = part.Name:lower()
            -- Deteksi bola/ring/projectile/part bergerak
            if name:find("ball") or name:find("tennis") or name:find("ring") or name:find("target") or name:find("indicator") or name:find("landing") then
                return part
            end
        end
    end
    return nil
end

local function ResetScriptState()
    isSpamActive = false
    isZoneLocked = false
    if sensorPart then
        sensorPart:Destroy()
        sensorPart = nil
    end
    BtnToggleSpam.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnToggleSpam.Text = "AUTO TELEPORT & SPAM SWING: OFF"
    BtnLockZone.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnLockZone.Text = "LOCK COURT ZONE POSITION"
    StatusText.Text = "Status: Script Reset Done!"
end

-- Event Listeners
BtnToggleSpam.MouseButton1Click:Connect(function()
    isSpamActive = not isSpamActive
    if isSpamActive then
        CreateSensorZone()
        BtnToggleSpam.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnToggleSpam.Text = "AUTO TELEPORT & SPAM SWING: ON"
        StatusText.Text = "Status: Waiting Ball Entry..."
    else
        ResetScriptState()
    end
end)

BtnLockZone.MouseButton1Click:Connect(function()
    if isSpamActive and sensorPart then
        isZoneLocked = not isZoneLocked
        if isZoneLocked then
            BtnLockZone.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            BtnLockZone.Text = "ZONE POSITION: LOCKED 🔒"
            StatusText.Text = "Status: Zone Locked to Court!"
        else
            BtnLockZone.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
            BtnLockZone.Text = "LOCK COURT ZONE POSITION"
            StatusText.Text = "Status: Tracking Character..."
        end
    end
end)

BtnReset.MouseButton1Click:Connect(function()
