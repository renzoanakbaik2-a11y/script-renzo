local function autoStoreFruits()
    if not Settings.AutoStoreFruit then return end
    
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") 
            or ReplicatedStorage:FindFirstChild("MainRemote")
            
        local commF = remotes and (remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("Data"))
        if not commF then return end
        
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local character = LocalPlayer.Character
        
        local function checkAndStore(item)
            if item:IsA("Tool") then
                local name = item.Name:lower()
                if name:find("fruit") or name:find("rocket") or name:find("spin") or name:find("kitsune") or name:find("dragon") or name:find("dough") or name:find("buddha") or name:find("trex") or name:find("mammoth") then
                    local originalName = item:GetAttribute("OriginalName") or item.Name
                    pcall(function() commF:InvokeServer("StoreFruit", originalName, item) end)
                    pcall(function() commF:InvokeServer("StoreFruit", item.Name) end)
                end
            end
        end
        
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                checkAndStore(item)
            end
        end
        
        if character then
            for _, item in ipairs(character:GetChildren()) do
                checkAndStore(item)
            end
        end
    end)
end

local function equipSelectedWeapon()
    pcall(function()
        local character = LocalPlayer.Character
        local backpack = LocalPlayer.Backpack
        if not character then return end
        
        local currentWeapon = character:FindFirstChildOfClass("Tool")
        if currentWeapon then
            local name = currentWeapon.Name:lower()
            if Settings.SelectWeapon == "Melee" and (name:find("combat") or name:find("step") or name:find("claw") or name:find("fist") or name:find("karate") or name:find("talon") or name:find("godhuman") or name:find("superhuman")) then
                return
            elseif Settings.SelectWeapon == "Sword" and (not name:find("gun") and not name:find("fruit") and not name:find("combat")) then
                return
            elseif Settings.SelectWeapon == "Blox Fruit" and (name:find("fruit") or name:find("flame") or name:find("ice") or name:find("buddha") or name:find("magma") or name:find("kitsune") or name:find("dough")) then
                return
            elseif Settings.SelectWeapon == "Gun" and (name:find("gun") or name:find("musket") or name:find("rifle") or name:find("kabucha") or name:find("guitar")) then
                return
            end
        end
        
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                local matched = false
                
                if Settings.SelectWeapon == "Melee" and (name:find("combat") or name:find("step") or name:find("claw") or name:find("fist") or name:find("karate") or name:find("talon") or name:find("godhuman") or name:find("superhuman")) then
                    matched = true
                elseif Settings.SelectWeapon == "Sword" and (not name:find("gun") and not name:find("fruit") and not name:find("combat")) then
                    matched = true
                elseif Settings.SelectWeapon == "Blox Fruit" and (name:find("fruit") or name:find("flame") or name:find("ice") or name:find("buddha") or name:find("magma") or name:find("kitsune") or name:find("dough")) then
                    matched = true
                elseif Settings.SelectWeapon == "Gun" and (name:find("gun") or name:find("musket") or name:find("rifle") or name:find("kabucha") or name:find("guitar")) then
                    matched = true
                end
                
                if matched then
                    item.Parent = character
                    break
                end
            end
        end
    end)
end

