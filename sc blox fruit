task.spawn(function()
    local bv, bg, noclip
    local lastBusoTick = 0
    
    while task.wait(0.1) do
        pcall(function()
            local character = LocalPlayer.Character
            local rootPart = getCharacterRootPart()
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            
            if Settings.AutoFarmLevel and rootPart and humanoid and humanoid.Health > 0 then
                -- 1. Buso Haki (Anti Kedap-kedip)
                if Settings.AutoBuso and commF then
                    local currentTime = tick()
                    if currentTime - lastBusoTick > 3 then
                        local hasBusoActive = character:FindFirstChild("HasBuso") or character:FindFirstChild("Buso") or LocalPlayer:FindFirstChild("BusoEnabled")
                        if not hasBusoActive then
                            pcall(function() commF:InvokeServer("Buso") end)
                            lastBusoTick = currentTime
                        end
                    end
                end

                -- 2. Senjata
                equipSelectedWeapon()

                -- 3. Cari Pusat Kelompok Mob Terdekat & Kunci Posisi Total
                local targetMobRoot = nil
                local shortest = math.huge
                
                for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
                    local eRoot = enemy:FindFirstChild("HumanoidRootPart")
                    local eHum = enemy:FindFirstChildOfClass("Humanoid")
                    if eRoot and eHum and eHum.Health > 0 then
                        local dist = (rootPart.Position - eRoot.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            targetMobRoot = eRoot
                        end
                    end
                end

                if targetMobRoot then
                    local centerPos = targetMobRoot.Position
                    
                    for _, enemy in ipairs(Workspace.Enemies:GetChildren()) do
                        local eRoot = enemy:FindFirstChild("HumanoidRootPart")
                        local eHum = enemy:FindFirstChildOfClass("Humanoid")
                        if eRoot and eHum and eHum.Health > 0 then
                            local distToTarget = (centerPos - eRoot.Position).Magnitude
                            if distToTarget < 300 then
                                -- Bekukan posisi mob di satu titik agar tidak lari dan hitbox sinkron
                                eRoot.CFrame = CFrame.new(centerPos.X, centerPos.Y, centerPos.Z)
                                eRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                eRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                eHum.PlatformStand = true
                                
                                pcall(function() enemy.Humanoid:MoveTo(centerPos) end)
                            end
                        end
                    end

                    -- 4. Aktifkan Terbang Melayang Stabil (Raycast Anti-Tanah)
                    humanoid.PlatformStand = true
                    
                    if not bv or not bv.Parent then
                        bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Velocity = Vector3.new(0, 0, 0)
                        bv.Parent = rootPart
                    end
                    
                    if not bg or not bg.Parent then
                        bg = Instance.new("BodyGyro")
                        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                        bg.Parent = rootPart
                    end

                    if not noclip then
                        noclip = RunService.Stepped:Connect(function()
                            if character then
                                for _, part in ipairs(character:GetDescendants()) do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end
                            end
                        end)
                    end

                    -- Gunakan Raycast untuk mendeteksi daratan asli agar tidak tembus ke bawah tanah
