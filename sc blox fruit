local function CreateSection(parent, sectionTitle)
    local SectionFrame = Instance.new("Frame")
    SectionFrame.Size = UDim2.new(1, -5, 0, 36)
    SectionFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    SectionFrame.ClipsDescendants = true
    SectionFrame.Parent = parent

    local SectionCorner = Instance.new("UICorner")
    SectionCorner.CornerRadius = UDim.new(0, 6)
    SectionCorner.Parent = SectionFrame

    local SectionStroke = Instance.new("UIStroke")
    SectionStroke.Color = Color3.fromRGB(255, 30, 60)
    SectionStroke.Thickness = 1.2
    SectionStroke.Parent = SectionFrame

    local HeaderBtn = Instance.new("TextButton")
    HeaderBtn.Size = UDim2.new(1, 0, 0, 36)
    HeaderBtn.BackgroundTransparency = 1
    HeaderBtn.Text = "  " .. sectionTitle
    HeaderBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    HeaderBtn.Font = Enum.Font.SourceSansBold
    HeaderBtn.TextSize = 12
    HeaderBtn.TextXAlignment = Enum.TextXAlignment.Left
    HeaderBtn.Parent = SectionFrame

    local ArrowLabel = Instance.new("TextLabel")
    ArrowLabel.Size = UDim2.new(0, 30, 0, 36)
    ArrowLabel.Position = UDim2.new(1, -30, 0, 0)
    ArrowLabel.BackgroundTransparency = 1
    ArrowLabel.Text = "∨"
    ArrowLabel.TextColor3 = Color3.fromRGB(255, 30, 60)
    ArrowLabel.Font = Enum.Font.SourceSansBold
    ArrowLabel.TextSize = 14
    ArrowLabel.Parent = SectionFrame

    local Container = Instance.new("Frame")
    Container.Size = UDim2.new(1, 0, 0, 0)
    Container.Position = UDim2.new(0, 0, 0, 36)
    Container.BackgroundTransparency = 1
    Container.Parent = SectionFrame

    local ContainerList = Instance.new("UIListLayout")
    ContainerList.Padding = UDim.new(0, 4)
    ContainerList.SortOrder = Enum.SortOrder.LayoutOrder
    ContainerList.Parent = Container

    local isExpanded = false

    local function UpdateSectionSize()
        if isExpanded then
            local contentHeight = ContainerList.AbsoluteContentSize.Y
            SectionFrame.Size = UDim2.new(1, -5, 0, 36 + contentHeight + 8)
            Container.Size = UDim2.new(1, 0, 0, contentHeight)
            ArrowLabel.Text = "∧"
        else
            SectionFrame.Size = UDim2.new(1, -5, 0, 36)
            ArrowLabel.Text = "∨"
        end
    end

    HeaderBtn.MouseButton1Click:Connect(function()
        isExpanded = not isExpanded
        UpdateSectionSize()
    end)

    local SectionAPI = {}
    
    -- Tambah Sakelar Saklar Toggle
    function SectionAPI:AddToggle(labelText, defaultState, callback)
        local ToggleFrame = Instance.new("Frame")
        ToggleFrame.Size = UDim2.new(1, -12, 0, 30)
        ToggleFrame.Position = UDim2.new(0, 6, 0, 0)
        ToggleFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
        ToggleFrame.Parent = Container

        local ToggleCorner = Instance.new("UICorner")
        ToggleCorner.CornerRadius = UDim.new(0, 4)
        ToggleCorner.Parent = ToggleFrame

        local Label = Instance.new("TextLabel")
        Label.Size = UDim2.new(1, -50, 1, 0)
        Label.Position = UDim2.new(0, 8, 0, 0)
        Label.BackgroundTransparency = 1
        Label.Text = labelText
        Label.TextColor3 = Color3.fromRGB(220, 220, 230)
        Label.Font = Enum.Font.SourceSansSemibold
        Label.TextSize = 11
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Parent = ToggleFrame

        local SwitchBtn = Instance.new("TextButton")
        SwitchBtn.Size = UDim2.new(0, 38, 0, 18)
        SwitchBtn.Position = UDim2.new(1, -44, 0.5, -9)
        SwitchBtn.BackgroundColor3 = defaultState and Color3.fromRGB(255, 30, 60) or Color3.fromRGB(60, 60, 75)
        SwitchBtn.Text = defaultState and "ON" or "OFF"
        SwitchBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        SwitchBtn.Font = Enum.Font.SourceSansBold
        SwitchBtn.TextSize = 9
        SwitchBtn.Parent = ToggleFrame

        local SwitchCorner = Instance.new("UICorner")
        SwitchCorner.CornerRadius = UDim.new(0, 8)
        SwitchCorner.Parent = SwitchBtn

        local state = defaultState
        SwitchBtn.MouseButton1Click:Connect(function()
            state = not state
            SwitchBtn.BackgroundColor3 = state and Color3.fromRGB(255, 30, 60) or Color3.fromRGB(60, 60, 75)
            SwitchBtn.Text = state and "ON" or "OFF"
            if callback then callback(state) end
        end)

        if isExpanded then UpdateSectionSize() end
    end

    -- Tambah Sub-Label / Teks Penjelas Kategori
    function SectionAPI:AddSubText(text)
        local SubTextLabel = Instance.new("TextLabel")
        SubTextLabel.Size = UDim2.new(1, -12, 0, 20)
        SubTextLabel.Position = UDim2.new(0, 6, 0, 0)
        SubTextLabel.BackgroundTransparency = 1
        SubTextLabel.Text = "  [ " .. text .. " ]"
        SubTextLabel.TextColor3 = Color3.fromRGB(255, 80, 100)
        SubTextLabel.Font = Enum.Font.SourceSansBold
        SubTextLabel.TextSize = 10
        SubTextLabel.TextXAlignment = Enum.TextXAlignment.Left
        SubTextLabel.Parent = Container

        if isExpanded then UpdateSectionSize() end
    end

    return SectionAPI
end

