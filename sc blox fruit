--// Logika FPS Boost
RunService.Stepped:Connect(function()
    pcall(function()
        if Settings.FPSBoost then
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CastShadow = false
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                    v.Enabled = false
                end
            end
        end
    end)
end)

--// Noclip untuk Karakter saat Auto Collect Aktif
RunService.Stepped:Connect(function()
    pcall(function()
        if Settings.AutoCollectFruit then
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end)

--// Fungsi Deteksi Pulau
local function GetIslandName(pos)
    if pos.Z > 20000 then
        return "Third Sea Island"
    elseif pos.Z < -10000 and pos.Z > -30000 then
        return "Second Sea Island"
    else
        return "First Sea Island / Main Area"
    end
end

--// Logika Fruit ESP & Sistem Notifikasi Popup Beranimasi (Tween)
local function ShowFruitPopup(fruitName)
    pcall(function()
        local popupGui = Instance.new("ScreenGui")
        popupGui.Name = "FruitPopupNotification"
        popupGui.Parent = CoreGui
        
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 280, 0, 60)
        frame.Position = UDim2.new(0.5, -140, 0, -80)
        frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        frame.BorderColor3 = Color3.fromRGB(255, 215, 0)
        frame.Parent = popupGui
        
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = frame
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 215, 0)
        label.TextSize = 14
        label.Font = Enum.Font.SourceSansBold
        label.Text = "BUAH SPAWN!\n" .. fruitName
        label.Parent = frame
        
        -- Animasi Masuk (Slide In)
        local tweenIn = TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -140, 0, 30)})
        tweenIn:Play()
        
        task.delay(3, function()
            -- Animasi Keluar (Slide Out)
            local tweenOut = TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0.5, -140, 0, -80)})
            tweenOut:Play()
            tweenOut.Completed:Connect(function()
                popupGui:Destroy()
            end)
        end)
    end)
end

--// Logika Utama: Fruit ESP & Auto Collect Terbang Mulus (Stabil, Tanpa Teleport & Kamera Aman)
task.spawn(function()
    local activeESPs = {}
    local trackedNotif = {}
    local attachment, linearVelocity, alignOrientation
    
    while true do
        task.wait(0.2)
        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local humanoid = char and char:FindFirstChild("Humanoid")
            
            -- Bersihkan ESP lama
            for fruitObj, espGui in pairs(activeESPs) do
                if not fruitObj or not fruitObj.Parent then
                    if espGui then espGui:Destroy() end
                    activeESPs[fruitObj] = nil
                end
            end
            
            local targetFruit = nil
            local shortestDistance = math.huge
            
            for _, obj in pairs(Workspace:GetChildren()) do
                if obj:IsA("Tool") or obj:IsA("Model") then
                    if obj.Name:find("Fruit") then
                        local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
                        
                        if part then
                            -- Trigger Notifikasi Popup Beranimasi untuk buah baru
                            if not trackedNotif[obj] then
                                trackedNotif[obj] = true
                                ShowFruitPopup(obj.Name)
                            end
                            
                            -- Buat ESP Tag
                            if not activeESPs[obj] then
                                local bill = Instance.new("BillboardGui")
                                bill.Name = "FruitESP_Tag"
                                bill.Size = UDim2.new(0, 200, 0, 50)
                                bill.AlwaysOnTop = true
                                bill.StudsOffset = Vector3.new(0, 3, 0)
                                
                                local textLabel = Instance.new("TextLabel")
                                textLabel.Size = UDim2.new(1, 0, 1, 0)
                                textLabel.BackgroundTransparency = 1
                                textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                                textLabel.TextStrokeTransparency = 0
                                textLabel.TextSize = 14
                                textLabel.Font = Enum.Font.SourceSansBold
                                textLabel.Parent = bill
                                
                                bill.Parent = part
                                activeESPs[obj] = bill
                            end
                            
                            -- Update Teks ESP
                            if activeESPs[obj] and hrp then
                                local textLabel = activeESPs[obj]:FindFirstChild("TextLabel")
                                if textLabel then
                                    local dist = math.floor((hrp.Position - part.Position).Magnitude)
                                    local island = GetIslandName(part.Position)
                                    textLabel.Text = string.Format("[%s]\nJarak: %dm\nPulau: %s", obj.Name, dist, island)
                                end
                            end
                            
                            -- Cari buah terdekat untuk Auto Collect
                            if Settings.AutoCollectFruit and hrp then
                                local dist = (hrp.Position - part.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetFruit = part
                                end
                            end
                        end
                    end
                end
            end
            
            -- Eksekusi Terbang Mulus ke Buah (Tanpa Teleport & Kamera Stabil)
            if Settings.AutoCollectFruit and hrp and humanoid and humanoid.Health > 0 then
                if targetFruit and targetFruit.Parent then
                    humanoid.PlatformStand = true
                    
                    -- Setup Fisika Terbang Stabil
                    if not hrp:FindFirstChild("FruitFlyAttachment") then
                        attachment = Instance.new("Attachment")
                        attachment.Name = "FruitFlyAttachment"
                        attachment.Parent = hrp
                    else
                        attachment = hrp:FindFirstChild("FruitFlyAttachment")
                    end
                    
                    if not hrp:FindFirstChild("FruitFlyVelocity") then
                        linearVelocity = Instance.new("LinearVelocity")
                        linearVelocity.Name = "FruitFlyVelocity"
                        linearVelocity.Attachment0 = attachment
                        linearVelocity.MaxForce = math.huge
                        linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                        linearVelocity.Parent = hrp
                    else
                        linearVelocity = hrp:FindFirstChild("FruitFlyVelocity")
                    end
                    
                    if not hrp:FindFirstChild("FruitFlyOrientation") then
                        alignOrientation = Instance.new("AlignOrientation")
                        alignOrientation.Name = "FruitFlyOrientation"
                        alignOrientation.Attachment0 = attachment
                        alignOrientation.MaxTorque = math.huge
                        alignOrientation.Responsiveness = 200
                        alignOrientation.Parent = hrp
                    else
                        alignOrientation = hrp:FindFirstChild("FruitFlyOrientation")
                    end
                    
                    local targetPos = targetFruit.Position + Vector3.new(0, 2, 0)
                    local direction = (targetPos - hrp.Position)
                    local distance = direction.Magnitude
                    
                    if distance > 3 then
                        linearVelocity.VectorVelocity = direction.Unit * 280
                        alignOrientation.CFrame = CFrame.new(hrp.Position, targetPos)
                        StatusLabel.Text = "Terbang ke Buah..."
                    else
                        linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
                        StatusLabel.Text = "Mengambil Buah..."
                    end
                else
                    -- Jika tidak ada buah, hapus physics terbang sementara
                    if hrp:FindFirstChild("FruitFlyVelocity") then hrp.FruitFlyVelocity:Destroy() end
                    if hrp:FindFirstChild("FruitFlyOrientation") then hrp.FruitFlyOrientation:Destroy() end
                    if hrp:FindFirstChild("FruitFlyAttachment") then hrp.FruitFlyAttachment:Destroy() end
                    humanoid.PlatformStand = false
                    StatusLabel.Text = "Status: Menunggu Buah Spawn..."
                end
            else
                -- Matikan fitur terbang jika toggle dimatikan atau karakter mati
                if hrp then
                    if hrp:FindFirstChild("FruitFlyVelocity") then hrp.FruitFlyVelocity:Destroy() end
                    if hrp:FindFirstChild("FruitFlyOrientation") then hrp.FruitFlyOrientation:Destroy() end
                    if hrp:FindFirstChild("FruitFlyAttachment") then hrp.FruitFlyAttachment:Destroy() end
                end
                if humanoid then
                    humanoid.PlatformStand = false
                end
                if not Settings.FruitESP then
                    StatusLabel.Text = "Status: Ready"
                end
            end
        end)
    end
end)
