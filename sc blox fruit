-- 3. NOCLIP AMAN & ANTI-TRAP
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local onGround = false
        if root then
            local ray = Ray.new(root.Position, Vector3.new(0, -3.5, 0))
            local hitPart = Workspace:FindPartOnRayWithIgnoreList(ray, {char})
            if hitPart then onGround = true end
        end

        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                if part.Name == "HumanoidRootPart" and onGround then
                    part.CanCollide = true
                else
                    part.CanCollide = false
                end
            end
        end

        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "Trap" or obj.Name == "BearTrap" then
                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                elseif obj:IsA("Model") then
                    for _, p in pairs(obj:GetChildren()) do
                        if p:IsA("BasePart") then p.CanTouch = false end
                    end
                end
            end
        end
    end
end)

-- 4. ESP ENGINE
task.spawn(function()
    while task.wait(1) do
        if Settings.ESP then
            for _, obj in pairs(Workspace:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local name = string.lower(obj.Name)
                    if name:find("key") or name:find("plank") or name:find("wrench") or name:find("hammer") or name:find("door") or name:find("piggy") or name:find("gun") or name:find("code") then
                        if not obj:FindFirstChild("PiggyESP") then
                            local highlight = Instance.new("Highlight")
                            highlight.Name = "PiggyESP"
                            highlight.FillTransparency = 0.5
                            highlight.OutlineTransparency = 0
                            if name:find("piggy") then
                                highlight.FillColor = Color3.fromRGB(255, 0, 0)
                            else
                                highlight.FillColor = Color3.fromRGB(0, 255, 128)
                            end
                            highlight.Parent = obj
                        end
                    end
                end
            end
        end
    end
end)
