                itemBtn.Text = "  • " .. obj.Name .. " [" .. obj.ClassName .. "]"
                itemBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
            end)
        end
    end
    
    -- Sesuaikan tinggi scrolling berdasarkan jumlah item
    ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, count * 32)
end

