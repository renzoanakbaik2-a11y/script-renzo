-- Loop Utama Pemantau Buah & Logika Anti-Reset Timer 10 Detik
task.spawn(function()
    task.wait(10) 
    local noFruitTimer = 0
    local isHopping = false

    while task.wait(1) do
        if isHopping then continue end

        autoStoreFruits()

        local hasFruitNow = false
        for _, obj in ipairs(Workspace:GetChildren()) do
            if isRealSpawnedFruit(obj) then
                hasFruitNow = true
                break
            end
        end

        if hasFruitNow then
            noFruitTimer = 0 
            if Settings.AutoCollectFruit and not activeFlyConnection then
                pcall(function()
                    collectNearestFruit()
                end)
            end

            if Settings.FruitNotifier then
                playFruitSound()
                showCustomNotification("BUAH TERDETEKSI DI MAP!", Color3.fromRGB(46, 204, 113))
            end
        else
            if Settings.AutoServerHop then
                noFruitTimer = noFruitTimer + 1
                
                local timeLeft = 10 - noFruitTimer
                if timeLeft > 0 then
                    showCustomNotification("Tidak ada buah. Hop dalam: " .. timeLeft .. "s", Color3.fromRGB(241, 196, 15))
                else
                    isHopping = true
                    showCustomNotification("Waktu habis! Menjalankan Server Hop...", Color3.fromRGB(231, 76, 60))
                    
                    triggerFinalServerHop()
                    
                    task.wait(20)
                    isHopping = false
                    noFruitTimer = 0
                end
            else
                noFruitTimer = 0
            end
        end
    end
end)

