-- 2. PENULUSURAN TARGET MOBS
local function GetNearestTarget()
    local nearestEnemy = nil
    local shortestDistance = math.huge
    local mobsFolder = Workspace:FindFirstChild("Mobs") or Workspace:FindFirstChild("Enemies")
    if not mobsFolder then return nil end

    for _, desc in pairs(mobsFolder:GetDescendants()) do
        if desc:IsA("Model") and desc ~= Character then
            local enemyHum = desc:FindFirstChildOfClass("Humanoid")
            local enemyRoot = desc:FindFirstChild("HumanoidRootPart") 
                or desc.PrimaryPart 
                or desc:FindFirstChild("Collider")
                or desc:FindFirstChildWhichIsA("BasePart")
            
            local isAlive = true
            if enemyHum and enemyHum.Health <= 0 then isAlive = false end
            
            if enemyRoot and isAlive then
                local dist = (RootPart.Position - enemyRoot.Position).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    nearestEnemy = enemyRoot
                end
            end
        end
    end
    return nearestEnemy
end

-- 3. AUTO ATTACK
local function AutoAttack()
    local now = tick()
    if now - lastAttackTime < CONFIG.ATTACK_DELAY then return end
    lastAttackTime = now

    local tool = Character:FindFirstChildOfClass("Tool")
    if not tool then
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            local backpackTool = backpack:FindFirstChildOfClass("Tool")
            if backpackTool then
                Humanoid:EquipTool(backpackTool)
                tool = backpackTool
            end
        end
    end
    if tool then tool:Activate() end
end

-- 4. GACHA PETI (2 PETI GRATIS)
local function ClaimGachaChests()
    if isLooting then return end
    isLooting = true
    StatusLabel.Text = "Status: Membuka Peti..."
    task.wait(1.5)
    
    local chestsFolder = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
    if chestsFolder then
        local allChests = chestsFolder:GetChildren()
        if #allChests >= 3 then
            local availableIndices = {1, 2, 3}
            local selectedChests = {}
            for i = 1, 2 do
                local randomIndex = math.random(1, #availableIndices)
                table.insert(selectedChests, allChests[availableIndices[randomIndex]])
                table.remove(availableIndices, randomIndex)
            end
            for _, chest in ipairs(selectedChests) do
                local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    fireproximityprompt(prompt)
                    task.wait(0.8)
                end
            end
        end
    end
    task.wait(1)
    isLooting = false
end

-- 5. TOGGLE EVENT & FLY HOVER LOOP
ToggleBtn.MouseButton1Click:Connect(function()
    isAutoFarm = not isAutoFarm
    
    if isAutoFarm then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 80)
        ToggleBtn.Text = "AUTO FARM: ON"
        
        heartbeatConnection = RunService.Heartbeat:Connect(function()
            if not isAutoFarm then return end
            
            Character = LocalPlayer.Character
            if not Character then return end
            RootPart = Character:FindFirstChild("HumanoidRootPart")
            Humanoid = Character:FindFirstChildOfClass("Humanoid")
            if not RootPart or not Humanoid then return end
            
            -- Netralkan gaya gravitasi Roblox agar melayang stabil di udara
            RootPart.AssemblyLinearVelocity = Vector3.zero
            
            local isTargetValid = false
            if currentTargetRoot and currentTargetRoot.Parent and currentTargetRoot:IsDescendantOf(Workspace) then
                isTargetValid = true
            end
            
            if not isTargetValid then
                currentTargetRoot = GetNearestTarget()
            end
            
            if currentTargetRoot then
                local enemyName = currentTargetRoot.Parent.Name
                local enemyPos = currentTargetRoot.Position
                local targetFlyPos = Vector3.new(enemyPos.X, enemyPos.Y + CONFIG.FLY_HEIGHT, enemyPos.Z)
                
                StatusLabel.Text = "Status: Terbang di atas " .. enemyName
                
                -- Pindahkan posisi CFrame melayang tepat 12 studs di atas musuh
                RootPart.CFrame = CFrame.new(targetFlyPos, enemyPos)
                AutoAttack()
            else
                local chests = Workspace:FindFirstChild("Chests") or Workspace:FindFirstChild("LootChests") or Workspace:FindFirstChild("Rewards")
                if chests and #chests:GetChildren() > 0 and not isLooting then
                    ClaimGachaChests()
                else
                    StatusLabel.Text = "Status: Menunggu Mobs..."
                end
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ToggleBtn.Text = "AUTO FARM: OFF"
        StatusLabel.Text = "Status: IDLE"
        currentTargetRoot = nil
        
        if heartbeatConnection then
            heartbeatConnection:Disconnect()
            heartbeatConnection = nil
        end
    end
end)-- ==========================================================
