    for name, page in pairs(TabPages) do
        page.Visible = (name == tabName)
    end
    if activeBtn then
        activeBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
        activeBtn.TextColor3 = Color3.fromRGB(160, 160, 170)
        local stroke = activeBtn:FindFirstChildOfClass("UIStroke")
        if stroke then stroke.Color = Color3.fromRGB(40, 40, 50) end
    end
    btn.BackgroundColor3 = Color3.fromRGB(45, 15, 25)
    btn.TextColor3 = Color3.fromRGB(255, 80, 100)
    local stroke = btn:FindFirstChildOfClass("UIStroke")
    if stroke then stroke.Color = Color3.fromRGB(255, 30, 60) end
    activeBtn = btn
end

