-- 3. LOGIKA UTAMA (TELEPORT + MUKUL)
local isRunning = false

-- Fungsi cari bola di Workspace
local function cariBola()
	-- Mencari part/model yang namanya mengandung kata "Ball" atau "Bola"
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			if obj.Name:lower():find("ball") or obj.Name:lower():find("bola") then
				if obj:IsA("BasePart") then
					return obj
				elseif obj:IsA("Model") and obj.PrimaryPart then
					return obj.PrimaryPart
				end
			end
		end
	end
	return nil
end

-- Fungsi eksekusi Teleport & Pukul
local function kejarDanPukul()
	local char = LocalPlayer.Character
	if not char then return end
	
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	
	-- 1. Ambil/Equip Senjata
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			tool = backpack:FindFirstChildOfClass("Tool")
			if tool then
				tool.Parent = char -- Equip senjata
			end
		end
	end
	
	-- 2. Cari Bola
	local bola = cariBola()
	if bola then
		-- Teleport ke posisi bola (agak sedikit di atas bola biar gak nempel banget)
		hrp.CFrame = bola.CFrame * CFrame.new(0, 2, 3)
		
		-- Mukul pakai senjata
		if tool then
			tool:Activate()
		end
		
		Status.Text = "Status: Teleport & Mukul Bola!"
		Status.TextColor3 = Color3.fromRGB(100, 255, 150)
	else
		Status.Text = "Status: Bola tidak ditemukan!"
		Status.TextColor3 = Color3.fromRGB(255, 100, 100)
	end
end

-- 4. PENGHUBUNG TOMBOL
Tombol.MouseButton1Click:Connect(function()
	isRunning = not isRunning
	
	if isRunning then
		Tombol.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
		Tombol.Text = "AUTO CHASE & HIT: ON"
		
		task.spawn(function()
			while isRunning do
				kejarDanPukul()
				task.wait(0.1) -- Jeda loop teleport & mukul
			end
		end)
	else
		Tombol.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
		Tombol.Text = "AUTO CHASE & HIT: OFF"
		Status.Text = "Status: Off"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
