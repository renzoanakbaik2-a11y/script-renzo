-- 3. LOGIKA MEMAKSA UI SKILL TETAP MUNCUL (PREVENT HIDE)
local function ForceSkillUIVisible()
    for _, gui in ipairs(PlayerGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "SpeedHubStep1V18UI" then
            for _, descendant in ipairs(gui:GetDescendants()) do
                if descendant:IsA("Frame") or descendant:IsA("ImageLabel") or descendant:IsA("CanvasGroup") then
                    local name = descendant.Name:lower()
                    if name:find("skill") or name:find("ability") or name:find("button") or name:find("hud") then
                        descendant.Visible = true
                    end
                end
            end
        end
    end
end

-- 4. LOGIKA SERANGAN DENGAN ARGUMEN REMOTE
local comboCount = 1

local function PerformAttackWithArgs()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local tool = char:FindFirstChildOfClass("Tool")

    -- Cari RemoteEvent di Tool atau ReplicatedStorage
    local remote = nil
    if tool then
        for _, obj in ipairs(tool:GetDescendants()) do
            if obj:IsA("RemoteEvent") then remote = obj break end
        end
    end

    if not remote then
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") then
                local n = obj.Name:lower()
                if n:find("attack") or n:find("combat") or n:find("m1") or n:find("swing") then
                    remote = obj
                    break
                end
            end
        end
    end

    -- Kirim Remote dengan Argumen Standar RPG
    if remote then
        pcall(function()
            remote:FireServer(comboCount, hrp.CFrame)
            remote:FireServer("Attack", comboCount)
            remote:FireServer({["Combo"] = comboCount, ["CFrame"] = hrp.CFrame})
        end)
        
        comboCount = comboCount + 1
        if comboCount > 4 then comboCount = 1 end
    end
end

local isRunning = false

ToggleBtn.MouseButton1Click:Connect(function()
