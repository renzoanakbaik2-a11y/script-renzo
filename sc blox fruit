-- AMANKAN KARAKTER (Biar Nggak Mati Kena Anti-Cheat / Jatuh)
local function amankanKarakter(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:ChangeState(Enum.HumanoidStateType.Swimming)
	end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.CanCollide = false
		end
	end
end

-- FUNGSI TERBANG MELAYANG (TWEEN FLY)
local function terbangKe(cframeTujuan, speed)
	local char = LocalPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local hrp = char.HumanoidRootPart
	
	amankanKarakter(char)
	
	local jarak = (hrp.Position - cframeTujuan.Position).Magnitude
	local durasi = jarak / (speed or 180)
	
	local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(hrp, tweenInfo, {CFrame = cframeTujuan})
	tween:Play()
	tween.Completed:Wait()
end

-- PUKUL OTOMATIS
local function hitTarget()
	local char = LocalPlayer.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		tool:Activate()
	end
end

-- DETEKSI TEKS MISI AKTIF DI UI
local function dapatkanInfoQuestUI()
	for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
		if gui:IsA("TextLabel") and gui.Visible and gui.Text ~= "" then
			local txt = gui.Text:lower()
			if txt:find("0/") or txt:find("1/") or txt:find("2/") or txt:find("3/") or txt:find("4/") or txt:find("5/") or txt:find("kill") or txt:find("defeat") or txt:find("collect") or txt:find("find") then
				return txt
			end
		end
	end
	return ""
end

-- EKSEKUSI TOMBOL UTAMA
BtnQuest.MouseButton1Click:Connect(function()
	isQuestActive = not isQuestActive
	
	if isQuestActive then
		BtnQuest.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
		BtnQuest.Text = "AUTO MISI LANGSUNG: ON"
		
		task.spawn(function()
			while isQuestActive do
				local char = LocalPlayer.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local hrp = char.HumanoidRootPart
					local questText = dapatkanInfoQuestUI()
					
					Status.Text = "Status: Eksekusi Misi...\n[" .. (questText ~= "" and questText or "Memindai Target...") .. "]"
					Status.TextColor3 = Color3.fromRGB(100, 255, 150)
					
					-- 1. JIKA MISI BERTARUNG (Pukul Mob/Musuh Terdekat)
					local musuhDitemukan = false
					for _, mob in ipairs(Workspace:GetDescendants()) do
						if mob:IsA("Model") and mob:FindFirstChildOfClass("Humanoid") then
							local mobHrp = mob:FindFirstChild("HumanoidRootPart") or mob.PrimaryPart
							local hum = mob:FindFirstChildOfClass("Humanoid")
							
							-- Pastikan Musuh Asli (Bukan Karakter Player)
							if mobHrp and hum and hum.Health > 0 and mob.Name ~= LocalPlayer.Name and not Players:GetPlayerFromCharacter(mob) then
								musuhDitemukan = true
								-- Terbang melayang 8 stud di atas musuh
								terbangKe(mobHrp.CFrame * CFrame.new(0, 8, 0) * CFrame.Angles(math.rad(-90), 0, 0), 200)
								hitTarget()
								break
							end
						end
					end
					
					-- 2. JIKA MISI NON-BERTARUNG (Cari Objek/Item Misi)
					if not musuhDitemukan then
						for _, obj in ipairs(Workspace:GetDescendants()) do
							if obj:IsA("BasePart") or obj:IsA("Model") then
								local namaObj = obj.Name:lower()
								if namaObj:find("item") or namaObj:find("candy") or namaObj:find("chest") or namaObj:find("target") or namaObj:find("quest") then
									local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildOfClass("BasePart")) or obj
									if part then
										terbangKe(part.CFrame, 200)
										if firetouchinterest then
											firetouchinterest(hrp, part, 0)
											firetouchinterest(hrp, part, 1)
										end
										for _, prompt in ipairs(obj:GetDescendants()) do
											if prompt:IsA("ProximityPrompt") and fireproximityprompt then
												fireproximityprompt(prompt)
											end
										end
										break
									end
								end
							end
						end
					end
				end
				task.wait(0.1)
			end
		end)
	else
		BtnQuest.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		BtnQuest.Text = "AUTO MISI LANGSUNG: OFF"
		Status.Text = "Status: Off"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
