task.spawn(function()
    while true do
        task.wait(0.03)
        if Settings.AutoFarm then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                DisableGravity(root)

                -- Auto Equip Weapon
                if not char:FindFirstChildOfClass("Tool") then
                    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                        if tool:IsA("Tool") then
                            hum:EquipTool(tool)
                            break
                        end
                    end
                end

                -- Safe Hitbox Extender Logic
                local activeTool = char:FindFirstChildOfClass("Tool")
                if activeTool then
                    local handle = activeTool:FindFirstChild("Handle")
                    if handle and handle:IsA("BasePart") then
                        if not OriginalHandleSizes[activeTool] then
                            OriginalHandleSizes[activeTool] = handle.Size
                        end
                        handle.Size = Settings.HitboxSize
                        handle.Transparency = 0.7
                        handle.CanCollide = false
                    end
                end

                local enemies = workspace:FindFirstChild("Enemies")
                if enemies then
                    local targetMob = nil

                    for _, mob in pairs(enemies:GetChildren()) do
                        local mHum = mob:FindFirstChildOfClass("Humanoid")
                        local mRoot = mob:FindFirstChild("HumanoidRootPart")
                        if mHum and mHum.Health > 0 and mRoot then
                            targetMob = mob
                            break
                        end
                    end

                    if targetMob then
                        local targetRoot = targetMob.HumanoidRootPart
                        local targetPos = targetRoot.Position
                        local hoverPos = targetPos + Vector3.new(0, Settings.FarmDistance, 0)

                        -- Hovering Above Mob Target & Facing Down
                        root.CFrame = CFrame.lookAt(hoverPos, targetPos)

                        -- Mob Magnet Logic
                        if Settings.MobMagnet then
                            local magnetPoint = root.Position - Vector3.new(0, Settings.FarmDistance - 1, 0)
                            for _, mob in pairs(enemies:GetChildren()) do
                                local mHum = mob:FindFirstChildOfClass("Humanoid")
                                local mRoot = mob:FindFirstChild("HumanoidRootPart")

                                if mHum and mHum.Health > 0 and mRoot then
                                    if (mRoot.Position - root.Position).Magnitude <= Settings.MagnetRadius then
                                        for _, mPart in pairs(mob:GetChildren()) do
                                            if mPart:IsA("BasePart") then
                                                mPart.CanCollide = false
                                            end
                                        end

                                        mRoot.CFrame = CFrame.new(magnetPoint) * (mRoot.CFrame - mRoot.CFrame.Position)
                                        mRoot.Velocity = Vector3.new(0, 0, 0)
                                        mHum.WalkSpeed = 0
                                    end
                                end
                            end
                        end

                        -- Trigger Attack
                        if activeTool then activeTool:Activate() end
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                    end
                end
            end
        else
            -- Clean Up Gravity & Reset Weapon Sizes when OFF
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then EnableGravity(root) end

            for tool, originalSize in pairs(OriginalHandleSizes) do
                if tool and tool:FindFirstChild("Handle") then
                    tool.Handle.Size = originalSize
                    tool.Handle.Transparency = 0
                end
            end
        end
    end
