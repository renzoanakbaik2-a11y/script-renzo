--// Event Handler untuk Tombol Menu
OpenButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

ChestToggleBtn.MouseButton1Click:Connect(function()
    Settings.AutoChest = not Settings.AutoChest
    ChestToggleBtn.BackgroundColor3 = Settings.AutoChest and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    ChestToggleBtn.Text = "Auto Collect Chest: " .. (Settings.AutoChest and "ON" or "OFF")
    SaveSettings()
end)

--// Noclip Loop
RunService.Stepped:Connect(function()
    pcall(function()
        if Settings.AutoChest then
            local char = LocalPlayer.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end)
end)

--// Auto Collect Chest Logic (Using BodyVelocity / LinearVelocity for direct physical movement)
task.spawn(function()
    local bv, bg
    while true do
        task.wait(0.1)
        pcall(function()
            if Settings.AutoChest then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChild("Humanoid")
                
                if hrp and humanoid and humanoid.Health > 0 then
                    local targetChest = nil
                    local shortestDistance = math.huge
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        local nameLower = obj.Name:lower()
                        if (nameLower:find("chest") or nameLower:find("box")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            if part then
                                local dist = (hrp.Position - part.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    targetChest = part
                                end
                            end
                        end
                    end
                    
                    if targetChest then
                        humanoid.PlatformStand = true
                        
                        -- Setup BodyVelocity & BodyGyro untuk terbang mulus langsung ke target
                        if not hrp:FindFirstChild("CustomChestFlyBV") then
                            bv = Instance.new("BodyVelocity")
                            bv.Name = "CustomChestFlyBV"
                            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bv.Velocity = Vector3.new(0, 0, 0)
                            bv.Parent = hrp
                        else
                            bv = hrp:FindFirstChild("CustomChestFlyBV")
                        end
                        
                        if not hrp:FindFirstChild("CustomChestFlyBG") then
                            bg = Instance.new("BodyGyro")
                            bg.Name = "CustomChestFlyBG"
                            bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                            bg.P = 10000
                            bg.Parent = hrp
                        else
                            bg = hrp:FindFirstChild("CustomChestFlyBG")
                        end
                        
                        while Settings.AutoChest and targetChest.Parent and (hrp.Position - targetChest.Position).Magnitude > 4 do
                            local direction = (targetChest.Position - hrp.Position).Unit
                            bv.Velocity = direction * 250
                            bg.CFrame = CFrame.new(hrp.Position, targetChest.Position)
                            task.wait(0.05)
                        end
                        
                        if bv then bv.Velocity = Vector3.new(0, 0, 0) end
                        humanoid.PlatformStand = false
                    else
                        if hrp:FindFirstChild("CustomChestFlyBV") then hrp.CustomChestFlyBV:Destroy() end
                        if hrp:FindFirstChild("CustomChestFlyBG") then hrp.CustomChestFlyBG:Destroy() end
                        humanoid.PlatformStand = false
                    end
                end
            else
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChild("Humanoid")
                if hrp then
                    if hrp:FindFirstChild("CustomChestFlyBV") then hrp.CustomChestFlyBV:Destroy() end
                    if hrp:FindFirstChild("CustomChestFlyBG") then hrp.CustomChestFlyBG:Destroy() end
                end
                if humanoid then
                    humanoid.PlatformStand = false
                end
            end
        end)
    end
end)
