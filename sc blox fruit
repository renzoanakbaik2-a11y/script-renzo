-- 3. LOGIKA KLIK TOMBOL BAWAAN GAME
local isRunning = false

local function TapNativeButton()
    local clicked = false
    
    -- Lacak semua UI di layar untuk mencari tombol Attack bawaan
    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if (gui:IsA("ImageButton") or gui:IsA("TextButton")) and gui.Visible then
            local name = gui.Name:lower()
            local parentName = gui.Parent and gui.Parent.Name:lower() or ""
            
            -- Filter nama yang sering dipakai developer buat tombol serang
            if name:find("attack") or name:find("combat") or name:find("m1") or name:find("basic") or name:find("action") or parentName:find("attack") then
                
                -- Eksekusi lewat getconnections (Invisible click)
                if getconnections then
                    pcall(function()
                        for _, conn in pairs(getconnections(gui.MouseButton1Down)) do conn:Fire() end
                        for _, conn in pairs(getconnections(gui.MouseButton1Click)) do conn:Fire() end
                        for _, conn in pairs(getconnections(gui.Activated)) do conn:Fire() end
                        for _, conn in pairs(getconnections(gui.TouchTap)) do conn:Fire() end
                    end)
                end

                -- Eksekusi lewat koordinat murni tombol (Fisik)
                local inset = game:GetService("GuiService"):GetGuiInset()
                local centerX = gui.AbsolutePosition.X + (gui.AbsoluteSize.X / 2)
                local centerY = gui.AbsolutePosition.Y + (gui.AbsoluteSize.Y / 2) + inset.Y
                
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 0)
                task.wait(0.01)
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 0)
                
                clicked = true
            end
        end
    end

    -- Kalau tombol gagal dilacak, pakai simulasi klik kiri (M1) tanpa sentuh layar virtual
    if not clicked then
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.01)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    isRunning = not isRunning
    if isRunning then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
