-- ===================================================
-- 6. LOGIKA SMART TELEPORT & ANTI-SPAM (Bumbu Terbaru)
-- ===================================================
local isAutoHitActive = false
local isProcessingHit = false
local lastProcessedRing = nil

-- Mukul Cuma Sekali Pas Dipanggil
local function SingleSwing()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.03)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

-- Deteksi Ring khusus Area Player (Bukan Area Lawan)
local function GetPlayerSideRing()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Decal") then
            local name = obj.Name:lower()
            if (name:find("ring") or name:find("indicator") or name:find("target") or name:find("landing")) then
                local ringPart = obj:IsA("BasePart") and obj or obj.Parent
                if ringPart and ringPart:IsA("BasePart") then
                    -- Filter 1: Pastikan ring ini belum pernah dipukul sebelumnya
                    if ringPart ~= lastProcessedRing then
                        -- Filter 2: Cek apakah ring ini lebih dekat ke sisi kita (Max jarak 60 studs)
                        local dist = (myPos - ringPart.Position).Magnitude
                        if dist <= 60 then
                            return ringPart
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- Function Emergency Reset
local function ResetScriptState()
    isAutoHitActive = false
    isProcessingHit = false
    lastProcessedRing = nil
    BtnTeleportHit.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    BtnTeleportHit.Text = "SMART TELEPORT HIT: OFF"
    StatusText.Text = "Status: Script Reset Successfully!"
end

-- 7. EVENTS & LISTENERS
BtnTeleportHit.MouseButton1Click:Connect(function()
    isAutoHitActive = not isAutoHitActive
    if isAutoHitActive then
        BtnTeleportHit.BackgroundColor3 = Color3.fromRGB(255, 30, 60)
        BtnTeleportHit.Text = "SMART TELEPORT HIT: ON"
        StatusText.Text = "Status: Waiting for Ball on Our Side..."
    else
        ResetScriptState()
    end
end)

BtnReset.MouseButton1Click:Connect(function()
    ResetScriptState()
end)

-- LOOP UTAMA ENGINE
RunService.RenderStepped:Connect(function()
    if not isAutoHitActive or isProcessingHit then return end

    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local HRP = char.HumanoidRootPart

    local targetRing = GetPlayerSideRing()

    if targetRing then
        isProcessingHit = true
        lastProcessedRing = targetRing
        StatusText.Text = "Status: Teleporting & 1-Hit!"

        -- 1. Teleport Presisi di atas Ring
        local ringPos = targetRing.Position
        HRP.CFrame = CFrame.new(ringPos + Vector3.new(0, 2.5, 0), Vector3.new(ringPos.X, HRP.Position.Y, ringPos.Z))

        -- 2. Delay sangat tipis biar fisik pendaratan pas, lalu Eksekusi 1X SWING SAJA
        task.wait(0.02)
        SingleSwing()

        -- 3. Lock Cooldown biar gak spamming di ring yang sama
        task.wait(0.3)
        isProcessingHit = false
        
        if isAutoHitActive then
            StatusText.Text = "Status: Waiting for Next Ball..."
        end
    end
end)
