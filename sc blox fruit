local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

local CONFIG_FILE_NAME = "RacketRivals_UltimateSettings.json"

local CONFIG = {
    AutoHitEnabled = false,
    AutoTeleportEnabled = false,
    HitDistance = 18,
    TeleportDistance = 30,
    TeleportOffset = {0, 2, -2}
}

-- Sistem Save & Load Pengaturan
local function saveSettings()
    local success, encoded = pcall(function()
        return HttpService:JSONEncode(CONFIG)
    end)
    if success and writefile then
        pcall(function() writefile(CONFIG_FILE_NAME, encoded) end)
    end
end

local function loadSettings()
    if readfile and pcall(function() return readfile(CONFIG_FILE_NAME) end) then
        local success, decoded = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE_NAME))
        end)
        if success and type(decoded) == "table" then
            for k, v in pairs(decoded) do
                CONFIG[k] = v
            end
        end
    end
end

loadSettings()

