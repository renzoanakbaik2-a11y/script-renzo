local function SafeEquipTool()
    task.wait(0.5)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if char and hum and not char:FindFirstChildOfClass("Tool") then
        local toolToEquip = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
        if toolToEquip then
            hum:EquipTool(toolToEquip)
        end
    end
end

