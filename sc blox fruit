local currentTabBtn = nil

local function SwitchTab(tabName, btn)
    for name, page in pairs(TabPages) do
        page.Visible = (name == tabName)
    end
    if currentTabBtn then
        currentTabBtn.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
        currentTabBtn.TextColor3 = Color3.fromRGB(160, 160, 170)
        local oldStroke = currentTabBtn:FindFirstChildOfClass("UIStroke")
        if oldStroke then oldStroke.Color = Color3.fromRGB(40, 40, 50) end
    end
    btn.BackgroundColor3 = Color3.fromRGB(40, 15, 22)
    btn.TextColor3 = Color3.fromRGB(255, 80, 100)
    local newStroke = btn:FindFirstChildOfClass("UIStroke")
    if newStroke then newStroke.Color = Color3.fromRGB(255, 30, 60) end
    currentTabBtn = btn
end

