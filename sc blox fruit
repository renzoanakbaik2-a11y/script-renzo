local ToggleHopBtn = CreateBtn(UDim2.new(0, 20, 0, 55))
local TeamBtn      = CreateBtn(UDim2.new(0, 20, 0, 105))
local RejoinTeamBtn = CreateBtn(UDim2.new(0, 20, 0, 155))

-- Status Tampilan Tombol Awal
ToggleHopBtn.Text = config.autoHopActive and "Auto Hop: ON" or "Auto Hop: OFF"
ToggleHopBtn.BackgroundColor3 = config.autoHopActive and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(231, 76, 60)

TeamBtn.Text = "Tim: " .. config.selectedTeam
TeamBtn.BackgroundColor3 = Color3.fromRGB(52, 152, 219)

RejoinTeamBtn.Text = "Paksa Pilih Tim Ini"
RejoinTeamBtn.BackgroundColor3 = Color3.fromRGB(155, 89, 182)

-- Aksi Tombol Buka/Tutup Menu
ToggleMenuBtn.MouseButton1Down:Connect(function()
	Main.Visible = not Main.Visible
end)

-- Aksi Tombol Ganti Tim (Pirates / Marines)
TeamBtn.MouseButton1Click:Connect(function()
	if config.selectedTeam == "Pirates" then
		config.selectedTeam = "Marines"
	else
		config.selectedTeam = "Pirates"
	end
	TeamBtn.Text = "Tim: " .. config.selectedTeam
	saveConfig()
	autoSelectTeam()
end)

-- Aksi Tombol Paksa Pilih Tim Manual
RejoinTeamBtn.MouseButton1Click:Connect(function()
	autoSelectTeam()
end)

-- ==========================================================
-- PENCARIAN BUAH & LOGIKA AUTO HOP
-- ==========================================================
local function findFruit()
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj:IsA("Tool") and (obj.Name:find("Fruit") or obj:FindFirstChild("Handle")) then
			return obj
		end
	end
	return nil
end

local function startFruitSearch()
	if not config.autoHopActive then return end

	print("[Blox Fruits] Masuk server baru, melewati menu tim & merapikan posisi...")
	task.wait(1.5)
	autoSelectTeam()
	task.wait(1.5)

	local detectedFruit = findFruit()
	if detectedFruit then
		-- JIKA ADA BUAH: Diam, Auto Hop dimatikan, Teleport ke dekat buah
		print("[SUKSES] Buah ditemukan: " .. detectedFruit.Name .. "! Auto Hop dihentikan agar Anda bisa mengambilnya.")
		config.autoHopActive = false
		saveConfig()
		
		ToggleHopBtn.Text = "Buah Ketemu! (OFF)"
		ToggleHopBtn.BackgroundColor3 = Color3.fromRGB(241, 196, 15)
		
		if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
			local handle = detectedFruit:FindFirstChild("Handle") or detectedFruit:FindFirstChildWhichIsA("BasePart")
			if handle then
				player.Character.HumanoidRootPart.CFrame = handle.CFrame + Vector3.new(0, 5, 0)
			end
		end
		return
	end

	-- JIKA TIDAK ADA BUAH: Lanjut Hop ke Server Lain
	print("[Blox Fruits] Tidak ada buah di server ini. Mencari server lain...")
	local success, result = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
		return HttpService:JSONDecode(game:HttpGet(url))
	end)

	if success and result and result.data then
		local servers = {}
		for _, server in ipairs(result.data) do
			if server.playing < server.maxPlayers and server.id ~= game.JobId then
				table.insert(servers, server.id)
			end
		end

		if #servers > 0 then
			local randomServerId = servers[math.random(1, #servers)]
			TeleportService:TeleportToPlaceInstance(placeId, randomServerId, player, { autoHop = true })
		else
			task.wait(SEARCH_DELAY)
			startFruitSearch()
		end
	else
		task.wait(SEARCH_DELAY)
		startFruitSearch()
	end
end

-- Aksi Tombol On/Off Auto Hop
ToggleHopBtn.MouseButton1Click:Connect(function()
	config.autoHopActive = not config.autoHopActive
	saveConfig()
	
	if config.autoHopActive then
		ToggleHopBtn.Text = "Auto Hop: ON"
		ToggleHopBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		startFruitSearch()
	else
		ToggleHopBtn.Text = "Auto Hop: OFF"
		ToggleHopBtn.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
	end
end)

-- Eksekusi awal saat script dijalankan
if config.autoHopActive then
	task.spawn(function() startFruitSearch() end)
else
	task.spawn(function()
		task.wait(1.5)
		autoSelectTeam()
	end)
end
