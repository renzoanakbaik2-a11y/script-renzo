local espBeam = Drawing.new("Line")
espBeam.Visible = false
espBeam.Color = Color3.fromRGB(0, 255, 128)
espBeam.Thickness = 2
espBeam.Transparency = 1

-- Fungsi pencarian target musuh yang lebih akurat mencakup folder game
local function findBestTarget(character, humanoidRootPart)
    local bestTarget = nil
    local shortestDist = math.huge

    -- Fungsi bantu cek objek/model musuh
    local function evaluate(obj)
        if obj:IsA("Model") and obj ~= character then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj.PrimaryPart
            if hum and hum.Health > 0 and root then
                local dist = (humanoidRootPart.Position - root.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    bestTarget = root
                end
            end
        end
    end

    -- Cek folder musuh khusus jika ada di Workspace (misal folder Enemies / Monsters / EnemiesFolder)
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            local name = child.Name:lower()
            if name:find("enemy") or name:find("monster") or name:find("mob") or name:find("boss") or name:find("character") then
                for _, obj in ipairs(child:GetDescendants()) do
                    evaluate(obj)
                end
            end
        end
    end

    -- Jika tidak ketemu di folder spesifik, scan seluruh Workspace
    if not bestTarget then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            evaluate(obj)
        end
    end

    return bestTarget
end

RunService.RenderStepped:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        espBeam.Visible = false
        return
    end

    local humanoidRootPart = character.HumanoidRootPart
    local targetPart = findBestTarget(character, humanoidRootPart)

    -- Update Garis ESP ke Target Killer
    if CONFIG.ESPLine and targetPart then
        local vector, onScreen = Workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            espBeam.From = Vector2.new(Workspace.CurrentCamera.ViewportSize.X / 2, Workspace.CurrentCamera.ViewportSize.Y)
            espBeam.To = Vector2.new(vector.X, vector.Y)
            espBeam.Visible = true
        else
            espBeam.Visible = false
        end
    else
        espBeam.Visible = false
    end

    -- Eksekusi Auto Farm, Teleport, & Damage 999999
    if CONFIG.AutoFarm and targetPart then
        -- Teleport mendekati musuh agar masuk area killer
        if (humanoidRootPart.Position - targetPart.Position).Magnitude > 10 then
            humanoidRootPart.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 3, 0))
        end

        -- Eksekusi Serangan / Damage 999999 ke semua RemoteEvent yang berhubungan dengan Combat/Damage
        pcall(function()
            for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                if remote:IsA("RemoteEvent") then
                    local rName = remote.Name:lower()
                    if rName:find("damage") or rName:find("hit") or rName:find("attack") or rName:find("combat") or rName:find("weapon") or rName:find("kill") then
                        remote:FireServer(999999, targetPart)
                        remote:FireServer(999999)
                    end
                end
            end
        end)
    end
end)

