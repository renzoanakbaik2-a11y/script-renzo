local CONFIG = {
    ScanRadius = 25,          -- Radius maksimal pencarian item dalam studs
    ScanInterval = 0.5,       -- Jeda waktu antar pemindaian (detik)
    AutoCollectActive = false,
    MagnetActive = false,
    CollectedCount = 0,
    DetectedCount = 0
}

local function addLog(text)
    pcall(function()
        local itemText = Instance.new("TextLabel", LogScroll)
        itemText.Size = UDim2.new(1, -6, 0, 20)
        itemText.BackgroundTransparency = 1
        itemText.TextColor3 = Color3.fromRGB(0, 255, 200)
        itemText.Font = Enum.Font.Code
        itemText.TextSize = 9
        itemText.TextXAlignment = Enum.TextXAlignment.Left
        itemText.Text = "• " .. text
        
        -- Batasi jumlah log agar tidak membebani memori memori HP
        local children = LogScroll:GetChildren()
        if #children > 30 then
            children[2]:Destroy()
        end
        LogScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
    end)
end

