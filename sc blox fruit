local function refreshPlayerList()
    for _, child in ipairs(PlayerListScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pLevel = "?"
            local pFruit = "Tidak Ada Buah"
            
            pcall(function()
                if p:FindFirstChild("Data") and p.Data:FindFirstChild("Level") then
                    pLevel = tostring(p.Data.Level.Value)
                elseif p:FindFirstChild("leaderstats") and p.leaderstats:FindFirstChild("Level") then
                    pLevel = tostring(p.leaderstats.Level.Value)
                end

                if p:FindFirstChild("Data") and p.Data:FindFirstChild("DevilFruit") then
                    local dfValue = tostring(p.Data.DevilFruit.Value)
                    if dfValue ~= "" and dfValue ~= "None" and dfValue ~= "nil" and dfValue ~= "Combat" then
                        pFruit = dfValue
                    end
                end
            end)

            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -6, 0, 35)
            pBtn.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.Text = " Lv." .. pLevel .. " | " .. p.Name .. " | Buah: " .. pFruit
            pBtn.TextSize, pBtn.Font = 9, Enum.Font.Gotham
            pBtn.TextXAlignment = Enum.TextXAlignment.Left
            pBtn.Parent = PlayerListScroll

            local pBtnCorner = Instance.new("UICorner")
            pBtnCorner.CornerRadius = UDim.new(0, 4)
            pBtnCorner.Parent = pBtn

            pBtn.MouseButton1Click:Connect(function()
                Settings.TargetPlayerName = p.Name
                TargetStatusLabel.Text = "Target Aktif: " .. p.Name
                saveSettings()
            end)
        end
    end
end

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)
task.spawn(refreshPlayerList)

