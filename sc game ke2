local function getCubeRarity(name)
    local num = name:match("cube_(%d+)")
    if num then return tonumber(num) end
    local altNum = name:match("(%d+)")
    if altNum then return tonumber(altNum) end
    return 1
end

-- 1. Auto Run Extraction
task.spawn(function()
    while true do
        task.wait(0.2)
        if Settings.AutoExtractRun then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local targetPart = nil
                    local worldFolder = Workspace:FindFirstChild("World")
                    if worldFolder then
                        local arenaFolder = worldFolder:FindFirstChild("Arena")
                        if arenaFolder then
                            local extractZone = arenaFolder:FindFirstChild("ExtractionZone")
                            if extractZone then
                                for _, part in pairs(extractZone:GetDescendants()) do
                                    if part:IsA("BasePart") and part.Transparency < 0.8 then
                                        targetPart = part
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetPart then
                        char.Humanoid.WalkSpeed = 160
                        char.Humanoid:MoveTo(targetPart.Position)
                    else
                        char.Humanoid.WalkSpeed = 16
                    end
                end
            end)
        end
    end
end)

-- 2. Anti Player (High Fly)
task.spawn(function()
    while true do
        task.wait(0.1)
        if Settings.AntiPlayerHighFly then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local playerNearby = false
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if distance < 25 then
                                playerNearby = true
                                break
                            end
                        end
                    end
                    
                    if playerNearby then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 180, hrp.Velocity.Z)
                    end
                end
            end)
        end
    end
end)

-- 3. Auto Collect Best Cube (Dengan Batasan Jarak / Radius Agar Tidak Nyasar ke Base Jauh)
task.spawn(function()
    while true do
        task.wait(0.2)
        if Settings.AutoCollectRareCube then
            pcall(function()
                local char = LocalPlayer.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local hrp = char.HumanoidRootPart
                
                local bestCubePart = nil
                local highestRarity = -1
                local maxRadius = 150 -- Batas jarak maksimal pencarian (meter) dari posisi kamu
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") or obj:IsA("Model") then
                        local partToCheck = obj:IsA("BasePart") and obj or (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true))
                        
                        if partToCheck then
                            -- Hitung jarak dari player ke objek
                            local distance = (hrp.Position - partToCheck.Position).Magnitude
                            
                            -- Hanya ambil jika jaraknya di dalam batas radius (supaya tidak tembus ke base orang lain yang jauh)
                            if distance <= maxRadius then
                                local nameLower = obj.Name:lower()
                                if nameLower:find("cube") or nameLower:find("brainrot") or nameLower:find("tile") then
                                    local rarity = getCubeRarity(obj.Name)
                                    if rarity >= highestRarity then
                                        highestRarity = rarity
                                        bestCubePart = partToCheck
                                    end
                                end
                            end
                        end
                    end
                end
                
                -- Teleport ke cube terdekat di sekitar arena/karakter
                if bestCubePart then
                    hrp.CFrame = bestCubePart.CFrame + Vector3.new(0, 3, 0)
                    
                    local touchInterest = bestCubePart:FindFirstChild("TouchInterest", true)
                    if touchInterest and firetouchinterest then
                        firetouchinterest(hrp, bestCubePart, 0)
                        task.wait(0.05)
                        firetouchinterest(hrp, bestCubePart, 1)
                    end
                end
            end)
        end
    end
end)

