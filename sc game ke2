local function getCubeRarity(name)
    local num = name:match("cube_(%d+)")
    if num then return tonumber(num) end
    local altNum = name:match("(%d+)")
    if altNum then return tonumber(altNum) end
    return 0
end

-- 1. Auto Run Extraction
task.spawn(function()
    while true do
        task.wait(0.2)
        if Settings.AutoExtractRun then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local targetPart = nil
                    local worldFolder = Workspace:FindFirstChild("World")
                    if worldFolder then
                        local arenaFolder = worldFolder:FindFirstChild("Arena")
                        if arenaFolder then
                            local extractZone = arenaFolder:FindFirstChild("ExtractionZone")
                            if extractZone then
                                for _, part in pairs(extractZone:GetDescendants()) do
                                    if part:IsA("BasePart") and part.Transparency < 0.8 then
                                        targetPart = part
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetPart then
                        char.Humanoid.WalkSpeed = 160
                        char.Humanoid:MoveTo(targetPart.Position)
                    else
                        char.Humanoid.WalkSpeed = 16
                    end
                end
            end)
        end
    end
end)

-- 2. Anti Player (High Fly)
task.spawn(function()
    while true do
        task.wait(0.1)
        if Settings.AntiPlayerHighFly then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local playerNearby = false
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if distance < 25 then
                                playerNearby = true
                                break
                            end
                        end
                    end
                    
                    if playerNearby then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 180, hrp.Velocity.Z)
                    end
                end
            end)
        end
    end
end)

-- 3. Auto Collect Best Cube (HANYA AMBIL DI DALAM FOLDER ARENA / DROP MAP)
task.spawn(function()
    while true do
        task.wait(0.2)
        if Settings.AutoCollectRareCube then
            pcall(function()
                local bestCubePart = nil
                local highestRarity = -1
                
                -- Fungsi untuk memastikan objek benar-benar berada di dalam zona Arena / Map Drop, bukan di base/plot player
                local function isValidArenaObject(obj)
                    local current = obj.Parent
                    local isInArena = false
                    
                    while current and current ~= Workspace do
                        local nameLower = current.Name:lower()
                        -- Jika masuk ke dalam folder player/base/plots, langsung tolak
                        if nameLower:find("player") or nameLower:find("base") or nameLower:find("plot") or nameLower:find("backpack") then
                            return false
                        end
                        -- Cek apakah berada di dalam folder yang mengarah ke Arena/Map/Spawns umum
                        if nameLower:find("arena") or nameLower:find("map") or nameLower:find("spawns") or nameLower:find("drops") or nameLower:find("world") then
                            isInArena = true
                        end
                        current = current.Parent
                    end
                    
                    return isInArena
                end
                
                -- Cari cube terbaik HANYA di dalam area valid map
                for _, obj in pairs(Workspace:GetDescendants()) do
                    local nameLower = obj.Name:lower()
                    if (nameLower:find("cube") or nameLower:find("brainrot")) and isValidArenaObject(obj) then
                        local rarity = getCubeRarity(obj.Name)
                        if rarity >= highestRarity then
                            highestRarity = rarity
                            if obj:IsA("BasePart") then
                                bestCubePart = obj
                            elseif obj:IsA("Model") then
                                bestCubePart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                            end
                        end
                    end
                end
                
                -- Teleport ke cube terbaik yang ada di arena
                if bestCubePart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    hrp.CFrame = bestCubePart.CFrame + Vector3.new(0, 2, 0)
                    
                    local touchInterest = bestCubePart:FindFirstChild("TouchInterest", true)
                    if touchInterest and firetouchinterest then
                        firetouchinterest(hrp, bestCubePart, 0)
                        task.wait(0.05)
                        firetouchinterest(hrp, bestCubePart, 1)
                    end
                end
            end)
        end
    end
end)

