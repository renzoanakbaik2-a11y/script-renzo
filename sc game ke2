local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local vim = game:GetService("VirtualInputManager") -- Layanan untuk simulasi klik/tap layar

-- 1-4. (Kode GUI / Menu tetap sama seperti sebelumnya, lewati sampai ke bagian tombol)

local autoPlayBtn = Instance.new("TextButton")
autoPlayBtn.Name = "AutoPlayButton"
autoPlayBtn.Size = UDim2.new(0, 220, 0, 45)
autoPlayBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoPlayBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoPlayBtn.Text = "Zona TP + Auto Hit: OFF"
autoPlayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoPlayBtn.TextSize = 14
autoPlayBtn.Font = Enum.Font.SourceSansBold
autoPlayBtn.Parent = mainFrame

local autoPlayAktif = false

-- FUNGSI BARU: Simulasi Tap Layar / Klik Kiri (Universal untuk semua game)
local function pukulBolaOtomatis()
    -- Mengirimkan sinyal klik/tap tepat di tengah layar ke server game
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 1) -- Tap/Klik Ditahan
    task.wait(0.05)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 1) -- Tap/Klik Dilepas
end

autoPlayBtn.MouseButton1Click:Connect(function()
    autoPlayAktif = not autoPlayAktif
    
    if autoPlayAktif then
        autoPlayBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoPlayBtn.Text = "Zona TP + Auto Hit: ON"
        
        task.spawn(function()
            local sudahPukul = false
            
            while autoPlayAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local targetBola = nil
                    
                    -- 1. Cari bola
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        local namaObj = obj.Name:lower()
                        if obj:IsA("BasePart") and (namaObj:find("ball") or namaObj:find("shuttle") or namaObj:find("birdie")) then
                            targetBola = obj
                            break
                        end
                    end
                    
                    -- 2. Logika Zona dan Pukul
                    if targetBola then
                        local jarakKeBola = (rootPart.Position - targetBola.Position).Magnitude
                        
                        -- LOGIKA ZONA: Teleport HANYA jika bola sudah agak dekat (masuk area kita, misal jarak di bawah 35 meter)
                        if jarakKeBola < 35 then
                            
                            -- JANGKAUAN PUKULAN (Radius 7 meter)
                            if jarakKeBola <= 7 then
                                -- Nempel presisi ke bola
                                rootPart.CFrame = targetBola.CFrame + Vector3.new(0, 0, 0)
                                
                                -- Auto Pukul / Klik Layar
                                if not sudahPukul then
                                    pukulBolaOtomatis()
                                    sudahPukul = true
                                    task.wait(0.3) -- Jeda biar raket mengayun sempurna
                                end
                            else
                                -- Kalau bola masih jauh (tapi udah di zona kita), kejar bolanya
                                rootPart.CFrame = targetBola.CFrame + Vector3.new(0, 0, 0)
                                sudahPukul = false
                            end
                            
                        else
                            -- Kalau bola jauh di lapangan lawan (jarak > 35), DIAM.
                            sudahPukul = false
                        end
                    end
                end
                task.wait(0.05) -- Pengecekan sangat cepat agar tidak meleset
            end
        end)
    else
        autoPlayBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoPlayBtn.Text = "Zona TP + Auto Hit: OFF"
    end
end)
