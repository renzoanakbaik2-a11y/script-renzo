-- Fitur 1: Auto Teleport ke Zona Extraction (Zona Hijau)
CreateToggleButton("Auto Teleport Extraction", "AutoExtract", function(state)
    task.spawn(function()
        while Config.AutoExtract do
            task.wait(0.5)
            pcall(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj.Name:lower():find("extraction") or obj.Name:lower():find("extract") then
                        if obj:IsA("BasePart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
                        end
                    end
                end
            end)
        end
    end)
end)

-- Fitur 2: Anti Player (Terbang Tinggi Otomatis Saat Player Mendekat)
CreateToggleButton("Anti Player (Fly Evasion)", "AntiPlayerFly", function(state)
    task.spawn(function()
        while Config.AntiPlayerFly do
            task.wait(0.1)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local playerNearby = false
                    
                    -- Cek jarak dengan pemain lain di sekitar arena
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if distance < 18 then -- Radius 18 stud (jika player terlalu dekat)
                                playerNearby = true
                                break
                            end
                        end
                    end
                    
                    if playerNearby then
                        -- Langsung melayang terbang ke atas untuk menghindari player
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 60, hrp.Velocity.Z)
                    end
                end
            end)
        end
    end)
end)

-- Fitur 3: Auto Collect Brainrot Paling Mahal / Rarity Tinggi di Arena
CreateToggleButton("Auto Collect Best Brainrot", "AutoCollectBest", function(state)
    task.spawn(function()
        while Config.AutoCollectBest do
            task.wait(1)
            pcall(function()
                local bestTarget = nil
                local maxScore = 0
                
                for _, item in pairs(Workspace:GetChildren()) do
                    if item:IsA("Model") or item:IsA("BasePart") then
                        local nameLower = item.Name:lower()
                        if nameLower:find("brainrot") or nameLower:find("item") or nameLower:find("gold") or item:FindFirstChild("Price") or item:FindFirstChild("Value") then
                            local score = item:GetAttribute("Value") or item:GetAttribute("Rarity") or 100
                            if score > maxScore then
                                maxScore = score
                                bestTarget = item
                            end
                        end
                    end
                end
                
                if bestTarget and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local targetPart = bestTarget:IsA("Model") and bestTarget.PrimaryPart or bestTarget:FindFirstChildWhichIsA("BasePart")
                    if targetPart then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end)
        end
    end)
end)

