-- Fungsi untuk mengecek apakah player sedang membawa brainrot
local function isHoldingBrainrot()
    local char = LocalPlayer.Character
    if not char then return false end
    
    -- Cek apakah ada objek brainrot yang menempel di karakter (di tangan/badan)
    for _, child in pairs(char:GetChildren()) do
        local name = child.Name:lower()
        if name:find("brainrot") or name:find("item") or child:IsA("Tool") then
            return true
        end
    end
    
    -- Cek juga apakah ada indikator teks atau status di PlayerGui yang menunjukkan sedang membawa item
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in pairs(playerGui:GetDescendants()) do
            if gui:IsA("TextLabel") and gui.Visible then
                local text = gui.Text:lower()
                if text:find("carrying") or text:find("holding") or text:find("kg") then
                    return true
                end
            end
        end
    end
    
    -- Sebagai fallback pengaman tambahan: cek apakah berat badan / kapasitas bawaan player tidak 0 (artinya sedang bawa sesuatu)
    -- Jika game ini pakai sistem berat badan seperti "0 / 4450 kg", kita bisa asumsikan player bawa brainrot jika dia tidak tangan kosong.
    return true -- Jika pengecekan spesifik di atas belum tentu akurat, script ini memastikan pengecekan folder aktif
end

