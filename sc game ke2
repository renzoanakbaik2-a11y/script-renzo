-- Fitur 1: Auto Run Kilat ke Extraction (Hanya jalan saat zona hijau benar-benar terbuka)
CreateToggleButton("Auto Run Extraction", "AutoExtractRun", function(state)
    task.spawn(function()
        while Config.AutoExtractRun do
            task.wait(0.2)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local extractionPart = nil
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj.Name:lower():find("extraction") or obj.Name:lower():find("extract") then
                            if obj:IsA("BasePart") and obj.Transparency < 0.8 then
                                extractionPart = obj
                                break
                            end
                        end
                    end
                    
                    if extractionPart then
                        char.Humanoid.WalkSpeed = 160
                        char.Humanoid:MoveTo(extractionPart.Position)
                    else
                        char.Humanoid.WalkSpeed = 16
                    end
                end
            end)
        end
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
            end
        end)
    end)
end)

-- Fitur 2: Anti Player (Terbang Jauh Tinggi ke Atas Supaya Aman)
CreateToggleButton("Anti Player (High Fly)", "AntiPlayerHighFly", function(state)
    task.spawn(function()
        while Config.AntiPlayerHighFly do
            task.wait(0.1)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local playerNearby = false
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if distance < 25 then
                                playerNearby = true
                                break
                            end
                        end
                    end
                    
                    if playerNearby then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 180, hrp.Velocity.Z)
                    end
                end
            end)
        end
    end)
end)

-- Fitur 3: Auto Steal & Attack Target (Otomatis kejar player yang bawa brainrot, pukul instan, dan rebut)
CreateToggleButton("Auto Steal & Attack", "AutoStealAndAttack", function(state)
    task.spawn(function()
        while Config.AutoStealAndAttack do
            task.wait(0.3)
            pcall(function()
                local targetPlayer = nil
                
                -- Cari player lain yang memiliki folder/item brainrot (seperti ArenaHeadBrainrot_1) di badannya
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        for _, child in pairs(p.Character:GetChildren()) do
                            if child.Name:lower():find("brainrot") or child.Name:lower():find("headbrainrot") then
                                targetPlayer = p
                                break
                            end
                        end
                    end
                    if targetPlayer then break end
                end
                
                -- Jika ada player yang bawa brainrot, langsung teleport ke depannya, pukul, dan ambil
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local localChar = LocalPlayer.Character
                    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                        -- Teleport instan tepat di sebelah player target
                        localChar.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        
                        -- Simulasi klik / pukul secara instan untuk merebut brainrot
                        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        task.wait(0.05)
                        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                    end
                end
            end)
        end
    end)
end)

