opBtn.Font = Enum.Font.SourceSansBold
opBtn.Parent = mainFrame


-- ==========================================
-- 5. LOGIKA UTAMA (TP + SPAM PUKUL + ZONA AMAN)
-- ==========================================

local autoAktif = false

opBtn.MouseButton1Click:Connect(function()
    autoAktif = not autoAktif
    
    if autoAktif then
        opBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        opBtn.Text = "Mobile Auto Play: ON"
        
        task.spawn(function()
            while autoAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local targetBola = nil
                    
                    -- Cari bola di Workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local n = obj.Name:lower()
                            if n:find("ball") or n:find("shuttle") or n:find("birdie") or n:find("tennis") then
                                targetBola = obj
                                break
                            end
                        end
                    end
                    
                    if targetBola then
                        local bolaZ = targetBola.Position.Z
                        local playerZ = rootPart.Position.Z
                        
                        -- Logika Zona: Jika bola terlalu jauh ke depan (wilayah musuh), karakter diam
                        local diZonaKita = true
                        if math.abs(bolaZ - playerZ) > 55 then
                            diZonaKita = false
                        end
                        
                        if diZonaKita then
                            -- Teleport ke bola
                            rootPart.CFrame = targetBola.CFrame
                            
                            -- Spam tombol pukul / aksi di HP secara virtual
                            local vim = game:GetService("VirtualInputManager")
                            pcall(function()
                                vim:SendMouseButtonEvent(480, 550, 0, true, game, 1)
                                task.wait(0.01)
                                vim:SendMouseButtonEvent(480, 550, 0, false, game, 1)
                            end)
                        else
                            -- Di zona musuh: Karakter diam tenang
                        end
                    end
                end
                task.wait(0.03)
            end
        end)
    else
        opBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        opBtn.Text = "Mobile Auto Play: OFF"
    end
end)
