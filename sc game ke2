-- 4. LOGIKA HOOK & PEMERIKSA ISI
local function FormatArgs(args)
    local str = "{"
    for i, v in ipairs(args) do
        str = str .. tostring(v) .. (i < #args and ", " or "")
    end
    return str .. "}"
end

local function AddLogEntry(remoteName, argsTable)
    local LogCard = Instance.new("Frame")
    LogCard.Size = UDim2.new(1, -8, 0, 42)
    LogCard.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
    LogCard.Parent = LogScroll

    local CardCorner = Instance.new("UICorner")
    CardCorner.CornerRadius = UDim.new(0, 4)
    CardCorner.Parent = LogCard

    local RemoteLabel = Instance.new("TextLabel")
    RemoteLabel.Size = UDim2.new(1, -10, 0, 18)
    RemoteLabel.Position = UDim2.new(0, 6, 0, 2)
    RemoteLabel.BackgroundTransparency = 1
    RemoteLabel.Text = "Event: " .. remoteName
    RemoteLabel.TextColor3 = Color3.fromRGB(255, 80, 100)
    RemoteLabel.Font = Enum.Font.SourceSansBold
    RemoteLabel.TextSize = 10
    RemoteLabel.TextXAlignment = Enum.TextXAlignment.Left
    RemoteLabel.Parent = LogCard

    local ArgText = FormatArgs(argsTable)
    local ArgLabel = Instance.new("TextLabel")
    ArgLabel.Size = UDim2.new(1, -10, 0, 18)
    ArgLabel.Position = UDim2.new(0, 6, 0, 20)
    ArgLabel.BackgroundTransparency = 1
    ArgLabel.Text = "Argumen: " .. ArgText
    ArgLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
    ArgLabel.Font = Enum.Font.SourceSansSemibold
    ArgLabel.TextSize = 10
    ArgLabel.TextXAlignment = Enum.TextXAlignment.Left
    ArgLabel.Parent = LogCard

    LogScroll.CanvasSize = UDim2.new(0, 0, 0, LogList.AbsoluteContentSize.Y + 10)
    ShowNotification("Remote Terdeteksi!", remoteName .. "\n" .. ArgText)
end

-- HOOK REMOTEEVENT DARI NET FOLDER
local NetFolder = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Util"):WaitForChild("Net")

for _, obj in ipairs(NetFolder:GetChildren()) do
    if obj:IsA("RemoteEvent") then
        obj.OnClientEvent:Connect(function(...)
            AddLogEntry(obj.Name, {...})
        end)
    end
end

