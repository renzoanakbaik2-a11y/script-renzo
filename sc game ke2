local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local VirtualUser = game:GetService("VirtualUser")

-- Konfigurasi
local player = Players.LocalPlayer
local runService = game:GetService("RunService")
local autoWalkEnabled = false

-- Membuat GUI
local ScreenGui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 200, 0, 250)
MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
MainFrame.Visible = false -- Default tertutup

-- Header & Versi
local Title = Instance.new("TextLabel", MainFrame)
Title.Text = "Brainrot Farmer - v1"
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
Title.TextColor3 = Color3.new(1, 1, 1)

-- Tombol Buka/Tutup (di luar menu)
local ToggleButton = Instance.new("TextButton", ScreenGui)
ToggleButton.Size = UDim2.new(0, 100, 0, 40)
ToggleButton.Position = UDim2.new(0.1, 0, 0.05, 0)
ToggleButton.Text = "Buka Menu"
ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- Tombol On/Off Auto-Walk
local WalkButton = Instance.new("TextButton", MainFrame)
WalkButton.Size = UDim2.new(0.8, 0, 0, 40)
WalkButton.Position = UDim2.new(0.1, 0, 0.2, 0)
WalkButton.Text = "Auto-Walk: OFF"
WalkButton.MouseButton1Click:Connect(function()
    autoWalkEnabled = not autoWalkEnabled
    WalkButton.Text = autoWalkEnabled and "Auto-Walk: ON" or "Auto-Walk: OFF"
end)

-- Tombol Auto-Hop Server
local HopButton = Instance.new("TextButton", MainFrame)
HopButton.Size = UDim2.new(0.8, 0, 0, 40)
HopButton.Position = UDim2.new(0.1, 0, 0.5, 0)
HopButton.Text = "Hop Server"
HopButton.MouseButton1Click:Connect(function()
    local servers = game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?limit=100"))
    local server = servers.data[math.random(1, #servers.data)]
    TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, player)
end)

-- Loop Auto-Walk
runService.RenderStepped:Connect(function()
    if autoWalkEnabled then
        local flashExtractFolder = workspace:FindFirstChild("World")
            and workspace.World:FindFirstChild("Arena")
            and workspace.World.Arena:FindFirstChild("ExtractionZone")
            and workspace.World.Arena.ExtractionZone:FindFirstChild("North")
            and workspace.World.Arena.ExtractionZone.North:FindFirstChild("FlashExtract")
        
        if flashExtractFolder then
            local target = flashExtractFolder:FindFirstChildWhichIsA("BasePart")
            if target and player.Character and player.Character:FindFirstChild("Humanoid") then
                player.Character.Humanoid:MoveTo(target.Position)
            end
        end
    end
end)
