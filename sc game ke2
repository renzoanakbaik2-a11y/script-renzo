local function AddLogText(txt)
    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -8, 0, 18)
    Label.BackgroundTransparency = 1
    Label.Text = " " .. txt
    Label.TextColor3 = Color3.fromRGB(255, 100, 120)
    Label.Font = Enum.Font.SourceSansSemibold
    Label.TextSize = 10
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Scroll
end

-- CARI REMOTE EVENT
local foundCount = 0

local function ScanFolder(parent)
    for _, child in ipairs(parent:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            foundCount = foundCount + 1
            AddLogText("[" .. foundCount .. "] " .. child:GetFullName())
        end
    end
end

ScanFolder(ReplicatedStorage)

if foundCount == 0 then
    ScanFolder(Workspace)
end

if foundCount == 0 then
    AddLogText("Tidak ditemukan RemoteEvent.")
end

Scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)-- ==========================================================
-- SPEED HUB X - AUTOMATIC REMOTE SCANNER FOR ROLL A FISHERMAN
-- ==========================================================

print("=== STARTING SCANNER ===")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local foundRemotes = {}

local function ScanObject(parent)
    for _, child in ipairs(parent:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            local name = string.lower(child.Name)
            if string.find(name, "roll") or string.find(name, "gacha") or string.find(name, "buy") or string.find(name, "spin") or string.find(name, "fisherman") then
                table.insert(foundRemotes, child:GetFullName())
            end
        end
    end
end

-- Scan ReplicatedStorage & Workspace
ScanObject(ReplicatedStorage)
ScanObject(Workspace)

print("=== HASIL PEMINDAIAN REMOTE ===")
if #foundRemotes > 0 then
    for i, path in ipairs(foundRemotes) do
        print("[" .. i .. "] " .. path)
    end
else
    print("Tidak ditemukan remote dengan kata kunci khusus. Menampilkan seluruh RemoteEvent di ReplicatedStorage:")
    for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            print("-> " .. child:GetFullName())
        end
    end
end
print("=== SCAN FINISHED ===")
