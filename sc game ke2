-- Script Tester ProximityPrompt
print("--- TESTER DIMULAI ---")
local count = 0
for _, v in pairs(game:GetService("Workspace"):GetDescendants()) do
    if v:IsA("ProximityPrompt") then
        count = count + 1
        print("Ketemu Prompt:", v.ActionText, "pada objek:", v.Parent.Name)
    end
end
print("Total ProximityPrompt yang terdeteksi di map:", count)
