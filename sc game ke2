-- 🛠️ FUNGSI AUTO-EQUIP PANCINGAN
local function equipRod()
	local char = LocalPlayer.Character
	if not char then return nil end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") and (item.Name:lower():find("rod") or item.Name:lower():find("pancing")) then
					char.Humanoid:EquipTool(item)
					task.wait(0.1)
					return item
				end
			end
		end
	end
	return tool
end

-- 🎣 FITUR 1: AUTO MANCING PLAYER (PERFECT CAST + INSTANT BUBBLE)
BtnPlayerFish.MouseButton1Click:Connect(function()
	autoPlayer = not autoPlayer
	BtnPlayerFish.Text = autoPlayer and "1. AUTO MANCING PLAYER: ON" or "1. AUTO MANCING PLAYER: OFF"
	BtnPlayerFish.BackgroundColor3 = autoPlayer and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(0, 120, 215)
	
	if autoPlayer then
		task.spawn(function()
			while autoPlayer do
				local rod = equipRod()
				local pGui = LocalPlayer.PlayerGui
				local bubbleFound = false
				
				-- A. Deteksi & Klik Gelembung Instan (Pop Bubbles)
				for _, v in ipairs(pGui:GetDescendants()) do
					if v:IsA("GuiObject") and v.Visible then
						local nameLower = v.Name:lower()
						if nameLower:find("bubble") or (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Parent and v.Parent.Name:lower():find("bubble") then
							bubbleFound = true
							if firesignal then
								firesignal(v.MouseButton1Click)
								firesignal(v.Activated)
							else
								local pos = v.AbsolutePosition + (v.AbsoluteSize / 2)
								VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + 36, 0, true, game, 1)
								VirtualInputManager:SendMouseButtonEvent(pos.X, pos.Y + 36, 0, false, game, 1)
							end
						end
					end
				end
				
				-- B. Jika Tidak Ada Gelembung = Lempar Kail Paling Jauh (Perfect Cast)
				if not bubbleFound then
					if rod then
						rod:Activate()
						
						-- Otomatis mencari meteran lemparan untuk diklik di zona Perfect / Max
						for _, v in ipairs(pGui:GetDescendants()) do
							if v:IsA("GuiObject") and v.Visible then
								local nameLower = v.Name:lower()
								if nameLower:find("cast") or nameLower:find("power") or nameLower:find("bar") then
									if firesignal and (v:IsA("TextButton") or v:IsA("ImageButton")) then
										firesignal(v.MouseButton1Click)
									end
								end
							end
						end
					end
					Status.Text = "Status: Lempar Kail (Perfect Cast)..."
					Status.TextColor3 = Color3.fromRGB(255, 200, 100)
				else
					Status.Text = "Status: Memecahkan Gelembung Instan!"
					Status.TextColor3 = Color3.fromRGB(100, 255, 150)
				end
				
				task.wait(0.02)
			end
		end)
	else
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)

