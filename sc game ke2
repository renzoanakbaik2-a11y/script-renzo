-- Fungsi untuk mengecek apakah gerbang/tembok sudah terbuka
-- (Memeriksa apakah part tembok sudah hilang, transparan, atau CanCollide-nya false)
local function isGateOpen()
    local extractionZone = workspace:FindFirstChild("World") 
        and workspace.World:FindFirstChild("Arena") 
        and workspace.World.Arena:FindFirstChild("ExtractionZone") 
    
    if extractionZone then
        -- Cek apakah ada objek tembok/pintu yang menghalangi
        -- Jika temboknya hilang atau tidak bisa ditabrak lagi (CanCollide == false), berarti terbuka
        local wall = extractionZone:FindFirstChild("Wall") -- Sesuaikan jika nama temboknya berbeda
        if wall and wall:IsA("BasePart") then
            if wall.CanCollide == false or wall.Transparency >= 0.9 then
                return true
            else
                return false
            end
        end
    end
    
    -- Jika script tidak menemukan tembok spesifik, kita anggap terbuka saat folder FlashExtract aktif/bisa diakses
    local flashFolder = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Arena")
        and workspace.World.Arena:FindFirstChild("ExtractionZone")
        and workspace.World.Arena.ExtractionZone:FindFirstChild("North")
        and workspace.World.Arena.ExtractionZone.North:FindFirstChild("FlashExtract")
        
    return flashFolder ~= nil
end

-- Fungsi mencari zona hijau sebelah kiri (FlashExtract)
local function getLeftGreenZone()
    local extractionFolder = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Arena")
        and workspace.World.Arena:FindFirstChild("ExtractionZone")
        and workspace.World.Arena.ExtractionZone:FindFirstChild("North")
        and workspace.World.Arena.ExtractionZone.North:FindFirstChild("FlashExtract")
    
    if not extractionFolder then return nil end
    
    -- Mengambil part pertama yang ada di dalam folder FlashExtract (zona hijau kiri pemain biasa)
    for _, part in ipairs(extractionFolder:GetChildren()) do
        if part:IsA("BasePart") then
            return part
        end
    end
    
    return nil
end

local hasTeleported = false

-- Loop Utama
RunService.RenderStepped:Connect(function()
    if autoWalkEnabled then
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            -- 1. Cek dulu apakah gerbang sudah terbuka
            if isGateOpen() then
                -- 2. Jika gerbang sudah terbuka dan belum sempat teleport, baru pindah ke zona hijau kiri
                if not hasTeleported then
                    local targetZone = getLeftGreenZone()
                    if targetZone then
                        hrp.CFrame = targetZone.CFrame + Vector3.new(0, 3, 0)
                        hasTeleported = true
                        print("Gerbang terbuka! Berhasil teleport ke zona hijau kiri.")
                    end
                end
            else
                -- Jika gerbang masih tertutup, reset status supaya nanti pas ronde baru buka, dia bisa teleport lagi
                hasTeleported = false
            end
        end
    end
end)
