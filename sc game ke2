-- ==========================================
-- FITUR: TERBANG MENUJU EGG DENGAN ANIMASI JALAN/MELAYANG
-- ==========================================

local flyEggBtn = Instance.new("TextButton")
flyEggBtn.Name = "FlyEggButton"
flyEggBtn.Size = UDim2.new(0, 220, 0, 45)
flyEggBtn.Position = UDim2.new(0.5, -110, 0, 60)
flyEggBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
flyEggBtn.Text = "Auto Fly Anim: OFF"
flyEggBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
flyEggBtn.TextSize = 14
flyEggBtn.Font = Enum.Font.SourceSansBold
flyEggBtn.Parent = mainFrame

local autoFlyAktif = false

flyEggBtn.MouseButton1Click:Connect(function()
    autoFlyAktif = not autoFlyAktif
    
    if autoFlyAktif then
        flyEggBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        flyEggBtn.Text = "Auto Fly Anim: ON"
        
        task.spawn(function()
            while autoFlyAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") and karakter:FindFirstChild("Humanoid") then
                    local rootPart = karakter.HumanoidRootPart
                    local humanoid = karakter.Humanoid
                    local targetTelur = nil
                    
                    -- Cari telur di workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("egg") or obj:FindFirstChild("TouchInterest")) then
                            if obj.Size.Magnitude < 10 and not obj.Name:lower():find("base") then
                                targetTelur = obj
                                break
                            end
                        end
                    end
                    
                    -- Kalau telur ketemu, terbang dengan animasi jalan ke arahnya
                    if targetTelur then
                        -- 1. Angkat sedikit posisi terbang ke udara biar kelihatan melayang
                        local titikTerbang = targetTelur.Position + Vector3.new(0, 5, 0)
                        
                        -- Nyalakan mode melayang biar gak jatuh ke tanah
                        local bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(1, 1, 1) * 30000
                        bv.Velocity = Vector3.new(0, 0, 0) -- Tahan posisi di udara
                        bv.Parent = rootPart
                        
                        -- 2. Gunakan MoveTo supaya animasi jalan/gerak karakter tetap terpancing ke arah telur
                        humanoid:MoveTo(titikTerbang)
                        
                        -- Biarkan karakternya "berjalan" di udara menuju titik telur
                        repeat
                            task.wait(0.1)
                            bv.Velocity = (titikTerbang - rootPart.Position).Unit * 16 -- Kecepatan jalan normal dengan animasi
                        until (rootPart.Position - titikTerbang).Magnitude < 3 or not autoFlyAktif
                        
                        -- Hapus penahan udara pas sudah sampai di atas telur
                        bv:Destroy()
                        task.wait(0.5)
                    end
                end
                task.wait(1.5)
            end
        end)
    else
        flyEggBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        flyEggBtn.Text = "Auto Fly Anim: OFF"
    end
end)
