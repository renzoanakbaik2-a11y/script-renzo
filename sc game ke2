-- [2. LOGIKA UTAMA: SCRIPT MESIN]
local function getNearestTarget()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    local closestPart = nil
    local shortestDist = 150 -- Batas radius maksimal pencarian

    -- Memindai Workspace secara global dengan aman & efisien
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("cube") or name:find("fruit") or name:find("brainrot") then
                
                -- Pengecekan parent ringan (tanpa GetFullName yang bikin berat)
                local p = obj.Parent
                if p and not (p.Name == "PlayerZones" or p.Name == "Plot" or p.Name == "Base") then
                    local dist = (obj.Position - myPos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestPart = obj
                    end
                end
            end
        end
    end
    return closestPart
end

