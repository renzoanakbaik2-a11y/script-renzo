local function GetPlayerMoney(plr)
    local money = 0
    local lstats = plr:FindFirstChild("leaderstats")
    if lstats then
        for _, child in ipairs(lstats:GetChildren()) do
            if child:IsA("ValueBase") then
                local n = string.lower(child.Name)
                if n == "cash" or n == "money" or n == "coins" or n == "$" or string.find(n, "cash") then
                    return tonumber(child.Value) or 0
                end
            end
        end
    end
    local dataFolder = plr:FindFirstChild("Data") or plr:FindFirstChild("stats")
    if dataFolder then
        for _, child in ipairs(dataFolder:GetChildren()) do
            if child:IsA("ValueBase") then
                local n = string.lower(child.Name)
                if n == "cash" or n == "money" or n == "coins" then
                    return tonumber(child.Value) or 0
                end
            end
        end
    end
    return money
end

