local function CreateToggleButton(name, configKey, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 290, 0, 38)
    btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(50, 180, 90) or Color3.fromRGB(40, 40, 50)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.Text = name .. ": " .. (Config[configKey] and "ON" or "OFF")
    btn.Parent = MainFrame

    createStroke(btn, 1, Color3.fromRGB(100, 255, 100))
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    task.spawn(function()
        if Config[configKey] then
            callback(true)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        Config[configKey] = not Config[configKey]
        if Config[configKey] then
            btn.BackgroundColor3 = Color3.fromRGB(50, 180, 90)
            btn.Text = name .. ": ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            btn.Text = name .. ": OFF"
        end
        SaveSettings()
        callback(Config[configKey])
    end)
end

-- =====================================================================
-- FUNGSI FINDER / PEMBACA RARITY CUBE YANG AKURAT
-- =====================================================================
local function getCubeRarity(name)
    local num = name:match("cube_(%d+)")
    if num then
        return tonumber(num)
    end
    return 0
end

