-- Tombol Brutal Spam (Gabungan TP nempel + Spam Hit tanpa henti)
local brutalBtn = Instance.new("TextButton")
brutalBtn.Size = UDim2.new(0, 220, 0, 55)
brutalBtn.Position = UDim2.new(0.5, -110, 0, 70)
brutalBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
brutalBtn.Text = "Brutal Spam TP & Hit: OFF"
brutalBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
brutalBtn.TextSize = 13
brutalBtn.Font = Enum.Font.SourceSansBold
brutalBtn.Parent = mainFrame

local brutalAktif = false
brutalBtn.MouseButton1Click:Connect(function()
    brutalAktif = not brutalAktif
    brutalBtn.BackgroundColor3 = brutalAktif and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    brutalBtn.Text = brutalAktif and "Brutal Spam TP & Hit: ON" or "Brutal Spam TP & Hit: OFF"
    
    if brutalAktif then
        task.spawn(function()
            while brutalAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local targetBola = nil
                    
                    -- Cari bola di Workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local n = obj.Name:lower()
                            if n:find("ball") or n:find("shuttle") or n:find("birdie") or n:find("tennis") then
                                targetBola = obj
                                break
                            end
                        end
                    end
                    
                    if targetBola then
                        local bolaZ = targetBola.Position.Z
                        local playerZ = rootPart.Position.Z
                        
                        -- Logika Zona: Cek apakah bola di area kita
                        if math.abs(bolaZ - playerZ) <= 50 then
                            -- TELEPORT MENEMPEL PAS DI BADAN BOLA (Supaya raket otomatis kena sentuh)
                            rootPart.CFrame = targetBola.CFrame
                            
                            -- SPAM HIT BRUTAL: Aktifkan Tool + Tembak SEMUA RemoteEvent yang ada di game secara bersamaan
                            local tool = karakter:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
                            if tool then 
                                pcall(function() tool:Activate() end) 
                            end
                            
                            for _, v in ipairs(workspace:GetDescendants()) do
                                if v:IsA("RemoteEvent") then
                                    pcall(function()
                                        v:FireServer()
                                        v:FireServer(targetBola) -- Memaksa kirim data bola ke server game
                                    end)
                                end
                            end
                        end
                    end
                end
                task.wait(0.02) -- Kecepatan super ngebut tanpa jeda
            end
        end)
    end
end)
