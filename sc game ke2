local playerGui = player:WaitForChild("PlayerGui")
local guiService = game:GetService("GuiService")
local vim = game:GetService("VirtualInputManager")

-- 1. Bersihkan menu lama
if playerGui:FindFirstChild("RacketRivalsMenu") then
    playerGui.RacketRivalsMenu:Destroy()
end

-- 2. Wadah Utama Layar (ScreenGui)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RacketRivalsMenu"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

-- 3. Tombol Menu (Bisa Digeser)
local openButton = Instance.new("TextButton")
openButton.Name = "OpenButton"
openButton.Size = UDim2.new(0, 110, 0, 40)
openButton.Position = UDim2.new(0, 20, 0.4, 0)
openButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
openButton.Text = "MENU"
openButton.TextColor3 = Color3.fromRGB(255, 255, 255)
openButton.Font = Enum.Font.SourceSansBold
openButton.Parent = screenGui

-- Logika Drag (Geser Tombol)
local dragging, dragInput, dragStart, startPos
openButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = openButton.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        openButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

