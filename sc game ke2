-- 🛠️ FUNGSI KLIK APLIKASI UNTUK SEMUA EXECUTOR
local function clickGui(guiObj)
	if not guiObj then return end
	pcall(function()
		if firesignal then
			firesignal(guiObj.MouseButton1Click)
			firesignal(guiObj.Activated)
		elseif getconnections then
			for _, conn in ipairs(getconnections(guiObj.MouseButton1Click)) do
				conn:Fire()
			end
			for _, conn in ipairs(getconnections(guiObj.Activated)) do
				conn:Fire()
			end
		end
	end)
end

-- 🛠️ AUTO EQUIP PANCINGAN
local function equipRod()
	local char = LocalPlayer.Character
	if not char then return nil end
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then
		local backpack = LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			for _, item in ipairs(backpack:GetChildren()) do
				if item:IsA("Tool") and (item.Name:lower():find("rod") or item.Name:lower():find("pancing") or item.Name:lower():find("fish")) then
					local hum = char:FindFirstChildOfClass("Humanoid")
					if hum then hum:EquipTool(item) end
					task.wait(0.1)
					return item
				end
			end
		end
	end
	return tool
end

-- 🎣 FITUR 1: AUTO MANCING PLAYER (PERFECT CAST + POP BUBBLES INSTAN)
BtnPlayerFish.MouseButton1Click:Connect(function()
	autoPlayer = not autoPlayer
	BtnPlayerFish.Text = autoPlayer and "1. AUTO MANCING PLAYER: ON" or "1. AUTO MANCING PLAYER: OFF"
	BtnPlayerFish.BackgroundColor3 = autoPlayer and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(0, 120, 215)
	
	if autoPlayer then
		task.spawn(function()
			while autoPlayer do
				pcall(function()
					local rod = equipRod()
					local pGui = LocalPlayer:FindFirstChild("PlayerGui")
					local bubbleFound = false
					
					if pGui then
						-- Cari & Pop Gelembung Secara Instan
						for _, v in ipairs(pGui:GetDescendants()) do
							if v:IsA("GuiObject") and v.Visible then
								local nameLower = v.Name:lower()
								if nameLower:find("bubble") or (v.Parent and v.Parent.Name:lower():find("bubble")) then
									bubbleFound = true
									clickGui(v)
								end
							end
						end
						
						-- Jika Gelembung Belum Ada = Lempar Kail (Perfect Cast)
						if not bubbleFound then
							if rod then
								rod:Activate()
								for _, v in ipairs(pGui:GetDescendants()) do
									if v:IsA("GuiObject") and v.Visible then
										local nameLower = v.Name:lower()
										if nameLower:find("cast") or nameLower:find("power") or nameLower:find("bar") then
											clickGui(v)
										end
									end
								end
							end
							Status.Text = "Status: Lempar Kail (Perfect Cast)..."
							Status.TextColor3 = Color3.fromRGB(255, 200, 100)
						else
							Status.Text = "Status: Pop Gelembung Instan!"
							Status.TextColor3 = Color3.fromRGB(100, 255, 150)
						end
					end
				end)
				task.wait(0.04)
			end
		end)
	else
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)

-- 🤖 FITUR 2: INSTANT REEL FISHERMAN (AUTO-WIN KHUSUS IKAN BAGUS FISHERMAN)
BtnFishermanReel.MouseButton1Click:Connect(function()
	autoFisherman = not autoFisherman
	BtnFishermanReel.Text = autoFisherman and "2. INSTANT REEL FISHERMAN: ON" or "2. INSTANT REEL FISHERMAN: OFF"
	BtnFishermanReel.BackgroundColor3 = autoFisherman and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(0, 120, 215)
	
	if autoFisherman then
		task.spawn(function()
			while autoFisherman do
				pcall(function()
					local pGui = LocalPlayer:FindFirstChild("PlayerGui")
					if pGui then
						local fishIcon, sliderBar, progressBar = nil, nil, nil
						
						-- Cari Elemen UI Minigame Reel
						for _, v in ipairs(pGui:GetDescendants()) do
							if v:IsA("GuiObject") and v.Visible then
								local nameLower = v.Name:lower()
								if nameLower:find("fish") or nameLower:find("ikan") then
									fishIcon = v
								elseif nameLower:find("slider") or nameLower:find("box") or (nameLower:find("bar") and not nameLower:find("progress")) then
									sliderBar = v
								elseif nameLower:find("progress") or nameLower:find("fill") then
									progressBar = v
								end
							end
						end
						
						-- Eksekusi Instan Begitu Minigame Muncul
						if fishIcon or sliderBar then
							if sliderBar and fishIcon then
								sliderBar.Position = UDim2.new(fishIcon.Position.X.Scale, sliderBar.Position.X.Offset, sliderBar.Position.Y.Scale, sliderBar.Position.Y.Offset)
							end
							
							if progressBar then
								progressBar.Size = UDim2.new(1, 0, progressBar.Size.Y.Scale, progressBar.Size.Y.Offset)
							end
							
							Status.Text = "Status: INSTANT WIN IKAN BAGUS!"
							Status.TextColor3 = Color3.fromRGB(100, 255, 150)
						else
							Status.Text = "Status: Standby (Menunggu Fisherman)..."
							Status.TextColor3 = Color3.fromRGB(150, 150, 150)
						end
					end
				end)
				task.wait(0.02)
			end
		end)
	else
		Status.Text = "Status: Standby"
		Status.TextColor3 = Color3.fromRGB(150, 150, 150)
	end
end)
