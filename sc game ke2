-- 7. FUNGSI UNTUK MELAKUKAN MENEKAN TOMBOL "E" (PROXIMITY PROMPT) DARI STAND ROLL
local function FireRollProximityPrompt()
    local rollStands = Workspace:FindFirstChild("RollStands") or Workspace:FindFirstChild("Buildings")
    if rollStands then
        for _, prompt in ipairs(rollStands:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                -- Menekan tombol E secara fisik via executor API
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                else
                    prompt:InputHoldBegin()
                    task.wait(0.1)
                    prompt:InputHoldEnd()
                end
                return true
            end
        end
    end
    
    -- Fallback jika ada ProximityPrompt di seluruh Workspace
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pName = string.lower(prompt.ObjectText .. prompt.ActionText)
            if string.find(pName, "roll") or string.find(pName, "gacha") or string.find(pName, "buy") then
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                end
                return true
            end
        end
    end
    return false
end

