-- Fitur 1: Auto Run Kilat ke Extraction (Menggunakan jalur folder spesifik World -> Arena -> ExtractionZone)
CreateToggleButton("Auto Run Extraction", "AutoExtractRun", function(state)
    task.spawn(function()
        while Config.AutoExtractRun do
            task.wait(0.2)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local targetPart = nil
                    
                    -- Mengikuti jalur akurat dari foto Dex: Workspace -> World -> Arena -> ExtractionZone
                    local worldFolder = Workspace:FindFirstChild("World")
                    if worldFolder then
                        local arenaFolder = worldFolder:FindFirstChild("Arena")
                        if arenaFolder then
                            local extractZone = arenaFolder:FindFirstChild("ExtractionZone")
                            if extractZone then
                                -- Cari bagian di dalam ExtractionZone yang sedang aktif/terbuka
                                for _, part in pairs(extractZone:GetDescendants()) do
                                    if part:IsA("BasePart") and part.Transparency < 0.8 then
                                        targetPart = part
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetPart then
                        char.Humanoid.WalkSpeed = 160
                        char.Humanoid:MoveTo(targetPart.Position)
                    else
                        char.Humanoid.WalkSpeed = 16
                    end
                end
            end)
        end
        pcall(function()
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
            end
        end)
    end)
end)

-- Fitur 2: Anti Player (Terbang Tinggi Jika Ada Player Mendekat)
CreateToggleButton("Anti Player (High Fly)", "AntiPlayerHighFly", function(state)
    task.spawn(function()
        while Config.AntiPlayerHighFly do
            task.wait(0.1)
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local playerNearby = false
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if distance < 25 then
                                playerNearby = true
                                break
                            end
                        end
                    end
                    
                    if playerNearby then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 180, hrp.Velocity.Z)
                    end
                end
            end)
        end
    end)
end)

-- Fitur 3: Smart Steal (Hanya kejar & pukul player yang memegang Brainrot langka)
CreateToggleButton("Smart Steal Rare Brainrot", "SmartStealAndAttack", function(state)
    task.spawn(function()
        while Config.SmartStealAndAttack do
            task.wait(0.3)
            pcall(function()
                local bestTargetPlayer = nil
                local highestRankScore = 0
                
                local function getBrainrotScore(name)
                    name = name:lower()
                    if name:find("trinity") then return 5000
                    elseif name:find("infinity") then return 4000
                    elseif name:find("admin") then return 3000
                    elseif name:find("celestial") then return 2000
                    else return 0
                    end
                end
                
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        for _, child in pairs(p.Character:GetChildren()) do
                            local score = getBrainrotScore(child.Name)
                            if score > highestRankScore then
                                highestRankScore = score
                                bestTargetPlayer = p
                            end
                        end
                    end
                end
                
                if bestTargetPlayer and bestTargetPlayer.Character and bestTargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local localChar = LocalPlayer.Character
                    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                        localChar.HumanoidRootPart.CFrame = bestTargetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2.5)
                        
                        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if tool:IsA("Tool") then
                                tool.Parent = localChar
                            end
                        end
                        
                        for _, tool in pairs(localChar:GetChildren()) do
                            if tool:IsA("Tool") then
                                tool:Activate()
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

