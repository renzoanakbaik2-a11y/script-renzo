getgenv().AutoPickUp = false

ToggleButton.MouseButton1Click:Connect(function()
    getgenv().AutoPickUp = not getgenv().AutoPickUp
    if getgenv().AutoPickUp then
        ToggleButton.Text = "Status: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
    else
        ToggleButton.Text = "Status: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    for _, child in pairs(MainFrame:GetChildren()) do
        if child:IsA("GuiObject") and child ~= Title and child ~= MinimizeBtn then
            child.Visible = not isMinimized
        end
    end
    if isMinimized then
        MainFrame.Size = UDim2.new(0, 220, 0, 40)
        MinimizeBtn.Text = "+"
    else
        MainFrame.Size = UDim2.new(0, 220, 0, 160)
        MinimizeBtn.Text = "-"
    end
end)

-- Loop Utama dengan Filter Area Spawn Bawah & Abaikan Pedestal Base Pemain
task.spawn(function()
    while task.wait(0.2) do
        if getgenv().AutoPickUp then
            pcall(function()
                local character = LocalPlayer.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, prompt in pairs(Workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local parentPart = prompt.Parent
                        if parentPart and parentPart:IsA("BasePart") then
                            
                            local actionText = prompt.ActionText:lower()
                            local parentName = parentPart.Name:lower()
                            
                            -- Syarat 1: Harus bertuliskan "pick up"
                            if actionText:find("pick up") then
                                
                                -- Syarat 2: JANGAN SENTUH jika objeknya adalah Pedestal yang ada di base pemain
                                -- (Biasanya Pedestal base pemain berada di lantai atas atau di dalam folder base)
                                local isAtBasePedestal = false
                                local ancestor = parentPart.Parent
                                while ancestor and ancestor ~= Workspace do
                                    local ancName = ancestor.Name:lower()
                                    if ancName:find("base") or ancName:find("plot") or ancName:find("owner") then
                                        isAtBasePedestal = true
                                        break
                                    end
                                    ancestor = ancestor.Parent
                                end
                                
                                -- Syarat 3: Pastikan posisinya berada di arena wadah bawah (ketinggian Y di bawah area base)
                                local pos = parentPart.Position
                                local isInArenaArea = (pos.Y < 50) -- Sesuaikan jika arena bawah memiliki batas Y tertentu
                                
                                -- Eksekusi HANYA jika itu "Pick Up", bukan di base orang, dan berada di area arena
                                if not isAtBasePedestal and isInArenaArea then
                                    hrp.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z)
                                    task.wait(0.1)
                                    fireproximityprompt(prompt)
                                end
                                
                            end
                            
                        end
                    end
                end
            end)
        end
    end
end)

print("GUI Perfect Farm Berhasil Dijalankan!")
