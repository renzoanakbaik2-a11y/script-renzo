-- ==========================================
-- TOMBOL 1: AUTO HIT (MENARGET TOMBOL LAYAR HP)
-- ==========================================
local attackBtn = Instance.new("TextButton")
attackBtn.Size = UDim2.new(0, 220, 0, 45)
attackBtn.Position = UDim2.new(0.5, -110, 0, 50)
attackBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
attackBtn.Text = "Mobile Auto Hit: OFF"
attackBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
attackBtn.TextSize = 13
attackBtn.Font = Enum.Font.SourceSansBold
attackBtn.Parent = mainFrame

local attackAktif = false
attackBtn.MouseButton1Click:Connect(function()
    attackAktif = not attackAktif
    attackBtn.BackgroundColor3 = attackAktif and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    attackBtn.Text = attackAktif and "Mobile Auto Hit: ON" or "Mobile Auto Hit: OFF"
    
    if attackAktif then
        task.spawn(function()
            while attackAktif do
                local karakter = player.Character
                if karakter then
                    -- 1. Coba aktifkan tool raket jika terdeteksi
                    local tool = karakter:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                    
                    -- 2. Menelusuri dan memicu tombol aksi pukul (ikon kok) di dalam PlayerGui secara otomatis
                    for _, gui in ipairs(playerGui:GetDescendants()) do
                        if gui:IsA("ImageButton") or gui:IsA("TextButton") then
                            local namaGui = gui.Name:lower()
                            -- Tombol aksi game biasanya berupa tombol besar atau mengandung kata kunci pukul/hit/action
                            if gui.AbsoluteSize.X > 60 or namaGui:find("hit") or namaGui:find("swing") or namaGui:find("attack") or namaGui:find("action") or namaGui:find("button") then
                                pcall(function()
                                    -- Meniru klik pada tombol layar tersebut
                                    for _, cb in ipairs(getgenv().debug and {} or {}) do end -- dummy safety
                                    -- Memicu event sentuh tombol game
                                    if gui:FindFirstChildWhichIsA("UITextSizeConstraint") or gui.AbsoluteSize.X > 70 then
                                        -- Mengirimkan sinyal klik langsung ke tombol game
                                        local VirtualUser = game:GetService("VirtualUser")
                                        VirtualUser:Button1Down(Vector2.new(gui.AbsolutePosition.X + 20, gui.AbsolutePosition.Y + 20))
                                        task.wait(0.02)
                                        VirtualUser:Button1Up(Vector2.new(gui.AbsolutePosition.X + 20, gui.AbsolutePosition.Y + 20))
                                    end
                                end)
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)


-- ==========================================
-- TOMBOL 2: SMART LANDING TP (TELEPORT SEKALI KE TITIK JATUH DI ZONA KITA)
-- ==========================================
local tpBtn = Instance.new("TextButton")
tpBtn.Size = UDim2.new(0, 220, 0, 45)
tpBtn.Position = UDim2.new(0.5, -110, 0, 110)
tpBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
tpBtn.Text = "Smart Landing TP: OFF"
tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
tpBtn.TextSize = 13
tpBtn.Font = Enum.Font.SourceSansBold
tpBtn.Parent = mainFrame

local tpAktif = false
tpBtn.MouseButton1Click:Connect(function()
    tpAktif = not tpAktif
    tpBtn.BackgroundColor3 = tpAktif and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    tpBtn.Text = tpAktif and "Smart Landing TP: ON" or "Smart Landing TP: OFF"
    
    if tpAktif then
        task.spawn(function()
            local sudahTeleport = false
            
            while tpAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local targetBola = nil
                    
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local n = obj.Name:lower()
                            if n:find("ball") or n:find("shuttle") or n:find("birdie") or n:find("tennis") then
                                targetBola = obj
                                break
                            end
                        end
                    end
                    
                    if targetBola then
                        local bolaPos = targetBola.Position
                        local playerPos = rootPart.Position
                        
                        -- Logika Zona: Pastikan bola berada di area setengah lapangan kita (tidak teleport ke zona musuh)
                        local jarakZ = bolaPos.Z - playerPos.Z
                        local diZonaKita = (jarakZ >= -40 and jarakZ <= 40)
                        
                        if diZonaKita then
                            -- Teleport sekali saja ke titik bawah lantai tempat bola akan mendarat
                            if not sudahTeleport then
                                local titikJatuh = Vector3.new(bolaPos.X, rootPart.Position.Y, bolaPos.Z)
                                rootPart.CFrame = CFrame.new(titikJatuh)
                                sudahTeleport = true
                            end
                        else
                            -- Jika bola di zona musuh, reset agar tidak teleport ke sana
                            sudahTeleport = false
                        end
                    else
                        sudahTeleport = false
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)
