-- ==========================================
-- 5. FITUR: SMART TP + AUTO SWING/HIT PRESISI
-- ==========================================

local autoPlayBtn = Instance.new("TextButton")
autoPlayBtn.Name = "AutoPlayButton"
autoPlayBtn.Size = UDim2.new(0, 220, 0, 45)
autoPlayBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoPlayBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoPlayBtn.Text = "Smart Auto Play: OFF"
autoPlayBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoPlayBtn.TextSize = 14
autoPlayBtn.Font = Enum.Font.SourceSansBold
autoPlayBtn.Parent = mainFrame

local autoPlayAktif = false

-- Fungsi pendukung untuk memicu tombol pukul game secara otomatis (Virtual Click / Remote Event)
local function pukulBolaOtomatis()
    -- Biasanya game olahraga menggunakan ClickDetector, Tool Activation, atau RemoteEvent.
    -- Kita picu tool yang sedang dipegang player (jika ada raket di tangan)
    local karakter = player.Character
    if karakter then
        local tool = karakter:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate() -- Otomatis mengayunkan raket yang sedang dipegang
        end
    end
end

autoPlayBtn.MouseButton1Click:Connect(function()
    autoPlayAktif = not autoPlayAktif
    
    if autoPlayAktif then
        autoPlayBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoPlayBtn.Text = "Smart Auto Play: ON"
        
        task.spawn(function()
            local sudahPukul = false
            
            while autoPlayAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local targetBola = nil
                    
                    -- Cari bola/shuttle di Workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        local namaObj = obj.Name:lower()
                        if obj:IsA("BasePart") and (namaObj:find("ball") or namaObj:find("shuttle") or namaObj:find("birdie")) then
                            targetBola = obj
                            break
                        end
                    end
                    
                    if targetBola then
                        local jarakKeBola = (rootPart.Position - targetBola.Position).Magnitude
                        
                        -- BATAS JARAK JANGKAUAN RAKET (Misalnya dalam radius 7 meter dari pemain)
                        if jarakKeBola <= 7 then
                            -- Teleport presisi tepat di dekat bola jika belum dipukul
                            rootPart.CFrame = targetBola.CFrame + Vector3.new(0, 0, 0)
                            
                            -- Pukul bola SEKALI saja saat masuk jangkauan (tidak spam)
                            if not sudahPukul then
                                pukulBolaOtomatis()
                                sudahPukul = true
                                task.wait(0.4) -- Jeda agar animasi pukul selesai
                            end
                        else
                            -- Reset status pukul jika bola menjauh lagi
                            sudahPukul = false
                            
                            -- Jika bola masih di area kita dan agak jauh, dekati secara cerdas
                            if jarakKeBola < 35 then
                                rootPart.CFrame = targetBola.CFrame + Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    else
        autoPlayBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoPlayBtn.Text = "Smart Auto Play: OFF"
    end
end)
