HopButton.MouseButton1Click:Connect(function()
    HopButton.Text = "Pindah Server..."
    pcall(function()
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.maxPlayers and s.playing and s.playing < s.maxPlayers and s.id ~= game.JobId then
                    table.insert(servers, s.id)
                end
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
        else
            HopButton.Text = "Gagal, Coba Lagi"
            task.wait(2)
            HopButton.Text = "Server Hop"
        end
    end)
end)

local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    for _, child in pairs(MainFrame:GetChildren()) do
        if child:IsA("GuiObject") and child ~= Title and child ~= MinimizeBtn then
            child.Visible = not isMinimized
        end
    end
    if isMinimized then
        MainFrame.Size = UDim2.new(0, 220, 0, 40)
        MinimizeBtn.Text = "+"
    else
        MainFrame.Size = UDim2.new(0, 220, 0, 215)
        MinimizeBtn.Text = "-"
    end
end)

-- Loop Utama V7: Deteksi Prompt "Pick Up" dinamis dengan Batasan Jarak Arena (Radius)
task.spawn(function()
    while true do
        task.wait(0.15)
        if getgenv().AutoPickUp then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, p in pairs(Workspace:GetDescendants()) do
                    if not getgenv().AutoPickUp then break end
                    
                    if p:IsA("ProximityPrompt") then
                        local actionText = tostring(p.ActionText):lower()
                        
                        -- Cek apakah prompt tersebut adalah untuk mengambil item ("pick up")
                        if actionText:find("pick up") then
                            local part = p.Parent
                            if part and part:IsA("BasePart") then
                                
                                -- Ambil posisi bagian item yang ada prompt-nya
                                local itemPos = part.Position
                                
                                -- FILTER AMAN: 
                                -- 1. Ketinggian Y harus di bawah area base pemain (di area arena bawah)
                                -- 2. Jarak dari karakter kita tidak terlalu jauh (misal dalam radius 60 studs) 
                                --    agar tidak mengejar prompt yang ada di base orang lain yang jauh.
                                local distanceFromPlayer = (itemPos - hrp.Position).Magnitude
                                
                                if itemPos.Y < 45 and distanceFromPlayer < 70 then
                                    hrp.CFrame = CFrame.new(itemPos.X, itemPos.Y + 3, itemPos.Z)
                                    task.wait(0.05)
                                    fireproximityprompt(p)
                                    task.wait(0.1)
                                end
                                
                            end
                        end
                    end
                end
            end)
        end
    end
end)

