-- ==========================================
-- [BAGIAN 5] FITUR UTAMA: AUTO COLLECT (METODE PAKSA)
-- ==========================================

local autoCollectBtn = Instance.new("TextButton")
autoCollectBtn.Name = "AutoCollectButton"
autoCollectBtn.Size = UDim2.new(0, 220, 0, 45)
autoCollectBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoCollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoCollectBtn.Text = "Auto Collect: OFF"
autoCollectBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoCollectBtn.TextSize = 14
autoCollectBtn.Font = Enum.Font.SourceSansBold
autoCollectBtn.Parent = mainFrame

local autoCollectAktif = false
autoCollectBtn.MouseButton1Click:Connect(function()
    autoCollectAktif = not autoCollectAktif
    
    if autoCollectAktif then
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoCollectBtn.Text = "Auto Collect: ON"
        
        task.spawn(function()
            while autoCollectAktif do
                local karakter = game:GetService("Players").LocalPlayer.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    
                    -- Cari semua benda di dalam Workspace secara menyeluruh
                    for _, v in ipairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and v.Name ~= "ArenaTiles" and v.Name ~= "Terrain" then
                            -- Cek apakah bagian itu punya interaksi atau ukuran seperti item
                            if v.Size.Magnitude < 10 and (v:FindFirstChild("TouchInterest") or v:FindFirstChild("ProximityPrompt") or v:FindFirstChild("ClickDetector")) then
                                karakter.HumanoidRootPart.CFrame = v.CFrame
                                task.wait(0.2)
                                break
                            end
                        end
                    end
                    
                end
                task.wait(0.3)
            end
        end)
    else
        autoCollectBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoCollectBtn.Text = "Auto Collect: OFF"
    end
end)
