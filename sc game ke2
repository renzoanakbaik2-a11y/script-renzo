-- [LOGIC: Optimized Auto Collect]
local ArenaFolder = Workspace:WaitForChild("World"):WaitForChild("Arena")

-- Filter agar tidak menyentuh folder milik pemain
local function isSafe(obj)
    local path = obj:GetFullName()
    return not (path:find("PlayerZones") or path:find("Plot") or path:find("Base"))
end

task.spawn(function()
    while task.wait(0.4) do
        if Settings.AutoCollect and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local bestCube, highestRarity = nil, -1
            for _, obj in pairs(ArenaFolder:GetDescendants()) do
                if (obj:IsA("BasePart")) and isSafe(obj) and obj.Name:lower():find("cube") then
                    local rarity = tonumber(obj.Name:match("%d+")) or 1
                    if rarity > highestRarity then
                        highestRarity = rarity
                        bestCube = obj
                    end
                end
            end
            if bestCube then
                LocalPlayer.Character.HumanoidRootPart.CFrame = bestCube.CFrame * CFrame.new(0, 2, 0)
            end
        end
    end
end)

-- [UI Component: Button Creator]
local function createButton(text, settingKey)
    local btn = Instance.new("TextButton", Container)
    btn.Size = UDim2.new(1, 0, 0, 50)
    btn.Text = text .. " [OFF]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Font = Enum.Font.Gotham
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    btn.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        btn.Text = text .. (Settings[settingKey] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = Settings[settingKey] and Color3.fromRGB(60, 179, 113) or Color3.fromRGB(40, 40, 40)
    end)
end

createButton("Auto Collect", "AutoCollect")
createButton("Anti Player", "AntiPlayer")

