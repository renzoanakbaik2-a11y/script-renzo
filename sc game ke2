-- Sistem Auto Save Settings
local SaveFileName = "BrainrotHub_Config_v8.json"
local Config = {
    AutoExtractRun = false,
    AntiPlayerHighFly = false,
    SmartStealAndAttack = false
}

local function SaveSettings()
    pcall(function()
        if writefile then
            writefile(SaveFileName, HttpService:JSONEncode(Config))
        end
    end)
end

local function LoadSettings()
    pcall(function()
        if readfile and isfile and isfile(SaveFileName) then
            Config = HttpService:JSONDecode(readfile(SaveFileName))
        end
    end)
end
