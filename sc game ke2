-- ==========================================

local autoStealBtn = Instance.new("TextButton")
autoStealBtn.Name = "AutoStealButton"
autoStealBtn.Size = UDim2.new(0, 220, 0, 45)
autoStealBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoStealBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoStealBtn.Text = "Auto Fly Steal: OFF"
autoStealBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoStealBtn.TextSize = 14
autoStealBtn.Font = Enum.Font.SourceSansBold
autoStealBtn.Parent = mainFrame

-- Fungsi Tambahan: Terbang Meluncur secara Smooth dari Titik A ke Titik B
local function terbangKe(posisiTujuan, kecepatan)
    local player = game:GetService("Players").LocalPlayer
    local karakter = player.Character
    if not (karakter and karakter:FindFirstChild("HumanoidRootPart")) then return end
    
    local rootPart = karakter.HumanoidRootPart
    local TweenService = game:GetService("TweenService")
    
    local jarak = (rootPart.Position - posisiTujuan.Position).Magnitude
    local durasi = jarak / kecepatan -- Menghitung waktu terbang berdasarkan jarak
    
    local tweenInfo = TweenInfo.new(durasi, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = posisiTujuan})
    
    -- Matikan gravitasi sementara biar melayang mulus
    karakter.Humanoid.PlatformStand = true
    tween:Play()
    tween.Completed:Wait() -- Tunggu sampai terbangnya selesai
    karakter.Humanoid.PlatformStand = false
end

local autoStealAktif = false
autoStealBtn.MouseButton1Click:Connect(function()
    autoStealAktif = not autoStealAktif
    
    if autoStealAktif then
        autoStealBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoStealBtn.Text = "Auto Fly Steal: ON"
        
        task.spawn(function()
            while autoStealAktif do
                local player = game:GetService("Players").LocalPlayer
                local karakter = player.Character
                
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local posisiBase = rootPart.CFrame -- Simpan posisi base asal
                    local targetTelur = nil
                    
                    -- Cari telur/item di workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("egg") or obj:FindFirstChild("TouchInterest")) then
                            if obj.Size.Magnitude < 10 and not obj.Name:lower():find("base") then
                                targetTelur = obj
                                break
                            end
                        end
                    end
                    
                    if targetTelur then
                        -- Kecepatan Terbang (Makin tinggi angkanya, makin cepat terbangnya)
                        local speedFly = 80 
                        
                        -- 1. TERBANG KE ATAS TELUR (Posisi melayang di udara di atas telur)
                        local titikAtasTelur = targetTelur.CFrame + Vector3.new(0, 15, 0)
                        terbangKe(titikAtasTelur, speedFly)
                        
                        -- 2. TURUN MENDEKAT KE TELUR UNTUK MENGAMBIL
                        local titikTelurDeket = targetTelur.CFrame + Vector3.new(0, 1, 0)
                        terbangKe(titikTelurDeket, 30) -- Turun agak pelan biar pas nempel telur
                        task.wait(0.3) -- Jeda sebentar buat ambil telur
                        
                        -- 3. TERBANG NAIK KEMBALI KE UDARA
                        terbangKe(titikAtasTelur, speedFly)
                        
                        -- 4. TERBANG BALIK KE BASE
                        local titikAtasBase = posisiBase + Vector3.new(0, 15, 0)
                        terbangKe(titikAtasBase, speedFly)
                        
                        -- 5. TURUN HALUS DI BASE
                        terbangKe(posisiBase, 40)
                    end
                    
                end
                task.wait(1.5)
            end
        end)
    else
        autoStealBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoStealBtn.Text = "Auto Fly Steal: OFF"
    end
end)
