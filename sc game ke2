local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

_G.BrainrotSettings = {
    AutoCollect = false,
    AntiPlayer = false
}

-- [1. UI DESIGN]
local ScreenGui = Instance.new("ScreenGui", CoreGui)
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 250, 0, 250)
MainFrame.Position = UDim2.new(0.5, -125, 0.5, -125)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 15)

local Container = Instance.new("UIListLayout", MainFrame)
Container.Padding = UDim.new(0, 15)
Container.HorizontalAlignment = Enum.HorizontalAlignment.Center
Container.Padding = UDim.new(0, 20)

local function createButton(text, settingKey)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 60)
    btn.Text = text .. " [OFF]"
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    btn.MouseButton1Click:Connect(function()
        _G.BrainrotSettings[settingKey] = not _G.BrainrotSettings[settingKey]
        btn.Text = text .. (_G.BrainrotSettings[settingKey] and " [ON]" or " [OFF]")
        btn.BackgroundColor3 = _G.BrainrotSettings[settingKey] and Color3.fromRGB(60, 179, 113) or Color3.fromRGB(40, 40, 40)
    end)
end

createButton("Auto Collect", "AutoCollect")
createButton("Anti Player", "AntiPlayer")

-- [2. LOGIKA UTAMA (Satu Loop Efisien)]
local function isSafe(obj)
    local path = obj:GetFullName()
    return not (path:find("PlayerZones") or path:find("Plot") or path:find("Base"))
end

local function collect(part)
    if not part then return end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = part.CFrame * CFrame.new(0, 2, 0)
        if firetouchinterest then
            firetouchinterest(char.HumanoidRootPart, part, 0)
            task.wait(0.05)
            firetouchinterest(char.HumanoidRootPart, part, 1)
        end
    end
end

task.spawn(function()
    while task.wait(0.3) do
        local Arena = Workspace:FindFirstChild("World") and Workspace.World:FindFirstChild("Arena")
        if not Arena then continue end

        -- Auto Collect (Cube, Brainrot, Fruit, Apple digabung)
        if _G.BrainrotSettings.AutoCollect then
            for _, obj in pairs(Arena:GetDescendants()) do
                if obj:IsA("BasePart") and isSafe(obj) then
                    local name = obj.Name:lower()
                    -- Mengecek semua keyword dalam satu kondisi
                    if name:find("cube") or name:find("brainrot") or name:find("fruit") or name:find("apple") then
                        collect(obj)
                        break -- Ambil satu objek terdekat lalu loop lagi
                    end
                end
            end
        end

        -- Anti Player
        if _G.BrainrotSettings.AntiPlayer then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        if (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude < 25 then
                            hrp.Velocity = Vector3.new(0, 150, 0)
                        end
                    end
                end
            end
        end
    end
end)

print("Brainrot Survival Hub Streamlined!")
