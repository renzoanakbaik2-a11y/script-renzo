-- ==========================================================
-- SPEED HUB X - AUTOMATIC REMOTE SCANNER FOR ROLL A FISHERMAN
-- ==========================================================

print("=== STARTING SCANNER ===")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local foundRemotes = {}

local function ScanObject(parent)
    for _, child in ipairs(parent:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            local name = string.lower(child.Name)
            if string.find(name, "roll") or string.find(name, "gacha") or string.find(name, "buy") or string.find(name, "spin") or string.find(name, "fisherman") then
                table.insert(foundRemotes, child:GetFullName())
            end
        end
    end
end

-- Scan ReplicatedStorage & Workspace
ScanObject(ReplicatedStorage)
ScanObject(Workspace)

print("=== HASIL PEMINDAIAN REMOTE ===")
if #foundRemotes > 0 then
    for i, path in ipairs(foundRemotes) do
        print("[" .. i .. "] " .. path)
    end
else
    print("Tidak ditemukan remote dengan kata kunci khusus. Menampilkan seluruh RemoteEvent di ReplicatedStorage:")
    for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
            print("-> " .. child:GetFullName())
        end
    end
end
print("=== SCAN FINISHED ===")
