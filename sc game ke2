local startTime = os.time()

local function GetPlayerMoney(plr)
    local money = 0
    local lstats = plr:FindFirstChild("leaderstats")
    if lstats then
        for _, child in ipairs(lstats:GetChildren()) do
            if child:IsA("ValueBase") then
                local n = string.lower(child.Name)
                if n == "cash" or n == "money" or n == "coins" or n == "$" or string.find(n, "cash") then
                    return tonumber(child.Value) or 0
                end
            end
        end
    end
    local dataFolder = plr:FindFirstChild("Data") or plr:FindFirstChild("stats")
    if dataFolder then
        for _, child in ipairs(dataFolder:GetChildren()) do
            if child:IsA("ValueBase") then
                local n = string.lower(child.Name)
                if n == "cash" or n == "money" or n == "coins" then
                    return tonumber(child.Value) or 0
                end
            end
        end
    end
    return money
end

task.spawn(function()
    while task.wait(1) do
        if not ScreenGui or not ScreenGui.Parent then break end

        local realTimeStr = os.date("%H:%M:%S")
        local elapsed = os.time() - startTime
        local hrs = math.floor(elapsed / 3600)
        local mins = math.floor((elapsed % 3600) / 60)
        local secs = elapsed % 60
        local playtimeStr = string.format("%02dh %02dm %02ds", hrs, mins, secs)

        local allPlayers = Players:GetPlayers()
        local playerAmount = #allPlayers
        local maxPlayers = Players.MaxPlayers or 6

        local richestName = "None"
        local maxCash = -1

        for _, plr in ipairs(allPlayers) do
            local pMoney = GetPlayerMoney(plr)
            if pMoney > maxCash then
                maxCash = pMoney
                richestName = plr.Name
            end
        end

        local richestStr = richestName
        if maxCash > -1 then
            richestStr = richestName .. " ($" .. tostring(maxCash) .. ")"
        end

        StatsText.Text = string.format(
            "SERVER INFORMATION:\n\n• Jam (Real Life)  : %s\n• Time Played     : %s\n• Server Players   : %d / %d Players\n• Richest Player   : %s",
            realTimeStr,
            playtimeStr,
            playerAmount,
            maxPlayers,
            richestStr
        )
    end
end)

