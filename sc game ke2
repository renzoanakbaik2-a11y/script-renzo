-- Fungsi untuk mengecek apakah pintu/tembok sudah terbuka
local function isDoorOpen()
    local wallPart = workspace:FindFirstChild("World") 
        and workspace.World:FindFirstChild("Arena") 
        and workspace.World.Arena:FindFirstChild("ExtractionZone") 
    
    if wallPart and wallPart:IsA("BasePart") then
        if wallPart.CanCollide == false or wallPart.Transparency > 0.5 then
            return true
        end
        return false
    end
    return true
end

-- Fungsi mencari zona hijau terdekat
local function getNearestGreenZone()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = character.HumanoidRootPart
    
    local extractionFolder = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Arena")
        and workspace.World.Arena:FindFirstChild("ExtractionZone")
        and workspace.World.Arena:FindFirstChild("ExtractionZone") -- Disesuaikan
        and workspace.World.Arena.ExtractionZone:FindFirstChild("North")
        and workspace.World.Arena.ExtractionZone.North:FindFirstChild("FlashExtract")
    
    if not extractionFolder then return nil end
    
    local nearestPart = nil
    local shortestDistance = math.huge
    
    for _, part in ipairs(extractionFolder:GetChildren()) do
        if part:IsA("BasePart") then
            local distance = (hrp.Position - part.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestPart = part
            end
        end
    end
    
    return nearestPart
end

-- Variabel penanda agar teleport tidak berulang-ulang terus di tempat yang sama
local hasTeleported = false

RunService.RenderStepped:Connect(function()
    if autoWalkEnabled then
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            if isDoorOpen() then
                if not hasTeleported then
                    local targetZone = getNearestGreenZone()
                    if targetZone then
                        -- Teleport langsung ke atas zona hijau dengan sedikit ketinggian agar tidak nyangkut
                        hrp.CFrame = targetZone.CFrame + Vector3.new(0, 3, 0)
                        hasTeleported = true
                        print("Berhasil teleport ke zona hijau!")
                    end
                end
            else
                -- Reset status teleport jika gerbang tertutup kembali (untuk ronde berikutnya)
                hasTeleported = false
            end
        end
    end
end)
