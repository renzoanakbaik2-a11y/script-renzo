-- Fungsi mencari zona hijau tujuan akhir
local function getNearestGreenZone()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = character.HumanoidRootPart
    
    local extractionFolder = workspace:FindFirstChild("World")
        and workspace.World:FindFirstChild("Arena")
        and workspace.World.Arena:FindFirstChild("ExtractionZone")
        and workspace.World.Arena.ExtractionZone:FindFirstChild("North")
        and workspace.World.Arena.ExtractionZone.North:FindFirstChild("FlashExtract")
    
    if not extractionFolder then return nil end
    
    local nearestPart = nil
    local shortestDistance = math.huge
    
    for _, part in ipairs(extractionFolder:GetChildren()) do
        if part:IsA("BasePart") then
            local distance = (hrp.Position - part.Position).Magnitude
            if distance < shortestDistance then
                shortestDistance = distance
                nearestPart = part
            end
        end
    end
    
    return nearestPart
end

local hasBypassed = false

RunService.RenderStepped:Connect(function()
    if autoWalkEnabled then
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        
        if hrp then
            local targetZone = getNearestGreenZone()
            if targetZone and not hasBypassed then
                -- Langsung pindahkan posisi karakter menembus area gerbang ke dalam zona hijau
                -- Ini membuat game mengira karakter sudah melewati area trigger secara instan tanpa memutar animasi jalan/hancur
                hrp.CFrame = targetZone.CFrame + Vector3.new(0, 3, 0)
                hasBypassed = true
                print("Berhasil bypass animasi gerbang!")
            end
        end
    else
        hasBypassed = false
    end
end)
