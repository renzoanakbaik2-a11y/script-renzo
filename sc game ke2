-- Loop Auto Collect (Teleport instan ke brainrot)
task.spawn(function()
    while true do
        task.wait(0.2)
        if getgenv().AutoCollect then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, p in pairs(Workspace:GetDescendants()) do
                    if not getgenv().AutoCollect then break end
                    
                    if p:IsA("ProximityPrompt") then
                        local actionText = tostring(p.ActionText):lower()
                        if actionText:find("pick up") then
                            local part = p.Parent
                            if part and part:IsA("BasePart") then
                                local isInBase = false
                                local ancestor = part.Parent
                                while ancestor and ancestor ~= Workspace do
                                    local name = ancestor.Name:lower()
                                    if name:find("base") or name:find("plot") or name:find("pedestal") or name:find("owner") then
                                        isInBase = true
                                        break
                                    end
                                    ancestor = ancestor.Parent
                                end
                                
                                if not isInBase then
                                    hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.05)
                                    fireproximityprompt(p)
                                    task.wait(0.1)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Loop Auto Extract V31 (Menargetkan langsung folder FlashExtract berdasarkan gambar)
task.spawn(function()
    while true do
        task.wait(1)
        if getgenv().AutoExtract then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not humanoid then return end
                
                local world = Workspace:FindFirstChild("World")
                local arena = world and world:FindFirstChild("Arena")
                local extractZone = arena and arena:FindFirstChild("ExtractionZone")
                
                if extractZone then
                    -- Cari ke dalam semua arah mata angin (West, East, North, South, dll.) yang ada di ExtractionZone
                    for _, directionFolder in pairs(extractZone:GetChildren()) do
                        local flashExtract = directionFolder:FindFirstChild("FlashExtract")
                        if flashExtract then
                            local targetZone = nil
                            local shortestDist = math.huge
                            
                            -- Cari part yang berawalan "ExtractionZoneFlash" di dalam FlashExtract
                            for _, part in pairs(flashExtract:GetChildren()) do
                                if part:IsA("BasePart") and part.Name:lower():find("extractionzoneflash") then
                                    local dist = (part.Position - hrp.Position).Magnitude
                                    if dist < shortestDist then
                                        shortestDist = dist
                                        targetZone = part
                                    end
                                end
                            end
                            
                            if targetZone then
                                -- LANGKAH 1: Biarkan karakter terbang/maju ke arah target zona/gerbang
                                humanoid:MoveTo(targetZone.Position)
                                task.wait(1.5)
                                
                                -- LANGKAH 2: Tunggu sampai animasi terbang/lewat/mental selesai stabil
                                local timeout = 5
                                while timeout > 0 do
                                    if not getgenv().AutoExtract then break end
                                    local vel = hrp.AssemblyLinearVelocity.Magnitude
                                    if vel > 15 then
                                        task.wait(0.3) -- Masih terpental, tunggu animasi selesai
                                    else
                                        task.wait(0.5) -- Sudah stabil
                                        break
                                    end
                                    timeout = timeout - 0.2
                                    task.wait(0.2)
                                end
                                
                                -- LANGKAH 3: Jalan kaki natural menuju tepat di atas part zona hijau tersebut
                                humanoid:MoveTo(targetZone.Position)
                                
                                local walkTime = tick()
                                repeat
                                    task.wait(0.2)
                                    if not getgenv().AutoExtract then break end
                                until (hrp.Position - targetZone.Position).Magnitude < 4 or (tick() - walkTime) > 5
                                
                                -- LANGKAH 4: Diam di atas zona hijau menunggu hitung mundur ekstraksi selesai
                                task.wait(6)
                                task.wait(5)
                                break
                            end
                        end
                    end
                end
            end)
        end
    end
end)

