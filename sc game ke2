-- Fungsi terbang mulus khusus untuk Extraction
local function smoothFlyTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 45 
    local duration = math.clamp(distance / speed, 0.5, 3) 
    
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    task.wait(duration)
end

-- Loop Auto Collect (Teleport instan ke posisi brainrot)
task.spawn(function()
    while true do
        task.wait(0.2)
        if getgenv().AutoCollect then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, p in pairs(Workspace:GetDescendants()) do
                    if not getgenv().AutoCollect then break end
                    
                    if p:IsA("ProximityPrompt") then
                        local actionText = tostring(p.ActionText):lower()
                        if actionText:find("pick up") then
                            local part = p.Parent
                            if part and part:IsA("BasePart") then
                                local isInBase = false
                                local ancestor = part.Parent
                                while ancestor and ancestor ~= Workspace do
                                    local name = ancestor.Name:lower()
                                    if name:find("base") or name:find("plot") or name:find("pedestal") or name:find("owner") then
                                        isInBase = true
                                        break
                                    end
                                    ancestor = ancestor.Parent
                                end
                                
                                if not isInBase then
                                    -- Teleport instan langsung ke atas brainrot
                                    hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.05)
                                    fireproximityprompt(p)
                                    task.wait(0.1)
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Loop Auto Extract (Diam sampai pintu terbuka, lalu terbang mulus ke zona hijau)
task.spawn(function()
    while true do
        task.wait(1)
        if getgenv().AutoExtract then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                local world = Workspace:FindFirstChild("World")
                local arena = world and world:FindFirstChild("Arena")
                local extractZone = arena and arena:FindFirstChild("ExtractionZone")
                
                if extractZone then
                    local targetPart = nil
                    
                    for _, part in pairs(extractZone:GetDescendants()) do
                        if part:IsA("BasePart") and part.Name:lower():find("extractionzone") then
                            targetPart = part
                            break 
                        end
                    end
                    
                    -- Kalau zona hijau sudah muncul (pintu terbuka), baru bergerak terbang mulus ke sana!
                    if targetPart then
                        smoothFlyTo(targetPart.CFrame + Vector3.new(0, 3, 0))
                        
                        local maxWait = 5
                        local elapsed = 0
                        while elapsed < maxWait do
                            if not getgenv().AutoExtract then break end
                            local currentVelocity = hrp.AssemblyLinearVelocity.Magnitude
                            if currentVelocity > 15 then
                                task.wait(0.3)
                            else
                                task.wait(0.5)
                                break
                            end
                            elapsed = elapsed + 0.2
                            task.wait(0.2)
                        end
                        
                        task.wait(6) -- Tunggu hitung mundur ekstraksi selesai
                        task.wait(5) -- Jeda menunggu ronde berikutnya
                    end
                end
            end)
        end
    end
end)

