-- ==========================================
-- TOMBOL 1: AUTO BASIC ATTACK (SPAM PUKUL)
-- ==========================================
local attackBtn = Instance.new("TextButton")
attackBtn.Size = UDim2.new(0, 220, 0, 45)
attackBtn.Position = UDim2.new(0.5, -110, 0, 50)
attackBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
attackBtn.Text = "Auto Basic Attack: OFF"
attackBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
attackBtn.TextSize = 13
attackBtn.Font = Enum.Font.SourceSansBold
attackBtn.Parent = mainFrame

local attackAktif = false
attackBtn.MouseButton1Click:Connect(function()
    attackAktif = not attackAktif
    attackBtn.BackgroundColor3 = attackAktif and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    attackBtn.Text = attackAktif and "Auto Basic Attack: ON" or "Auto Basic Attack: OFF"
    
    if attackAktif then
        task.spawn(function()
            while attackAktif do
                local karakter = player.Character
                if karakter then
                    -- Metode 1: Mengaktifkan tool raket di tangan/tas
                    local tool = karakter:FindFirstChildOfClass("Tool") or player.Backpack:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                    end
                    
                    -- Metode 2: Menembak RemoteEvent pukul game secara langsung
                    for _, remote in ipairs(workspace:GetDescendants()) do
                        if remote:IsA("RemoteEvent") then
                            local rName = remote.Name:lower()
                            if rName:find("hit") or rName:find("swing") or rName:find("attack") or rName:find("shot") or rName:find("racket") then
                                pcall(function() remote:FireServer() end)
                            end
                        end
                    end
                    
                    -- Metode 3: Otomatis mencari tombol sentuh pukul di layar HP lalu men-trigger-nya
                    for _, gui in ipairs(playerGui:GetDescendants()) do
                        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                            local gName = gui.Name:lower()
                            if gName:find("hit") or gName:find("swing") or gName:find("attack") or gName:find("action") then
                                pcall(function()
                                    for _, conn in ipairs(getconnections(gui.MouseButton1Click)) do
                                        conn:Fire()
                                    end
                                    for _, conn in ipairs(getconnections(gui.Activated)) do
                                        conn:Fire()
                                    end
                                end)
                            end
                        end
                    end
                end
                task.wait(0.05) -- Spam kecepatan pukul
            end
        end)
    end
end)


-- ==========================================
-- TOMBOL 2: TELEPORT KE TITIK JATUH BOLA (PREDIKSI)
-- ==========================================
local tpBtn = Instance.new("TextButton")
tpBtn.Size = UDim2.new(0, 220, 0, 45)
tpBtn.Position = UDim2.new(0.5, -110, 0, 110)
tpBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
tpBtn.Text = "Teleport Landing: OFF"
tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
tpBtn.TextSize = 13
tpBtn.Font = Enum.Font.SourceSansBold
tpBtn.Parent = mainFrame

local tpAktif = false
tpBtn.MouseButton1Click:Connect(function()
    tpAktif = not tpAktif
    tpBtn.BackgroundColor3 = tpAktif and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(200, 50, 50)
    tpBtn.Text = tpAktif and "Teleport Landing: ON" : "Teleport Landing: OFF" -- (Diperbaiki bawah)
    tpBtn.Text = tpAktif and "Teleport Landing: ON" or "Teleport Landing: OFF"
    
    if tpAktif then
        task.spawn(function()
            local sudahTeleport = false
            
            while tpAktif do
                local karakter = player.Character
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local targetBola = nil
                    
                    -- Cari objek bola di Workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") then
                            local n = obj.Name:lower()
                            if n:find("ball") or n:find("shuttle") or n:find("birdie") or n:find("tennis") then
                                targetBola = obj
                                break
                            end
                        end
                    end
                    
                    if targetBola then
                        local bolaZ = targetBola.Position.Z
                        local playerZ = rootPart.Position.Z
                        
                        -- Logika Zona Aman: Jika bola di zona musuh, jangan teleport
                        local diZonaKita = true
                        if math.abs(bolaZ - playerZ) > 55 then
                            diZonaKita = false
                        end
                        
                        if diZonaKita then
                            -- TELEPORT SEKALI SAJA KE TITIK JATUH (Bukan spam teleport)
                            if not sudahTeleport then
                                -- Prediksi titik jatuh bola di atas lantai (Y disesuaikan dengan posisi lantai lapangan)
                                local posisiJatuh = Vector3.new(targetBola.Position.X, rootPart.Position.Y, targetBola.Position.Z)
                                rootPart.CFrame = CFrame.new(posisiJatuh + Vector3.new(0, 0, 1))
                                
                                sudahTeleport = true
                            end
                        else
                            -- Jika bola kembali ke zona musuh, reset status teleport agar siap untuk bola berikutnya
                            sudahTeleport = false
                        end
                    else
                        sudahTeleport = false
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end)
