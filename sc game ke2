-- ==========================================
-- 5. FITUR UTAMA: AUTO FLY & STEAL + SAFE BASE
-- ==========================================

local autoStealBtn = Instance.new("TextButton")
autoStealBtn.Name = "AutoStealButton"
autoStealBtn.Size = UDim2.new(0, 220, 0, 45)
autoStealBtn.Position = UDim2.new(0.5, -110, 0, 60)
autoStealBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoStealBtn.Text = "Auto Fly Steal: OFF"
autoStealBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
autoStealBtn.TextSize = 14
autoStealBtn.Font = Enum.Font.SourceSansBold
autoStealBtn.Parent = mainFrame

local autoStealAktif = false

-- Fungsi Terbang Halus (Stabil & Aman dari Error)
local function terbangHalusKe(posisiTujuanCFrame, kecepatan)
    local player = game:GetService("Players").LocalPlayer
    local karakter = player.Character
    if not (karakter and karakter:FindFirstChild("HumanoidRootPart") and karakter:FindFirstChild("Humanoid")) then return end
    
    local rootPart = karakter.HumanoidRootPart
    local humanoid = karakter.Humanoid
    
    humanoid.PlatformStand = true
    
    local targetPos = posisiTujuanCFrame.Position
    while autoStealAktif and (rootPart.Position - targetPos).Magnitude > 3 do
        local arah = (targetPos - rootPart.Position).Unit
        rootPart.CFrame = rootPart.CFrame + (arah * (kecepatan / 20))
        task.wait(0.03)
    end
    
    rootPart.CFrame = posisiTujuanCFrame
    humanoid.PlatformStand = false
end

autoStealBtn.MouseButton1Click:Connect(function()
    autoStealAktif = not autoStealAktif
    
    if autoStealAktif then
        autoStealBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        autoStealBtn.Text = "Auto Fly Steal: ON"
        
        task.spawn(function()
            while autoStealAktif do
                local player = game:GetService("Players").LocalPlayer
                local karakter = player.Character
                
                if karakter and karakter:FindFirstChild("HumanoidRootPart") then
                    local rootPart = karakter.HumanoidRootPart
                    local posisiBase = rootPart.CFrame
                    local targetTelur = nil
                    
                    -- Cari telur/item di workspace
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and (obj.Name:lower():find("egg") or obj:FindFirstChild("TouchInterest")) then
                            if obj.Size.Magnitude < 10 and not obj.Name:lower():find("base") then
                                targetTelur = obj
                                break
                            end
                        end
                    end
                    
                    if targetTelur then
                        -- 1. Terbang naik ke udara
                        local posisiAtas = rootPart.CFrame + Vector3.new(0, 15, 0)
                        terbangHalusKe(posisiAtas, 35)
                        
                        -- 2. Terbang meluncur ke atas telur
                        local titikAtasTelur = targetTelur.CFrame + Vector3.new(0, 15, 0)
                        terbangHalusKe(titikAtasTelur, 50)
                        
                        -- 3. Turun mendekati telur untuk mengambilnya
                        local titikTelurDeket = targetTelur.CFrame + Vector3.new(0, 1, 0)
                        terbangHalusKe(titikTelurDeket, 20)
                        task.wait(0.4)
                        
                        -- 4. Terbang naik lagi membawa telur
                        terbangHalusKe(titikAtasTelur, 50)
                        
                        -- 5. Terbang balik ke arah base
                        local titikAtasBase = posisiBase + Vector3.new(0, 15, 0)
                        terbangHalusKe(titikAtasBase, 50)
                        
                        -- 6. Turun halus kembali ke base
                        terbangHalusKe(posisiBase, 25)
                    end
                    
                end
                task.wait(1.5)
            end
        end)
    else
        autoStealBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        autoStealBtn.Text = "Auto Fly Steal: OFF"
    end
end)
