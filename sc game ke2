local function getCubeRarity(name)
    local num = name:match("cube_(%d+)")
    if num then
        return tonumber(num)
    end
    -- Cadangan jika format namanya beda tapi mengandung angka
    local altNum = name:match("(%d+)")
    if altNum and #altNum >= 1 then
        return tonumber(altNum)
    end
    return 0
end

-- 1. Auto Run Extraction
task.spawn(function()
    while true do
        task.wait(0.2)
        if Settings.AutoExtractRun then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                    local targetPart = nil
                    local worldFolder = Workspace:FindFirstChild("World")
                    if worldFolder then
                        local arenaFolder = worldFolder:FindFirstChild("Arena")
                        if arenaFolder then
                            local extractZone = arenaFolder:FindFirstChild("ExtractionZone")
                            if extractZone then
                                for _, part in pairs(extractZone:GetDescendants()) do
                                    if part:IsA("BasePart") and part.Transparency < 0.8 then
                                        targetPart = part
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetPart then
                        char.Humanoid.WalkSpeed = 160
                        char.Humanoid:MoveTo(targetPart.Position)
                    else
                        char.Humanoid.WalkSpeed = 16
                    end
                end
            end)
        end
    end
end)

-- 2. Anti Player (High Fly)
task.spawn(function()
    while true do
        task.wait(0.1)
        if Settings.AntiPlayerHighFly then
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local hrp = char.HumanoidRootPart
                    local playerNearby = false
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local distance = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if distance < 25 then
                                playerNearby = true
                                break
                            end
                        end
                    end
                    
                    if playerNearby then
                        hrp.Velocity = Vector3.new(hrp.Velocity.X, 180, hrp.Velocity.Z)
                    end
                end
            end)
        end
    end
end)

-- 3. Auto Collect Best Cube (DIREVISI AGAR LEBIH SENSITIF & AKURAT)
task.spawn(function()
    while true do
        task.wait(0.2)
        if Settings.AutoCollectRareCube then
            pcall(function()
                local bestCubePart = nil
                local highestRarity = -1
                
                -- Fungsi rekursif untuk menyisir semua objek di workspace
                local function scanFolder(parent)
                    for _, obj in pairs(parent:GetChildren()) do
                        local nameLower = obj.Name:lower()
                        if nameLower:find("cube") or nameLower:find("brainrot") then
                            local rarity = getCubeRarity(obj.Name)
                            if rarity >= highestRarity then
                                highestRarity = rarity
                                if obj:IsA("BasePart") then
                                    bestCubePart = obj
                                elseif obj:IsA("Model") then
                                    bestCubePart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                                end
                            end
                        end
                        -- Lanjut scan ke dalam jika punya anak
                        if #obj:GetChildren() > 0 and not obj:IsA("Player") then
                            scanFolder(obj)
                        end
                    end
                end
                
                scanFolder(Workspace)
                
                -- Teleport instan langsung ke posisi cube terbaik yang didapat
                if bestCubePart and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = bestCubePart.CFrame + Vector3.new(0, 3, 0)
                end
            end)
        end
    end
end)

-- 4. Smart Steal Best Cube Player (DIREVISI)
task.spawn(function()
    while true do
        task.wait(0.3)
        if Settings.SmartStealRareCube then
            pcall(function()
                local targetPlayer = nil
                local highestPlayerRarity = -1
                
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        for _, child in pairs(p.Character:GetDescendants()) do
                            local nameLower = child.Name:lower()
                            if nameLower:find("cube") or nameLower:find("brainrot") then
                                local rarity = getCubeRarity(child.Name)
                                if rarity >= highestPlayerRarity then
                                    highestPlayerRarity = rarity
                                    targetPlayer = p
                                end
                            end
                        end
                    end
                end
                
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local localChar = LocalPlayer.Character
                    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                        localChar.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 2.5)
                        
                        for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                            if tool:IsA("Tool") then
                                tool.Parent = localChar
                            end
                        end
                        
                        for _, tool in pairs(localChar:GetChildren()) do
                            if tool:IsA("Tool") then
                                tool:Activate()
                            end
                        end
                    end
                end
            end)
        end
    end
end)

