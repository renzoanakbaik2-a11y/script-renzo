-- 1. Auto Run Extraction
CreateToggleButton("Auto Run Extraction", "AutoExtractRun", function(state)
    task.spawn(function()
        while Config.AutoExtractRun do
            task.wait(0.2)
            pcall(function()
                local char = LocalPlayer.Character
                local targetPart = nil
                local world = Workspace:FindFirstChild("World")
                if world and world:FindFirstChild("Arena") then
                    local zone = world.Arena:FindFirstChild("ExtractionZone")
                    if zone then
                        for _, v in pairs(zone:GetDescendants()) do
                            if v:IsA("BasePart") and v.Transparency < 0.8 then targetPart = v break end
                        end
                    end
                end
                if targetPart and char and char:FindFirstChild("HumanoidRootPart") then
                    char.Humanoid.WalkSpeed = 160
                    char.Humanoid:MoveTo(targetPart.Position)
                end
            end)
        end
    end)
end)

-- 2. Anti Player (High Fly)
CreateToggleButton("Anti Player (High Fly)", "AntiPlayerHighFly", function(state)
    task.spawn(function()
        while Config.AntiPlayerHighFly do
            task.wait(0.1)
            pcall(function()
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            if (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude < 25 then
                                hrp.Velocity = Vector3.new(0, 180, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

-- 3. Auto Collect Best Cube
CreateToggleButton("Auto Collect Best Cube", "AutoCollectRareCube", function(state)
    task.spawn(function()
        while Config.AutoCollectRareCube do
            task.wait(0.3)
            pcall(function()
                local bestCube, highestRarity = nil, 0
                for _, obj in pairs(Workspace:GetDescendants()) do
                    local r = getCubeRarity(obj.Name)
                    if r > highestRarity then highestRarity = r; bestCube = obj end
                end
                if bestCube and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local target = bestCube:IsA("BasePart") and bestCube or bestCube:FindFirstChildWhichIsA("BasePart")
                    if target then LocalPlayer.Character.HumanoidRootPart.CFrame = target.CFrame + Vector3.new(0, 2, 0) end
                end
            end)
        end
    end)
end)

