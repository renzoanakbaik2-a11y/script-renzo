HopButton.MouseButton1Click:Connect(function()
    HopButton.Text = "Pindah Server..."
    pcall(function()
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        local body = HttpService:JSONDecode(req)
        if body and body.data then
            for _, s in pairs(body.data) do
                if type(s) == "table" and s.maxPlayers and s.playing and s.playing < s.maxPlayers and s.id ~= game.JobId then
                    table.insert(servers, s.id)
                end
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
        else
            HopButton.Text = "Gagal, Coba Lagi"
            task.wait(2)
            HopButton.Text = "Server Hop"
        end
    end)
end)

local isMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    for _, child in pairs(MainFrame:GetChildren()) do
        if child:IsA("GuiObject") and child ~= Title and child ~= MinimizeBtn then
            child.Visible = not isMinimized
        end
    end
    if isMinimized then
        MainFrame.Size = UDim2.new(0, 220, 0, 40)
        MinimizeBtn.Text = "+"
    else
        MainFrame.Size = UDim2.new(0, 220, 0, 215)
        MinimizeBtn.Text = "-"
    end
end)

-- Loop Utama V9: Global Reach Tanpa Batasan Jarak Karakter (Langsung Teleport dari Base ke Arena)
task.spawn(function()
    while true do
        task.wait(0.2)
        if getgenv().AutoPickUp then
            pcall(function()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, p in pairs(Workspace:GetDescendants()) do
                    if not getgenv().AutoPickUp then break end
                    
                    if p:IsA("ProximityPrompt") then
                        local actionText = tostring(p.ActionText):lower()
                        
                        if actionText:find("pick up") then
                            local part = p.Parent
                            if part and part:IsA("BasePart") then
                                
                                -- Pengecekan Base/Pedestal
                                local isInBase = false
                                local ancestor = part.Parent
                                while ancestor and ancestor ~= Workspace do
                                    local name = ancestor.Name:lower()
                                    if name:find("base") or name:find("plot") or name:find("pedestal") or name:find("owner") then
                                        isInBase = true
                                        break
                                    end
                                    ancestor = ancestor.Parent
                                end
                                
                                -- Hapus batasan jarak dari player, jadi dari base pun langsung disambar ke arena!
                                if not isInBase then
                                    hrp.CFrame = CFrame.new(part.Position.X, part.Position.Y + 3, part.Position.Z)
                                    task.wait(0.1)
                                    fireproximityprompt(p)
                                    task.wait(0.2)
                                end
                                
                            end
                        end
                    end
                end
            end)
        end
    end
end)

