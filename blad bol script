local function TriggerSkillButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                if string.lower(gui.Name):find("skill") or string.lower(gui.Name):find("attack") or string.lower(gui.Name):find("fight") then
                    pcall(function()
                        for _, connection in ipairs(getconnections(gui.MouseButton1Click)) do
                            connection:Fire()
                        end
                    end)
                end
            end
        end
    end
end

local lastTeleportTick = 0

