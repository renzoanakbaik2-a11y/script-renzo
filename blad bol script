-- Pastikan executor kamu mendukung fungsi game client
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer

getgenv().AutoParryEnabled = false

local lastParry = 0
local function triggerParry()
    if tick() - lastParry < 0.03 then return end
    lastParry = tick()

    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.01)
    vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- Looping Deteksi Universal (Mencari objek bergerak tercepat di sekitar)
local connection = nil
local function startScript()
    if connection then return end
    
    connection = RunService.Heartbeat:Connect(function()
        if not getgenv().AutoParryEnabled then return end
        
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart
        
        -- Pindai seluruh bagian di workspace untuk mencari objek yang melaju kencang ke arah kita
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Size.Magnitude < 15 and not obj.Anchored then
                local distance = (obj.Position - rootPart.Position).Magnitude
                
                -- Hanya proses objek yang berada dalam radius jangkauan
                if distance <= 45 then
                    local velocity = obj.AssemblyLinearVelocity
                    local speed = velocity.Magnitude
                    
                    -- Jika objek ini bergerak cukup cepat (kriteria bola Blade Ball)
                    if speed > 20 then
                        local toPlayer = (rootPart.Position - obj.Position).Unit
                        local speedTowards = velocity:Dot(toPlayer)
                        
                        -- Jika objek bergerak mendekati player
                        if speedTowards > 0 then
                            local timeToImpact = distance / speedTowards
                            
                            -- Threshold otomatis: Semakin cepat bola di hit ke-3+, semakin peka pemicunya
                            local threshold = math.clamp(0.4 + (speed * 0.001), 0.3, 0.7)
                            
                            -- Eksekusi pukulan jika waktu tubrukan tercapai atau jarak sudah sangat dekat (< 32 studs)
                            if timeToImpact <= threshold or distance <= 32 then
                                triggerParry()
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function stopScript()
    if connection then
        connection:Disconnect()
        connection = nil
    end
end

-- Fungsi Server Hop
local function serverHop()
    local HttpService = game:GetService("HttpService")
    local Servers = {}
    local success = pcall(function()
        local response = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
        Servers = HttpService:JSONDecode(response).data
    end)
    
    if success and Servers then
        for _, s in pairs(Servers) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                break
            end
        end
    else
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end

