-- Blade Ball Auto Parry & UI Script
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

-- Configuration Table
local Settings = {
    AutoParry = false,
    HitDistance = 15,
    AutoPingAdjust = true,
    ConfigFile = "BladeBall_Config.json"
}

-- Load Saved Settings
if isfile and isfile(Settings.ConfigFile) then
    pcall(function()
        local data = HttpService:JSONDecode(readfile(Settings.ConfigFile))
        for k, v in pairs(data) do
            Settings[k] = v
        end
    end)
end

-- Save Settings Function
local function SaveSettings()
    if writefile then
        pcall(function()
            writefile(Settings.ConfigFile, HttpService:JSONEncode({
                AutoParry = Settings.AutoParry,
                HitDistance = Settings.HitDistance,
                AutoPingAdjust = Settings.AutoPingAdjust
            }))
        end)
    end
end

-- Create UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BladeBallUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Toggle Button (Floating)
local OpenBtn = Instance.new("TextButton")
OpenBtn.Size = UDim2.new(0, 100, 0, 35)
OpenBtn.Position = UDim2.new(0, 10, 0.4, 0)
OpenBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
OpenBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
OpenBtn.Text = "Toggle Menu"
OpenBtn.Parent = ScreenGui

-- Main Frame
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 260, 0, 220)
MainFrame.Position = UDim2.new(0.5, -130, 0.5, -110)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = false
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Text = "Blade Ball Auto Parry"
Title.Parent = MainFrame

-- Auto Parry Toggle Button
local AutoParryBtn = Instance.new("TextButton")
AutoParryBtn.Size = UDim2.new(0.8, 0, 0, 35)
AutoParryBtn.Position = UDim2.new(0.1, 0, 0.25, 0)
AutoParryBtn.BackgroundColor3 = Settings.AutoParry and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
AutoParryBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AutoParryBtn.Text = "Auto Parry: " .. (Settings.AutoParry and "ON" or "OFF")
AutoParryBtn.Parent = MainFrame

-- Save Config Button
local SaveBtn = Instance.new("TextButton")
SaveBtn.Size = UDim2.new(0.8, 0, 0, 35)
SaveBtn.Position = UDim2.new(0.1, 0, 0.5, 0)
SaveBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 200)
SaveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SaveBtn.Text = "Save Settings"
SaveBtn.Parent = MainFrame

-- UI Actions
OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

AutoParryBtn.MouseButton1Click:Connect(function()
    Settings.AutoParry = not Settings.AutoParry
    AutoParryBtn.Text = "Auto Parry: " .. (Settings.AutoParry and "ON" or "OFF")
    AutoParryBtn.BackgroundColor3 = Settings.AutoParry and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(170, 0, 0)
end)

SaveBtn.MouseButton1Click:Connect(function()
    SaveSettings()
    SaveBtn.Text = "Saved!"
    task.wait(1)
    SaveBtn.Text = "Save Settings"
end)

-- Parry Trigger Function
local function Parry()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- Ball Detection Loop
RunService.PreRender:Connect(function()
    if not Settings.AutoParry then return end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local balls = workspace:FindFirstChild("Balls") or workspace
    
    for _, ball in pairs(balls:GetChildren()) do
        if ball:IsA("BasePart") and ball:getAttribute("Target") == LocalPlayer.Name then
            local distance = (ball.Position - hrp.Position).Magnitude
            local velocity = ball.AssemblyLinearVelocity.Magnitude
            
            -- Dynamic Prediction Threshold
            local ping = Settings.AutoPingAdjust and (LocalPlayer:GetNetworkPing() * 1000) or 50
            local requiredDistance = Settings.HitDistance + (velocity * 0.05) + (ping * 0.1)

            if distance <= requiredDistance then
                Parry()
                break
            end
        end
    end
end)
