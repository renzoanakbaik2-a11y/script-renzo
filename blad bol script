-- Fungsi Pengecekan Target di Server
local function checkTargetFound(targets)
    for _, targetName in ipairs(targets) do
        targetName = targetName:gsub("^%s*(.-)%s*$", ""):lower()
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                if string.lower(obj.Name):find(targetName) then
                    return true, obj.Name
                end
            end
        end
    end
    return false
end

-- Fungsi Server Hop Aman untuk Executor Delta (Tanpa HttpService yang sering diblock)
local function safeServerHop()
    pcall(function()
        -- Menggunakan metode server hop alternatif yang aman di mobile executor
        local servers = {}
        local req = request or syn and syn.request or http and http.request
        
        if req then
            local success, res = pcall(function()
                return req({
                    Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100",
                    Method = "GET"
                })
            end)
            
            if success and res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.data then
                    for _, s in ipairs(data.data) do
                        if s.playing < s.maxPlayers and s.id ~= game.JobId then
                            table.insert(servers, s.id)
                        end
                    end
                end
            end
        end
        
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            -- Fallback teleport biasa kalau list kosong
            TeleportService:Teleport(game.PlaceId, player)
        end
    end)
end

-- Tombol Start / Stop Manual & Loop AFK
toggleButton.MouseButton1Click:Connect(function()
    isSearching = not isSearching
    
    if isSearching then
        toggleButton.Text = "Status: AFK Mencari... (Klik Stop)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        
        local rawText = textBox.Text
        local targets = {}
        for match in string.gmatch(rawText, "[^,%s]+") do
            table.insert(targets, match)
        end
        
        if #targets == 0 then
            print("Masukkan minimal satu nama seed/bunga!")
            isSearching = false
            toggleButton.Text = "Start Auto Hop"
            toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
            return
        end
        
        task.spawn(function()
            -- Jeda loading awal di server
            task.wait(3)
            
            while isSearching do
                local found, name = checkTargetFound(targets)
                
                if found then
                    print("TARGET KETEMU: " .. name .. "! Auto hop dihentikan.")
                    isSearching = false
                    toggleButton.Text = "Target Ketemu! (" .. name .. ")"
                    toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
                    showWhatsAppNotification(name)
                    break
                else
                    print("Target tidak ditemukan, pindah server...")
                    safeServerHop()
                    task.wait(15) -- Jeda waktu tunggu pindah server
                end
                
                task.wait(3)
            end
        end)
    else
        isSearching = false
        toggleButton.Text = "Start Auto Hop"
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
        notifBanner.Visible = false
        print("Auto hop dihentikan manual.")
    end
end)
