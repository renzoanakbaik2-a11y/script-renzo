-- 3. FUNGSI LOGIKA PERGERAKAN & PATHFINDING
local function jalanKeTarget(targetPos)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true
    })

    local success, _ = pcall(function()
        path:ComputeAsync(HumanoidRootPart.Position, targetPos)
    end)

    if success and path.Status == Enum.PathStatus.Success then
        for _, waypoint in ipairs(path:GetWaypoints()) do
            if not isLooping and currentCommand == "" then break end
            if waypoint.Action == Enum.PathWaypointAction.Jump then
                Humanoid.Jump = true
            end
            Humanoid:MoveTo(waypoint.Position)
            Humanoid.MoveToFinished:Wait()
        end
    else
        Humanoid:MoveTo(targetPos)
    end
end

-- 4. PROCESS PERINTAH AI
local function eksekusiAI(cmd)
    local perintah = string.lower(cmd)
    
    if string.find(perintah, "ambil") or string.find(perintah, "cari") then
        local targetName = string.gsub(perintah, "ambil ", "")
        targetName = string.gsub(targetName, "cari ", "")
        
        local ditemuin = false
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool")) and string.find(string.lower(obj.Name), targetName) then
                ditemuin = true
                StatusLabel.Text = "AI: Bergerak ke " .. obj.Name
                local pos = obj:IsA("Model") and obj:GetPivot().Position or obj.Position
                jalanKeTarget(pos)
                break
            end
        end
        if not ditemuin then
            StatusLabel.Text = "AI: Item '" .. targetName .. "' tidak ada!"
        end
    elseif string.find(perintah, "ikuti") or string.find(perintah, "follow") then
        local targetPlayer = string.gsub(perintah, "ikuti ", "")
        targetPlayer = string.gsub(targetPlayer, "follow ", "")
        
        for _, p in ipairs(Players:GetPlayers()) do
            if string.find(string.lower(p.Name), targetPlayer) and p.Character then
                StatusLabel.Text = "AI: Mengikuti " .. p.Name
                jalanKeTarget(p.Character.HumanoidRootPart.Position)
                break
            end
        end
    else
        StatusLabel.Text = "AI: Perintah tidak dikenali!"
    end
end

-- 5. TRIGGER & AUTO-LOOPING THREAD
SubmitBtn.MouseButton1Click:Connect(function()
    currentCommand = TextBox.Text
    if currentCommand ~= "" then
        task.spawn(function()
            eksekusiAI(currentCommand)
        end)
    end
end)

LoopBtn.MouseButton1Click:Connect(function()
    isLooping = not isLooping
    if isLooping then
        LoopBtn.Text = "AUTO LOOP: ON"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        
        task.spawn(function()
            while isLooping do
                if currentCommand ~= "" then
                    eksekusiAI(currentCommand)
                end
                task.wait(1) -- Jeda loop agar game tidak lag/crash
            end
        end)
    else
        LoopBtn.Text = "AUTO LOOP: OFF"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
    end
end)
