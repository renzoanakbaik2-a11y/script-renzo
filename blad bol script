-- ==========================================
-- LOGIKA AUTO SKILL & TELEPORT DIPERBARUI
-- ==========================================

local function TriggerSkillButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetDescendants()) do
            -- Mencari tombol skill berdasarkan struktur kotak skill di samping layar (seperti gambar yang kamu tandai)
            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                local nameLower = string.lower(gui.Name)
                -- Menargetkan tombol yang biasanya dipakai untuk skill/attack di game pet/turn-based
                if nameLower:find("skill") or nameLower:find("attack") or nameLower:find("fight") or nameLower:find("move") or nameLower:find("button") then
                    pcall(function()
                        -- Mensimulasikan klik 2 kali berturut-turut agar menu info terbuka lalu tereksekusi menyerang
                        for _, connection in ipairs(getconnections(gui.MouseButton1Click)) do
                            connection:Fire()
                            task.wait(0.05)
                            connection:Fire()
                        end
                    end)
                end
            end
        end
    end
end

local lastActionTick = 0

RunService.RenderStepped:Connect(function()
    if not Settings.AutoFarmLevel then return end

    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    local targetBrainrot = nil
    local shortestDistance = math.huge

    -- Cari musuh liar di map (menghindari player & pet sendiri)
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj ~= character and obj:FindFirstChild("HumanoidRootPart") and obj:FindFirstChild("Humanoid") then
            local isMyPetOrSelf = false
            for _, plr in ipairs(Players:GetPlayers()) do
                if obj.Name == plr.Name or (plr.Character and obj == plr.Character) then
                    isMyPetOrSelf = true
                    break
                end
            end

            if not isMyPetOrSelf and obj.Humanoid.Health > 0 then
                local distance = (hrp.Position - obj.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    targetBrainrot = obj
                end
            end
        end
    end

    -- Teleport ke musuh & masuk ring
    if targetBrainrot and targetBrainrot:FindFirstChild("HumanoidRootPart") then
        if tick() - lastActionTick > 2 then
            lastActionTick = tick()
            
            hrp.CFrame = targetBrainrot.HumanoidRootPart.CFrame + Vector3.new(0, 3, 4)
            
            task.wait(0.3)
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end
    end

    -- Eksekusi Auto Skill (Klik dua kali otomatis)
    if Settings.AutoSkill then
        TriggerSkillButton()
    end

    -- Karena fitur Instant Kill diblokir server game, kita maksimalkan di Auto Skill yang menembak terus-menerus
    if Settings.InstantKill then
        if targetBrainrot and targetBrainrot:FindFirstChild("Humanoid") then
            pcall(function()
                targetBrainrot.Humanoid.Health = 0
            end)
        end
    end
end)
