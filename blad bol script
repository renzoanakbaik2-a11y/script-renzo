-- LOGIC UTAMA: Jalan otomatis nge-pick up kalau di-ON-kan
task.spawn(function()
    while true do
        task.Wait(1)
        if isAutoPickActive then
            pcall(function()
                local char = Player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local rootPart = char.HumanoidRootPart

                local blocksToTake = {}
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj.Name == selectedPickBlock then
                        local targetPart = nil
                        if obj:IsA("Model") then
                            targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        elseif obj:IsA("BasePart") then
                            targetPart = obj
                        end

                        -- Filter keamanan: ambil yang di atas menara (Y > 10)
                        if targetPart and targetPart.Position.Y > 10 then
                            table.insert(blocksToTake, targetPart)
                        end
                    end
                end

                if #blocksToTake > 0 and isAutoPickActive then
                    local carried = 0
                    for _, blockPart in ipairs(blocksToTake) do
                        if carried >= maxCarryLimit or not isAutoPickActive then break end
                        
                        -- Karakter nyamperin ke posisi lucky block
                        rootPart.CFrame = blockPart.CFrame + Vector3.new(0, 3, 0)
                        task.Wait(0.3)
                        
                        blockPart.CFrame = rootPart.CFrame + Vector3.new(0, 0, -3)
                        task.Wait(0.2)
                        
                        carried = carried + 1
                        task.Wait(0.4)
                    end
                else
                    task.Wait(2)
                end
            end)
        end
    end
end)

-- Auto Save background (silent)
spawn(function()
    while true do
        pcall(function()
            for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if v:IsA("RemoteEvent") and (string.lower(v.Name):find("save") or string.lower(v.Name):find("autosave")) then
                    v:FireServer()
                end
            end
        end)
        task.Wait(30)
    end
end)
