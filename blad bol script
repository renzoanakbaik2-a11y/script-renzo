-- Pastikan kamu menjalankan script ini menggunakan executor Roblox yang mendukung fungsi client (misal: Delta, Arceus X, Fluxus, dll)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- Status Toggle Auto Parry
getgenv().AutoParryEnabled = false
getgenv().DetectionDistance = 25 -- Jarak deteksi bola (bisa disesuaikan)

-- Fungsi untuk melakukan klik / parry secara otomatis
local function triggerParry()
    -- Mengirim virtual input tombol 'F' atau klik kiri untuk parry
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.05)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- Sistem Deteksi Bola Utama
RunService.RenderStepped:Connect(function()
    if not getgenv().AutoParryEnabled then return end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    
    -- Mencari bola di dalam Workspace (biasanya bernama "Ball")
    local ballsFolder = workspace:FindFirstChild("Balls") or workspace
    for _, ball in pairs(ballsFolder:GetChildren()) do
        if ball.Name == "Ball" and ball:IsA("BasePart") then
            -- Cek apakah bola menargetkan player kita (biasanya ada atribut atau properti target)
            local distance = (ball.Position - rootPart.Position).Magnitude
            
            -- Hitung kecepatan bola untuk menyesuaikan jarak dinamis jika diperlukan
            -- Jika bola sangat cepat, jarak deteksi bisa ditambah sedikit secara otomatis
            local ballSpeed = ball.AssemblyLinearVelocity.Magnitude
            local dynamicThreshold = math.clamp(getgenv().DetectionDistance + (ballSpeed * 0.05), 20, 50)
            
            if distance <= dynamicThreshold then
                -- Cek apakah bola benar-benar bergerak ke arah kita
                local directionToPlayer = (rootPart.Position - ball.Position).Unit
                local ballDirection = ball.AssemblyLinearVelocity.Unit
                local dotProduct = ballDirection:Dot(directionToPlayer)
                
                -- Jika bola mengarah ke kita (dotProduct > 0)
                if dotProduct > 0.3 then
                    triggerParry()
                    task.wait(0.2) -- Jeda singkat agar tidak spam berlebihan
                end
            end
        end
    end
end)

