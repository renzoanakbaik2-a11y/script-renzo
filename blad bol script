-- Fungsi ESP
local function applyESP(targetObj, displayName)
    pcall(function()
        if targetObj:FindFirstChild("TargetESP") then
            targetObj.TargetESP:Destroy()
        end
        
        local espFolder = Instance.new("Folder")
        espFolder.Name = "TargetESP"
        espFolder.Parent = targetObj
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Adornee = targetObj
        highlight.FillColor = Color3.fromRGB(0, 255, 100)
        highlight.FillTransparency = 0.4
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Parent = espFolder
        
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPText"
        billboard.Adornee = targetObj:IsA("Model") and targetObj.PrimaryPart or (targetObj:IsA("BasePart") and targetObj or targetObj:FindFirstChildWhichIsA("BasePart"))
        billboard.Size = UDim2.new(0, 150, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = espFolder
        
        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.Text = "[ TARGET: " .. displayName .. " ]"
        textLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
        textLabel.TextStrokeTransparency = 0
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.GothamBold
        textLabel.Parent = billboard
    end)
end

