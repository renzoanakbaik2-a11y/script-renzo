-- Pastikan executor kamu mendukung fungsi game client
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

getgenv().AutoParryEnabled = false

-- Variabel kontrol untuk mencegah spam macet
local lastParryTick = 0
local parryCooldown = 0.15 -- Jeda minimal antar parry agar aman dari cooldown game

local function triggerParry()
    local currentTime = tick()
    if currentTime - lastParryTick < parryCooldown then return end
    lastParryTick = currentTime

    -- Simulasi tombol F untuk Parry
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.02)
    vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

local parryConnection = nil

local function startAutoParry()
    if parryConnection then return end
    
    parryConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().AutoParryEnabled then return end
        
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart
        
        local ballsFolder = workspace:FindFirstChild("Balls")
        if not ballsFolder then return end
        
        for _, ball in pairs(ballsFolder:GetChildren()) do
            if ball:IsA("BasePart") then
                local ballPos = ball.Position
                local ballVel = ball.AssemblyLinearVelocity
                local distance = (ballPos - rootPart.Position).Magnitude
                
                -- Arah dan kecepatan bola menuju player
                local directionToPlayer = (rootPart.Position - ballPos).Unit
                local velocityTowardsPlayer = ballVel:Dot(directionToPlayer)
                
                if velocityTowardsPlayer > 0 then
                    local timeToImpact = distance / velocityTowardsPlayer
                    local speedMagnitude = ballVel.Magnitude
                    
                    -- Threshold dinamis berdasarkan kecepatan bola
                    local triggerThreshold = math.clamp(0.3 + (speedMagnitude * 0.0008), 0.25, 0.5)
                    
                    -- Kondisi pukul: jika jarak sudah dekat atau waktu tubrukan sudah pas
                    if distance <= 18 or timeToImpact <= triggerThreshold then
                        triggerParry()
                    end
                end
            end
        end
    end)
end

local function stopAutoParry()
    if parryConnection then
        parryConnection:Disconnect()
        parryConnection = nil
    end
end

