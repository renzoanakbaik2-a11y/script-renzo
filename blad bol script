-- Fungsi Pengecekan Target yang Difilter (Anti-Fake Part)
local function checkTargetFound(targets)
    -- Daftar nama umum/sistem yang WAJIB diabaikan agar tidak salah deteksi
    local blacklist = {"basepart", "model", "part", "workspace", "camera", "terrain", "spawnlocation", "meshpart"}

    for _, targetName in ipairs(targets) do
        targetName = targetName:gsub("^%s*(.-)%s*$", ""):lower()
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            local objNameLower = string.lower(obj.Name)
            
            -- Pastikan objek bukan bagian dari blacklist sistem game
            local isBlacklisted = false
            for _, blackWord in ipairs(blacklist) do
                if objNameLower == blackWord then
                    isBlacklisted = true
                    break
                end
            end
            
            -- Cek hanya jika nama objek mengandung target dan lolos filter blacklist
            if not isBlacklisted and objNameLower:find(targetName) then
                -- Pastikan objek tersebut berupa model atau part fisik yang valid (bukan folder kosong)
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    applyESP(obj, obj.Name)
                    return true, obj.Name
                end
            end
        end
    end
    return false
end

-- Fungsi Server Hop Aman untuk Delta
local function safeServerHop()
    pcall(function()
        local servers = {}
        local req = request or syn and syn.request or http and http.request
        
        if req then
            local success, res = pcall(function()
                return req({
                    Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100",
                    Method = "GET"
                })
            end)
            
            if success and res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.data then
                    for _, s in ipairs(data.data) do
                        if s.playing < s.maxPlayers and s.id ~= game.JobId then
                            table.insert(servers, s.id)
                        end
                    end
                end
            end
        end
        
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    end)
end

-- Tombol Start / Stop & Looping AFK
toggleButton.MouseButton1Click:Connect(function()
    isSearching = not isSearching
    
    if isSearching then
        toggleButton.Text = "Status: Mencari... (Klik Stop)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local rawText = textBox.Text
        local targets = {}
        for match in string.gmatch(rawText, "[^,%s]+") do
            table.insert(targets, match)
        end
        
        if #targets == 0 then
            print("Masukkan minimal satu nama seed/bunga!")
            isSearching = false
            toggleButton.Text = "Start Auto Hop"
            toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
            toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
            return
        end
        
        task.spawn(function()
            task.wait(3) -- Jeda loading server
            
            while isSearching do
                local found, name = checkTargetFound(targets)
                
                if found then
                    print("TARGET KETEMU: " .. name .. "! Auto hop dihentikan.")
                    isSearching = false
                    toggleButton.Text = "Target Ketemu! (" .. name .. ")"
                    toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
                    toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
                    showNotification(name)
                    break
                else
                    print("Target tidak ditemukan, pindah server...")
                    safeServerHop()
                    task.wait(15)
                end
                
                task.wait(3)
            end
        end)
    else
        isSearching = false
        toggleButton.Text = "Start Auto Hop"
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
        toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
        notifBanner.Visible = false
        print("Auto hop dihentikan manual.")
    end
end)
