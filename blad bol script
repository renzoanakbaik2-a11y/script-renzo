-- LOGIC UTAMA: Auto Loop Farm Teleport Block ke Base sesuai Max Limit
task.spawn(function()
    while true do
        task.Wait(0.5)
        if isAutoFarmActive then
            pcall(function()
                local char = Player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local rootPart = char.HumanoidRootPart
                
                local availableBlocks = {}
                for _, obj in pairs(Workspace:GetChildren()) do
                    if obj.Name == selectedFarmBlock then
                        table.insert(availableBlocks, obj)
                    end
                end
                
                if #availableBlocks > 0 then
                    local carriedCount = 0
                    
                    for _, block in ipairs(availableBlocks) do
                        if carriedCount >= maxCarryLimit or not isAutoFarmActive then break end
                        
                        if block:IsA("Model") and block.PrimaryPart then
                            block:SetPrimaryPartCFrame(rootPart.CFrame + Vector3.new(0, 3, 0))
                        elseif block:IsA("BasePart") then
                            block.CFrame = rootPart.CFrame + Vector3.new(0, 3, 0)
                        end
                        
                        task.Wait(0.2)
                        
                        local baseDropPos = rootPart.Position + Vector3.new(0, 3, -5)
                        if block:IsA("Model") and block.PrimaryPart then
                            block:SetPrimaryPartCFrame(CFrame.new(baseDropPos))
                        elseif block:IsA("BasePart") then
                            block.CFrame = CFrame.new(baseDropPos)
                        end
                        
                        carriedCount = carriedCount + 1
                        task.Wait(0.3)
                    end
                end
            end)
        end
    end
end)

