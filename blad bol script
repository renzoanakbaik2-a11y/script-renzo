-- Fungsi Server Hop Aman
local function safeHop()
    pcall(function()
        local servers = {}
        local req = request or syn and syn.request or http and http.request
        if req then
            local success, res = pcall(function()
                return req({
                    Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100",
                    Method = "GET"
                })
            end)
            if success and res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.data then
                    for _, s in ipairs(data.data) do
                        if s.playing < s.maxPlayers and s.id ~= game.JobId then
                            table.insert(servers, s.id)
                        end
                    end
                end
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    end)
end

-- Fungsi Pindai Pintar (Mengabaikan objek dasar map yang sering bikin salah deteksi)
local function scanTarget(targets)
    local ignoreList = {"baseplate", "terrain", "spawnlocation", "camera", "lighting", "replicatedstorage"}
    
    for _, targetName in ipairs(targets) do
        targetName = targetName:gsub("^%s*(.-)%s*$", ""):lower()
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            local objName = obj.Name:lower()
            
            -- Pastikan objek bukan bagian dari environment umum
            local skip = false
            for _, ign in ipairs(ignoreList) do
                if objName == ign then
                    skip = true
                    break
                end
            end
            
            if not skip and (obj:IsA("BasePart") or obj:IsA("Model")) then
                if objName:find(targetName) then
                    return true, obj.Name
                end
            end
        end
    end
    return false
end

toggleButton.MouseButton1Click:Connect(function()
    isSearching = not isSearching
    
    if isSearching then
        toggleButton.Text = "STOP (Mencari...)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        
        local rawText = textBox.Text
        local targets = {}
        for match in string.gmatch(rawText, "[^,%s]+") do
            table.insert(targets, match)
        end
        
        if #targets == 0 then
            isSearching = false
            toggleButton.Text = "START AUTO HOP"
            toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 120)
            toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
            return
        end
        
        task.spawn(function()
            task.wait(3) -- Tunggu loading awal server
            while isSearching do
                local found, name = scanTarget(targets)
                
                if found then
                    isSearching = false
                    toggleButton.Text = "KETEMU: " .. name
                    toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 120)
                    toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
                    print("TARGET DITEMUKAN: " .. name)
                    break
                else
                    print("Target tidak ada, pindah server...")
                    safeHop()
                    task.wait(15)
                end
                task.wait(3)
            end
        end)
    else
        isSearching = false
        toggleButton.Text = "START AUTO HOP"
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 120)
        toggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    end
end)
