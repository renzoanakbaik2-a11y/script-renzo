local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local player = Players.LocalPlayer

local frame = script.Parent
local textBox = frame:WaitForChild("TextBox")
local toggleButton = frame:WaitForChild("TextButton")

local screenGui = frame.Parent
local openCloseButton = screenGui:FindFirstChild("OpenButton")

if openCloseButton and openCloseButton:IsA("TextButton") then
    openCloseButton.MouseButton1Click:Connect(function()
        frame.Visible = not frame.Visible
    end)
end

local isSearching = false

-- Cek apakah kita baru saja pindah server dan membawa data sebelumnya (TeleportData)
local teleportData = TeleportService:GetLocalPlayerTeleportData()
if teleportData and teleportData.savedTargets then
    textBox.Text = teleportData.savedTargets
    isSearching = true
end

-- Fungsi buat ngecek target bunga
local function checkTargetFound(targets)
    for _, targetName in ipairs(targets) do
        targetName = targetName:gsub("^%s*(.-)%s*$", ""):lower()
        
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                if string.lower(obj.Name):find(targetName) then
                    return true, obj.Name
                end
            end
        end
    end
    return false
end

-- Fungsi server hop dengan membawa data teks target
local function serverHop(currentTargetsText)
    local success, err = pcall(function()
        local servers = {}
        local cursor = ""
        
        repeat
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            if cursor ~= "" then
                url = url .. "&cursor=" .. cursor
            end
            
            local response = HttpService:JSONDecode(game:HttpGet(url))
            cursor = response.nextPageCursor
            
            for _, s in ipairs(response.data) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    table.insert(servers, s.id)
                end
            end
        until cursor == nil or #servers > 0
        
        -- Siapkan data untuk dikirim ke server tujuan
        local teleportOptions = Instance.new("TeleportOptions")
        teleportOptions:SetTeleportData({savedTargets = currentTargetsText})
        
        if #servers > 0 then
            local randomServerId = servers[math.random(1, #servers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServerId, player, teleportOptions)
        else
            TeleportService:TeleportAsync(game.PlaceId, {player}, teleportOptions)
        end
    end)
    
    if not success then
        warn("Gagal server hop, mencoba lagi...", err)
        task.wait(2)
        serverHop(currentTargetsText)
    end
end

-- Eksekusi otomatis jika data teleport ada (artinya lanjut AFK dari server sebelumnya)
if isSearching then
    toggleButton.Text = "Status: AFK Mencari... (Klik Stop)"
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
    
    task.spawn(function()
        -- Jeda sedikit untuk menunggu game selesai loading sempurna di server baru
        task.wait(5)
        
        while isSearching do
            local rawText = textBox.Text
            local targets = {}
            for match in string.gmatch(rawText, "[^,%s]+") do
                table.insert(targets, match)
            end
            
            if #targets == 0 then
                isSearching = false
                toggleButton.Text = "Start Auto Hop"
                toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
                break
            end
            
            local found, name = checkTargetFound(targets)
            
            if found then
                print("TARGET KETEMU: " .. name .. "! Auto hop dihentikan.")
                isSearching = false
                toggleButton.Text = "Target Ketemu! (" .. name .. ")"
                toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
                break
            else
                print("Target tidak ada, pindah server...")
                serverHop(rawText)
                task.wait(15) -- Jeda waktu pindah
            end
            
            task.wait(3)
        end
    end)
end

-- Tombol Start / Stop manual
toggleButton.MouseButton1Click:Connect(function()
    isSearching = not isSearching
    
    if isSearching then
        toggleButton.Text = "Status: AFK Mencari... (Klik Stop)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        
        local rawText = textBox.Text
        local targets = {}
        for match in string.gmatch(rawText, "[^,%s]+") do
            table.insert(targets, match)
        end
        
        if #targets == 0 then
            print("Masukkan minimal satu nama seed/bunga!")
            isSearching = false
            toggleButton.Text = "Start Auto Hop"
            toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
            return
        end
        
        task.spawn(function()
            while isSearching do
                local found, name = checkTargetFound(targets)
                
                if found then
                    print("TARGET KETEMU: " .. name .. "! Auto hop dihentikan.")
                    isSearching = false
                    toggleButton.Text = "Target Ketemu! (" .. name .. ")"
                    toggleButton.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
                    break
                else
                    print("Target tidak ditemukan di server ini, pindah server...")
                    serverHop(rawText)
